#!/bin/bash
# Integration-lane stand-in for the tailscale CLI, shipped inside the locally
# built tailscale package the lane's file:// apt repository serves (design
# section 7: "locally built packages for every third-party component"). It is
# installed at /usr/bin/tailscale by that package, which is where a real
# tailscale lives and, more to the point, where runuser's reset PATH can find it
# when Harbor runs the operator's unprivileged read-access probe.
#
# It reproduces exactly the CLI surface Harbor calls:
#   tailscale status --json   the read every other read in the operator row
#                             stands on. Root always gets an answer; a non-root
#                             caller gets one only once it is the recorded
#                             operator, which is what makes the probe mean
#                             something.
#   tailscale set --operator=NAME   records the grant. Root only.
#   tailscale get operator    refused as an unknown subcommand, which is what the
#                             current stable CLI does, so the lane exercises the
#                             probe-based branch of the operator row rather than
#                             the exact-value branch.
#   tailscale up --hostname=NAME   the attended login of design sections 3.6 and
#                             5.3, which harbor auth tailscale runs as the
#                             operator without sudo. It prints a login URL on the
#                             terminal and moves BackendState from NeedsLogin to
#                             Running, which is the transition that command waits
#                             for. No tailnet is reached and no auth key exists:
#                             the "approval" is the printed URL and nothing else,
#                             and an --authkey of any spelling is refused.
#   tailscale version         prints the version the package carries.
# Anything else is refused loudly. tailscale login, logout, serve, funnel and down
# stay refused on purpose: the lane never logs a node in to a real tailnet.
#
# The daemon this stands in for is never contacted, so this stub CANNOT settle
# issue #63 (whether a real never-logged-in tailscaled exits 0 for
# status --json). tests/integration/tailscale_status_probe.sh measures that
# against a real daemon; see its header.
set -euo pipefail

it_state=/opt/harbor-it/state
it_shim_log="${it_state}/shim.log"
it_mut_log="${it_state}/mutations.log"
it_operator_file="${it_state}/tailscale.operator"
it_backend_file="${it_state}/tailscale.backend"
it_version_file=/usr/share/harbor-integration/tailscale-version
# The login URL "up" prints. Design section 3.6 says that URL reaches the operator's
# terminal and no log, and an absence assertion proves nothing unless the string it
# looks for is one that really was printed, so it is a fixed literal on both sides
# rather than anything either side generates. This stub is installed inside the
# locally built package and cannot source tests/integration/lib/common.sh, so the
# same literal is spelled there as IT_LOGIN_URL; keep the two byte for byte in step.
# The host is under the reserved .invalid domain: nothing resolves it and nothing
# secret is involved.
it_login_url="https://login.tailscale-integration.invalid/a/f00dcafe0123456789"

it_log() {
  local kind line arg
  kind="${1}"
  shift
  line="$(date -u +%s)"$'\t'"${kind}"$'\t'tailscale
  for arg in "$@"; do
    line="${line}"$'\t'"${arg}"
  done
  # The lane's state directory only exists once setup.sh has run. The stub is
  # also installed by the standalone status probe, which has no lane state and
  # nothing to log to; that is a deliberate branch, not a swallowed error.
  if [ -d "${it_state}" ]; then
    printf '%s\n' "${line}" >>"${it_shim_log}"
    if [ "${kind}" = mutate ]; then
      printf '%s\n' "${line}" >>"${it_mut_log}"
    fi
  fi
}

it_version() {
  if [ -r "${it_version_file}" ]; then
    cat "${it_version_file}"
  else
    printf '0.0.0\n'
  fi
}

it_operator() {
  if [ -r "${it_operator_file}" ]; then
    cat "${it_operator_file}"
  fi
}

# The BackendState this stand-in reports. NeedsLogin until an "up" has run, which is
# the pre-state every bootstrap in this lane measures; the standalone status probe
# installs this stub with no lane state at all and gets the same default.
it_backend() {
  if [ -r "${it_backend_file}" ]; then
    cat "${it_backend_file}"
  else
    printf 'NeedsLogin\n'
  fi
}

it_user="$(id -un)"

case "${1:-}" in
  status)
    it_log inspect "$@"
    if [ "${it_user}" != root ] && [ "${it_user}" != "$(it_operator)" ]; then
      printf 'Access denied: this command is available only to the operator or root\n' >&2
      exit 1
    fi
    case "${2:-}" in
      --json) ;;
      *)
        printf 'Logged out.\n' >&2
        exit 1
        ;;
    esac
    it_backend_state="$(it_backend)"
    if [ "${it_backend_state}" = Running ]; then
      it_want_running=true
    else
      it_want_running=false
    fi
    # AuthURL stays empty in every reading. The login URL belongs to the terminal
    # "up" printed it on and to nothing that reads status, least of all to a caller
    # that might log what it read.
    printf '{\n'
    printf '  "Version": "%s",\n' "$(it_version)"
    printf '  "BackendState": "%s",\n' "${it_backend_state}"
    printf '  "AuthURL": "",\n'
    printf '  "TailscaleIPs": null,\n'
    printf '  "Self": null,\n'
    printf '  "Health": ["state=%s, wantRunning=%s"],\n' "${it_backend_state}" "${it_want_running}"
    printf '  "MagicDNSSuffix": "",\n'
    printf '  "CurrentTailnet": null,\n'
    printf '  "Peer": null,\n'
    printf '  "User": null\n'
    printf '}\n'
    ;;
  set)
    it_log mutate "$@"
    if [ "${it_user}" != root ]; then
      printf 'Access denied: changing settings requires root\n' >&2
      exit 1
    fi
    case "${2:-}" in
      --operator=*) ;;
      *)
        printf 'integration tailscale stub: only --operator=NAME is supported, got %s\n' "${2:-}" >&2
        exit 64
        ;;
    esac
    [ -d "${it_state}" ] || {
      printf 'integration tailscale stub: %s is missing, so the operator grant cannot be recorded\n' "${it_state}" >&2
      exit 1
    }
    printf '%s\n' "${2#--operator=}" >"${it_operator_file}"
    chmod 0644 "${it_operator_file}"
    ;;
  get)
    it_log inspect "$@"
    printf 'tailscale: unknown subcommand "get"\n' >&2
    printf 'For help, run: tailscale --help\n' >&2
    exit 1
    ;;
  version | --version)
    it_log inspect "$@"
    it_version
    ;;
  up)
    it_log mutate "$@"
    # The argv is logged above and carries no URL, which is the point: what this
    # subcommand prints below never reaches shim.log or mutations.log, and the
    # integration assertions look for it in both.
    #
    # Run by the operator without sudo, which is what the design section 5.2 grant
    # exists for; root may run it too and nobody else may, exactly as status does.
    if [ "${it_user}" != root ] && [ "${it_user}" != "$(it_operator)" ]; then
      printf 'Access denied: this command is available only to the operator or root\n' >&2
      exit 1
    fi
    [ -d "${it_state}" ] || {
      printf 'integration tailscale stub: %s is missing, so a login cannot be recorded\n' "${it_state}" >&2
      exit 1
    }
    shift
    it_hostname=""
    for it_arg in "$@"; do
      case "${it_arg}" in
        --hostname=*) it_hostname="${it_arg#--hostname=}" ;;
        --ssh)
          # This release ships with the design section 3.6 --ssh gate closed:
          # vendor-smoke/tailscale-ssh.probe records result=accepted-not-adopted, so
          # the gate opens only on result=accepted and no release under test passes
          # the flag. A Harbor that passed --ssh anyway would be reaching past its own
          # gate, so the stand-in refuses it loudly rather than letting the lane pass
          # quietly.
          printf 'integration tailscale stub: refusing --ssh; the release under test ships the --ssh gate closed\n' >&2
          exit 64
          ;;
        --auth-key* | --authkey*)
          printf 'integration tailscale stub: refusing an auth key; the lane holds none and never logs in to a real tailnet\n' >&2
          exit 64
          ;;
        *)
          printf 'integration tailscale stub: unsupported "up" flag: %s\n' "${it_arg}" >&2
          exit 64
          ;;
      esac
    done
    [ -n "${it_hostname}" ] || {
      printf 'integration tailscale stub: "up" needs --hostname=NAME\n' >&2
      exit 64
    }
    # The vendor prints the login URL on the terminal it was invoked from and
    # nowhere else, and Harbor passes that output straight through without
    # capturing it (design section 5.3).
    printf 'To authenticate, visit:\n\n\t%s\n\n' "${it_login_url}"
    # No tailnet is reached and no approval is waited for: printing the URL is the
    # whole login here, and the backend moves NeedsLogin -> Running, which is the
    # transition harbor auth tailscale polls status for.
    printf 'Running\n' >"${it_backend_file}"
    printf 'Success.\n'
    ;;
  login | logout | serve | funnel | down)
    it_log mutate "$@"
    printf 'integration tailscale stub: refusing "%s"; the lane never logs a node in and holds no auth key\n' "${1}" >&2
    exit 64
    ;;
  *)
    it_log inspect "$@"
    printf 'integration tailscale stub: unsupported invocation: %s\n' "${*}" >&2
    exit 64
    ;;
esac
