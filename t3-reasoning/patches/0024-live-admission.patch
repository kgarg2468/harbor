diff --git a/packages/contracts/src/updateAdmission.ts b/packages/contracts/src/updateAdmission.ts
new file mode 100644
index 0000000000000000000000000000000000000000..241893c2b268c4d8a9506628e54f0600ac92e6e7
--- /dev/null
+++ b/packages/contracts/src/updateAdmission.ts
@@ -0,0 +1,51 @@
+import * as Schema from "effect/Schema";
+import * as HttpServerRespondable from "effect/unstable/http/HttpServerRespondable";
+import * as HttpServerResponse from "effect/unstable/http/HttpServerResponse";
+import * as HttpApiMiddleware from "effect/unstable/httpapi/HttpApiMiddleware";
+import * as RpcMiddleware from "effect/unstable/rpc/RpcMiddleware";
+
+/**
+ * Raised for a client command that arrives while the server is closed for
+ * maintenance (self-update). Retryable: the gate reopens once maintenance ends.
+ *
+ * Declared through transport middleware, so every admitted WebSocket RPC, HTTP
+ * endpoint, and MCP tool carries it in its error channel without each handler
+ * naming it.
+ */
+export class UpdateAdmissionClosedError extends Schema.TaggedError<UpdateAdmissionClosedError>()(
+  "UpdateAdmissionClosedError",
+  {},
+  { httpApiStatus: 503 },
+) {
+  readonly retryable = true;
+
+  override get message(): string {
+    return "Server is closed for maintenance; retry the command shortly";
+  }
+
+  [HttpServerRespondable.symbol]() {
+    return HttpServerResponse.schemaJson(UpdateAdmissionClosedError)(this, { status: 503 });
+  }
+}
+
+/**
+ * Counts one WebSocket RPC as an in-flight client command for its whole
+ * lifetime, including a finite stream until it ends or the client cancels.
+ * Attached only to ordinary public mutations; reads, subscriptions, response
+ * channels, and update control stay outside the gate so maintenance can never
+ * deadlock against the work it waits for.
+ */
+export class UpdateAdmissionRpcMiddleware extends RpcMiddleware.Service<UpdateAdmissionRpcMiddleware>()(
+  "UpdateAdmissionRpcMiddleware",
+  { error: UpdateAdmissionClosedError },
+) {}
+
+/**
+ * The HTTP counterpart of `UpdateAdmissionRpcMiddleware`. Attached inside the
+ * authentication middleware, so an unauthenticated request never learns the
+ * maintenance state.
+ */
+export class UpdateAdmissionHttpMiddleware extends HttpApiMiddleware.Service<UpdateAdmissionHttpMiddleware>()(
+  "UpdateAdmissionHttpMiddleware",
+  { error: UpdateAdmissionClosedError },
+) {}
