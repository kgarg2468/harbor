+    "projects.searchContents",
+    "projects.listEntries",
+    "projects.readFile",
+    "filesystem.browse",
+    "agentSessions.scan",
+    "assets.createUrl",
+    "vcs.refreshStatus",
+    "vcs.listRefs",
+    "git.resolvePullRequest",
+    "review.getDiffPreview",
+    "review.getDiffFileContents",
+    "terminal.attach",
+    "preview.list",
+    "device.list",
+    "device.detail",
+    "device.testHost",
+    "preview.reportStatus",
+    // Update control: these drive maintenance and can never wait on it.
+    "server.updateServer",
+    "server.updateServerWithProgress",
+    "server.commitDesktopUpdate",
+    // Automation host channel: the host answers admitted tool calls through it.
+    "previewAutomation.connect",
+    "previewAutomation.respond",
+    "previewAutomation.focusHost",
+    // Subscriptions.
+    "subscribeDeviceState",
+    "provider.auth.subscribe",
+    "provider.install.subscribe",
+    "pullRequests.subscribeRefreshes",
+    "orchestration.subscribeShell",
+    "orchestration.subscribeThread",
+    "subscribeVcsStatus",
+    "subscribePreviewEvents",
+    "subscribeTerminalEvents",
+    "subscribeTerminalMetadata",
+    "subscribeServerConfig",
+    "subscribeServerLifecycle",
+    "subscribeAuthAccess",
+    "subscribeBackgroundPolicy",
+    "subscribeResourceTelemetry",
+    "subscribeDiscoveredLocalServers",
+  ];
+
+  it("admits exactly the client mutations", () => {
+    const actual = Array.from(WsRpcGroup.requests.values())
+      .filter((rpc) => (rpc.middlewares as ReadonlySet<unknown>).has(UpdateAdmissionRpcMiddleware))
+      .map((rpc) => rpc._tag)
+      .sort();
+    expect(actual).toEqual([...admitted].sort());
+  });
+
+  it("classifies every RPC exactly once", () => {
+    const all = Array.from(WsRpcGroup.requests.keys()).sort();
+    expect(new Set([...admitted, ...excluded]).size).toBe(admitted.length + excluded.length);
+    expect([...admitted, ...excluded].sort()).toEqual(all);
+  });
+});
