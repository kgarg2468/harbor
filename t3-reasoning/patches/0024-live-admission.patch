+
+// Tools that drive the page are client mutations: refused while the server is
+// closed for maintenance, and counted in flight until the host answers or the
+// caller gives up. Observing tools stay open.
+it.effect("admits driving tools and keeps observing tools open during maintenance", () =>
+  Effect.scoped(
+    Effect.gen(function* () {
+      const server = yield* McpServer.McpServer;
+      const broker = yield* PreviewAutomationBroker.PreviewAutomationBroker;
+      const admission = yield* UpdateAdmission.UpdateAdmission;
+      const routed: string[] = [];
+      let clickGate:
+        | { entered: Deferred.Deferred<void>; release: Deferred.Deferred<void> }
+        | undefined;
+      const events = yield* broker.connect({ clientId: "mcp-admission-client", environmentId });
+      yield* Stream.runForEach(events, (event) => {
+        if (event.type === "connected") return Effect.void;
+        routed.push(event.request.operation);
+        const respond = broker.respond({
+          clientId: "mcp-admission-client",
+          connectionId: event.connectionId,
+          requestId: event.request.requestId,
+          ok: true,
+          result:
+            event.request.operation === "status"
+              ? {
+                  available: true,
+                  visible: true,
+                  tabId,
+                  url: "http://example.test/",
+                  title: "Example",
+                  loading: false,
+                }
+              : undefined,
+        });
+        const gate = event.request.operation === "click" ? clickGate : undefined;
+        return gate === undefined
+          ? respond
+          : Deferred.succeed(gate.entered, undefined).pipe(
+              Effect.andThen(Deferred.await(gate.release)),
+              Effect.andThen(respond),
+            );
+      }).pipe(Effect.forkScoped);
+      yield* Effect.yieldNow;
+      const callTool = (name: string, args: Record<string, unknown>) =>
+        server
+          .callTool({ name, arguments: args })
+          .pipe(
+            Effect.provideService(McpInvocationContext.McpInvocationContext, invocation),
+            Effect.provideService(McpSchema.McpServerClient, client),
+          );
+
+      const closed = yield* Deferred.make<void>();
+      const reopen = yield* Deferred.make<void>();
+      const maintenance = yield* admission
+        .withMaintenance(
+          Deferred.succeed(closed, undefined).pipe(Effect.andThen(Deferred.await(reopen))),
+        )
+        .pipe(Effect.forkScoped);
+      yield* Deferred.await(closed);
+
+      const status = yield* callTool("preview_status", {});
+      expect(status.isError).toBe(false);
+      const refused = yield* callTool("preview_click", { x: 10, y: 10 });
+      expect(refused.isError).toBe(true);
+      expect(refused.content).toEqual([
+        { type: "text", text: "Server is closed for maintenance; retry the command shortly" },
+      ]);
+      const refusedRecording = yield* callTool("preview_recording_stop", {});
+      expect(refusedRecording.isError).toBe(true);
+      expect(refusedRecording.content).toEqual(refused.content);
+      const refusedEvaluation = yield* callTool("preview_evaluate", { expression: "1 + 1" });
+      expect(refusedEvaluation.isError).toBe(true);
+      expect(refusedEvaluation.content).toEqual(refused.content);
+      expect(routed).toEqual(["status"]);
+      yield* Deferred.succeed(reopen, undefined);
+      yield* Fiber.join(maintenance);
+
+      // A click the host has not answered yet holds its claim.
+      const held = { entered: yield* Deferred.make<void>(), release: yield* Deferred.make<void>() };
+      clickGate = held;
+      const click = yield* callTool("preview_click", { x: 10, y: 10 }).pipe(Effect.forkScoped);
+      yield* Deferred.await(held.entered);
+      expect((yield* admission.state).inFlight).toBe(1);
+      expect((yield* admission.tryWithMaintenance(Effect.void)).status).toBe("busy");
+      yield* Deferred.succeed(held.release, undefined);
+      expect((yield* Fiber.join(click)).isError).toBe(false);
+      yield* admission.withMaintenance(Effect.void);
+      expect((yield* admission.state).inFlight).toBe(0);
+
+      // The caller giving up releases the claim as well.
+      const abandoned = {
+        entered: yield* Deferred.make<void>(),
+        release: yield* Deferred.make<void>(),
+      };
+      clickGate = abandoned;
+      const interrupted = yield* callTool("preview_click", { x: 10, y: 10 }).pipe(
+        Effect.forkScoped,
+      );
+      yield* Deferred.await(abandoned.entered);
+      expect((yield* admission.tryWithMaintenance(Effect.void)).status).toBe("busy");
+      yield* Fiber.interrupt(interrupted);
+      yield* admission.withMaintenance(Effect.void);
+      expect((yield* admission.state).inFlight).toBe(0);
+      yield* Deferred.succeed(abandoned.release, undefined);
+      expect(routed).toEqual(["status", "click", "click"]);
+    }),
+  ).pipe(Effect.provide(TestLayer)),
+);
