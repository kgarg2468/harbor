index 000000000..d2ba8233f
--- /dev/null
+++ b/apps/server/src/updateActivityRoots.ts
@@ -0,0 +1,172 @@
+/**
+ * UpdateActivityRoots - admission helpers for independent server roots
+ * (timers, settings watchers, sweepers) that must own their work in the
+ * UpdateActivity registry but may not start it while the registry is sealed.
+ *
+ * Only acquisition is retried: a sealed refusal waits, outside any lease,
+ * for the registry revision to move and then tries again. The body of an
+ * operation never runs twice. A closed registry means the server is
+ * shutting down, so waiting roots exit with their scope instead of spinning.
+ *
+ * @module UpdateActivityRoots
+ */
+import * as Deferred from "effect/Deferred";
+import * as Effect from "effect/Effect";
+import * as Exit from "effect/Exit";
+import * as Queue from "effect/Queue";
+import type * as Scope from "effect/Scope";
+
+import {
+  UpdateActivityUnavailableError,
+  type ActivityBlocker,
+  type ActivityLease,
+  type UpdateActivityShape,
+} from "./updateActivity.ts";
+
+type Restore = <A, E, R>(effect: Effect.Effect<A, E, R>) => Effect.Effect<A, E, R>;
+
+// Acquisition itself stays uninterruptible so a lease can never exist without
+// its release installed; only the wait for a sealed registry is restored to
+// interruptible. The revision is read before the attempt, so a seal released
+// between the refusal and the wait wakes the waiter immediately.
+const acquireWhenOpen = (
+  activity: UpdateActivityShape,
+  label: string,
+  restore: Restore,
+): Effect.Effect<ActivityLease, UpdateActivityUnavailableError> =>
+  Effect.gen(function* () {
+    while (true) {
+      const { revision } = yield* activity.state;
+      const attempt = yield* Effect.exit(activity.acquire(label));
+      if (Exit.isSuccess(attempt)) return attempt.value;
+      const refusal = Exit.isFailure(attempt) ? attempt.cause.reasons[0] : undefined;
+      if (refusal?._tag !== "Fail" || refusal.error.reason !== "sealed") {
+        return yield* Effect.failCause(attempt.cause);
+      }
+      yield* restore(activity.awaitChange(revision));
+    }
+  });
+
+/**
+ * Runs `effect` under a lease, waiting while the registry is sealed before
+ * acquiring it. Open-but-busy admits immediately. A closed registry ends the
+ * caller by interruption, which is how a root retires with its scope.
+ */
+export const runWhenOpen = <A, E, R>(
+  activity: UpdateActivityShape,
+  label: string,
+  effect: Effect.Effect<A, E, R>,
+): Effect.Effect<A, E, R> =>
+  Effect.uninterruptibleMask((restore) =>
+    acquireWhenOpen(activity, label, restore).pipe(
+      Effect.catchTag("UpdateActivityUnavailableError", () => Effect.interrupt),
+      Effect.flatMap((lease) => Effect.ensuring(restore(effect), Effect.sync(lease.release))),
+    ),
+  );
+
+export interface TrackedWorker<A> {
+  /**
+   * Transfers a lease to the worker with the item, waiting while sealed.
+   * Caller cancellation after acceptance cannot release the lease.
+   */
+  readonly enqueue: (value: A) => Effect.Effect<void, UpdateActivityUnavailableError>;
+  /** Resolves when this worker's queued and in-flight items are done. Local convenience, never the global proof. */
+  readonly drain: Effect.Effect<void>;
+}
+
+interface TrackedItem<A> {
+  readonly value: A;
+  readonly lease: ActivityLease;
+}
+
+/**
+ * A queue worker whose items each own a registry lease from acceptance until
+ * processing ends. An uncaught failure kills the worker and leaves a permanent
+ * blocker so lost work can never look like idleness.
+ */
+export const makeTrackedWorker = <A, E, R>(
+  activity: UpdateActivityShape,
+  name: string,
+  process: (value: A) => Effect.Effect<void, E, R>,
+): Effect.Effect<TrackedWorker<A>, never, R | Scope.Scope> =>
+  Effect.gen(function* () {
+    const queue = yield* Queue.unbounded<TrackedItem<A>>();
+    let closed = false;
+    let localOutstanding = 0;
+    let unavailable: ActivityBlocker | undefined;
+    const drainWaiters = new Set<Deferred.Deferred<void>>();
+
+    const settle = (lease: ActivityLease): void => {
+      lease.release();
+      localOutstanding -= 1;
+      if (localOutstanding > 0 || drainWaiters.size === 0) return;
+      const woken = Array.from(drainWaiters);
+      drainWaiters.clear();
+      for (const waiter of woken) Deferred.doneUnsafe(waiter, Effect.void);
+    };
+
+    const markUnavailable = (): void => {
+      unavailable ??= activity.block(`worker unavailable: ${name}`);
+    };
+
+    // Blocker first, then pending leases, all in one synchronous step so no
+    // observer can see the count hit zero without the blocker.
+    const shutdown = Effect.sync(() => {
+      if (closed) return;
+      closed = true;
+      markUnavailable();
+      for (
+        let item = Queue.takeUnsafe(queue);
+        item !== undefined && Exit.isSuccess(item);
+        item = Queue.takeUnsafe(queue)
+      ) {
+        settle(item.value.lease);
+      }
+    }).pipe(Effect.andThen(Queue.shutdown(queue)));
+
+    // The item finalizer is installed before `process` is even constructed, so
+    // a callback that throws synchronously still settles its lease. The mask
+    // keeps the dequeue-to-finalizer handoff atomic while waiting and
+    // processing stay interruptible.
+    const processItem = (item: TrackedItem<A>, restore: Restore) =>
+      Effect.onExit(restore(Effect.suspend(() => process(item.value))), (exit) =>
+        Effect.sync(() => {
+          if (!Exit.isSuccess(exit)) markUnavailable();
+          settle(item.lease);
+        }),
+      );
+
+    yield* Effect.uninterruptibleMask((restore) =>
+      Effect.flatMap(restore(Queue.take(queue)), (item) => processItem(item, restore)),
+    ).pipe(
+      Effect.forever,
+      Effect.onExit(() => shutdown),
+      Effect.forkScoped,
+    );
+    yield* Effect.addFinalizer(() => shutdown);
+
+    const enqueue: TrackedWorker<A>["enqueue"] = (value) =>
+      Effect.uninterruptibleMask((restore) =>
+        Effect.flatMap(acquireWhenOpen(activity, `${name} item`, restore), (lease) =>
+          Effect.suspend(() => {
+            if (!closed && Queue.offerUnsafe(queue, { value, lease })) {
+              localOutstanding += 1;
+              return Effect.void;
+            }
+            lease.release();
+            return Effect.fail(new UpdateActivityUnavailableError({ reason: "worker-closed" }));
+          }),
+        ),
+      );
+
+    const drain: TrackedWorker<A>["drain"] = Effect.suspend(() => {
+      if (localOutstanding === 0) return Effect.void;
+      const waiter = Deferred.makeUnsafe<void>();
+      drainWaiters.add(waiter);
+      return Effect.onInterrupt(Deferred.await(waiter), () =>
+        Effect.sync(() => drainWaiters.delete(waiter)),
+      );
+    });
+
+    return { enqueue, drain } satisfies TrackedWorker<A>;
+  });
diff --git a/packages/effect-codex-app-server/src/client.test.ts b/packages/effect-codex-app-server/src/client.test.ts
