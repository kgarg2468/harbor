+    const spawned = makeSpawn();
+    const sdk = makeSdkQuery();
+    const first = makeClaudeQueryRuntime(
+      { prompt: emptyPrompt, options: baseOptions },
+      { query: sdk.query, spawn: spawned.spawn },
