+  const awaitResponse = (id: number | string) =>
+    Effect.gen(function* () {
+      while (true) {
+        const response = yield* Queue.take(responses);
+        if (response.id === id) return response;
+      }
+    });
+
+  return {
+    spawner,
+    notify: (method: string, params: unknown) => write({ jsonrpc: "2.0", method, params }),
+    serverRequest: (id: number, method: string, params: unknown) =>
+      write({ jsonrpc: "2.0", id, method, params }),
+    awaitTurnStart: Queue.take(turnStarts),
+    pendingTurnStarts: Queue.size(turnStarts),
+    awaitCompactStart: Queue.take(compactStarts),
+    pendingCompactStarts: Queue.size(compactStarts),
+    respond: (id: number | string, result: unknown) => write({ id, result }),
+    respondError: (id: number | string, message: string) =>
+      write({ id, error: { code: -32000, message } }),
+    awaitResponse,
+    /** Bytes on stdout exactly as given: several frames in one chunk, or a partial one. */
+    writeRaw: (text: string) =>
+      Effect.sync(() => {
+        Queue.offerUnsafe(stdout, encoder.encode(text));
+      }),
+    /** The process ends on its own, as a crash or a self-exit would. */
+    exit: (code: number) => Effect.sync(() => finishExit(code)),
+    /** The process is gone but died to a signal: no exit code, not running. */
+    signalExit: () =>
+      Effect.sync(() => {
+        running = false;
+        Deferred.doneUnsafe(exit, Effect.fail(platformError("exitCode", "killed by signal")));
+        Queue.endUnsafe(stdout);
+      }),
+    /** The status waiter fails while the process is, as far as anyone knows, still running. */
+    failExitWaiter: () =>
+      Effect.sync(() => {
+        Deferred.doneUnsafe(exit, Effect.fail(platformError("exitCode", "waiter broke")));
+      }),
+    /** Every kill attempt is refused; the process keeps running. */
+    failKill: () => {
+      killFails = true;
+    },
+    awaitKill: Deferred.await(killAttempted),
+    /** A kill is requested but the process lingers until `releaseExit`. */
+    holdExit: () => {
