+    usage: {
+      input_tokens: 10,
+      cache_read_input_tokens: 0,
+      cache_creation_input_tokens: 0,
+      output_tokens: 5,
+    },
+    ...(userMessageUuids ? { user_message_uuids: userMessageUuids } : {}),
+    ...(options?.singleUserMessageUuid !== undefined
+      ? { user_message_uuid: options.singleUserMessageUuid }
+      : {}),
+    session_id: "sdk-session-native",
+    uuid,
+  }) as unknown as SDKMessage;
+
+const nativeTaskStarted = (
+  taskId: string,
+  options?: { readonly skipTranscript?: boolean; readonly uuid?: string },
+) =>
+  ({
+    type: "system",
+    subtype: "task_started",
+    task_id: taskId,
+    description: `Task ${taskId}`,
+    task_type: "local_agent",
+    ...(options?.skipTranscript !== undefined ? { skip_transcript: options.skipTranscript } : {}),
+    session_id: "sdk-session-native",
+    uuid: options?.uuid ?? `${taskId}-started`,
+  }) as unknown as SDKMessage;
+
+/** Resolves once the registry reports no outstanding work and no blocker. */
+const awaitRegistryQuiet = (activity: UpdateActivityShape) =>
+  Effect.gen(function* () {
+    let state = yield* activity.state;
+    while (state.outstanding > 0 || state.blockers.length > 0) {
+      state = yield* activity.awaitChange(state.revision);
+    }
+  });
+
+const nativeTaskNotification = (taskId: string) =>
+  ({
+    type: "system",
+    subtype: "task_notification",
+    task_id: taskId,
+    status: "completed",
+    summary: `Task ${taskId} finished`,
+    session_id: "sdk-session-native",
+    uuid: `${taskId}-notification`,
+  }) as unknown as SDKMessage;
+
+const nativeRoster = (
+  uuid: string,
+  tasks: ReadonlyArray<{ readonly taskId: string; readonly ambient?: boolean }>,
+) =>
+  ({
+    type: "system",
+    subtype: "background_tasks_changed",
+    tasks: tasks.map((task) => ({
+      task_id: task.taskId,
+      task_type: "local_agent",
+      description: `Task ${task.taskId}`,
+      ...(task.ambient !== undefined ? { ambient: task.ambient } : {}),
+    })),
+    session_id: "sdk-session-native",
+    uuid,
+  }) as unknown as SDKMessage;
+
+const promptUuidOf = (message: SDKUserMessage | undefined): string => {
+  assert.equal(typeof message?.uuid, "string", "prompt carries a client uuid");
+  return message?.uuid ?? "";
+};
+
+/**
+ * Builds a registry, an adapter owning its runtime events through it, the
+ * required consumer, and one started session. `body` runs with the adapter
+ * alive; `afterAdapter` runs once the adapter scope has closed, with the
+ * registry still open and the consumer's run fiber available.
+ */
+const nativeOwnershipScenario = <E1 = never, E2 = never>(
+  config: {
+    readonly runtimeMode?: RuntimeMode;
+    readonly nativeExit?: boolean;
+    readonly hold?: (event: ProviderRuntimeEvent) => boolean;
+    readonly afterAdapter?: (env: {
+      readonly activity: UpdateActivityShape;
+      readonly consumerFiber: OwnedConsumer["fiber"];
+    }) => Effect.Effect<void, E2>;
+  },
+  body: (env: {
+    readonly activity: UpdateActivityShape;
+    readonly adapter: ClaudeAdapterShape;
+    readonly harness: ReturnType<typeof makeHarness>;
+    readonly consumer: OwnedConsumer;
+    readonly settle: Effect.Effect<void>;
+    readonly nextPrompt: Effect.Effect<SDKUserMessage | undefined>;
+  }) => Effect.Effect<void, E1, ClaudeAdapter>,
+) =>
+  Effect.gen(function* () {
+    const activity = yield* makeUpdateActivity();
+    const harness = makeHarness({
+      updateActivity: activity,
+      ...(config.nativeExit === true ? { nativeExit: true } : {}),
+    });
+    const consumerFiber = yield* Effect.gen(function* () {
+      const adapter = yield* ClaudeAdapter;
+      const consumer = yield* subscribeOwnedConsumer(adapter, config.hold);
+      yield* adapter.startSession({
+        threadId: THREAD_ID,
+        provider: ProviderDriverKind.make("claudeAgent"),
+        runtimeMode: config.runtimeMode ?? "full-access",
+      });
+      const settle = settleNative(harness.query, consumer);
+      yield* settle;
+      let promptIterator: AsyncIterator<SDKUserMessage> | undefined;
+      const nextPrompt = Effect.promise(async () => {
+        promptIterator ??= harness.getLastCreateQueryInput()?.prompt[Symbol.asyncIterator]();
+        const next = await promptIterator?.next();
+        return next && !next.done ? next.value : undefined;
+      });
+      yield* body({ activity, adapter, harness, consumer, settle, nextPrompt });
+      return consumer.fiber;
+    }).pipe(
+      Effect.provideService(Random.Random, makeDeterministicRandomService()),
+      Effect.provide(harness.layer),
+    );
+    if (config.afterAdapter) {
+      yield* config.afterAdapter({ activity, consumerFiber });
+    }
+  }).pipe(Effect.scoped);
