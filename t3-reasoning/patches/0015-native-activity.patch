+/**
+ * Wraps an activity so the next raw-notification lease request parks until
+ * released. That request is made inline in the protocol reader's dispatch,
+ * so the parked reader still holds every later line of the same chunk,
+ * unread by anything with a lease. Every lease label is also recorded.
+ */
+const makeRawAcquireGate = (base: UpdateActivityShape) => {
+  const acquired: Array<string> = [];
+  let armed:
+    | { readonly paused: Deferred.Deferred<void>; readonly resume: Deferred.Deferred<void> }
+    | undefined;
+  const activity: UpdateActivityShape = {
+    ...base,
+    acquire: (label) =>
+      Effect.suspend(() => {
+        acquired.push(label);
+        const gate = label === "codex raw notification" ? armed : undefined;
+        if (gate === undefined) return base.acquire(label);
+        armed = undefined;
+        Deferred.doneUnsafe(gate.paused, Effect.void);
+        return Deferred.await(gate.resume).pipe(Effect.andThen(base.acquire(label)));
+      }),
+  };
+  return {
+    activity,
+    acquired,
+    pauseNext: () => {
+      const gate = { paused: Deferred.makeUnsafe<void>(), resume: Deferred.makeUnsafe<void>() };
+      armed = gate;
+      return {
+        paused: Deferred.await(gate.paused),
+        resume: Effect.sync(() => {
+          Deferred.doneUnsafe(gate.resume, Effect.void);
+        }),
+      };
+    },
+  };
+};
