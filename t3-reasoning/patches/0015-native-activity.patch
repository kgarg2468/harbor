index 000000000..750130630
--- /dev/null
+++ b/apps/server/src/provider/claudeQueryRuntime.ts
@@ -0,0 +1,257 @@
+// @effect-diagnostics nodeBuiltinImport:off - the SDK hook hands over a raw Node spawn
+// @effect-diagnostics globalTimers:off - the stderr grace mirrors the SDK's own plain timer
+/**
+ * ClaudeQueryRuntime - the production Claude SDK query factory, with proof of
+ * the CLI process exit for each query.
+ *
+ * The SDK's `Query` never exposes its child process: `close()` only asks the
+ * CLI to stop, its cleanup waits at most two seconds for the exit, and the
+ * message iterator can finish while the process still works. The public
+ * `spawnClaudeCodeProcess` hook is the one place the SDK hands over the exact
+ * spawn it would otherwise perform itself, so the factory spawns there,
+ * observes the raw child's exit before the SDK ever sees the child, and
+ * exposes that observation as `waitForExit`.
+ *
+ * The hook replaces the SDK's own local spawn wrapper, so this file mirrors
+ * what that wrapper did: decode and drain stderr, forward it to the
+ * `Options.stderr` callback, and deliver the SDK's exit observers only after
+ * stderr closed or a short grace elapsed. The exit proof itself uses the raw
+ * exit event and never waits on that grace. Stop, kill, and abort policy stay
+ * with the SDK, which drives them through the forwarded signal and `kill`.
+ *
+ * @module ClaudeQueryRuntime
+ */
+import * as NodeChildProcess from "node:child_process";
+import type * as NodeEvents from "node:events";
+import type * as NodeStream from "node:stream";
+import * as NodeStringDecoder from "node:string_decoder";
+
+import {
+  query,
+  type Options,
+  type PermissionMode,
+  type Query,
+  type SDKMessage,
+  type SDKUserMessage,
+  type SpawnOptions,
+  type SpawnedProcess,
+} from "@anthropic-ai/claude-agent-sdk";
+
+/** The subset of a Node `ChildProcess` spawned with piped stdio that this factory relies on. */
+export interface ClaudeChildProcess extends NodeEvents.EventEmitter {
+  readonly stdin: NodeStream.Writable;
+  readonly stdout: NodeStream.Readable;
+  readonly stderr: NodeStream.Readable;
+  /** Set only once the process actually started; a failed spawn leaves it undefined. */
+  readonly pid?: number | undefined;
+  readonly killed: boolean;
+  readonly exitCode: number | null;
+  readonly signalCode: NodeJS.Signals | null;
+  kill(signal?: NodeJS.Signals): boolean;
+}
+
+/** Exactly the spawn options the SDK's own local spawn uses. */
+export interface ClaudeSpawnOptions {
+  readonly cwd?: string;
+  readonly env: SpawnOptions["env"];
+  readonly signal: AbortSignal;
+  readonly stdio: ["pipe", "pipe", "pipe"];
+  readonly windowsHide: true;
+}
+
+export type ClaudeSpawn = (
+  command: string,
+  args: ReadonlyArray<string>,
+  options: ClaudeSpawnOptions,
+) => ClaudeChildProcess;
+
+export interface ClaudeQueryInput {
+  readonly prompt: AsyncIterable<SDKUserMessage>;
+  readonly options: Options;
+}
+
+/** What the factory needs from the SDK's `Query`; the real one is a superset. */
+export type ClaudeSdkQuery = AsyncIterable<SDKMessage> &
+  Pick<Query, "setModel" | "setPermissionMode" | "setMaxThinkingTokens" | "close">;
+
+export interface ClaudeProcessQueryRuntime extends AsyncIterable<SDKMessage> {
+  readonly setModel: (model?: string) => Promise<void>;
+  readonly setPermissionMode: (mode: PermissionMode) => Promise<void>;
+  readonly setMaxThinkingTokens: (maxThinkingTokens: number | null) => Promise<void>;
+  readonly close: () => void;
+  /**
+   * Settles once the raw child process has exited, or once it is proven that
+   * no child ever started. It never rejects: a child `error` event (a spawn
+   * failure, Node's abort error, a kill failure) is not an exit, so the wait
+   * continues until the exit event arrives or the failed spawn is proven by
+   * the child having no pid.
+   */
+  readonly waitForExit: () => Promise<void>;
+}
+
+/** Test seams only; production uses the SDK `query` and Node `spawn`. */
+export interface ClaudeQueryRuntimeDeps {
+  readonly query?: (input: ClaudeQueryInput) => ClaudeSdkQuery;
+  readonly spawn?: ClaudeSpawn;
+}
+
+/** Name under which SDK exit observers are notified, after stderr drained. */
+const DRAINED_EXIT_EVENT = "t3-exit-after-stderr-drained";
+/** How long a delivered exit waits for stderr to close, as in the SDK's own wrapper. */
+const STDERR_DRAIN_GRACE_MS = 200;
+
+const spawnLocal: ClaudeSpawn = (command, args, options) =>
+  NodeChildProcess.spawn(command, args, options);
+
+interface ExitProof {
+  readonly promise: Promise<void>;
+  readonly settle: () => void;
+}
+
+const makeExitProof = (): ExitProof => {
+  let settle: () => void = () => {};
+  const promise = new Promise<void>((resolve) => {
+    settle = resolve;
+  });
+  return { promise, settle };
+};
+
+/**
+ * Observes the raw child before the SDK gets it. A spawn failure surfaces as
+ * an `error` on a child that never got a pid; any other error leaves the
+ * process possibly alive, so only the exit event may settle the proof.
+ */
+const observeRawExit = (child: ClaudeChildProcess, exit: ExitProof): void => {
+  child.once("exit", () => exit.settle());
+  child.on("error", () => {
+    if (child.pid === undefined) exit.settle();
+  });
+};
+
+type ExitListener = (code: number | null, signal: NodeJS.Signals | null) => void;
+type ErrorListener = (error: Error) => void;
+
+/**
+ * The SDK-facing view of the child, matching the SDK's local spawn wrapper:
+ * stderr is decoded as UTF-8 and forwarded to `stderr`, and the SDK's `exit`
+ * observers fire only after stderr closed or the grace elapsed, so the
+ * callback has received everything before the SDK reacts to the exit. What
+ * this cannot restore is the SDK's private stderr tail: only its own spawn
+ * fills it, so exit errors raised by the SDK omit the stderr excerpt. The
+ * `stderr` callback is the only place that output remains available.
+ */
+const wrapForSdk = (child: ClaudeChildProcess, stderr: Options["stderr"]): SpawnedProcess => {
+  const decoder = new NodeStringDecoder.StringDecoder("utf8");
+  let delivered = false;
+  let stderrClosed = false;
+  let exited = false;
+  let grace: NodeJS.Timeout | undefined;
+
+  const deliver = (): void => {
+    if (delivered) return;
+    delivered = true;
+    if (grace !== undefined) clearTimeout(grace);
+    child.emit(DRAINED_EXIT_EVENT, child.exitCode, child.signalCode);
+    if (!stderrClosed) child.stderr.destroy();
+  };
+
+  child.stderr.on("data", (chunk: Buffer | string) => {
+    if (delivered) return;
+    const text = typeof chunk === "string" ? chunk : decoder.write(chunk);
+    if (text.length > 0) stderr?.(text);
+  });
+  // A failed stderr read only ends the drain; the process outcome is the child's.
+  child.stderr.on("error", () => {});
+  child.stderr.once("close", () => {
+    const rest = decoder.end();
+    if (rest.length > 0 && !delivered) stderr?.(rest);
+    stderrClosed = true;
+    if (exited) deliver();
+  });
+  child.once("exit", () => {
+    exited = true;
+    if (stderrClosed) deliver();
+    else grace = setTimeout(deliver, STDERR_DRAIN_GRACE_MS);
+  });
+
+  const sdkEvent = (event: "exit" | "error"): string =>
+    event === "exit" ? DRAINED_EXIT_EVENT : event;
+
+  return {
+    stdin: child.stdin,
+    stdout: child.stdout,
+    get killed() {
+      return child.killed;
+    },
+    get exitCode() {
+      return child.exitCode;
+    },
+    get signalCode() {
+      return child.signalCode;
+    },
+    kill: (signal) => child.kill(signal),
+    on: (event: "exit" | "error", listener: ExitListener | ErrorListener) => {
+      child.on(sdkEvent(event), listener);
+    },
+    once: (event: "exit" | "error", listener: ExitListener | ErrorListener) => {
+      child.once(sdkEvent(event), listener);
+    },
+    off: (event: "exit" | "error", listener: ExitListener | ErrorListener) => {
+      child.off(sdkEvent(event), listener);
+    },
+  };
+};
+
+/**
+ * Starts an SDK query whose CLI process this factory spawned, returning the
+ * query's methods bound to the real SDK instance plus `waitForExit` backed by
+ * that one child's raw exit. The SDK computes the command, arguments, cwd,
+ * environment and forwarded abort signal; the hook applies them unchanged,
+ * with piped stdio and a hidden window exactly as the SDK's own spawn does.
+ *
+ * A spawn that throws synchronously never produced a child, so the proof
+ * settles before the SDK rethrows. A query configured to spawn later (the
+ * SDK defers only for session-store resumes, which the adapter never uses)
+ * keeps the proof pending until that spawn happens.
+ */
+export const makeClaudeQueryRuntime = (
+  input: ClaudeQueryInput,
+  deps?: ClaudeQueryRuntimeDeps,
+): ClaudeProcessQueryRuntime => {
+  const spawnChild = deps?.spawn ?? spawnLocal;
+  const startQuery = deps?.query ?? query;
+  const exit = makeExitProof();
+  const stderr = input.options.stderr;
+
+  const spawnClaudeCodeProcess = (spawnOptions: SpawnOptions): SpawnedProcess => {
+    let child: ClaudeChildProcess;
+    try {
+      child = spawnChild(spawnOptions.command, spawnOptions.args, {
+        ...(spawnOptions.cwd !== undefined ? { cwd: spawnOptions.cwd } : {}),
+        env: spawnOptions.env,
+        signal: spawnOptions.signal,
+        stdio: ["pipe", "pipe", "pipe"],
+        windowsHide: true,
+      });
+    } catch (error) {
+      exit.settle();
+      throw error;
+    }
+    observeRawExit(child, exit);
+    return wrapForSdk(child, stderr);
+  };
+
+  const sdkQuery = startQuery({
+    prompt: input.prompt,
+    options: { ...input.options, spawnClaudeCodeProcess },
+  });
+
+  return {
+    setModel: (model) => sdkQuery.setModel(model),
+    setPermissionMode: (mode) => sdkQuery.setPermissionMode(mode),
+    setMaxThinkingTokens: (maxThinkingTokens) => sdkQuery.setMaxThinkingTokens(maxThinkingTokens),
+    close: () => sdkQuery.close(),
+    [Symbol.asyncIterator]: () => sdkQuery[Symbol.asyncIterator](),
+    waitForExit: () => exit.promise,
+  };
+};
