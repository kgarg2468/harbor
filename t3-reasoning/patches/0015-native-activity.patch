+        default:
+          return yield* write({ id: message.id, result: {} });
+      }
+    });
+
+  const stdin = Sink.forEach((chunk: Uint8Array) =>
+    Effect.gen(function* () {
+      buffered += decoder.decode(chunk, { stream: true });
+      const lines = buffered.split("\n");
+      buffered = lines.pop() ?? "";
+      for (const line of lines) {
