+const expectBusy = (activity: UpdateActivityShape) =>
+  Effect.map(activity.trySealIdle, (claim) => {
+    NodeAssert.equal(claim.status, "busy");
+  });
+
+const expectSealed = (activity: UpdateActivityShape) =>
+  Effect.map(activity.trySealIdle, (claim) => {
+    NodeAssert.equal(claim.status, "sealed");
+    if (claim.status === "sealed") claim.seal.release();
+  });
