+/** The required consumer, settling each delivery at once unless told to hold. */
+const startRequiredConsumer = (runtime: CodexSessionRuntimeShape) =>
+  Effect.gen(function* () {
+    NodeAssert.ok(runtime.subscribeUpdateEvents);
+    const subscription = yield* runtime.subscribeUpdateEvents;
+    const seen = yield* Queue.unbounded<OwnedDelivery<ProviderEvent>>();
+    const held: Array<OwnedDelivery<ProviderEvent>> = [];
+    let holding = false;
+    const fiber = yield* Effect.forkScoped(
+      subscription.run((delivery) =>
+        Effect.sync(() => {
+          if (holding) held.push(delivery);
+          else delivery.complete();
+          Queue.offerUnsafe(seen, delivery);
+        }),
+      ),
+    );
+    const awaitEvent = (method: string) =>
+      Effect.gen(function* () {
+        while (true) {
+          const delivery = yield* Queue.take(seen);
+          if (delivery.value.method === method) return delivery;
+        }
+      });
