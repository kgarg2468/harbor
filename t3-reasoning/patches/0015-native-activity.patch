+/**
+ * Pauses the runtime's event-id generation once, on demand. Every emitted
+ * event asks for an id before anything else, so this parks a raw handler in
+ * the middle of mapping, before the ownership transition that follows the
+ * emit, without touching the runtime.
+ */
+const makeEventIdGate = Effect.gen(function* () {
+  const base = yield* Crypto.Crypto;
+  let armed:
+    | { readonly paused: Deferred.Deferred<void>; readonly resume: Deferred.Deferred<void> }
+    | undefined;
+  const crypto: Crypto.Crypto = {
+    ...base,
+    randomUUIDv4: Effect.suspend(() => {
+      const gate = armed;
+      if (gate === undefined) return base.randomUUIDv4;
+      armed = undefined;
+      Deferred.doneUnsafe(gate.paused, Effect.void);
+      return Deferred.await(gate.resume).pipe(Effect.andThen(base.randomUUIDv4));
+    }),
+  };
+  return {
+    crypto,
+    pauseNext: () => {
+      const gate = { paused: Deferred.makeUnsafe<void>(), resume: Deferred.makeUnsafe<void>() };
+      armed = gate;
+      return {
+        paused: Deferred.await(gate.paused),
+        resume: Effect.sync(() => {
+          Deferred.doneUnsafe(gate.resume, Effect.void);
+        }),
+      };
+    },
+  };
+});
