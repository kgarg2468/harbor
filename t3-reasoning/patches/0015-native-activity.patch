new file mode 100644
index 000000000..0ecdb77a2
--- /dev/null
+++ b/apps/server/src/updateActivityRoots.test.ts
@@ -0,0 +1,277 @@
+import { describe, expect, it } from "@effect/vitest";
+import * as Deferred from "effect/Deferred";
+import * as Effect from "effect/Effect";
+import * as Exit from "effect/Exit";
+import * as Fiber from "effect/Fiber";
+import * as Scope from "effect/Scope";
+
+import {
+  make,
+  UpdateActivityUnavailableError,
+  type UpdateActivityShape,
+} from "./updateActivity.ts";
+import { makeTrackedWorker, runWhenOpen } from "./updateActivityRoots.ts";
+
+const seal = (activity: UpdateActivityShape) =>
+  Effect.gen(function* () {
+    const claim = yield* activity.trySealIdle;
+    if (claim.status !== "sealed") {
+      return yield* Effect.die(new Error(`expected sealed, got ${claim.status}`));
+    }
+    return claim.seal;
+  });
+
+describe("runWhenOpen", () => {
+  it.effect("admits immediately while open, even when other work is outstanding", () =>
+    Effect.gen(function* () {
+      const activity = yield* make();
+      const other = yield* activity.acquire("other");
+      let ran = 0;
+      const outstandingInside = yield* runWhenOpen(
+        activity,
+        "root",
+        Effect.gen(function* () {
+          ran += 1;
+          return (yield* activity.state).outstanding;
+        }),
+      );
+      expect(ran).toBe(1);
+      expect(outstandingInside).toBe(2);
+      expect((yield* activity.state).outstanding).toBe(1);
+      other.release();
+    }),
+  );
+
+  it.effect("waits outside any lease while sealed and runs once after reopening", () =>
+    Effect.gen(function* () {
+      const activity = yield* make();
+      const held = yield* seal(activity);
+      let ran = 0;
+      const fiber = yield* Effect.forkChild(
+        runWhenOpen(
+          activity,
+          "root",
+          Effect.sync(() => {
+            ran += 1;
+          }),
+        ),
+      );
+      yield* Effect.yieldNow;
+      expect(ran).toBe(0);
+      expect((yield* activity.state).outstanding).toBe(0);
+
+      // Releasing the seal reopens without any waiter holding a lease.
+      held.release();
+      yield* Fiber.join(fiber);
+      expect(ran).toBe(1);
+      const state = yield* activity.state;
+      expect(state.phase).toBe("open");
+      expect(state.outstanding).toBe(0);
+    }),
+  );
+
+  it.effect("a canceled wait leaks no lease and never runs the body", () =>
+    Effect.gen(function* () {
+      const activity = yield* make();
+      const held = yield* seal(activity);
+      let ran = 0;
+      const fiber = yield* Effect.forkChild(
+        runWhenOpen(
+          activity,
+          "root",
+          Effect.sync(() => {
+            ran += 1;
+          }),
+        ),
+      );
+      yield* Effect.yieldNow;
+      yield* Fiber.interrupt(fiber);
+      expect(Exit.hasInterrupts(yield* Fiber.await(fiber))).toBe(true);
+      held.release();
+      yield* Effect.yieldNow;
+      expect(ran).toBe(0);
+      const claim = yield* activity.trySealIdle;
+      expect(claim.status).toBe("sealed");
+      if (claim.status === "sealed") claim.seal.release();
+    }),
+  );
+
+  it.effect("a failing body is not retried and releases its lease", () =>
+    Effect.gen(function* () {
+      const activity = yield* make();
+      let attempts = 0;
+      const exit = yield* Effect.exit(
+        runWhenOpen(
+          activity,
+          "root",
+          Effect.suspend(() => {
+            attempts += 1;
+            return Effect.fail("boom");
+          }),
+        ),
+      );
+      expect(Exit.isFailure(exit)).toBe(true);
+      expect(attempts).toBe(1);
+      expect((yield* activity.state).outstanding).toBe(0);
+    }),
+  );
+
+  it.effect("cancellation during the body finishes its cleanup before the lease is released", () =>
+    Effect.gen(function* () {
+      const activity = yield* make();
+      const entered = yield* Deferred.make<void>();
+      const releaseCleanup = yield* Deferred.make<void>();
+      let cleanedUp = false;
+      yield* Effect.gen(function* () {
+        const fiber = yield* Effect.forkChild(
+          runWhenOpen(
+            activity,
+            "root",
+            Deferred.succeed(entered, undefined).pipe(
+              Effect.andThen(Effect.never),
+              Effect.onInterrupt(() =>
+                Deferred.await(releaseCleanup).pipe(
+                  Effect.andThen(
+                    Effect.sync(() => {
+                      cleanedUp = true;
+                    }),
+                  ),
+                ),
+              ),
+            ),
+          ),
+        );
+        yield* Deferred.await(entered);
+        expect((yield* activity.state).outstanding).toBe(1);
+
+        const interrupting = yield* Effect.forkChild(Fiber.interrupt(fiber));
+        yield* Effect.yieldNow;
+        // The body is interrupted but its cleanup is still pending: the lease
+        // stays with the operation until that cleanup finishes.
+        expect((yield* activity.state).outstanding).toBe(1);
+        expect((yield* activity.trySealIdle).status).toBe("busy");
+
+        yield* Deferred.succeed(releaseCleanup, undefined);
+        yield* Fiber.join(interrupting);
+        expect(cleanedUp).toBe(true);
+        expect((yield* activity.state).outstanding).toBe(0);
+      }).pipe(
+        // A failed assertion above must not leave the interrupted body parked
+        // on the gate while the test scope waits for its child fibers.
+        Effect.ensuring(Deferred.succeed(releaseCleanup, undefined)),
+      );
+    }),
+  );
+
+  it.effect("a closed registry ends waiters by interruption instead of spinning", () =>
+    Effect.gen(function* () {
+      const scope = yield* Scope.make();
+      const activity = yield* make().pipe(Scope.provide(scope));
+      const held = yield* seal(activity);
+      let ran = 0;
+      const fiber = yield* Effect.forkChild(
+        runWhenOpen(
+          activity,
+          "root",
+          Effect.sync(() => {
+            ran += 1;
+          }),
+        ),
+      );
+      yield* Effect.yieldNow;
+      // Closing the registry's scope wakes the waiter; it exits by interruption.
+      yield* Scope.close(scope, Exit.void);
+      const exit = yield* Fiber.await(fiber);
+      expect(Exit.hasInterrupts(exit)).toBe(true);
+      expect(ran).toBe(0);
+      held.release();
+      expect((yield* activity.state).phase).toBe("closed");
+    }),
+  );
+});
+
+describe("makeTrackedWorker", () => {
+  it.effect(
+    "items own a lease from acceptance until processing ends and survive caller cancel",
+    () =>
+      Effect.gen(function* () {
+        const activity = yield* make();
+        const entered = yield* Deferred.make<string>();
+        const gate = yield* Deferred.make<void>();
+        const worker = yield* makeTrackedWorker<string, never, never>(activity, "test", (value) =>
+          Deferred.succeed(entered, value).pipe(Effect.andThen(Deferred.await(gate))),
+        );
+
+        const offered = yield* Deferred.make<void>();
+        const caller = yield* Effect.forkChild(
+          worker
+            .enqueue("job")
+            .pipe(
+              Effect.andThen(Deferred.succeed(offered, undefined)),
+              Effect.andThen(Effect.never),
+            ),
+        );
+        yield* Deferred.await(offered);
+        yield* Fiber.interrupt(caller);
+
+        expect(yield* Deferred.await(entered)).toBe("job");
+        const drained = yield* Deferred.make<void>();
+        yield* Effect.forkChild(
+          worker.drain.pipe(Effect.andThen(Deferred.succeed(drained, undefined))),
+        );
+        yield* Effect.yieldNow;
+        expect(yield* Deferred.isDone(drained)).toBe(false);
+        expect((yield* activity.state).outstanding).toBe(1);
+        expect((yield* activity.trySealIdle).status).toBe("busy");
+
+        yield* Deferred.succeed(gate, undefined);
+        yield* Deferred.await(drained);
+        expect((yield* activity.state).outstanding).toBe(0);
+        const claim = yield* activity.trySealIdle;
+        expect(claim.status).toBe("sealed");
+        if (claim.status === "sealed") claim.seal.release();
+      }),
+  );
+
+  it.effect("an enqueue while sealed waits without a lease and delivers after reopening", () =>
+    Effect.gen(function* () {
+      const activity = yield* make();
+      const processed: Array<number> = [];
+      const worker = yield* makeTrackedWorker<number, never, never>(activity, "test", (value) =>
+        Effect.sync(() => {
+          processed.push(value);
+        }),
+      );
+      const held = yield* seal(activity);
+      const queued = yield* Effect.forkChild(worker.enqueue(1));
+      yield* Effect.yieldNow;
+      expect(processed).toEqual([]);
+      expect((yield* activity.state).outstanding).toBe(0);
+
+      held.release();
+      yield* Fiber.join(queued);
+      yield* worker.drain;
+      expect(processed).toEqual([1]);
+      expect((yield* activity.state).outstanding).toBe(0);
+    }),
+  );
+
+  it.effect("worker death blocks before its counters reach zero and a closed worker rejects", () =>
+    Effect.gen(function* () {
+      const activity = yield* make();
+      const worker = yield* makeTrackedWorker<number, string, never>(activity, "dying", (value) =>
+        value === 1 ? Effect.fail("handler exploded") : Effect.void,
+      );
+      yield* worker.enqueue(1);
+      yield* worker.enqueue(2);
+      yield* worker.drain;
+      const state = yield* activity.state;
+      expect(state.outstanding).toBe(0);
+      expect(state.blockers).toEqual(["worker unavailable: dying"]);
+      const rejected = yield* Effect.flip(worker.enqueue(3));
+      expect(rejected).toBeInstanceOf(UpdateActivityUnavailableError);
+      expect(rejected.reason).toBe("worker-closed");
+      expect((yield* activity.trySealIdle).status).toBe("busy");
+    }),
+  );
+});
