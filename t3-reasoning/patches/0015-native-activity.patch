+++ b/apps/server/src/provider/claudeQueryRuntime.test.ts
@@ -0,0 +1,342 @@
+// @effect-diagnostics nodeBuiltinImport:off
+import * as NodeEvents from "node:events";
+import * as NodeStream from "node:stream";
+
+import type {
+  Options,
+  SDKMessage,
+  SDKUserMessage,
+  SpawnOptions,
+  SpawnedProcess,
+} from "@anthropic-ai/claude-agent-sdk";
+import { afterEach, assert, describe, it, vi } from "@effect/vitest";
+
+import {
+  type ClaudeChildProcess,
+  type ClaudeSpawn,
+  type ClaudeSpawnOptions,
+  makeClaudeQueryRuntime,
+} from "./claudeQueryRuntime.ts";
+
+/** A test-owned child: never a real process, exits only when the test says so. */
+class FakeChild extends NodeEvents.EventEmitter implements ClaudeChildProcess {
+  readonly stdin = new NodeStream.PassThrough();
+  readonly stdout = new NodeStream.PassThrough();
+  readonly stderr = new NodeStream.PassThrough();
+  pid: number | undefined;
+  killed = false;
+  exitCode: number | null = null;
+  signalCode: NodeJS.Signals | null = null;
+  readonly killSignals: Array<NodeJS.Signals | undefined> = [];
+
+  constructor(options?: { readonly started?: boolean }) {
+    super();
+    this.pid = options?.started === false ? undefined : 4242;
+  }
+
+  kill(signal?: NodeJS.Signals): boolean {
+    this.killSignals.push(signal);
+    this.killed = true;
+    return true;
+  }
+
+  /** The raw process exit. */
+  exit(code: number | null, signal: NodeJS.Signals | null = null): void {
+    this.exitCode = code;
+    this.signalCode = signal;
+    this.emit("exit", code, signal);
+  }
+
+  fail(error: Error): void {
+    this.emit("error", error);
+  }
+}
+
+interface SpawnCall {
+  readonly command: string;
+  readonly args: ReadonlyArray<string>;
+  readonly options: ClaudeSpawnOptions;
+  readonly child: FakeChild;
+}
+
+const makeSpawn = (nextChild: () => FakeChild = () => new FakeChild()) => {
+  const calls: Array<SpawnCall> = [];
+  const spawn: ClaudeSpawn = (command, args, options) => {
+    const child = nextChild();
+    calls.push({ command, args, options, child });
+    return child;
+  };
+  return { spawn, calls };
+};
+
+/**
+ * Stands in for the SDK's `query`: spawns through the hook synchronously,
+ * exactly as the installed SDK's transport constructor does, and returns a
+ * class instance whose prototype methods depend on `this`.
+ */
+class FakeSdkQuery implements AsyncIterable<SDKMessage> {
+  readonly calls: Array<string> = [];
+  readonly messages: Array<SDKMessage> = [];
+  closed = false;
+  readonly spawned: SpawnedProcess;
+  constructor(spawned: SpawnedProcess) {
+    this.spawned = spawned;
+  }
+
+  async setModel(model?: string): Promise<void> {
+    this.calls.push(`setModel:${model ?? ""}`);
+  }
+  async setPermissionMode(mode: string): Promise<void> {
+    this.calls.push(`setPermissionMode:${mode}`);
+  }
+  async setMaxThinkingTokens(maxThinkingTokens: number | null): Promise<void> {
+    this.calls.push(`setMaxThinkingTokens:${maxThinkingTokens ?? "null"}`);
+  }
+  close(): void {
+    this.closed = true;
+  }
+  async *[Symbol.asyncIterator](): AsyncIterator<SDKMessage> {
+    this.calls.push("iterate");
+    yield* this.messages;
+  }
+}
+
+const SDK_SPAWN: SpawnOptions = {
+  command: "/opt/node",
+  args: ["/opt/claude/cli.js", "--output-format", "stream-json"],
+  cwd: "/work/tree",
+  env: { CLAUDE_CODE_ENTRYPOINT: "sdk-ts", PATH: "/usr/bin" },
+  signal: new AbortController().signal,
+};
+
+const makeSdkQuery = (spawnOptions: SpawnOptions = SDK_SPAWN) => {
+  const queries: Array<FakeSdkQuery> = [];
+  const optionsSeen: Array<Options> = [];
+  const query = (input: { readonly prompt: AsyncIterable<SDKUserMessage>; options: Options }) => {
+    optionsSeen.push(input.options);
+    const hook = input.options.spawnClaudeCodeProcess;
+    if (hook === undefined) {
+      throw new Error("the factory must install the SDK spawn hook");
+    }
+    const instance = new FakeSdkQuery(hook(spawnOptions));
+    queries.push(instance);
+    return instance;
+  };
+  return { query, queries, optionsSeen };
+};
+
+const emptyPrompt: AsyncIterable<SDKUserMessage> = {
+  async *[Symbol.asyncIterator]() {},
+};
+
+const baseOptions: Options = { pathToClaudeCodeExecutable: "/opt/claude/cli.js" };
+
+/** Whether a promise has settled by the time the event loop turns once. */
+const settledState = (promise: Promise<void>) =>
+  Promise.race([
+    promise.then(
+      () => "resolved" as const,
+      () => "rejected" as const,
+    ),
+    new Promise<"pending">((resolve) => setImmediate(() => resolve("pending"))),
+  ]);
+
+const start = (deps?: { readonly spawnOptions?: SpawnOptions; readonly options?: Options }) => {
+  const spawned = makeSpawn();
+  const sdk = makeSdkQuery(deps?.spawnOptions);
+  const runtime = makeClaudeQueryRuntime(
+    { prompt: emptyPrompt, options: deps?.options ?? baseOptions },
+    { query: sdk.query, spawn: spawned.spawn },
+  );
+  const call = spawned.calls[0]!;
+  return { runtime, sdk, spawned, call, child: call.child, query: sdk.queries[0]! };
+};
+
+describe("makeClaudeQueryRuntime", () => {
+  afterEach(() => {
+    vi.useRealTimers();
+  });
+
+  it("spawns exactly what the SDK asked for, through its hook", () => {
+    const { call, sdk } = start();
+    assert.equal(sdk.optionsSeen[0]!.pathToClaudeCodeExecutable, "/opt/claude/cli.js");
+    assert.equal(call.command, SDK_SPAWN.command);
+    assert.deepEqual([...call.args], SDK_SPAWN.args);
+    assert.equal(call.options.cwd, SDK_SPAWN.cwd);
+    assert.strictEqual(call.options.env, SDK_SPAWN.env);
+    assert.strictEqual(call.options.signal, SDK_SPAWN.signal);
+    assert.deepEqual(call.options.stdio, ["pipe", "pipe", "pipe"]);
+    assert.strictEqual(call.options.windowsHide, true);
+  });
+
+  it("omits cwd when the SDK did", () => {
+    const { cwd: _cwd, ...withoutCwd } = SDK_SPAWN;
+    const { call } = start({ spawnOptions: withoutCwd });
+    assert.ok(!("cwd" in call.options));
+  });
+
+  it("keeps the query's methods bound to the real SDK instance", async () => {
+    const { runtime, query } = start();
+    query.messages.push({ type: "system", subtype: "compact_boundary" } as unknown as SDKMessage);
+    await runtime.setModel("claude-x");
+    await runtime.setPermissionMode("plan");
+    await runtime.setMaxThinkingTokens(null);
+    const seen: Array<SDKMessage> = [];
+    for await (const message of runtime) seen.push(message);
+    runtime.close();
+    assert.deepEqual(query.calls, [
+      "setModel:claude-x",
+      "setPermissionMode:plan",
+      "setMaxThinkingTokens:null",
+      "iterate",
+    ]);
+    assert.equal(seen.length, 1);
+    assert.ok(query.closed);
+  });
+
+  it("hands the SDK the child's streams, state and kill", () => {
+    const { child, query } = start();
+    assert.strictEqual(query.spawned.stdin, child.stdin);
+    assert.strictEqual(query.spawned.stdout, child.stdout);
+    assert.equal(query.spawned.killed, false);
+    query.spawned.kill("SIGTERM");
+    assert.deepEqual(child.killSignals, ["SIGTERM"]);
+    assert.equal(query.spawned.killed, true);
+    child.exit(3, null);
+    assert.equal(query.spawned.exitCode, 3);
+    assert.equal(query.spawned.signalCode, null);
+  });
+
+  it("drains stderr into the SDK's callback as UTF-8 and delivers exit after it closes", async () => {
+    const diagnostics: Array<string> = [];
+    const { child, query, runtime } = start({
+      options: { ...baseOptions, stderr: (text) => diagnostics.push(text) },
+    });
+    const observed: Array<string> = [];
+    query.spawned.on("exit", (code, signal) => observed.push(`sdk-exit:${code}:${signal}`));
+
+    const euro = Buffer.from("€");
+    child.stderr.write(Buffer.concat([Buffer.from("warn "), euro.subarray(0, 1)]));
+    child.stderr.write(euro.subarray(1));
+    await new Promise<void>((resolve) => setImmediate(resolve));
+    assert.deepEqual(diagnostics, ["warn ", "€"]);
+
+    child.exit(0, null);
+    assert.equal(await settledState(runtime.waitForExit()), "resolved");
+    assert.deepEqual(observed, [], "SDK observers wait for stderr to close");
+
+    child.stderr.end();
+    await new Promise<void>((resolve) => child.stderr.once("close", () => resolve()));
+    await new Promise<void>((resolve) => setImmediate(resolve));
+    assert.deepEqual(observed, ["sdk-exit:0:null"]);
+  });
+
+  it("delivers the SDK's exit after the grace when stderr never closes", () => {
+    vi.useFakeTimers();
+    const { child, query } = start();
+    const observed: Array<string> = [];
+    const listener = () => observed.push("sdk-exit");
+    query.spawned.once("exit", listener);
+    child.exit(null, "SIGTERM");
+    assert.deepEqual(observed, []);
+    vi.advanceTimersByTime(199);
+    assert.deepEqual(observed, []);
+    vi.advanceTimersByTime(1);
+    assert.deepEqual(observed, ["sdk-exit"]);
+    assert.ok(child.stderr.destroyed, "stderr is released after delivery");
+  });
+
+  it("lets the SDK remove its exit observer", () => {
+    const { child, query } = start();
+    const observed: Array<string> = [];
+    const listener = () => observed.push("sdk-exit");
+    query.spawned.on("exit", listener);
+    query.spawned.off("exit", listener);
+    child.stderr.end();
+    child.exit(0, null);
+    assert.deepEqual(observed, []);
+  });
+
+  it("proves an exit that happened before anyone waited", async () => {
+    const { child, runtime } = start();
+    child.exit(0, null);
+    assert.equal(await settledState(runtime.waitForExit()), "resolved");
+  });
+
+  it("close and iterator cleanup are not exit proof", async () => {
+    const { runtime, query, child } = start();
+    runtime.close();
+    for await (const _ of runtime) {
+      // the SDK stream ends without the process
+    }
+    assert.ok(query.closed);
+    assert.equal(await settledState(runtime.waitForExit()), "pending");
+    child.exit(0, null);
+    assert.equal(await settledState(runtime.waitForExit()), "resolved");
+  });
+
+  it("a child error or abort before the exit keeps the wait open", async () => {
+    const { runtime, child } = start();
+    const abort = new Error("The operation was aborted");
+    abort.name = "AbortError";
+    child.fail(abort);
+    child.fail(Object.assign(new Error("kill EPERM"), { syscall: "kill" }));
+    assert.equal(await settledState(runtime.waitForExit()), "pending");
+    child.exit(null, "SIGKILL");
+    assert.equal(await settledState(runtime.waitForExit()), "resolved");
+  });
+
+  it("a spawn failure on a child that never started counts as no process", async () => {
+    const spawned = makeSpawn(() => new FakeChild({ started: false }));
+    const sdk = makeSdkQuery();
+    const runtime = makeClaudeQueryRuntime(
+      { prompt: emptyPrompt, options: baseOptions },
+      { query: sdk.query, spawn: spawned.spawn },
+    );
+    const child = spawned.calls[0]!.child;
+    assert.equal(await settledState(runtime.waitForExit()), "pending");
+    child.fail(Object.assign(new Error("spawn ENOENT"), { code: "ENOENT", syscall: "spawn" }));
+    assert.equal(await settledState(runtime.waitForExit()), "resolved");
+  });
+
+  it("a spawn that throws surfaces from the factory", () => {
+    const sdk = makeSdkQuery();
+    const spawn: ClaudeSpawn = () => {
+      throw new Error("spawn EINVAL");
+    };
+    assert.throws(
+      () =>
+        makeClaudeQueryRuntime(
+          { prompt: emptyPrompt, options: baseOptions },
