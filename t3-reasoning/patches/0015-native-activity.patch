+      module: "ChildProcess",
+      method,
+      description,
+    });
+
+  const finishExit = (code: number): void => {
+    running = false;
+    Deferred.doneUnsafe(exit, Effect.succeed(ChildProcessSpawner.ExitCode(code)));
+    Queue.endUnsafe(stdout);
+  };
+
+  const write = (message: unknown) =>
+    Effect.sync(() => {
+      // @effect-diagnostics-next-line preferSchemaOverJson:off
+      Queue.offerUnsafe(stdout, encoder.encode(`${JSON.stringify(message)}\n`));
+    });
+
+  const handleLine = (line: string) =>
+    Effect.gen(function* () {
+      // @effect-diagnostics-next-line preferSchemaOverJson:off
+      const message = JSON.parse(line) as {
+        readonly id?: number | string;
+        readonly method?: string;
+        readonly params?: unknown;
+        readonly result?: unknown;
+        readonly error?: unknown;
+      };
+      if (message.method === undefined) {
+        if (message.id !== undefined) {
+          yield* Queue.offer(responses, {
+            id: message.id,
+            result: message.result,
+            error: message.error,
+          });
+        }
+        return;
+      }
+      if (message.id === undefined) return;
+      switch (message.method) {
+        case "initialize":
+          return yield* write({
+            id: message.id,
+            result: {
+              userAgent: "t3-fake-codex/0.0.0",
+              codexHome: "/tmp",
+              platformFamily: "unix",
+              platformOs: "darwin",
