+      fiber,
+      held,
+      awaitEvent,
+      hold: () => {
+        holding = true;
+      },
+      releaseHeld: () => {
+        holding = false;
+        for (const delivery of held.splice(0)) delivery.complete();
+      },
+    };
+  });
