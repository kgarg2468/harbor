+import { createModelSelection } from "@t3tools/shared/model";
+import {
+  isAtomCommandInterrupted,
+  squashAtomCommandFailure,
+} from "@t3tools/client-runtime/state/runtime";
+import { Link } from "@tanstack/react-router";
+import { GitForkIcon, TriangleAlertIcon } from "lucide-react";
+import { useCallback, useEffect, useId, useMemo, useRef, useState } from "react";
+
+import { getCustomModelOptionsByInstance } from "~/modelSelection";
+import type { ProviderInstanceEntry } from "~/providerInstances";
+import { threadEnvironment } from "~/state/threads";
+import { useAtomCommand } from "~/state/use-atom-command";
+import { cn, randomUUID } from "~/lib/utils";
+import { Button } from "../ui/button";
+import {
+  Dialog,
+  DialogDescription,
+  DialogFooter,
+  DialogHeader,
+  DialogPanel,
+  DialogPopup,
+  DialogTitle,
+} from "../ui/dialog";
+import { Input } from "../ui/input";
+import { Radio, RadioGroup } from "../ui/radio-group";
+import { ProviderModelPicker } from "./ProviderModelPicker";
+import { TraitsPicker } from "./TraitsPicker";
+import {
+  buildForkThreadInput,
+  createForkThreadOperation,
+  describeForkThreadFailure,
+  resolveForkDefaultModelSelection,
+  resolveForkThreadDefaultTitle,
+  resolveForkWorkspaceAvailability,
+} from "./ForkThreadDialog.logic";
+
+export interface ForkThreadDialogSource {
+  readonly threadId: ThreadId;
+  readonly title: string;
+  readonly modelSelection: ModelSelection;
+  readonly runtimeMode: RuntimeMode;
+  readonly interactionMode: ProviderInteractionMode;
+}
+
+export interface ForkThreadDialogProps {
+  open: boolean;
+  onOpenChange: (open: boolean) => void;
+  environmentId: EnvironmentId;
+  source: ForkThreadDialogSource;
+  sourceTurnId: TurnId;
+  /** 1-based position of the source turn when known from its checkpoint. */
+  sourceTurnNumber: number | null;
+  checkpointStatus: OrchestrationCheckpointStatus | null;
+  providers: ReadonlyArray<ServerProvider>;
+  settings: UnifiedSettings;
+  instanceEntries: ReadonlyArray<ProviderInstanceEntry>;
+  onOpenProviderSetup?: (instanceId: ProviderInstanceId) => void;
+  /** Called once the fork is durable on the server, before the dialog closes. */
+  onForked: (result: {
+    threadId: ThreadId;
+    warnings: ReadonlyArray<string>;
+  }) => Promise<void> | void;
+}
+
+const PICKER_TRIGGER_CLASSNAME =
+  "h-8 min-h-8 min-w-0 max-w-none shrink-0 text-foreground/90 hover:text-foreground sm:h-7 sm:min-h-7";
+
+/**
+ * Forks a thread at a completed assistant turn. Mount with a fresh `key` per
+ * open so the form state and the idempotent operation ids start clean; the
+ * ids then stay fixed for every retry inside this instance.
+ */
+export function ForkThreadDialog({
+  open,
+  onOpenChange,
+  environmentId,
+  source,
+  sourceTurnId,
+  sourceTurnNumber,
+  checkpointStatus,
+  providers,
+  settings,
+  instanceEntries,
+  onOpenProviderSetup,
+  onForked,
+}: ForkThreadDialogProps) {
+  const titleInputRef = useRef<HTMLInputElement>(null);
+  const titleId = useId();
+  const forkThread = useAtomCommand(threadEnvironment.fork, { reportFailure: false });
+  const [operation] = useState(() => createForkThreadOperation(randomUUID));
+  const workspace = useMemo(
+    () => resolveForkWorkspaceAvailability(checkpointStatus),
+    [checkpointStatus],
+  );
+  const [title, setTitle] = useState(() => resolveForkThreadDefaultTitle(source.title));
+  const [modelSelection, setModelSelection] = useState<ModelSelection | null>(() =>
+    resolveForkDefaultModelSelection(providers, source.modelSelection),
+  );
+  const [workspaceMode, setWorkspaceMode] = useState<ThreadForkWorkspaceMode>(
+    workspace.defaultMode,
+  );
+  const [pending, setPending] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [attempted, setAttempted] = useState(false);
+
+  useEffect(() => {
+    if (!open) return;
+    const frame = window.requestAnimationFrame(() => {
+      titleInputRef.current?.focus();
+      titleInputRef.current?.select();
+    });
+    return () => {
+      window.cancelAnimationFrame(frame);
+    };
+  }, [open]);
+
+  const modelOptionsByInstance = useMemo(
+    () =>
+      getCustomModelOptionsByInstance(
+        settings,
+        providers,
+        modelSelection?.instanceId ?? null,
+        modelSelection?.model ?? null,
+      ),
+    [modelSelection?.instanceId, modelSelection?.model, providers, settings],
+  );
+  const activeEntry = useMemo(
+    () =>
+      modelSelection
+        ? (instanceEntries.find((entry) => entry.instanceId === modelSelection.instanceId) ?? null)
+        : null,
+    [instanceEntries, modelSelection],
+  );
+
+  const handleSubmit = useCallback(async () => {
+    if (pending) return;
+    const form = buildForkThreadInput({
+      operation,
+      sourceThreadId: source.threadId,
+      sourceTurnId,
+      title,
+      modelSelection,
+      runtimeMode: source.runtimeMode,
+      interactionMode: source.interactionMode,
+      workspaceMode,
+      newWorktreeEnabled: workspace.newWorktreeEnabled,
+    });
+    if (!form.ok) {
+      setAttempted(true);
+      setError(form.reason);
+      return;
+    }
+    setAttempted(true);
+    setPending(true);
+    setError(null);
+    const result = await forkThread({ environmentId, input: form.input });
+    if (result._tag === "Failure") {
+      setPending(false);
+      if (!isAtomCommandInterrupted(result)) {
+        setError(describeForkThreadFailure(squashAtomCommandFailure(result)));
+      }
+      return;
+    }
+    await onForked({ threadId: result.value.threadId, warnings: result.value.warnings });
+    setPending(false);
+    onOpenChange(false);
+  }, [
+    environmentId,
+    forkThread,
+    modelSelection,
+    onForked,
+    onOpenChange,
+    operation,
+    pending,
+    source.interactionMode,
+    source.runtimeMode,
+    source.threadId,
+    sourceTurnId,
+    title,
+    workspace.newWorktreeEnabled,
+    workspaceMode,
+  ]);
+
+  const boundaryLabel =
+    sourceTurnNumber === null ? "the selected reply" : `turn ${sourceTurnNumber}`;
+  const submitLabel = pending ? "Forking…" : attempted && error ? "Retry" : "Fork thread";
+
+  return (
+    <Dialog
+      open={open}
+      onOpenChange={(nextOpen) => {
+        if (!pending) {
+          onOpenChange(nextOpen);
+        }
+      }}
+    >
+      <DialogPopup className="max-w-lg">
+        <DialogHeader>
+          <DialogTitle className="flex items-center gap-2">
+            <GitForkIcon className="size-4" />
+            Fork thread
+          </DialogTitle>
+          <DialogDescription>
+            Starts a new thread from this point. The conversation through {boundaryLabel} is handed
+            to the new agent as history, and it only begins working when you send the next prompt.
+          </DialogDescription>
+        </DialogHeader>
+        <DialogPanel className="space-y-4">
+          <label className="grid gap-1.5" htmlFor={titleId}>
+            <span className="text-xs font-medium text-foreground">Title</span>
+            <Input
+              ref={titleInputRef}
+              id={titleId}
+              value={title}
+              disabled={pending}
+              onChange={(event) => setTitle(event.target.value)}
+              onKeyDown={(event) => {
+                if (event.key !== "Enter") return;
+                event.preventDefault();
+                void handleSubmit();
+              }}
+            />
+          </label>
+
+          <div className="grid gap-1.5">
+            <span className="text-xs font-medium text-foreground">Harness and model</span>
+            {modelSelection && activeEntry ? (
+              <div className="flex flex-wrap items-center gap-1.5">
+                <ProviderModelPicker
+                  activeInstanceId={modelSelection.instanceId}
+                  model={modelSelection.model}
+                  lockedProvider={null}
+                  instanceEntries={instanceEntries}
+                  modelOptionsByInstance={modelOptionsByInstance}
+                  triggerVariant="outline"
+                  triggerClassName={PICKER_TRIGGER_CLASSNAME}
+                  disabled={pending}
+                  {...(onOpenProviderSetup ? { onOpenProviderSetup } : {})}
+                  onInstanceModelChange={(instanceId, model) => {
+                    setModelSelection(createModelSelection(instanceId, model));
+                  }}
+                />
+                <TraitsPicker
+                  provider={activeEntry.driverKind}
+                  instanceId={activeEntry.instanceId}
+                  models={activeEntry.models}
+                  model={modelSelection.model}
+                  prompt=""
+                  onPromptChange={() => {}}
+                  modelOptions={modelSelection.options ?? []}
+                  allowPromptInjectedEffort={false}
+                  planModeEnabled={settings.planModeEnabled}
+                  triggerVariant="outline"
+                  triggerClassName={PICKER_TRIGGER_CLASSNAME}
+                  onModelOptionsChange={(nextOptions) => {
+                    setModelSelection((current) =>
+                      current
+                        ? createModelSelection(current.instanceId, current.model, nextOptions)
+                        : current,
+                    );
+                  }}
+                />
+              </div>
+            ) : (
+              <p className="text-sm text-muted-foreground">No providers available</p>
+            )}
+          </div>
+
+          <div className="grid gap-1.5">
+            <span className="text-xs font-medium text-foreground">Workspace</span>
+            <RadioGroup
+              className="gap-2"
+              value={workspaceMode}
+              disabled={pending}
+              onValueChange={(value) => {
+                if (value === "shared" || value === "new-worktree") {
+                  setWorkspaceMode(value);
+                }
+              }}
+            >
+              <ForkWorkspaceOption
+                value="new-worktree"
+                label="Create a new worktree"
+                description={
+                  workspace.newWorktreeDisabledReason ??
+                  "Restores this turn's files into a fresh worktree on its own branch."
+                }
+                disabled={!workspace.newWorktreeEnabled}
+              />
+              <ForkWorkspaceOption
+                value="shared"
+                label="Share the current workspace"
+                description="Both threads edit the same files."
+              />
+            </RadioGroup>
+          </div>
+
+          {error ? <p className="text-destructive text-xs">{error}</p> : null}
+        </DialogPanel>
+        <DialogFooter>
+          <Button
+            type="button"
+            variant="outline"
+            size="sm"
+            onClick={() => onOpenChange(false)}
+            disabled={pending}
+          >
+            Cancel
+          </Button>
+          <Button
+            type="button"
+            size="sm"
+            onClick={() => {
+              void handleSubmit();
+            }}
+            disabled={pending}
+          >
+            {submitLabel}
+          </Button>
+        </DialogFooter>
+      </DialogPopup>
+    </Dialog>
+  );
+}
+
+function ForkWorkspaceOption({
+  value,
+  label,
+  description,
+  disabled = false,
+}: {
+  value: ThreadForkWorkspaceMode;
+  label: string;
+  description: string;
+  disabled?: boolean;
+}) {
+  return (
+    <label
+      className={cn(
+        "flex items-start gap-2.5 rounded-lg border border-border/70 px-3 py-2.5",
+        disabled ? "opacity-64" : "cursor-pointer hover:bg-muted/40",
+      )}
+    >
+      <Radio value={value} disabled={disabled} className="mt-0.5" />
+      <span className="grid min-w-0 gap-0.5">
+        <span className="text-sm font-medium text-foreground">{label}</span>
+        <span className="text-xs text-muted-foreground">{description}</span>
+      </span>
+    </label>
+  );
+}
+
+/**
+ * Lineage line shown at the top of a forked thread. Links back to the source
+ * thread and notes when the provider received less history than the thread
+ * displays. Provider-side session state is never surfaced here.
+ */
+export function ForkThreadLineage({
+  environmentId,
+  forkedFrom,
+  parentTitle,
+  contextTruncated,
+}: {
+  environmentId: EnvironmentId;
+  forkedFrom: ThreadForkOrigin;
+  /** Null when the source thread is no longer available in this client. */
+  parentTitle: string | null;
+  contextTruncated: boolean;
+}) {
+  return (
+    <div className="mx-auto flex w-full max-w-3xl flex-col gap-0.5 px-4 pt-3 text-xs text-muted-foreground sm:px-5">
+      <span className="flex min-w-0 items-center gap-1.5">
+        <GitForkIcon aria-hidden="true" className="size-3.5 shrink-0" />
+        <span className="shrink-0">Forked from</span>
+        {parentTitle === null ? (
+          <span className="truncate">a thread that is no longer available</span>
+        ) : (
+          <Link
+            to="/$environmentId/$threadId"
+            params={{ environmentId, threadId: forkedFrom.threadId }}
+            className="truncate text-foreground underline-offset-2 hover:underline"
+          >
+            {parentTitle}
+          </Link>
+        )}
+      </span>
+      {contextTruncated ? (
+        <span className="flex items-center gap-1.5">
+          <TriangleAlertIcon aria-hidden="true" className="size-3.5 shrink-0" />
+          Older history was trimmed from what the agent received; the full conversation is still
+          shown here.
+        </span>
+      ) : null}
+    </div>
+  );
+}
