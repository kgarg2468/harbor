+/**
+ * The turn a "fork from here" action would branch from, or null when the
+ * assistant message is not a valid fork boundary. Only the settled canonical
+ * reply of a completed turn qualifies: the server seeds history through that
+ * turn, so a running, interrupted, or failed turn has nothing stable to copy.
+ * `forkEnabled` carries the environment capability so older servers hide the
+ * action entirely instead of failing the request.
+ */
+export function resolveAssistantForkTurnId(input: {
+  message: Pick<ChatMessage, "role" | "turnId" | "streaming" | "channel">;
+  /** True while the turn that produced this message is still visually in progress. */
+  responseInProgress: boolean;
+  runningTurnId: TurnId | null;
+  latestTurn: Pick<TimelineLatestTurn, "turnId" | "state"> | null;
+  forkEnabled: boolean;
+}): TurnId | null {
+  if (!input.forkEnabled) return null;
+  const { message } = input;
+  if (message.role !== "assistant" || isReasoningMessage(message)) return null;
+  if (message.streaming || input.responseInProgress) return null;
+  const turnId = message.turnId ?? null;
+  if (turnId === null || turnId === input.runningTurnId) return null;
+  if (input.latestTurn?.turnId === turnId && input.latestTurn.state !== "completed") {
+    return null;
+  }
+  return turnId;
+}
