+import { describe, expect, it } from "vite-plus/test";
+import {
+  ProviderDriverKind,
+  ProviderInstanceId,
+  ThreadId,
+  TurnId,
+  type ModelSelection,
+  type ServerProvider,
+} from "@t3tools/contracts";
+import {
+  buildForkThreadInput,
+  createForkThreadOperation,
+  describeForkThreadFailure,
+  resolveForkDefaultModelSelection,
+  resolveForkThreadDefaultTitle,
+  resolveForkWorkspaceAvailability,
+} from "./ForkThreadDialog.logic";
+
+function provider(input: {
+  driver: string;
+  instanceId: string;
+  enabled?: boolean;
+  status?: ServerProvider["status"];
+  availability?: ServerProvider["availability"];
+  models?: ServerProvider["models"];
+}): ServerProvider {
+  return {
+    instanceId: ProviderInstanceId.make(input.instanceId),
+    driver: ProviderDriverKind.make(input.driver),
+    enabled: input.enabled ?? true,
+    installed: true,
+    version: null,
+    status: input.status ?? "ready",
+    ...(input.availability ? { availability: input.availability } : {}),
+    auth: { status: "authenticated" },
+    checkedAt: "2026-09-05T00:00:00.000Z",
+    models: input.models ?? [],
+    slashCommands: [],
+    skills: [],
+  };
+}
+
+const model = (slug: string, isDefault = false) => ({
+  slug,
+  name: slug,
+  isCustom: false,
+  ...(isDefault ? { isDefault: true } : {}),
+  capabilities: {},
+});
+
+describe("resolveForkThreadDefaultTitle", () => {
+  it("suffixes the trimmed source title", () => {
+    expect(resolveForkThreadDefaultTitle("  Fix login  ")).toBe("Fix login (fork)");
+  });
+
+  it("falls back when the source title is blank", () => {
+    expect(resolveForkThreadDefaultTitle("   ")).toBe("Forked thread");
+  });
+});
+
+describe("resolveForkWorkspaceAvailability", () => {
+  it("defaults to a new worktree when the checkpoint is ready", () => {
+    expect(resolveForkWorkspaceAvailability("ready")).toEqual({
+      newWorktreeEnabled: true,
+      newWorktreeDisabledReason: null,
+      defaultMode: "new-worktree",
+    });
+  });
+
+  it.each(["missing", "error", null] as const)(
+    "keeps sharing available and explains why a worktree is not (%s)",
+    (status) => {
+      const availability = resolveForkWorkspaceAvailability(status);
+      expect(availability.newWorktreeEnabled).toBe(false);
+      expect(availability.defaultMode).toBe("shared");
+      expect(availability.newWorktreeDisabledReason).toEqual(expect.any(String));
+    },
+  );
+});
+
+describe("resolveForkDefaultModelSelection", () => {
+  const codex = provider({
+    driver: "codex",
+    instanceId: "codex",
+    models: [model("gpt-5-codex", true), model("gpt-5")],
+  });
+  const claude = provider({
+    driver: "claudeAgent",
+    instanceId: "claudeAgent",
+    models: [model("claude-opus", true)],
+  });
+
+  it("keeps the source selection, including options, when its instance can start", () => {
+    const source: ModelSelection = {
+      instanceId: ProviderInstanceId.make("claudeAgent"),
+      model: "claude-opus",
+      options: [{ id: "effort", value: "high" }],
+    };
+    expect(resolveForkDefaultModelSelection([codex, claude], source)).toBe(source);
+  });
+
+  it("falls back to the first ready instance and its default model", () => {
+    const source: ModelSelection = {
+      instanceId: ProviderInstanceId.make("claudeAgent"),
+      model: "claude-opus",
+    };
+    const unavailableClaude = provider({
+      driver: "claudeAgent",
+      instanceId: "claudeAgent",
+      availability: "unavailable",
+      models: [model("claude-opus", true)],
+    });
+    expect(resolveForkDefaultModelSelection([codex, unavailableClaude], source)).toEqual({
+      instanceId: ProviderInstanceId.make("codex"),
+      model: "gpt-5-codex",
+    });
+  });
+
+  it("returns null when no provider can start", () => {
+    const disabled = provider({ driver: "codex", instanceId: "codex", enabled: false });
+    expect(resolveForkDefaultModelSelection([disabled], null)).toBeNull();
+  });
+});
+
+describe("buildForkThreadInput", () => {
+  const operation = createForkThreadOperation(
+    (() => {
+      let counter = 0;
+      return () => `id-${++counter}`;
+    })(),
+  );
+  const base = {
+    operation,
+    sourceThreadId: ThreadId.make("source-thread"),
+    sourceTurnId: TurnId.make("turn-3"),
+    title: "  Fix login (fork)  ",
+    modelSelection: { instanceId: ProviderInstanceId.make("codex"), model: "gpt-5-codex" },
+    runtimeMode: "approval-required" as const,
+    interactionMode: "default" as const,
+    workspaceMode: "new-worktree" as const,
+    newWorktreeEnabled: true,
+  };
+
+  it("mints distinct command and thread ids once per operation", () => {
+    expect(operation.commandId).not.toBe(operation.threadId);
+  });
+
+  it("builds the request with trimmed title and the stable operation ids on retry", () => {
+    const first = buildForkThreadInput(base);
+    const retry = buildForkThreadInput({ ...base, title: "Fix login (fork)" });
+    expect(first).toEqual({
+      ok: true,
+      input: {
+        commandId: operation.commandId,
+        threadId: operation.threadId,
+        sourceThreadId: base.sourceThreadId,
+        sourceTurnId: base.sourceTurnId,
+        title: "Fix login (fork)",
+        modelSelection: base.modelSelection,
+        runtimeMode: "approval-required",
+        interactionMode: "default",
+        workspaceMode: "new-worktree",
+      },
+    });
+    expect(retry).toEqual(first);
+  });
+
+  it("rejects a blank title", () => {
+    expect(buildForkThreadInput({ ...base, title: "  " })).toMatchObject({ ok: false });
+  });
+
+  it("rejects a missing model selection", () => {
+    expect(buildForkThreadInput({ ...base, modelSelection: null })).toMatchObject({ ok: false });
+  });
+
+  it("rejects a new worktree when the checkpoint cannot back it", () => {
+    expect(buildForkThreadInput({ ...base, newWorktreeEnabled: false })).toMatchObject({
+      ok: false,
+    });
+    expect(
+      buildForkThreadInput({ ...base, newWorktreeEnabled: false, workspaceMode: "shared" }),
+    ).toMatchObject({ ok: true, input: { workspaceMode: "shared" } });
+  });
+});
+
+describe("describeForkThreadFailure", () => {
+  it("uses the server message when present", () => {
+    expect(
+      describeForkThreadFailure({
+        _tag: "OrchestrationDispatchCommandError",
+        message: "Source turn is not completed.",
+      }),
+    ).toBe("Source turn is not completed.");
+    expect(describeForkThreadFailure(new Error("boom"))).toBe("boom");
+  });
+
+  it("falls back to a generic message for unknown failures", () => {
+    expect(describeForkThreadFailure(undefined)).toBe("Could not fork the thread.");
+    expect(describeForkThreadFailure({ message: "" })).toBe("Could not fork the thread.");
+  });
+});
