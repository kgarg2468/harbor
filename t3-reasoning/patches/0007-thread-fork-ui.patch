@@ -0,0 +1,151 @@
+import {
+  CommandId,
+  ThreadId,
+  type ModelSelection,
+  type OrchestrationCheckpointStatus,
+  type ProviderInteractionMode,
+  type RuntimeMode,
+  type ServerProvider,
+  type ThreadForkWorkspaceMode,
+  type TurnId,
+} from "@t3tools/contracts";
+import type { ForkThreadInput } from "@t3tools/client-runtime/state/threads";
+import { resolveDefaultProviderModelSelection } from "../../providerInstances";
+
+const FORK_TITLE_SUFFIX = " (fork)";
+const FALLBACK_FORK_TITLE = "Forked thread";
+
+export function resolveForkThreadDefaultTitle(sourceTitle: string): string {
+  const trimmed = sourceTitle.trim();
+  return trimmed.length === 0 ? FALLBACK_FORK_TITLE : `${trimmed}${FORK_TITLE_SUFFIX}`;
+}
+
+export interface ForkWorkspaceAvailability {
+  readonly newWorktreeEnabled: boolean;
+  /** Why "new worktree" cannot be chosen; null when it can. */
+  readonly newWorktreeDisabledReason: string | null;
+  readonly defaultMode: ThreadForkWorkspaceMode;
+}
+
+/**
+ * A new worktree restores the selected turn's checkpoint, so it needs a
+ * ready checkpoint. Sharing the current workspace copies nothing and stays
+ * available even when checkpointing never ran (no git repository) or failed.
+ */
+export function resolveForkWorkspaceAvailability(
+  checkpointStatus: OrchestrationCheckpointStatus | null,
+): ForkWorkspaceAvailability {
+  switch (checkpointStatus) {
+    case "ready":
+      return {
+        newWorktreeEnabled: true,
+        newWorktreeDisabledReason: null,
+        defaultMode: "new-worktree",
+      };
+    case "missing":
+      return {
+        newWorktreeEnabled: false,
+        newWorktreeDisabledReason:
+          "The checkpoint for this turn is missing, so a new worktree cannot restore its files.",
+        defaultMode: "shared",
+      };
+    case "error":
+      return {
+        newWorktreeEnabled: false,
+        newWorktreeDisabledReason:
+          "The checkpoint for this turn failed to record, so a new worktree cannot restore its files.",
+        defaultMode: "shared",
+      };
+    case null:
+      return {
+        newWorktreeEnabled: false,
+        newWorktreeDisabledReason:
+          "This turn has no checkpoint. New worktrees need a git repository with checkpointing.",
+        defaultMode: "shared",
+      };
+  }
+}
+
+/**
+ * Destination defaults to the source thread's harness and model when that
+ * instance can still start; otherwise the first instance that can, with its
+ * own default model. Null when no configured provider is usable.
+ */
+export function resolveForkDefaultModelSelection(
+  providers: ReadonlyArray<ServerProvider>,
+  sourceSelection: ModelSelection | null,
+): ModelSelection | null {
+  return resolveDefaultProviderModelSelection(providers, sourceSelection);
+}
+
+/**
+ * Identifiers minted once per dialog and reused across every retry, so a
+ * repeated submit after a transient failure is idempotent on the server
+ * instead of creating a second fork.
+ */
+export interface ForkThreadOperation {
+  readonly commandId: CommandId;
+  readonly threadId: ThreadId;
+}
+
+export function createForkThreadOperation(generateId: () => string): ForkThreadOperation {
+  return {
+    commandId: CommandId.make(generateId()),
+    threadId: ThreadId.make(generateId()),
+  };
+}
+
+export interface ForkThreadFormInput {
+  readonly operation: ForkThreadOperation;
+  readonly sourceThreadId: ThreadId;
+  readonly sourceTurnId: TurnId;
+  readonly title: string;
+  readonly modelSelection: ModelSelection | null;
+  readonly runtimeMode: RuntimeMode;
+  readonly interactionMode: ProviderInteractionMode;
+  readonly workspaceMode: ThreadForkWorkspaceMode;
+  readonly newWorktreeEnabled: boolean;
+}
+
+export type ForkThreadFormResult =
+  | { readonly ok: true; readonly input: ForkThreadInput }
+  | { readonly ok: false; readonly reason: string };
+
+export function buildForkThreadInput(form: ForkThreadFormInput): ForkThreadFormResult {
+  const title = form.title.trim();
+  if (title.length === 0) {
+    return { ok: false, reason: "Give the forked thread a title." };
+  }
+  if (form.modelSelection === null) {
+    return { ok: false, reason: "Choose a harness and model for the forked thread." };
+  }
+  if (form.workspaceMode === "new-worktree" && !form.newWorktreeEnabled) {
+    return { ok: false, reason: "A new worktree needs a ready checkpoint for this turn." };
+  }
+  return {
+    ok: true,
+    input: {
+      commandId: form.operation.commandId,
+      threadId: form.operation.threadId,
+      sourceThreadId: form.sourceThreadId,
+      sourceTurnId: form.sourceTurnId,
+      title,
+      modelSelection: form.modelSelection,
+      runtimeMode: form.runtimeMode,
+      interactionMode: form.interactionMode,
+      workspaceMode: form.workspaceMode,
+    },
+  };
+}
+
+const GENERIC_FORK_FAILURE = "Could not fork the thread.";
+
+/** Human-readable text for a squashed command failure. */
+export function describeForkThreadFailure(error: unknown): string {
+  if (typeof error === "string" && error.trim().length > 0) return error;
+  if (error !== null && typeof error === "object" && "message" in error) {
+    const message = (error as { message?: unknown }).message;
+    if (typeof message === "string" && message.trim().length > 0) return message;
+  }
+  return GENERIC_FORK_FAILURE;
+}
