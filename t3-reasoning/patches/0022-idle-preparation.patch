index 000000000..26d8593a1
--- /dev/null
+++ b/apps/server/src/cloud/idleUpdatePreparation.ts
@@ -0,0 +1,280 @@
+/**
+ * IdleUpdatePreparation - retires idle provider resources ahead of a managed
+ * update, once per server, and tells the coordinator whether that proof still
+ * stands immediately before it seals.
+ *
+ * Preparation is a server-scope single-flight owner: a request either starts
+ * it or observes the one already running, and cancelling a requester never
+ * cancels the owner. The owner claims client admission without waiting,
+ * proves the activity registry idle under that claim, holds one ordinary
+ * activity lease around `ProviderService.prepareIdleRetirement`, and releases
+ * both before any work the retirement produced has to drain. It never waits
+ * for other roots and never drains the engine. Only a token issued by
+ * ProviderService counts as prepared; every other outcome is busy or blocked.
+ *
+ * @module IdleUpdatePreparation
+ */
+import * as Cause from "effect/Cause";
+import * as Context from "effect/Context";
+import * as Deferred from "effect/Deferred";
+import * as Effect from "effect/Effect";
+import * as Exit from "effect/Exit";
+import * as Layer from "effect/Layer";
+import * as Scope from "effect/Scope";
+
+import {
+  type ProviderIdlePreparationToken,
+  ProviderService,
+  type ProviderServiceShape,
+} from "../provider/Services/ProviderService.ts";
+import { UpdateAdmission, type UpdateAdmissionShape } from "../updateAdmission.ts";
+import {
+  UpdateActivity,
+  type UpdateActivityShape,
+  type UpdateActivityState,
+} from "../updateActivity.ts";
+import type { ActivationDeclined } from "./queuedUpdate.ts";
+
+export type IdleUpdatePreparationState =
+  | { readonly phase: "idle" }
+  | { readonly phase: "preparing" }
+  | { readonly phase: "prepared" }
+  | { readonly phase: "busy"; readonly reason: string }
+  | { readonly phase: "blocked"; readonly reason: string };
+
+/** Answer for the coordinator: seal now, or decline with the reason the queue should see. */
+export type IdleSealReadiness = { readonly status: "ready" } | ActivationDeclined;
+
+export interface IdleUpdatePreparationShape {
+  /**
+   * Starts preparation if the server is known idle and nothing is prepared
+   * or preparing, otherwise answers with the current state. Returns promptly;
+   * a started owner runs in the server scope, not in the requester.
+   */
+  readonly request: Effect.Effect<IdleUpdatePreparationState>;
+  readonly state: Effect.Effect<IdleUpdatePreparationState>;
+  /** Resolves with the state once no owner is running. Local convenience, never a proof. */
+  readonly settled: Effect.Effect<IdleUpdatePreparationState>;
+  /**
+   * Side-effect-free readiness of the stored proof, for the coordinator to
+   * run inside its own admission claim immediately before sealing. Never
+   * starts preparation or takes admission. A proof found stale is discarded,
+   * so the next request after the claim releases starts a new owner.
+   */
+  readonly checkReadyForSeal: Effect.Effect<IdleSealReadiness>;
+}
+
+export class IdleUpdatePreparation extends Context.Service<
+  IdleUpdatePreparation,
+  IdleUpdatePreparationShape
+>()("t3/cloud/idleUpdatePreparation") {}
+
+export interface IdleUpdatePreparationDependencies {
+  readonly provider: Pick<
+    ProviderServiceShape,
+    "prepareIdleRetirement" | "checkIdleRetirementReadiness"
+  >;
+  readonly admission: UpdateAdmissionShape;
+  readonly activity: UpdateActivityShape;
+  /** Owns the preparation fiber; closing it is the only way to cancel one. */
+  readonly serverScope: Scope.Scope;
+}
+
+const isIdle = (state: UpdateActivityState): boolean =>
+  state.phase === "open" && state.outstanding === 0 && state.blockers.length === 0;
+
+const describeActivity = (state: UpdateActivityState): string => {
+  if (state.phase === "closed") return "activity registry is closed";
+  if (state.phase === "sealed") return "activity is already sealed";
+  if (state.blockers.length > 0) return `activity is blocked: ${state.blockers.join(", ")}`;
+  return `${state.outstanding} agent operation(s) in flight`;
+};
+
+const busy = (reason: string): IdleUpdatePreparationState => ({ phase: "busy", reason });
+const blocked = (reason: string): IdleUpdatePreparationState => ({ phase: "blocked", reason });
+const preparing: IdleUpdatePreparationState = { phase: "preparing" };
+const prepared: IdleUpdatePreparationState = { phase: "prepared" };
+
+const ready: IdleSealReadiness = { status: "ready" };
+const noProof: IdleSealReadiness = { status: "busy", reason: "idle providers are not prepared" };
+const stillPreparing: IdleSealReadiness = {
+  status: "busy",
+  reason: "idle provider preparation is in progress",
+};
+
+export const make = ({
+  provider,
+  admission,
+  activity,
+  serverScope,
+}: IdleUpdatePreparationDependencies): IdleUpdatePreparationShape => {
+  let current: IdleUpdatePreparationState = { phase: "idle" };
+  let owner: Deferred.Deferred<void> | undefined;
+  let token: ProviderIdlePreparationToken | undefined;
+
+  const missingCapabilityReason = "provider service cannot prove idle retirement";
+  const missingCapability = blocked(missingCapabilityReason);
+
+  // Runs with admission claimed, the registry re-proven idle and one
+  // preparation lease held. Every ProviderService answer maps to a state; a
+  // typed failure is a transient refusal, never a proof.
+  const retire: Effect.Effect<IdleUpdatePreparationState> = Effect.suspend(() => {
+    const prepare = provider.prepareIdleRetirement;
+    if (prepare === undefined || provider.checkIdleRetirementReadiness === undefined) {
+      return Effect.succeed(missingCapability);
+    }
+    return prepare().pipe(
+      Effect.map((result): IdleUpdatePreparationState => {
+        if (result.status === "prepared") {
+          token = result.token;
+          return prepared;
+        }
+        return { phase: result.status, reason: result.reason };
+      }),
+      Effect.catch((error) => Effect.succeed(busy(`idle retirement failed: ${error._tag}`))),
+    );
+  });
+
+  // Inside the admission claim. The lease is taken under the mask, so an
+  // interruption arriving at any point still releases it; the retirement
+  // itself stays interruptible so the owning scope can end it.
+  const underClaim: Effect.Effect<IdleUpdatePreparationState> = Effect.flatMap(
+    activity.state,
+    (before) => {
+      if (!isIdle(before)) return Effect.succeed(busy(describeActivity(before)));
+      return Effect.uninterruptibleMask((restore) =>
+        activity.acquire("update preparation").pipe(
+          Effect.flatMap((lease) =>
+            Effect.flatMap(activity.state, (held) => {
+              if (held.phase !== "open" || held.blockers.length > 0 || held.outstanding !== 1) {
+                lease.release();
+                return Effect.succeed(
+                  busy(describeActivity({ ...held, outstanding: held.outstanding - 1 })),
+                );
+              }
+              return restore(retire).pipe(Effect.ensuring(Effect.sync(() => lease.release())));
+            }),
+          ),
+          Effect.catchTag("UpdateActivityUnavailableError", (error) =>
+            Effect.succeed(busy(`activity registry is ${error.reason}`)),
+          ),
+        ),
+      );
+    },
+  );
+
+  const prepare: Effect.Effect<IdleUpdatePreparationState> = Effect.map(
+    admission.tryWithMaintenance(underClaim),
+    (claim) =>
+      claim.status === "busy"
+        ? busy("client commands or another maintenance own update admission")
+        : claim.value,
+  );
+
+  // The owner's exit, however it happens, publishes a state and frees the
+  // slot in one synchronous step. Interruption and defects discard any token
+  // the retirement may have stored on the way out.
+  //
+  // The owner is forked with an immediate start so this exit step is on its
+  // stack before the requester continues, and it yields once before the real
+  // preparation so no retirement work runs inside the requester. A server
+  // scope that is already closed, or closes before that yield resumes,
+  // interrupts a parked owner whose bookkeeping is already in place.
+  const runOwner = (done: Deferred.Deferred<void>) =>
+    Effect.andThen(Effect.yieldNow, prepare).pipe(
+      Effect.catchCause((cause) =>
+        Cause.hasInterruptsOnly(cause)
+          ? Effect.failCause(cause)
+          : Effect.logWarning("idle provider preparation failed", { cause }).pipe(
+              Effect.as(busy("idle preparation failed")),
+            ),
+      ),
+      Effect.onExit((exit) =>
+        Effect.sync(() => {
+          if (Exit.isSuccess(exit)) {
+            current = exit.value;
+          } else {
+            token = undefined;
+            current = busy("idle preparation was interrupted");
+          }
+          owner = undefined;
+          Deferred.doneUnsafe(done, Effect.void);
+        }),
+      ),
+    );
+
+  const request: IdleUpdatePreparationShape["request"] = Effect.suspend(() => {
+    if (owner !== undefined) return Effect.succeed(preparing);
+    if (token !== undefined) return Effect.succeed(prepared);
+    // Only an optimization: a known-busy environment answers without
+    // touching admission. The authoritative checks run under the claim.
+    return Effect.flatMap(activity.state, (activityState) => {
+      if (!isIdle(activityState)) {
+        current = busy(describeActivity(activityState));
+        return Effect.succeed(current);
+      }
+      // Ownership is installed and the owner forked in one uninterruptible
+      // step, into the server scope rather than the requester. The answer is
+      // read after the fork: an owner interrupted on arrival by a closed
+      // server scope has already published its state.
+      return Effect.uninterruptible(
+        Effect.suspend(() => {
+          if (owner !== undefined) return Effect.succeed(preparing);
+          const done = Deferred.makeUnsafe<void>();
+          owner = done;
+          current = preparing;
+          return Effect.map(
+            Effect.forkIn(runOwner(done), serverScope, { startImmediately: true }),
+            () => current,
+          );
+        }),
+      );
+    });
+  });
+
+  const state: IdleUpdatePreparationShape["state"] = Effect.sync(() => current);
+
+  const settled: IdleUpdatePreparationShape["settled"] = Effect.suspend(() =>
+    owner === undefined ? state : Effect.andThen(Deferred.await(owner), state),
+  );
+
+  const checkReadyForSeal: IdleUpdatePreparationShape["checkReadyForSeal"] = Effect.suspend(() => {
+    if (owner !== undefined) return Effect.succeed(stillPreparing);
+    const proof = token;
+    if (proof === undefined) return Effect.succeed(noProof);
+    const check = provider.checkIdleRetirementReadiness;
+    if (check === undefined) {
+      token = undefined;
+      current = missingCapability;
+      return Effect.succeed<IdleSealReadiness>({
+        status: "unknown",
+        reason: missingCapabilityReason,
+      });
+    }
+    return Effect.map(check(proof), (result): IdleSealReadiness => {
+      if (result.status === "retired") return ready;
+      // Discard only the proof that was checked; a newer one issued
+      // meanwhile (impossible under the claim, cheap to respect) stays.
+      if (token === proof) {
+        token = undefined;
+        current = { phase: result.status, reason: result.reason };
+      }
+      return result.status === "blocked"
+        ? { status: "unknown", reason: result.reason }
+        : { status: "busy", reason: result.reason };
+    });
+  });
+
+  return { request, state, settled, checkReadyForSeal } satisfies IdleUpdatePreparationShape;
+};
+
+export const layer = Layer.effect(
+  IdleUpdatePreparation,
+  Effect.gen(function* () {
+    const provider = yield* ProviderService;
+    const admission = yield* UpdateAdmission;
+    const activity = yield* UpdateActivity;
+    const serverScope = yield* Scope.Scope;
+    return make({ provider, admission, activity, serverScope });
+  }),
+);
