+      const newSession = "provider instance 'codex' (codex) has 1 live session(s)";
+      env.fake.setReadiness({ status: "busy", reason: newSession });
+      assert.deepStrictEqual(yield* env.preparation.checkReadyForSeal, {
+        status: "busy",
+        reason: newSession,
+      });
+      assert.equal(env.fake.calls.prepare, 1);
+      assert.equal(env.fake.calls.check, 2);
+      assert.deepStrictEqual(yield* env.preparation.state, { phase: "busy", reason: newSession });
+      yield* assertReleased(env);
+      // Discarded: no further provider check until a new proof exists.
+      assert.deepStrictEqual(yield* env.preparation.checkReadyForSeal, noProof);
+      assert.equal(env.fake.calls.check, 2);
+
+      env.fake.setReadiness({ status: "blocked", reason: "adapter generation replaced" });
+      assert.deepStrictEqual(yield* env.preparation.request, { phase: "preparing" });
+      assert.deepStrictEqual(yield* env.preparation.settled, { phase: "prepared" });
+      assert.deepStrictEqual(yield* env.preparation.checkReadyForSeal, {
+        status: "unknown",
+        reason: "adapter generation replaced",
+      });
+      assert.deepStrictEqual(yield* env.preparation.state, {
+        phase: "blocked",
+        reason: "adapter generation replaced",
+      });
