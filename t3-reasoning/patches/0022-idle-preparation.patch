+import { assert, describe, it } from "@effect/vitest";
+import * as Deferred from "effect/Deferred";
+import * as Effect from "effect/Effect";
+import * as Exit from "effect/Exit";
+import * as Fiber from "effect/Fiber";
+import * as Scope from "effect/Scope";
+
+import type { ProviderServiceError } from "../provider/Errors.ts";
+import type { ProviderIdleRetirementResult } from "../provider/Services/ProviderAdapter.ts";
+import {
+  type ProviderIdlePreparationResult,
+  type ProviderIdlePreparationToken,
+  ProviderIdlePreparationTokenTypeId,
+} from "../provider/Services/ProviderService.ts";
+import { make as makeAdmission } from "../updateAdmission.ts";
+import { make as makeActivity, UpdateActivityUnavailableError } from "../updateActivity.ts";
+import { type IdleUpdatePreparationDependencies, make } from "./idleUpdatePreparation.ts";
+
+/**
+ * A ProviderService reduced to the two members the controller uses. `hold`
+ * parks the next retirement so a test can observe the gates while it runs.
+ */
+const makeFakeProvider = () => {
+  const token: ProviderIdlePreparationToken = {
+    [ProviderIdlePreparationTokenTypeId]: ProviderIdlePreparationTokenTypeId,
+  };
+  const prepared: ProviderIdlePreparationResult = { status: "prepared", token };
+  let onPrepare: Effect.Effect<ProviderIdlePreparationResult, ProviderServiceError> =
+    Effect.succeed(prepared);
+  let readiness: ProviderIdleRetirementResult = { status: "retired" };
+  const calls = { prepare: 0, check: 0 };
+  const provider: IdleUpdatePreparationDependencies["provider"] = {
+    prepareIdleRetirement: () =>
+      Effect.suspend(() => {
+        calls.prepare += 1;
+        return onPrepare;
+      }),
+    checkIdleRetirementReadiness: (candidate) =>
+      Effect.sync((): ProviderIdleRetirementResult => {
+        calls.check += 1;
+        return candidate === token
+          ? readiness
+          : { status: "blocked", reason: "token was not issued by this service" };
+      }),
+  };
+  const hold = (during: Effect.Effect<void> = Effect.void) =>
+    Effect.gen(function* () {
+      const entered = yield* Deferred.make<void>();
+      const release = yield* Deferred.make<void>();
+      onPrepare = during.pipe(
+        Effect.andThen(Deferred.succeed(entered, undefined)),
+        Effect.andThen(Deferred.await(release)),
+        Effect.as(prepared),
+      );
+      return { entered, release };
+    });
+  return {
+    provider,
+    token,
+    calls,
+    hold,
+    answer: (next: ProviderIdlePreparationResult) => {
+      onPrepare = Effect.succeed(next);
+    },
+    fail: (error: ProviderServiceError) => {
+      onPrepare = Effect.fail(error);
+    },
+    setReadiness: (next: ProviderIdleRetirementResult) => {
+      readiness = next;
+    },
+  };
+};
+
+const setup = Effect.fn("setup")(function* (
+  provider?: IdleUpdatePreparationDependencies["provider"],
+) {
+  const admission = yield* makeAdmission();
+  const activity = yield* makeActivity();
+  const serverScope = yield* Scope.make();
+  const fake = makeFakeProvider();
+  const preparation = make({
+    provider: provider ?? fake.provider,
+    admission,
+    activity,
+    serverScope,
+  });
+  return { admission, activity, serverScope, fake, preparation };
+});
+
+type Setup = Effect.Success<ReturnType<typeof setup>>;
+
+const assertReleased = Effect.fn("assertReleased")(function* (env: Setup) {
+  assert.deepStrictEqual(yield* env.admission.state, { phase: "open", inFlight: 0 });
+  assert.include(yield* env.activity.state, { phase: "open", outstanding: 0 });
+});
+
+const noProof = { status: "busy", reason: "idle providers are not prepared" } as const;
+
+describe("idleUpdatePreparation", () => {
+  it.effect("answers a known-busy environment without admission or retirement", () =>
+    Effect.gen(function* () {
+      const env = yield* setup();
+      const lease = yield* env.activity.acquire("turn waiting for approval");
+
+      assert.deepStrictEqual(yield* env.preparation.request, {
+        phase: "busy",
+        reason: "1 agent operation(s) in flight",
+      });
+      assert.equal(env.fake.calls.prepare, 0);
+      assert.deepStrictEqual(yield* env.admission.state, { phase: "open", inFlight: 0 });
+      // The reply that finishes the turn is still admitted.
+      yield* env.admission.withAdmission(Effect.sync(() => lease.release()));
+      yield* assertReleased(env);
+
+      const blocker = env.activity.block("worker unavailable: fanout");
+      assert.deepStrictEqual(yield* env.preparation.request, {
+        phase: "busy",
+        reason: "activity is blocked: worker unavailable: fanout",
+      });
+      blocker.clear();
+      assert.equal(env.fake.calls.prepare, 0);
+      assert.deepStrictEqual(yield* env.preparation.checkReadyForSeal, noProof);
+      assert.equal(env.fake.calls.check, 0);
+    }),
+  );
+
+  it.effect(
+    "one server-owned retirement serves duplicate requests and survives requester cancellation",
+    () =>
+      Effect.gen(function* () {
+        const env = yield* setup();
+        const gate = yield* env.fake.hold();
+
+        const requester = yield* Effect.forkChild(env.preparation.request);
+        yield* Deferred.await(gate.entered);
+        yield* Fiber.interrupt(requester);
+        assert.deepStrictEqual(yield* env.preparation.state, { phase: "preparing" });
+
+        // Later requests join the running owner instead of retiring again.
+        assert.deepStrictEqual(yield* env.preparation.request, { phase: "preparing" });
+        assert.deepStrictEqual(yield* env.preparation.request, { phase: "preparing" });
+        assert.equal(env.fake.calls.prepare, 1);
+        assert.deepStrictEqual(yield* env.preparation.checkReadyForSeal, {
+          status: "busy",
+          reason: "idle provider preparation is in progress",
+        });
+
+        // Admission and exactly one ordinary lease are held for the retirement.
+        assert.deepStrictEqual(yield* env.admission.state, { phase: "maintenance", inFlight: 0 });
+        assert.include(yield* env.activity.state, { phase: "open", outstanding: 1 });
+        assert.equal((yield* env.activity.trySealIdle).status, "busy");
+        assert.deepStrictEqual(yield* env.admission.tryWithMaintenance(Effect.void), {
+          status: "busy",
+        });
+
+        yield* Deferred.succeed(gate.release, undefined);
+        assert.deepStrictEqual(yield* env.preparation.settled, { phase: "prepared" });
+        assert.equal(env.fake.calls.prepare, 1);
+        yield* assertReleased(env);
+        assert.deepStrictEqual(yield* env.preparation.request, { phase: "prepared" });
+        assert.deepStrictEqual(yield* env.preparation.checkReadyForSeal, { status: "ready" });
+        assert.equal(env.fake.calls.check, 1);
+      }),
+  );
+
+  it.effect("releases admission and its lease before work produced by retirement drains", () =>
+    Effect.gen(function* () {
+      const env = yield* setup();
+      // Retirement publishes a tracked event whose consumer finishes later.
+      let produced: { release: () => void } | undefined;
+      const gate = yield* env.fake.hold(
+        Effect.map(Effect.orDie(env.activity.acquire("adapter exit event")), (lease) => {
+          produced = lease;
+        }),
+      );
+      assert.deepStrictEqual(yield* env.preparation.request, { phase: "preparing" });
+      yield* Deferred.await(gate.entered);
+      assert.deepStrictEqual(yield* env.admission.state, { phase: "maintenance", inFlight: 0 });
+      assert.include(yield* env.activity.state, { outstanding: 2 });
+
+      yield* Deferred.succeed(gate.release, undefined);
+      assert.deepStrictEqual(yield* env.preparation.settled, { phase: "prepared" });
+      // Preparation did not wait for the consumer; both its holds are gone.
+      assert.deepStrictEqual(yield* env.admission.state, { phase: "open", inFlight: 0 });
+      assert.include(yield* env.activity.state, { phase: "open", outstanding: 1 });
+      produced?.release();
+      yield* assertReleased(env);
+    }),
+  );
+
+  it.effect("a client command in flight or a root under the claim prevents any retirement", () =>
+    Effect.gen(function* () {
+      const env = yield* setup();
+      const release = yield* Deferred.make<void>();
+      const command = yield* env.admission
+        .withAdmission(Deferred.await(release))
+        .pipe(Effect.forkChild);
+      yield* Effect.yieldNow;
+
+      assert.deepStrictEqual(yield* env.preparation.request, { phase: "preparing" });
+      assert.deepStrictEqual(yield* env.preparation.settled, {
+        phase: "busy",
+        reason: "client commands or another maintenance own update admission",
+      });
+      assert.equal(env.fake.calls.prepare, 0);
+      assert.deepStrictEqual(yield* env.admission.state, { phase: "open", inFlight: 1 });
+      yield* Deferred.succeed(release, undefined);
+      yield* Fiber.join(command);
+      yield* assertReleased(env);
+
+      // The request's own read says idle, then a root acquires before the
+      // claim's re-read: nothing is retired and admission reopens.
+      let lease: { release: () => void } | undefined;
+      let reads = 0;
+      const racing = {
+        ...env.activity,
+        state: Effect.tap(env.activity.state, () =>
+          reads++ === 0
+            ? Effect.map(Effect.orDie(env.activity.acquire("racing root")), (acquired) => {
+                lease = acquired;
+              })
+            : Effect.void,
+        ),
+      };
+      const preparation = make({
+        provider: env.fake.provider,
+        admission: env.admission,
+        activity: racing,
+        serverScope: env.serverScope,
+      });
+      assert.deepStrictEqual(yield* preparation.request, { phase: "preparing" });
+      assert.deepStrictEqual(yield* preparation.settled, {
+        phase: "busy",
+        reason: "1 agent operation(s) in flight",
+      });
+      assert.equal(env.fake.calls.prepare, 0);
+      assert.deepStrictEqual(yield* env.admission.state, { phase: "open", inFlight: 0 });
+      assert.include(yield* env.activity.state, { outstanding: 1 });
+      lease?.release();
+      yield* assertReleased(env);
+    }),
+  );
+
+  it.effect.each([
+    {
+      name: "a ProviderService without the capability",
+      provider: {} as IdleUpdatePreparationDependencies["provider"],
+      expected: {
+        phase: "blocked",
+        reason: "provider service cannot prove idle retirement",
+      } as const,
+    },
+    {
+      name: "a ProviderService with only the readiness half",
+      provider: {
+        checkIdleRetirementReadiness: () => Effect.succeed({ status: "retired" } as const),
+      } as IdleUpdatePreparationDependencies["provider"],
+      expected: {
+        phase: "blocked",
+        reason: "provider service cannot prove idle retirement",
+      } as const,
+    },
+  ])("$name is blocked without taking a proof", ({ provider, expected }) =>
+    Effect.gen(function* () {
+      const env = yield* setup(provider);
+      assert.deepStrictEqual(yield* env.preparation.request, { phase: "preparing" });
+      assert.deepStrictEqual(yield* env.preparation.settled, expected);
+      yield* assertReleased(env);
+      assert.deepStrictEqual(yield* env.preparation.checkReadyForSeal, noProof);
+    }),
+  );
+
+  it.effect.each([
+    {
+      name: "an unsupported adapter",
+      answer: { status: "blocked", reason: "provider instance 'cursor' cannot prove" } as const,
+      expected: { phase: "blocked", reason: "provider instance 'cursor' cannot prove" } as const,
+    },
+    {
+      name: "native work found",
+      answer: { status: "busy", reason: "provider instance 'codex': turn running" } as const,
+      expected: { phase: "busy", reason: "provider instance 'codex': turn running" } as const,
+    },
+  ])("$name never produces a proof", ({ answer, expected }) =>
+    Effect.gen(function* () {
+      const env = yield* setup();
+      env.fake.answer(answer);
+      assert.deepStrictEqual(yield* env.preparation.request, { phase: "preparing" });
+      assert.deepStrictEqual(yield* env.preparation.settled, expected);
+      assert.equal(env.fake.calls.prepare, 1);
+      yield* assertReleased(env);
+      assert.deepStrictEqual(yield* env.preparation.checkReadyForSeal, noProof);
+      assert.equal(env.fake.calls.check, 0);
+      // The next request tries again rather than trusting the old answer.
+      assert.deepStrictEqual(yield* env.preparation.request, { phase: "preparing" });
+      yield* env.preparation.settled;
+      assert.equal(env.fake.calls.prepare, 2);
+    }),
+  );
+
+  it.effect(
+    "a typed retirement failure or an interrupted owner is busy with everything released",
+    () =>
+      Effect.gen(function* () {
+        const env = yield* setup();
+        env.fake.fail(new UpdateActivityUnavailableError({ reason: "sealed" }));
+        assert.deepStrictEqual(yield* env.preparation.request, { phase: "preparing" });
+        assert.deepStrictEqual(yield* env.preparation.settled, {
+          phase: "busy",
+          reason: "idle retirement failed: UpdateActivityUnavailableError",
+        });
+        yield* assertReleased(env);
+
+        const gate = yield* env.fake.hold();
+        assert.deepStrictEqual(yield* env.preparation.request, { phase: "preparing" });
+        yield* Deferred.await(gate.entered);
+        assert.deepStrictEqual(yield* env.admission.state, { phase: "maintenance", inFlight: 0 });
+        // Only the owning server scope can end a running owner.
+        yield* Scope.close(env.serverScope, Exit.void);
+        assert.deepStrictEqual(yield* env.preparation.settled, {
+          phase: "busy",
+          reason: "idle preparation was interrupted",
+        });
+        yield* assertReleased(env);
+        assert.deepStrictEqual(yield* env.preparation.checkReadyForSeal, noProof);
+      }),
+  );
+
+  it.effect(
+    "a server scope closed before the owner first resumes still settles as interrupted",
+    () =>
+      Effect.gen(function* () {
+        const env = yield* setup();
+        const gate = yield* env.fake.hold();
+        assert.deepStrictEqual(yield* env.preparation.request, { phase: "preparing" });
+        // Closed before the scheduled owner ran anything: no retirement, no
+        // admission, and the owner must still publish and free its slot.
+        yield* Scope.close(env.serverScope, Exit.void);
+        assert.equal(env.fake.calls.prepare, 0);
+        assert.isFalse(yield* Deferred.isDone(gate.entered));
+        assert.deepStrictEqual(yield* env.preparation.settled, {
+          phase: "busy",
+          reason: "idle preparation was interrupted",
+        });
+        assert.deepStrictEqual(yield* env.preparation.checkReadyForSeal, noProof);
+        assert.equal(env.fake.calls.check, 0);
+        yield* assertReleased(env);
+      }),
+  );
+
+  it.effect("a request on an already-closed server scope answers interrupted at once", () =>
+    Effect.gen(function* () {
+      const env = yield* setup();
+      yield* Scope.close(env.serverScope, Exit.void);
+      const interrupted = { phase: "busy", reason: "idle preparation was interrupted" } as const;
+      assert.deepStrictEqual(yield* env.preparation.request, interrupted);
+      assert.deepStrictEqual(yield* env.preparation.state, interrupted);
+      assert.deepStrictEqual(yield* env.preparation.settled, interrupted);
+      assert.equal(env.fake.calls.prepare, 0);
+      assert.deepStrictEqual(yield* env.preparation.checkReadyForSeal, noProof);
+      yield* assertReleased(env);
+      // Nothing is left owning the slot, so a later request tries again and
+      // is refused the same way rather than reporting a phantom owner.
+      assert.deepStrictEqual(yield* env.preparation.request, interrupted);
+      assert.equal(env.fake.calls.prepare, 0);
+    }),
+  );
+
+  it.effect("a stale proof is discarded by the check without any retirement side effect", () =>
+    Effect.gen(function* () {
+      const env = yield* setup();
+      assert.deepStrictEqual(yield* env.preparation.request, { phase: "preparing" });
+      assert.deepStrictEqual(yield* env.preparation.settled, { phase: "prepared" });
+      assert.deepStrictEqual(yield* env.preparation.checkReadyForSeal, { status: "ready" });
+      assert.deepStrictEqual(yield* env.preparation.state, { phase: "prepared" });
