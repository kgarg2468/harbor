+  it("uses bounded native removal retries for owned scratch and staging cleanup", async () => {
+    const f = await fixture();
+    const removals: Array<Parameters<typeof fs.rm>> = [];
+    f.seams.fs = {
+      ...fs,
+      rm: async (...args) => {
+        removals.push(args);
+        return fs.rm(...args);
+      },
+    };
+    const p = f.make();
+    const token = await p.prepare(f.descriptor);
+    const scratch = path.join(
+      f.root,
+      (await fs.readdir(f.root)).find((name) => name.startsWith("managed-desktop-"))!,
+    );
+    const options = { recursive: true, force: true, maxRetries: 5, retryDelay: 200 };
+    const handoff = await p.claim(token);
+    expect(removals).toEqual([[scratch, options]]);
+    await expect(fs.stat(scratch)).rejects.toThrow();
+    await handoff.cleanup();
+    expect(removals).toEqual([[scratch, options], [handoff.stagedBundle, options]]);
+    await expect(fs.stat(handoff.stagedBundle)).rejects.toThrow();
+    expect((await fs.stat(f.installed)).isDirectory()).toBe(true);
+  });
+  it("propagates permanent owned cleanup failures", async () => {
+    const f = await fixture();
+    const failure = Object.assign(new Error("cleanup denied"), { code: "EACCES" });
+    f.seams.fs = {
+      ...fs,
+      rm: async () => {
+        throw failure;
+      },
+    };
+    const p = f.make();
+    const token = await p.prepare(f.descriptor);
+    await expect(p.cancel(token)).rejects.toBe(failure);
+    expect(p.isPrepared(token)).toBe(false);
+    expect((await fs.stat(f.installed)).isDirectory()).toBe(true);
+  });
