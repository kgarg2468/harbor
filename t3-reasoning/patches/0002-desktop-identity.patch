diff --git a/scripts/update-reasoning-mac-app.sh b/scripts/update-reasoning-mac-app.sh
new file mode 100755
index 0000000000000000000000000000000000000000..ea583477ba333d0bfa528a446f4807d66bfdc73c
--- /dev/null
+++ b/scripts/update-reasoning-mac-app.sh
@@ -0,0 +1,449 @@
+#!/usr/bin/env bash
+# Manual update/rebuild/install for the private macOS "T3 Code (Reasoning)" app.
+#
+# Syncs the local customization branch by merging in the reasoning PR ref and
+# current upstream main (history-preserving merges),
+# rebuilds the unsigned arm64 ZIP with scripts/build-desktop-artifact.ts,
+# verifies the produced bundle, and swaps it into
+# "/Applications/T3 Code (Reasoning).app" with rollback. The official
+# "T3 Code (Nightly).app" install is never touched.
+set -euo pipefail
+
+readonly REASONING_BUNDLE_ID="com.t3tools.t3code.reasoning"
+readonly OFFICIAL_BUNDLE_ID="com.t3tools.t3code"
+readonly REASONING_DISPLAY_NAME="T3 Code (Reasoning)"
+readonly REASONING_URL_SCHEME="t3code-reasoning"
+readonly TARGET_APP="/Applications/T3 Code (Reasoning).app"
+readonly OFFICIAL_APP="/Applications/T3 Code (Nightly).app"
+readonly DEFAULT_UPSTREAM_REF="origin/t3code/streaming-reasoning-transcript"
+readonly DEFAULT_MAIN_REF="upstream/main"
+readonly DEFAULT_LOCAL_BRANCH="local/reasoning-mac-app"
+readonly REQUIRED_NODE_VERSION="24.13.1"
+readonly REQUIRED_PNPM_VERSION="11.10.0"
+
+readonly PLUTIL=/usr/bin/plutil
+readonly DITTO=/usr/bin/ditto
+readonly CODESIGN=/usr/bin/codesign
+readonly OPEN=/usr/bin/open
+
+SKIP_SYNC=0
+NO_LAUNCH=0
+
+usage() {
+  cat <<'EOF'
+Usage: scripts/update-reasoning-mac-app.sh [options]
+
+Rebuilds and reinstalls the private "T3 Code (Reasoning)" macOS app from this
+repository. By default it verifies that the private Reasoning branch
+(local/reasoning-mac-app) is checked out, fetches and merges the reasoning PR
+ref and then current upstream main into it (history-preserving merges), then
+builds an unsigned arm64 ZIP and swaps it into /Applications with
+verification and rollback.
+
+Options:
+  --skip-sync    Build the currently checked-out source; skip fetch + merges.
+  --no-launch    Do not launch the app after installing.
+  -h, --help     Show this help.
+
+Environment:
+  T3CODE_REASONING_UPSTREAM  Reasoning PR ref to merge in
+                             (default: origin/t3code/streaming-reasoning-transcript).
+  T3CODE_REASONING_MAIN      Main ref to merge in after the reasoning PR ref
+                             (default: upstream/main).
+  T3CODE_REASONING_BRANCH    Local branch the sync expects to be checked out
+                             (default: local/reasoning-mac-app). Set this only
+                             if you intentionally renamed the Reasoning branch.
+  T3CODE_REASONING_NODE      Path to a Node >= 24.13.1 (major 24) executable to
+                             use when the system Node does not satisfy engines.
+                             Without it, if no installed Node qualifies, the
+                             script bootstraps one via 'npx -y node@24.13.1'
+                             (one-time download; needs network on first use).
+
+Safety:
+  - Runs only on macOS arm64.
+  - Refuses to sync unless the expected Reasoning branch is checked out
+    (see T3CODE_REASONING_BRANCH); --skip-sync builds any checkout as-is.
+  - Refuses to run with a dirty tracked worktree (unless --skip-sync).
+  - Never resets or discards local changes; a conflicting merge is aborted,
+    though an earlier successful merge from the same sync, if any, remains.
+  - Only ever replaces "/Applications/T3 Code (Reasoning).app", and only after
+    verifying the new bundle's identity. The prior app goes to the Trash with a
+    timestamped name; nothing is rm'd.
+  - "/Applications/T3 Code (Nightly).app" is verified untouched, never modified.
+EOF
+}
+
+log() { printf '[update-reasoning] %s\n' "$*"; }
+die() { printf '[update-reasoning] ERROR: %s\n' "$*" >&2; exit 1; }
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --skip-sync) SKIP_SYNC=1 ;;
+    --no-launch) NO_LAUNCH=1 ;;
+    -h|--help) usage; exit 0 ;;
+    *) usage >&2; die "Unknown argument: $1" ;;
+  esac
+  shift
+done
+
+# --- Host + repo checks -----------------------------------------------------
+
+[[ "$(uname -s)" == "Darwin" ]] || die "This script only runs on macOS."
+[[ "$(uname -m)" == "arm64" ]] || die "This script only runs on Apple Silicon (arm64)."
+
+SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd -P)"
+REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd -P)"
+[[ -f "$REPO_ROOT/pnpm-workspace.yaml" && -f "$REPO_ROOT/scripts/build-desktop-artifact.ts" ]] \
+  || die "Could not locate the t3code repo root from $SCRIPT_DIR."
+
+UPSTREAM_REF="${T3CODE_REASONING_UPSTREAM:-$DEFAULT_UPSTREAM_REF}"
+MAIN_REF="${T3CODE_REASONING_MAIN:-$DEFAULT_MAIN_REF}"
+EXPECTED_LOCAL_BRANCH="${T3CODE_REASONING_BRANCH:-$DEFAULT_LOCAL_BRANCH}"
+
+# --- Temp dir + cleanup trap ------------------------------------------------
+
+TMP_ROOT=""
+STAGED_APP=""
+
+cleanup() {
+  # Only remove paths this run provably created: the mktemp dir with our
+  # template in its name, and the uniquely named hidden staging bundle.
+  if [[ -n "$TMP_ROOT" && -d "$TMP_ROOT" && "$TMP_ROOT" == *"t3code-reasoning-update."* ]]; then
+    rm -rf -- "$TMP_ROOT"
+  fi
+  if [[ -n "$STAGED_APP" && -d "$STAGED_APP" \
+        && "$STAGED_APP" == "/Applications/.t3code-reasoning-staged-"* ]]; then
+    rm -rf -- "$STAGED_APP"
+  fi
+}
+trap cleanup EXIT
+
+TMP_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/t3code-reasoning-update.XXXXXX")"
+[[ -d "$TMP_ROOT" ]] || die "mktemp failed."
+
+# --- Plist helpers ----------------------------------------------------------
+
+plist_value() {
+  # plist_value <app path> <key> — prints the raw value, empty on absence.
+  "$PLUTIL" -extract "$2" raw -o - -- "$1/Contents/Info.plist" 2>/dev/null || true
+}
+
+bundle_id_of() { plist_value "$1" CFBundleIdentifier; }
+
+collect_url_schemes() {
+  # Prints every CFBundleURLSchemes entry of the app, one per line.
+  local plist="$1/Contents/Info.plist" t=0 s=0 value
+  while "$PLUTIL" -extract "CFBundleURLTypes.$t" raw -o - -- "$plist" >/dev/null 2>&1; do
+    s=0
+    while value="$("$PLUTIL" -extract "CFBundleURLTypes.$t.CFBundleURLSchemes.$s" raw -o - -- "$plist" 2>/dev/null)"; do
+      printf '%s\n' "$value"
+      s=$((s + 1))
+    done
+    t=$((t + 1))
+  done
+}
+
+verify_reasoning_bundle() {
+  # Full identity check of a candidate Reasoning app bundle before install.
+  local app="$1" id display schemes
+  [[ -d "$app" ]] || die "App bundle not found at: $app"
+
+  id="$(bundle_id_of "$app")"
+  [[ "$id" == "$REASONING_BUNDLE_ID" ]] \
+    || die "Bundle at '$app' has CFBundleIdentifier '$id', expected '$REASONING_BUNDLE_ID'."
+
+  display="$(plist_value "$app" CFBundleDisplayName)"
+  [[ "$display" == "$REASONING_DISPLAY_NAME" ]] \
+    || die "Bundle at '$app' has CFBundleDisplayName '$display', expected '$REASONING_DISPLAY_NAME'."
+
+  schemes="$(collect_url_schemes "$app")"
+  [[ "$schemes" == "$REASONING_URL_SCHEME" ]] \
+    || die "Bundle at '$app' must claim exactly the '$REASONING_URL_SCHEME' URL scheme; found: ${schemes:-<none>}"
+  while IFS= read -r scheme; do
+    case "$scheme" in
+      t3code|t3code-dev) die "Bundle at '$app' claims official scheme '$scheme'; refusing." ;;
+    esac
+  done <<< "$schemes"
+
+  [[ ! -e "$app/Contents/Resources/app-update.yml" ]] \
+    || die "Bundle at '$app' contains app-update.yml (auto-update feed); refusing to install it."
+}
+
+# --- Guard the official install --------------------------------------------
+
+if [[ -d "$OFFICIAL_APP" ]]; then
+  official_id="$(bundle_id_of "$OFFICIAL_APP")"
+  [[ "$official_id" == "$OFFICIAL_BUNDLE_ID" ]] \
+    || die "Official app at '$OFFICIAL_APP' has unexpected bundle id '$official_id'. Refusing to continue; investigate before updating."
+  log "Official app check OK: $OFFICIAL_APP is $official_id (will not be touched)."
+fi
+
+if [[ -e "$TARGET_APP" ]]; then
+  [[ -d "$TARGET_APP" ]] || die "'$TARGET_APP' exists but is not an app bundle directory."
+  target_id="$(bundle_id_of "$TARGET_APP")"
+  [[ "$target_id" == "$REASONING_BUNDLE_ID" ]] \
+    || die "'$TARGET_APP' has bundle id '${target_id:-<none>}', not '$REASONING_BUNDLE_ID'. Refusing to replace something that is not the Reasoning app."
+fi
+
+# --- Sync with upstream (unless --skip-sync) --------------------------------
+
+git_r() { git -C "$REPO_ROOT" "$@"; }
+
+fetched_remotes=" "
+fetch_remote_of_ref() {
+  # Fetches the remote a "<remote>/<branch>" ref points at, once per remote.
+  # Refs without a configured-remote prefix (tags, local branches) fetch
+  # nothing and are just verified to exist afterwards.
+  local ref="$1" remote="${1%%/*}"
+  [[ "$remote" != "$ref" ]] || return 0
+  git_r remote get-url "$remote" >/dev/null 2>&1 || return 0
+  [[ "$fetched_remotes" != *" $remote "* ]] || return 0
+  git_r fetch "$remote" || die "git fetch $remote failed."
+  fetched_remotes="$fetched_remotes$remote "
+}
+
+merge_ref() {
+  # merge_ref <ref> <env var that overrides it>
+  local ref="$1" env_name="$2"
+  git_r rev-parse --verify --quiet "${ref}^{commit}" >/dev/null \
+    || die "Ref '$ref' does not exist after fetch. Set $env_name to a valid ref."
+  if git_r merge-base --is-ancestor "$ref" HEAD; then
+    log "'$branch' already contains '$ref'."
+    return 0
+  fi
+  log "Merging '$ref' into '$branch'..."
+  if ! git_r merge --no-edit "$ref"; then
+    git_r merge --abort >/dev/null 2>&1 || true
+    die "Merge of '$ref' into '$branch' hit conflicts. The conflicting merge was aborted; earlier successful merges from this sync, if any, remain on your branch. Resolve manually (git merge $ref), then rerun with --skip-sync."
+  fi
+}
+
+if [[ "$SKIP_SYNC" -eq 0 ]]; then
+  log "Syncing '$EXPECTED_LOCAL_BRANCH' with '$UPSTREAM_REF' and '$MAIN_REF'..."
+
+  git_dir="$(git_r rev-parse --absolute-git-dir)" || die "Not a git repository: $REPO_ROOT"
+  [[ ! -d "$git_dir/rebase-merge" && ! -d "$git_dir/rebase-apply" ]] \
+    || die "A rebase is already in progress in this worktree. Resolve it first."
+  [[ ! -f "$git_dir/MERGE_HEAD" ]] \
+    || die "A merge is already in progress in this worktree. Resolve it first."
+
+  branch="$(git_r symbolic-ref --quiet --short HEAD || true)"
+  [[ -n "$branch" ]] || die "HEAD is detached. Check out the local Reasoning branch first."
+
+  [[ "$branch" == "$EXPECTED_LOCAL_BRANCH" ]] \
+    || die "Checked-out branch is '$branch', expected '$EXPECTED_LOCAL_BRANCH'. Check out the Reasoning branch, set T3CODE_REASONING_BRANCH if you renamed it, or use --skip-sync to build this checkout as-is."
+
+  if [[ -n "$(git_r status --porcelain --untracked-files=no)" ]]; then
+    die "Tracked worktree is dirty. Commit or set aside your changes, or rerun with --skip-sync to build the current source as-is."
+  fi
+
+  fetch_remote_of_ref "$UPSTREAM_REF"
+  fetch_remote_of_ref "$MAIN_REF"
+
+  merge_ref "$UPSTREAM_REF" T3CODE_REASONING_UPSTREAM
+  merge_ref "$MAIN_REF" T3CODE_REASONING_MAIN
+else
+  log "Skipping upstream sync (--skip-sync); building current checkout."
+fi
+
+# --- Toolchain: Node ${REQUIRED_NODE_VERSION} + pnpm ${REQUIRED_PNPM_VERSION}
+
+node_satisfies() {
+  # Accepts ^24.13.1: major 24, and (minor, patch) >= (13, 1).
+  local v major minor patch
+  v="$("$1" --version 2>/dev/null)" || return 1
+  v="${v#v}"
+  IFS=. read -r major minor patch <<< "$v"
+  [[ "$major" == "24" ]] || return 1
+  [[ "$minor" =~ ^[0-9]+$ && "$patch" =~ ^[0-9]+$ ]] || return 1
+  (( minor > 13 || (minor == 13 && patch >= 1) ))
+}
+
+resolve_node() {
+  local candidate
+  if [[ -n "${T3CODE_REASONING_NODE:-}" ]]; then
+    node_satisfies "$T3CODE_REASONING_NODE" \
+      || die "T3CODE_REASONING_NODE ('$T3CODE_REASONING_NODE') is not a Node ^${REQUIRED_NODE_VERSION} executable."
+    printf '%s\n' "$T3CODE_REASONING_NODE"
+    return
+  fi
+  for candidate in \
+    "$HOME/.nvm/versions/node/v$REQUIRED_NODE_VERSION/bin/node" \
+    "$HOME/Library/Application Support/fnm/node-versions/v$REQUIRED_NODE_VERSION/installation/bin/node" \
+    "$HOME/.local/share/fnm/node-versions/v$REQUIRED_NODE_VERSION/installation/bin/node" \
+    "$HOME/.local/share/mise/installs/node/$REQUIRED_NODE_VERSION/bin/node" \
+    "$HOME/.asdf/installs/nodejs/$REQUIRED_NODE_VERSION/bin/node" \
+    "$HOME/.volta/tools/image/node/$REQUIRED_NODE_VERSION/bin/node"; do
+    if [[ -x "$candidate" ]] && node_satisfies "$candidate"; then
+      printf '%s\n' "$candidate"
+      return
+    fi
+  done
+  if candidate="$(command -v node)" && node_satisfies "$candidate"; then
+    printf '%s\n' "$candidate"
+    return
+  fi
+  # Last resort: let npx fetch the exact Node into its cache (one-time
+  # download; needs network on first use). Logs go to stderr so the caller's
+  # command substitution captures only the final path.
+  if command -v npx >/dev/null 2>&1; then
+    log "No local Node ^${REQUIRED_NODE_VERSION} found; bootstrapping via 'npx -y node@${REQUIRED_NODE_VERSION}' (one-time download, may need network)..." >&2
+    if candidate="$(npx -y "node@$REQUIRED_NODE_VERSION" -p 'process.execPath' 2>/dev/null)"; then
+      candidate="${candidate##*$'\n'}"
+      if [[ -x "$candidate" ]] && node_satisfies "$candidate"; then
+        printf '%s\n' "$candidate"
+        return
+      fi
+    fi
+  fi
+  die "No Node ^${REQUIRED_NODE_VERSION} found (and the npx bootstrap did not yield one). Install it (e.g. 'nvm install ${REQUIRED_NODE_VERSION}' or 'fnm install ${REQUIRED_NODE_VERSION}') or set T3CODE_REASONING_NODE to a suitable node binary."
+}
+
+NODE_BIN="$(resolve_node)"
+NODE_BIN_DIR="$(cd -- "$(dirname -- "$NODE_BIN")" >/dev/null 2>&1 && pwd -P)"
+export PATH="$REPO_ROOT/node_modules/.bin:$NODE_BIN_DIR:$PATH"
+log "Using Node $("$NODE_BIN" --version) at $NODE_BIN"
+
+# pnpm: prefer an on-PATH exact match, then corepack (pinned by the repo's
+# packageManager field), then a one-off npx fetch of the pinned version.
+PNPM_CMD=()
+if command -v pnpm >/dev/null 2>&1 \
+   && [[ "$(pnpm --version 2>/dev/null)" == "$REQUIRED_PNPM_VERSION" ]]; then
+  PNPM_CMD=(pnpm)
+elif command -v corepack >/dev/null 2>&1; then
+  export COREPACK_ENABLE_DOWNLOAD_PROMPT=0
+  PNPM_CMD=(corepack pnpm)
+elif command -v npx >/dev/null 2>&1; then
+  PNPM_CMD=(npx -y "pnpm@$REQUIRED_PNPM_VERSION")
+else
+  die "Could not find pnpm $REQUIRED_PNPM_VERSION, corepack, or npx next to the resolved Node."
+fi
+
+pnpm_version="$(cd "$REPO_ROOT" && "${PNPM_CMD[@]}" --version 2>/dev/null)" || true
+[[ "$pnpm_version" == "$REQUIRED_PNPM_VERSION" ]] \
+  || die "Resolved pnpm reports version '${pnpm_version:-<none>}', expected $REQUIRED_PNPM_VERSION."
+log "Using pnpm $pnpm_version (${PNPM_CMD[*]})"
+
+# --- Install + build --------------------------------------------------------
+
+log "Installing frozen dependency graph..."
+(cd "$REPO_ROOT" && "${PNPM_CMD[@]}" install --frozen-lockfile) \
+  || die "pnpm install --frozen-lockfile failed. The installed app was not touched."
+
+BUILD_OUT="$TMP_ROOT/artifacts"
+mkdir -p "$BUILD_OUT"
+
+# Explicit flags below outrank env, but clear the toggles that have no flag
+# so an ambient dev environment cannot skew this build.
+unset T3CODE_DESKTOP_SIGNED T3CODE_DESKTOP_SKIP_BUILD T3CODE_DESKTOP_KEEP_STAGE \
+      T3CODE_DESKTOP_MOCK_UPDATES T3CODE_DESKTOP_MOCK_UPDATE_SERVER_PORT \
+      T3CODE_DESKTOP_OUTPUT_DIR T3CODE_DESKTOP_VERSION 2>/dev/null || true
+
+log "Building unsigned macOS arm64 ZIP (this runs the full desktop build)..."
+(cd "$REPO_ROOT" && "$NODE_BIN" scripts/build-desktop-artifact.ts \
+    --platform mac --target zip --arch arm64 --output-dir "$BUILD_OUT") \
+  || die "Desktop artifact build failed. The installed app was not touched."
+
+# --- Locate + extract + verify the built app --------------------------------
+
+zips=()
+while IFS= read -r -d '' zip; do
+  zips+=("$zip")
+done < <(find "$BUILD_OUT" -maxdepth 1 -type f -name 'T3-Code-Reasoning-*.zip' -print0)
+[[ ${#zips[@]} -eq 1 ]] \
+  || die "Expected exactly one Reasoning ZIP in $BUILD_OUT, found ${#zips[@]}."
+ZIP_PATH="${zips[0]}"
+log "Built artifact: $(basename "$ZIP_PATH")"
+
+EXTRACT_DIR="$TMP_ROOT/extracted"
+mkdir -p "$EXTRACT_DIR"
+"$DITTO" -x -k "$ZIP_PATH" "$EXTRACT_DIR" || die "ditto extraction failed."
+
+apps=()
+while IFS= read -r -d '' app; do
+  apps+=("$app")
+done < <(find "$EXTRACT_DIR" -maxdepth 1 -type d -name '*.app' -print0)
+[[ ${#apps[@]} -eq 1 ]] \
+  || die "Expected exactly one .app in the extracted ZIP, found ${#apps[@]}."
+NEW_APP="${apps[0]}"
+
+log "Verifying built bundle identity..."
+verify_reasoning_bundle "$NEW_APP"
+NEW_VERSION="$(plist_value "$NEW_APP" CFBundleShortVersionString)"
+log "Built bundle OK: $REASONING_BUNDLE_ID ${NEW_VERSION:-<unknown version>}"
+
+# --- Refuse to replace a running app ----------------------------------------
+
+if [[ -d "$TARGET_APP" ]] \
+   && ps -axo comm= | grep -F -q "$TARGET_APP/Contents/MacOS/"; then
+  die "'$REASONING_DISPLAY_NAME' is currently running. Quit it, then rerun (with --skip-sync to reuse this build's source state). Note the built artifact lives in a temp dir and is discarded on exit."
+fi
+
+# --- Stage, ad-hoc sign, swap ------------------------------------------------
+
+STAMP="$(date +%Y%m%d-%H%M%S)"
+STAGED_APP="/Applications/.t3code-reasoning-staged-$STAMP-$$.app"
+[[ ! -e "$STAGED_APP" ]] || die "Staging path already exists: $STAGED_APP"
+
+log "Staging new app at $STAGED_APP"
+"$DITTO" "$NEW_APP" "$STAGED_APP" || die "Failed to stage the new app under /Applications."
+
+if ! "$CODESIGN" --verify --deep --strict "$STAGED_APP" >/dev/null 2>&1; then
+  log "Ad-hoc signing staged app so it can launch locally..."
+  "$CODESIGN" --force --deep --sign - "$STAGED_APP" \
+    || die "Ad-hoc signing failed; the installed app was not touched."
+fi
+"$CODESIGN" --verify --deep --strict "$STAGED_APP" \
+  || die "codesign verification of the staged app failed; the installed app was not touched."
+
+# BSD mv -n exits 0 even when it declines to move over an existing
+# destination, so every move is re-checked by looking at the filesystem.
+TRASHED_APP=""
+if [[ -d "$TARGET_APP" ]]; then
+  TRASHED_APP="$HOME/.Trash/T3 Code (Reasoning) $STAMP-$$.app"
+  log "Moving previous app to Trash: $TRASHED_APP"
+  mv -n "$TARGET_APP" "$TRASHED_APP" || true
+  if [[ -e "$TARGET_APP" || ! -d "$TRASHED_APP" ]]; then
+    die "Could not move the previous app to the Trash (grant this terminal Full Disk Access, or move it aside manually). The installed app was not touched."
+  fi
+fi
+
+mv -n "$STAGED_APP" "$TARGET_APP" || true
+if [[ -e "$STAGED_APP" || ! -d "$TARGET_APP" ]]; then
+  if [[ -n "$TRASHED_APP" && -d "$TRASHED_APP" && ! -e "$TARGET_APP" ]]; then
+    mv -n "$TRASHED_APP" "$TARGET_APP" || true
+    if [[ -d "$TARGET_APP" && ! -e "$TRASHED_APP" ]]; then
+      log "Rolled back: previous app restored from Trash."
+    else
+      log "ROLLBACK FAILED: previous app is still at '$TRASHED_APP'. Restore it manually."
+    fi
+  fi
+  die "Failed to move the staged app into place."
+fi
+STAGED_APP=""  # installed; nothing left for the trap to clean
+
+# --- Post-install verification ----------------------------------------------
+
+installed_id="$(bundle_id_of "$TARGET_APP")"
+[[ "$installed_id" == "$REASONING_BUNDLE_ID" ]] \
+  || die "Post-install check failed: '$TARGET_APP' reports bundle id '$installed_id'."
+
+if [[ -d "$OFFICIAL_APP" ]]; then
+  official_id="$(bundle_id_of "$OFFICIAL_APP")"
+  [[ "$official_id" == "$OFFICIAL_BUNDLE_ID" ]] \
+    || die "Post-install check failed: official app bundle id changed to '$official_id'. Investigate immediately."
+fi
+
+if [[ "$NO_LAUNCH" -eq 0 ]]; then
+  log "Launching $REASONING_DISPLAY_NAME..."
+  # Strip ELECTRON_RUN_AS_NODE from the launch environment: when this script
+  # runs from a backend child that variable is set, and if it reaches the app
+  # it starts as a headless node process instead of the GUI.
+  /usr/bin/env -u ELECTRON_RUN_AS_NODE "$OPEN" "$TARGET_APP" \
+    || log "WARNING: launch failed; open '$TARGET_APP' manually."
+fi
+
+log "Success."
+log "  Installed: $TARGET_APP ($REASONING_BUNDLE_ID, version ${NEW_VERSION:-unknown})"
+[[ -z "$TRASHED_APP" ]] || log "  Previous:  $TRASHED_APP (recoverable from Trash)"
+[[ ! -d "$OFFICIAL_APP" ]] || log "  Official:  $OFFICIAL_APP untouched ($OFFICIAL_BUNDLE_ID)"
