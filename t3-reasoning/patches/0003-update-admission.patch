--- /dev/null
+++ b/apps/server/src/updateAdmission.test.ts
@@ -0,0 +1,212 @@
+import { assert, describe, it } from "@effect/vitest";
+import * as Cause from "effect/Cause";
+import * as Deferred from "effect/Deferred";
+import * as Effect from "effect/Effect";
+import * as Exit from "effect/Exit";
+import * as Fiber from "effect/Fiber";
+import * as Scope from "effect/Scope";
+
+import { make, UpdateAdmissionClosedError, type UpdateAdmissionShape } from "./updateAdmission.ts";
+
+/**
+ * Forks a command that stays admitted until `release` completes, then waits
+ * until the gate actually counted it so the test never races the fork.
+ */
+const holdCommand = Effect.fn("holdCommand")(function* (admission: UpdateAdmissionShape) {
+  const release = yield* Deferred.make<void>();
+  const fiber = yield* admission.withAdmission(Deferred.await(release)).pipe(Effect.forkChild);
+  yield* Effect.yieldNow;
+  assert.equal((yield* admission.state).inFlight, 1);
+  return { fiber, release };
+});
+
+/** Forks a maintenance whose callback signals `started` and blocks until `finish`. */
+const forkMaintenance = Effect.fn("forkMaintenance")(function* (admission: UpdateAdmissionShape) {
+  const started = yield* Deferred.make<void>();
+  const finish = yield* Deferred.make<void>();
+  const fiber = yield* admission
+    .withMaintenance(
+      Deferred.succeed(started, undefined).pipe(Effect.andThen(Deferred.await(finish))),
+    )
+    .pipe(Effect.forkChild);
+  yield* Effect.yieldNow;
+  return { fiber, started, finish };
+});
+
+describe("updateAdmission", () => {
+  it.effect("starts open with nothing in flight and runs admitted commands", () =>
+    Effect.gen(function* () {
+      const admission = yield* make();
+      assert.deepStrictEqual(yield* admission.state, { phase: "open", inFlight: 0 });
+
+      const result = yield* admission.withAdmission(Effect.succeed("ok"));
+      assert.equal(result, "ok");
+      assert.deepStrictEqual(yield* admission.state, { phase: "open", inFlight: 0 });
+    }),
+  );
+
+  it.effect("an admitted command blocks the maintenance callback until it completes", () =>
+    Effect.gen(function* () {
+      const admission = yield* make();
+      const command = yield* holdCommand(admission);
+      const maintenance = yield* forkMaintenance(admission);
+
+      assert.deepStrictEqual(yield* admission.state, { phase: "maintenance", inFlight: 1 });
+      assert.isFalse(yield* Deferred.isDone(maintenance.started));
+
+      yield* Deferred.succeed(command.release, undefined);
+      yield* Fiber.join(command.fiber);
+      yield* Deferred.await(maintenance.started);
+      assert.deepStrictEqual(yield* admission.state, { phase: "maintenance", inFlight: 0 });
+
+      yield* Deferred.succeed(maintenance.finish, undefined);
+      yield* Fiber.join(maintenance.fiber);
+      assert.deepStrictEqual(yield* admission.state, { phase: "open", inFlight: 0 });
+    }),
+  );
+
+  it.effect("rejects new commands as soon as closing begins, without counting them", () =>
+    Effect.gen(function* () {
+      const admission = yield* make();
+      const command = yield* holdCommand(admission);
+      const maintenance = yield* forkMaintenance(admission);
+
+      const error = yield* admission.withAdmission(Effect.succeed("late")).pipe(Effect.flip);
+      assert.instanceOf(error, UpdateAdmissionClosedError);
+      assert.isTrue(error.retryable);
+      assert.deepStrictEqual(yield* admission.state, { phase: "maintenance", inFlight: 1 });
+
+      yield* Deferred.succeed(command.release, undefined);
+      yield* Deferred.succeed(maintenance.finish, undefined);
+      yield* Fiber.join(maintenance.fiber);
+
+      const result = yield* admission.withAdmission(Effect.succeed("after"));
+      assert.equal(result, "after");
+    }),
+  );
+
+  it.effect("a failing command releases its count", () =>
+    Effect.gen(function* () {
+      const admission = yield* make();
+      const error = yield* admission.withAdmission(Effect.fail("boom")).pipe(Effect.flip);
+      assert.equal(error, "boom");
+      assert.deepStrictEqual(yield* admission.state, { phase: "open", inFlight: 0 });
+    }),
+  );
+
+  it.effect("an interrupted command releases its count and wakes a waiting maintenance", () =>
+    Effect.gen(function* () {
+      const admission = yield* make();
+      const command = yield* holdCommand(admission);
+      const maintenance = yield* forkMaintenance(admission);
+
+      yield* Fiber.interrupt(command.fiber);
+      yield* Deferred.await(maintenance.started);
+      assert.deepStrictEqual(yield* admission.state, { phase: "maintenance", inFlight: 0 });
+
+      yield* Deferred.succeed(maintenance.finish, undefined);
+      yield* Fiber.join(maintenance.fiber);
+      assert.deepStrictEqual(yield* admission.state, { phase: "open", inFlight: 0 });
+    }),
+  );
+
+  it.effect("serializes concurrent maintenance and keeps the gate closed between them", () =>
+    Effect.gen(function* () {
+      const admission = yield* make();
+      const first = yield* forkMaintenance(admission);
+      const second = yield* forkMaintenance(admission);
+
+      yield* Deferred.await(first.started);
+      assert.isFalse(yield* Deferred.isDone(second.started));
+
+      yield* Deferred.succeed(first.finish, undefined);
+      yield* Fiber.join(first.fiber);
+      yield* Deferred.await(second.started);
+      assert.deepStrictEqual(yield* admission.state, { phase: "maintenance", inFlight: 0 });
+
+      yield* Deferred.succeed(second.finish, undefined);
+      yield* Fiber.join(second.fiber);
+      assert.deepStrictEqual(yield* admission.state, { phase: "open", inFlight: 0 });
+    }),
+  );
+
+  it.effect("cancelling maintenance while it waits for the drain reopens the gate", () =>
+    Effect.gen(function* () {
+      const admission = yield* make();
+      const command = yield* holdCommand(admission);
+      const maintenance = yield* forkMaintenance(admission);
+
+      yield* Fiber.interrupt(maintenance.fiber);
+      assert.isFalse(yield* Deferred.isDone(maintenance.started));
+      assert.deepStrictEqual(yield* admission.state, { phase: "open", inFlight: 1 });
+
+      const result = yield* admission.withAdmission(Effect.succeed("admitted"));
+      assert.equal(result, "admitted");
+
+      yield* Deferred.succeed(command.release, undefined);
+      yield* Fiber.join(command.fiber);
+      assert.deepStrictEqual(yield* admission.state, { phase: "open", inFlight: 0 });
+    }),
+  );
+
+  it.effect("a failing maintenance callback reopens the gate and propagates the error", () =>
+    Effect.gen(function* () {
+      const admission = yield* make();
+      const error = yield* admission
+        .withMaintenance(Effect.fail("update failed"))
+        .pipe(Effect.flip);
+      assert.equal(error, "update failed");
+      assert.deepStrictEqual(yield* admission.state, { phase: "open", inFlight: 0 });
+    }),
+  );
+
+  it.effect("an interrupted maintenance callback reopens the gate", () =>
+    Effect.gen(function* () {
+      const admission = yield* make();
+      const maintenance = yield* forkMaintenance(admission);
+      yield* Deferred.await(maintenance.started);
+      assert.deepStrictEqual(yield* admission.state, { phase: "maintenance", inFlight: 0 });
+
+      yield* Fiber.interrupt(maintenance.fiber);
+      const exit = yield* Fiber.await(maintenance.fiber);
+      assert.isTrue(Exit.isFailure(exit) && Cause.hasInterrupts(exit.cause));
+      assert.deepStrictEqual(yield* admission.state, { phase: "open", inFlight: 0 });
+    }),
+  );
+
+  it.effect("does not lose the wakeup when the last command finishes at the close boundary", () =>
+    Effect.gen(function* () {
+      const admission = yield* make();
+      const command = yield* holdCommand(admission);
+
+      // Close and finish the last command in the same scheduler pass: the
+      // maintenance fiber must observe the drain either way.
+      const maintenance = yield* admission
+        .withMaintenance(Effect.succeed("ran"))
+        .pipe(Effect.forkChild);
+      yield* Deferred.succeed(command.release, undefined);
+
+      assert.equal(yield* Fiber.join(maintenance), "ran");
+      assert.deepStrictEqual(yield* admission.state, { phase: "open", inFlight: 0 });
+    }),
+  );
+
+  it.effect("closing the owning scope wakes a maintenance stuck waiting for the drain", () =>
+    Effect.gen(function* () {
+      const scope = yield* Scope.make();
+      const admission = yield* make().pipe(Scope.provide(scope));
+      const command = yield* holdCommand(admission);
+      const maintenance = yield* forkMaintenance(admission);
+
+      yield* Scope.close(scope, Exit.void);
+      const exit = yield* Fiber.await(maintenance.fiber);
+      assert.isTrue(Exit.isFailure(exit));
+      assert.isFalse(yield* Deferred.isDone(maintenance.started));
+      assert.deepStrictEqual(yield* admission.state, { phase: "open", inFlight: 1 });
+
+      yield* Deferred.succeed(command.release, undefined);
+      yield* Fiber.join(command.fiber);
+      assert.deepStrictEqual(yield* admission.state, { phase: "open", inFlight: 0 });
+    }),
+  );
+});
