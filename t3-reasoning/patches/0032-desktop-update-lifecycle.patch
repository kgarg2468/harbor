new file mode 100644
index 0000000000000000000000000000000000000000..01d18a96f87848a7f65ade74605398dead500edc
--- /dev/null
+++ b/apps/desktop/src/backend/desktopUpdateLifecycle.ts
@@ -0,0 +1,134 @@
+import * as Context from "effect/Context";
+import * as Deferred from "effect/Deferred";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import type {
+  DesktopUpdateFreezeResult,
+  OwnedBackendRun,
+} from "../updates/desktopUpdateReservation.ts";
+
+export type DesktopBackendGeneration =
+  | { readonly _tag: "supported"; readonly run: OwnedBackendRun }
+  | { readonly _tag: "unsupported"; readonly reason: string }
+  | { readonly _tag: "stopped" };
+
+export class DesktopUpdateLifecycle extends Context.Service<
+  DesktopUpdateLifecycle,
+  {
+    readonly tryFreeze: Effect.Effect<DesktopUpdateFreezeResult>;
+    /** Mutations may overlap each other, but are exclusive with a frozen inventory. */
+    readonly withMutation: <A, E, R>(effect: Effect.Effect<A, E, R>) => Effect.Effect<A, E, R>;
+    /** Teardown is excluded during a provisional freeze, but may finish after retention. */
+    readonly withTeardown: <A, E, R>(effect: Effect.Effect<A, E, R>) => Effect.Effect<A, E, R>;
+    readonly isRetained: Effect.Effect<boolean>;
+    /** Called inside the construction mutation; removal belongs to the instance scope. */
+    readonly addOwner: (
+      snapshot: Effect.Effect<DesktopBackendGeneration>,
+    ) => Effect.Effect<Effect.Effect<void>>;
+  }
+>()("@t3tools/desktop/backend/desktopUpdateLifecycle") {}
+
+export const make = Effect.sync(() => {
+  let mutations = 0;
+  let retained = false;
+  let teardownFence: Deferred.Deferred<void> | undefined;
+  let fence: Deferred.Deferred<void> | undefined;
+  const owners = new Set<Effect.Effect<DesktopBackendGeneration>>();
+  const guard =
+    (teardown: boolean): DesktopUpdateLifecycle["Service"]["withMutation"] =>
+    (effect) =>
+      Effect.uninterruptibleMask((restore) => {
+        const enter: Effect.Effect<void> = Effect.suspend(() => {
+          if (fence !== undefined && !(teardown && retained)) {
+            return restore(Deferred.await(teardown ? teardownFence! : fence)).pipe(
+              Effect.andThen(enter),
+            );
+          }
+          mutations++;
+          return Effect.void;
+        });
+        return enter.pipe(
+          Effect.andThen(() =>
+            restore(effect).pipe(
+              Effect.ensuring(
+                Effect.sync(() => {
+                  mutations--;
+                }),
+              ),
+            ),
+          ),
+        );
+      });
+  const guarded = guard(false);
+  const withTeardown = guard(true);
+  const tryFreeze = Effect.suspend(() => {
+    let abort: Effect.Effect<void> = Effect.void;
+    return Effect.uninterruptibleMask((restore) =>
+      Effect.gen(function* () {
+        if (mutations > 0 || fence !== undefined)
+          return {
+            _tag: "busy",
+            reason: "Desktop backend lifecycle work is active or frozen.",
+          } as const;
+        const acquired = Deferred.makeUnsafe<void>();
+        fence = acquired;
+        const teardownReleased = Deferred.makeUnsafe<void>();
+        teardownFence = teardownReleased;
+        let released = false;
+        const release = Effect.uninterruptible(
+          Effect.suspend(() => {
+            if (retained || released) return Effect.void;
+            released = true;
+            fence = undefined;
+            teardownFence = undefined;
+            Deferred.doneUnsafe(teardownReleased, Effect.void);
+            return Deferred.succeed(acquired, undefined).pipe(Effect.asVoid);
+          }),
+        );
+        abort = release;
+        const snapshots = yield* restore(Effect.forEach(owners, (snapshot) => snapshot)).pipe(
+          Effect.onExit((exit) => (exit._tag === "Failure" ? release : Effect.void)),
+        );
+        const unsupported = snapshots.find((snapshot) => snapshot._tag === "unsupported");
+        if (unsupported?._tag === "unsupported") {
+          yield* release;
+          return unsupported;
+        }
+        return {
+          _tag: "frozen",
+          backends: {
+            runs: snapshots.flatMap((snapshot) =>
+              snapshot._tag === "supported" ? [snapshot.run] : [],
+            ),
+            release,
+            retainUntilProcessExit: () => {
+              if (!released && !retained) {
+                retained = true;
+                Deferred.doneUnsafe(teardownReleased, Effect.void);
+              }
+            },
+          },
+        } as const;
+      }),
+    ).pipe(Effect.onExit((exit) => (exit._tag === "Failure" ? abort : Effect.void)));
+  });
+  return DesktopUpdateLifecycle.of({
+    tryFreeze,
+    withMutation: guarded,
+    withTeardown,
+    isRetained: Effect.sync(() => retained),
+    addOwner: (snapshot) =>
+      guarded(
+        Effect.sync(() => {
+          owners.add(snapshot);
+          return withTeardown(
+            Effect.sync(() => {
+              owners.delete(snapshot);
+            }),
+          );
+        }),
+      ),
+  });
+});
+
+export const layer = Layer.effect(DesktopUpdateLifecycle, make);
