+++ b/apps/desktop/src/backend/desktopUpdateLifecycle.test.ts
@@ -0,0 +1,143 @@
+import { assert, describe, it } from "@effect/vitest";
+import * as Deferred from "effect/Deferred";
+import * as Effect from "effect/Effect";
+import * as Fiber from "effect/Fiber";
+import * as Lifecycle from "./desktopUpdateLifecycle.ts";
+
+describe("desktop update lifecycle", () => {
+  it.effect("returns busy immediately during mutation and recovers after interruption", () =>
+    Effect.gen(function* () {
+      const lifecycle = yield* Lifecycle.make;
+      const entered = yield* Deferred.make<void>();
+      const worker = yield* lifecycle
+        .withMutation(Deferred.succeed(entered, undefined).pipe(Effect.andThen(Effect.never)))
+        .pipe(Effect.forkChild);
+      yield* Deferred.await(entered);
+      assert.equal((yield* lifecycle.tryFreeze)._tag, "busy");
+      yield* Fiber.interrupt(worker);
+      const frozen = yield* lifecycle.tryFreeze;
+      assert.equal(frozen._tag, "frozen");
+      if (frozen._tag === "frozen") yield* frozen.backends.release;
+    }),
+  );
+
+  it.effect("blocks mutation until idempotent release; interrupted waiters own no permit", () =>
+    Effect.gen(function* () {
+      const lifecycle = yield* Lifecycle.make;
+      const frozen = yield* lifecycle.tryFreeze;
+      assert.equal(frozen._tag, "frozen");
+      if (frozen._tag !== "frozen") return;
+      let ran = false;
+      const worker = yield* lifecycle
+        .withMutation(
+          Effect.sync(() => {
+            ran = true;
+          }),
+        )
+        .pipe(Effect.forkChild);
+      yield* Effect.yieldNow;
+      assert.isFalse(ran);
+      yield* Fiber.interrupt(worker);
+      yield* frozen.backends.release;
+      yield* frozen.backends.release;
+      yield* lifecycle.withMutation(
+        Effect.sync(() => {
+          ran = true;
+        }),
+      );
+      assert.isTrue(ran);
+      const next = yield* lifecycle.tryFreeze;
+      assert.equal(next._tag, "frozen");
+      if (next._tag === "frozen") yield* next.backends.release;
+    }),
+  );
+
+  it.effect("retaining a fence is synchronous and irrevocable", () =>
+    Effect.gen(function* () {
+      const lifecycle = yield* Lifecycle.make;
+      const frozen = yield* lifecycle.tryFreeze;
+      if (frozen._tag !== "frozen") return assert.fail("expected freeze");
+      frozen.backends.retainUntilProcessExit();
+      frozen.backends.retainUntilProcessExit();
+      yield* frozen.backends.release;
+      const worker = yield* lifecycle.withMutation(Effect.void).pipe(Effect.forkChild);
+      yield* Effect.yieldNow;
+      assert.isUndefined(worker.pollUnsafe());
+      assert.equal((yield* lifecycle.tryFreeze)._tag, "busy");
+      yield* Fiber.interrupt(worker);
+    }),
+  );
+
+  it.effect("returns exact owners, omits stopped owners, and releases unsupported snapshots", () =>
+    Effect.gen(function* () {
+      const lifecycle = yield* Lifecycle.make;
+      const removeSupported = yield* lifecycle.addOwner(
+        Effect.succeed({ _tag: "supported", run: { instanceId: "primary", runId: 9 } }),
+      );
+      const removeStopped = yield* lifecycle.addOwner(Effect.succeed({ _tag: "stopped" }));
+      const remove = yield* lifecycle.addOwner(
+        Effect.succeed({ _tag: "unsupported", reason: "WSL" }),
+      );
+      assert.deepEqual(yield* lifecycle.tryFreeze, { _tag: "unsupported", reason: "WSL" });
+      yield* remove;
+      const frozen = yield* lifecycle.tryFreeze;
+      if (frozen._tag !== "frozen") return assert.fail("expected freeze");
+      assert.deepEqual(frozen.backends.runs, [{ instanceId: "primary", runId: 9 }]);
+      yield* frozen.backends.release;
+      yield* removeStopped;
+      yield* removeSupported;
+    }),
+  );
+
+  it.effect("interrupted inventory collection releases the fence", () =>
+    Effect.gen(function* () {
+      const lifecycle = yield* Lifecycle.make;
+      const entered = yield* Deferred.make<void>();
+      const remove = yield* lifecycle.addOwner(
+        Deferred.succeed(entered, undefined).pipe(Effect.andThen(Effect.never)),
+      );
+      const freezing = yield* lifecycle.tryFreeze.pipe(Effect.forkChild);
+      yield* Deferred.await(entered);
+      yield* Fiber.interrupt(freezing);
+      yield* remove;
+      yield* lifecycle.withMutation(Effect.void);
+      const frozen = yield* lifecycle.tryFreeze;
+      assert.equal(frozen._tag, "frozen");
+      if (frozen._tag === "frozen") yield* frozen.backends.release;
+    }),
+  );
+});
+
+it.effect("retention wakes only teardown waiters without reopening mutation", () =>
+  Effect.gen(function* () {
+    const lifecycle = yield* Lifecycle.make;
+    const frozen = yield* lifecycle.tryFreeze;
+    if (frozen._tag !== "frozen") return assert.fail("expected freeze");
+    let tornDown = false;
+    let started = false;
+    const teardown = yield* lifecycle
+      .withTeardown(
+        Effect.sync(() => {
+          tornDown = true;
+        }),
+      )
+      .pipe(Effect.forkChild);
+    const mutation = yield* lifecycle
+      .withMutation(
+        Effect.sync(() => {
+          started = true;
+        }),
+      )
+      .pipe(Effect.forkChild);
+    yield* Effect.yieldNow;
+    assert.isFalse(tornDown);
+    assert.isFalse(started);
+    frozen.backends.retainUntilProcessExit();
+    yield* Fiber.join(teardown);
+    yield* frozen.backends.release;
+    assert.isTrue(tornDown);
+    assert.isFalse(started);
+    assert.isTrue(yield* lifecycle.isRetained);
+    yield* Fiber.interrupt(mutation);
+  }),
+);
