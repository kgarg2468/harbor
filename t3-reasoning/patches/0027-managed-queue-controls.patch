+
+/**
+ * Public stages of the server-owned managed update queue. `updating` means an
+ * activation attempt is running: cancel, retry, and a different target are
+ * rejected until it answers. A declined attempt returns to `queued`.
+ */
+export const ManagedServerUpdateStage = Schema.Literals([
+  "current",
+  "downloading",
+  "queued",
+  "updating",
+  "failed",
+]);
+export type ManagedServerUpdateStage = typeof ManagedServerUpdateStage.Type;
+
+/** Durable queue state as clients see it. Staged artifact identity and
+    persistence details stay on the server; they are not client controls. */
+export const ManagedServerUpdateState = Schema.Struct({
+  stage: ManagedServerUpdateStage,
+  installedVersion: TrimmedNonEmptyString,
+  targetVersion: TrimmedNonEmptyString,
+  /** Why the queue is where it is: a staging failure, or the last decline
+      while `queued`. Null when nothing needs explaining. */
+  reason: Schema.NullOr(TrimmedNonEmptyString),
+});
+export type ManagedServerUpdateState = typeof ManagedServerUpdateState.Type;
+
+export const ManagedServerUpdateQueueInput = Schema.Struct({
+  /** Exact t3 version, never a dist-tag. The server rejects anything else. */
+  targetVersion: TrimmedNonEmptyString,
+});
+export type ManagedServerUpdateQueueInput = typeof ManagedServerUpdateQueueInput.Type;
+
+export const ManagedServerUpdateRejectedReason = Schema.Literals([
+  "invalid-version",
+  "handoff-accepted",
+  "activation-in-progress",
+  "already-installed",
+  "nothing-to-retry",
+]);
+export type ManagedServerUpdateRejectedReason = typeof ManagedServerUpdateRejectedReason.Type;
+
+/** The queue refused the command and left its state untouched. */
+export class ManagedServerUpdateRejectedError extends Schema.TaggedErrorClass<ManagedServerUpdateRejectedError>()(
+  "ManagedServerUpdateRejectedError",
+  {
+    reason: ManagedServerUpdateRejectedReason,
+    message: TrimmedNonEmptyString,
+  },
+) {}
+
+/** The queue's durable state could not be read or written. Carries only a
+    user-safe message: never a path, cause, or artifact detail. */
+export class ManagedServerUpdateUnavailableError extends Schema.TaggedErrorClass<ManagedServerUpdateUnavailableError>()(
+  "ManagedServerUpdateUnavailableError",
+  {
+    message: TrimmedNonEmptyString,
+  },
+) {}
