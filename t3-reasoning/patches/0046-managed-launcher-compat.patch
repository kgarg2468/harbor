index 0000000000000000000000000000000000000000..011be4042cf1f1f38fab261544b08736c0fc40ab
--- /dev/null
+++ b/apps/server/src/cloud/managedServiceRuntime.ts
@@ -0,0 +1,106 @@
+// @effect-diagnostics nodeBuiltinImport:off
+// Shared with the standalone launcher; keep this module on Node built-ins.
+import * as NodeFSP from "node:fs/promises";
+import { constants } from "node:fs";
+import * as NodePath from "node:path";
+import * as NodeSea from "node:sea";
+
+const numeric = "(?:0|[1-9]\\d*)";
+const managedVersionPattern = new RegExp(
+  `^${numeric}\\.${numeric}\\.${numeric}-nightly\\.[1-9]\\d{7}\\.${numeric}\\.managed\\.(${numeric})\\.p[0-9a-f]{12}$`,
+);
+
+export function isManagedServiceVersion(version: string): boolean {
+  const match = managedVersionPattern.exec(version);
+  return match !== null && Number.isSafeInteger(Number(match[1])) && Number(match[1]) > 0;
+}
+
+export function assertPlainNodeHost(
+  versions: Readonly<Record<string, string | undefined>> = process.versions,
+  sea = NodeSea.isSea(),
+): void {
+  if (!versions.node || versions.electron || versions.bun || sea) {
+    throw new Error("Managed service runtimes require a plain Node launcher.");
+  }
+}
+
+export async function verifyManagedServiceRuntime(baseDir: string, version: string): Promise<void> {
+  if (!isManagedServiceVersion(version)) throw new Error("Invalid managed service version.");
+  assertPlainNodeHost();
+  const root = NodePath.join(baseDir, "runtime", "versions", version);
+  const identities: Array<{ file: string; dev: number; ino: number }> = [];
+  // Every component from the supplied base to the executable is owned; a
+  // symlink cannot redirect either metadata reads or the selected child.
+  const directories = [
+    baseDir,
+    NodePath.join(baseDir, "runtime"),
+    NodePath.dirname(root),
+    root,
+    NodePath.join(root, "node_modules"),
+    NodePath.join(root, "node_modules/t3"),
+    NodePath.join(root, "node_modules/t3/dist"),
+  ];
+  for (const directory of directories) {
+    const stat = await NodeFSP.lstat(directory);
+    if (!stat.isDirectory() || stat.isSymbolicLink())
+      throw new Error("Invalid managed runtime directory.");
+    identities.push({ file: directory, dev: stat.dev, ino: stat.ino });
+  }
+  const read = async (relative: string, maxBytes: number) => {
+    const file = NodePath.join(root, relative);
+    const handle = await NodeFSP.open(file, constants.O_RDONLY | constants.O_NOFOLLOW);
+    try {
+      const stat = await handle.stat();
+      if (!stat.isFile() || stat.size > maxBytes)
+        throw new Error("Invalid managed runtime metadata.");
+      identities.push({ file, dev: stat.dev, ino: stat.ino });
+      return await handle.readFile("utf8");
+    } finally {
+      await handle.close();
+    }
+  };
+  const [sentinel, packageText, recordText] = await Promise.all([
+    read(".install-complete", 512),
+    read("node_modules/t3/package.json", 1024 * 1024),
+    read(".managed-artifact.json", 16 * 1024),
+  ]);
+  const entry = await NodeFSP.lstat(NodePath.join(root, "node_modules/t3/dist/bin.mjs"));
+  if (!entry.isFile() || entry.isSymbolicLink()) throw new Error("Invalid managed runtime entry.");
+  identities.push({
+    file: NodePath.join(root, "node_modules/t3/dist/bin.mjs"),
+    dev: entry.dev,
+    ino: entry.ino,
+  });
+  const pkg = JSON.parse(packageText);
+  const record = JSON.parse(recordText);
+  const hex = (value: unknown) => typeof value === "string" && /^[0-9a-f]{64}$/.test(value);
+  if (
+    sentinel !== `${version}\n` ||
+    pkg.name !== "t3" ||
+    pkg.version !== version ||
+    Object.keys(record).length !== 11 ||
+    record.schemaVersion !== 1 ||
+    record.version !== version ||
+    record.launcherProtocol !== 2 ||
+    !["managed-server-darwin-arm64", "managed-server-linux-x64"].includes(
+      record.releaseArtifactId,
+    ) ||
+    record.platform !== process.platform ||
+    record.arch !== process.arch ||
+    record.releaseArtifactId !== `managed-server-${process.platform}-${process.arch}` ||
+    !hex(record.archiveSha256) ||
+    !hex(record.manifestSha256) ||
+    !hex(record.releaseInputSha256) ||
+    !Number.isSafeInteger(record.archiveBytes) ||
+    record.archiveBytes <= 0 ||
+    record.artifactId !== `${record.releaseArtifactId}@sha256:${record.archiveSha256}`
+  ) {
+    throw new Error("Managed runtime metadata does not match its selected version and host.");
+  }
+  for (const identity of identities) {
+    const stat = await NodeFSP.lstat(identity.file);
+    if (stat.isSymbolicLink() || stat.dev !== identity.dev || stat.ino !== identity.ino) {
+      throw new Error("Managed runtime changed during validation.");
+    }
+  }
+}
