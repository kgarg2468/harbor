+++ b/apps/server/src/cloud/managedServiceRuntime.test.ts
@@ -0,0 +1,166 @@
+// @effect-diagnostics nodeBuiltinImport:off
+import { describe, it, expect } from "@effect/vitest";
+import * as fs from "node:fs/promises";
+import * as path from "node:path";
+import * as os from "node:os";
+import { Launcher, readServiceState, writeServiceState } from "../serviceLauncher.ts";
+import {
+  assertPlainNodeHost,
+  isManagedServiceVersion,
+  verifyManagedServiceRuntime,
+} from "./managedServiceRuntime.ts";
+
+const first = "0.0.41-nightly.20260914.1722.managed.1.p0123456789ab";
+const next = "0.0.41-nightly.20260914.1722.managed.2.p0123456789ab";
+async function fixture(run: (base: string, root: string) => Promise<void>) {
+  const base = await fs.realpath(await fs.mkdtemp(path.join(os.tmpdir(), "managed-launcher-")));
+  try {
+    for (const version of [first, next]) {
+      const root = path.join(base, "runtime/versions", version);
+      await fs.mkdir(path.join(root, "node_modules/t3/dist"), { recursive: true });
+      await fs.writeFile(path.join(root, ".install-complete"), `${version}\n`);
+      await fs.writeFile(
+        path.join(root, "node_modules/t3/package.json"),
+        JSON.stringify({ name: "t3", version }),
+      );
+      await fs.writeFile(path.join(root, "node_modules/t3/dist/bin.mjs"), "process.exit(0)");
+      const releaseArtifactId = `managed-server-${process.platform}-${process.arch}`;
+      const hash = "a".repeat(64);
+      await fs.writeFile(
+        path.join(root, ".managed-artifact.json"),
+        JSON.stringify({
+          schemaVersion: 1,
+          version,
+          releaseArtifactId,
+          artifactId: `${releaseArtifactId}@sha256:${hash}`,
+          archiveSha256: hash,
+          archiveBytes: 123,
+          manifestSha256: hash,
+          releaseInputSha256: hash,
+          platform: process.platform,
+          arch: process.arch,
+          launcherProtocol: 2,
+        }),
+      );
+    }
+    await run(base, path.join(base, "runtime/versions", first));
+  } finally {
+    await fs.rm(base, { recursive: true, force: true });
+  }
+}
+
+describe("managed launcher compatibility", () => {
+  it("requires exact managed versions and plain Node", () => {
+    expect(isManagedServiceVersion(first)).toBe(true);
+    for (const value of [
+      first.replace("managed.1", "managed.0"),
+      first + ".extra",
+      "1.2.3",
+      "../" + first,
+    ]) {
+      expect(isManagedServiceVersion(value)).toBe(false);
+    }
+    expect(() => assertPlainNodeHost({ node: "24.13.1" }, false)).not.toThrow();
+    for (const versions of [{ node: "24", electron: "40" }, { node: "24", bun: "1" }, {}]) {
+      expect(() => assertPlainNodeHost(versions, false)).toThrow();
+    }
+    expect(() => assertPlainNodeHost({ node: "24" }, true)).toThrow();
+  });
+
+  for (const corruption of [
+    "version",
+    "sentinel",
+    "record",
+    "entry-symlink",
+    "directory-symlink",
+    "record-symlink",
+  ] as const) {
+    it(`rejects ${corruption} without choosing a fake archive executable`, async () =>
+      fixture(async (base, root) => {
+        await fs.writeFile(path.join(root, "t3"), "#!/bin/sh\nexit 0\n", { mode: 0o755 });
+        if (corruption === "version")
+          await fs.writeFile(
+            path.join(root, "node_modules/t3/package.json"),
+            JSON.stringify({ name: "t3", version: next }),
+          );
+        if (corruption === "sentinel")
+          await fs.writeFile(path.join(root, ".install-complete"), next + "\n");
+        if (corruption === "record")
+          await fs.writeFile(path.join(root, ".managed-artifact.json"), "{}");
+        if (corruption.endsWith("symlink")) {
+          const relative =
+            corruption === "entry-symlink"
+              ? "node_modules/t3/dist/bin.mjs"
+              : corruption === "directory-symlink"
+                ? "node_modules/t3/dist"
+                : ".managed-artifact.json";
+          const original = path.join(root, relative);
+          const target = path.join(base, "external");
+          await fs.rename(original, target);
+          await fs.symlink(target, original);
+        }
+        await expect(verifyManagedServiceRuntime(base, first)).rejects.toThrow();
+        await expect(
+          new Launcher(base, { protocol: 2, activeVersion: first }).run(),
+        ).rejects.toThrow();
+      }));
+  }
+
+  for (const scenario of ["start", "commit", "rollback", "recover"] as const) {
+    it(`runs managed Node children through ${scenario}`, async () =>
+      fixture(async (base) => {
+        const statePath = path.join(base, "runtime/service-state.json");
+        const database = path.join(base, "userdata/state.sqlite");
+        await fs.mkdir(path.dirname(database));
+        await fs.writeFile(database, "original");
+        const marker = path.join(base, "children.jsonl");
+        const source = `
+import fs from "node:fs";
+const context = JSON.parse(process.env.T3_SERVICE_LAUNCHER_CONTEXT);
+fs.appendFileSync(${JSON.stringify(marker)}, JSON.stringify({version:context.childVersion, args:process.argv.slice(2)}) + "\\n");
+if (context.update?.status === "pending") {
+ process.send({type:"prepared",updateId:${scenario === "rollback" ? '"wrong"' : "context.update.id"}});
+ process.on("message", message => {if(message.type === "committed") process.exit(0)});
+} else if (!context.update && ${JSON.stringify(scenario !== "start")}) {
+ process.send({type:"request-update",targetVersion:${JSON.stringify(next)},dbPath:${JSON.stringify(database)}});
+ setInterval(()=>{},1000);
+} else process.exit(0);
+`;
+        for (const version of [first, next])
+          await fs.writeFile(
+            path.join(base, "runtime/versions", version, "node_modules/t3/dist/bin.mjs"),
+            source,
+          );
+        await writeServiceState(statePath, {
+          protocol: 2,
+          activeVersion: first,
+          ...(scenario === "recover"
+            ? {
+                update: {
+                  id: "recovery",
+                  status: "pending" as const,
+                  fromVersion: first,
+                  targetVersion: next,
+                  dbPath: database,
+                },
+              }
+            : {}),
+        });
+        await expect(new Launcher(base, await readServiceState(statePath)).run()).rejects.toThrow();
+        const children = (await fs.readFile(marker, "utf8"))
+          .trim()
+          .split("\n")
+          .map((line) => JSON.parse(line));
+        expect(children.length).toBeGreaterThan(0);
+        expect(
+          children.every((child) => child.args.length === 1 && child.args[0] === "serve"),
+        ).toBe(true);
+        const state = await readServiceState(statePath);
+        expect(state.activeVersion).toBe(
+          scenario === "commit" || scenario === "recover" ? next : first,
+        );
+        if (scenario !== "start")
+          expect(state.update?.status).toBe(scenario === "rollback" ? "rolled-back" : "committed");
+      }));
+  }
+});
