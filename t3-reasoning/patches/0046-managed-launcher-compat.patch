@@ -0,0 +1,18 @@
+// @effect-diagnostics nodeBuiltinImport:off
+// Standalone entry for managed Node runtimes; executable builds use the
+// __service-launcher subcommand instead. Importing this module does not start it.
+import { resolve } from "node:path";
+import { pathToFileURL } from "node:url";
+
+import { main } from "./serviceLauncher.ts";
+
+if (process.argv[1] && import.meta.url === pathToFileURL(resolve(process.argv[1])).href) {
+  main().catch((cause: unknown) => {
+    const category = cause instanceof Error ? cause.name : "UnknownError";
+    const message = cause instanceof Error ? cause.message : String(cause);
+    process.stderr.write(
+      `[service-launcher] ${category.slice(0, 80)}: ${message.replace(/[\r\n]/g, " ").slice(0, 512)}\n`,
+    );
+    process.exitCode = 1;
+  });
+}
