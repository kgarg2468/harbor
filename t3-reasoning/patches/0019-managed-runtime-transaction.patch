+// --- archive fixture ------------------------------------------------------------------
+
+const BLOCK = 512;
+const PKG = "node_modules/t3";
+
+function pad(buffer: Buffer, unit = BLOCK): Buffer {
+  const remainder = buffer.length % unit;
+  return remainder === 0 ? buffer : Buffer.concat([buffer, Buffer.alloc(unit - remainder)]);
+}
+
+function member(spec: {
+  readonly path: string;
+  readonly type?: HeaderData["type"];
+  readonly body?: string | Buffer;
+  readonly linkpath?: string;
+  readonly mode?: number;
+}): Buffer {
+  const body =
+    spec.body === undefined
+      ? Buffer.alloc(0)
+      : Buffer.isBuffer(spec.body)
+        ? spec.body
+        : Buffer.from(spec.body);
+  const type = spec.type ?? "File";
+  const header = new Header({
+    // @effect-diagnostics-next-line globalDate:off - tar headers carry a plain mtime
+    mtime: new Date(0),
+    uid: 0,
+    gid: 0,
+    uname: "",
+    gname: "",
+    path: spec.path,
+    type,
+    size: body.length,
+    ...(spec.linkpath === undefined ? {} : { linkpath: spec.linkpath }),
+    mode: spec.mode ?? 0o644,
+  });
+  header.encode();
+  return Buffer.concat([Buffer.from(header.block as Buffer), pad(body)]);
+}
+
+function machOArm64(): Buffer {
+  const head = Buffer.alloc(32);
+  head.writeUInt32LE(0xfeedfacf, 0);
+  head.writeUInt32LE(0x0100000c, 4);
+  head.writeUInt32LE(2, 12);
+  return head;
+}
+
+function elfX64(): Buffer {
+  const head = Buffer.from([0x7f, 0x45, 0x4c, 0x46, 2, 1, 1, 0, ...Buffer.alloc(24)]);
+  head.writeUInt16LE(3, 16);
+  head.writeUInt16LE(0x3e, 18);
+  return head;
+}
+
+const DEP_DIR = `${PKG}/node_modules/.pnpm/dep@1.0.0/node_modules/dep`;
+const DEP_LINK = ".pnpm/dep@1.0.0/node_modules/dep";
+
+function buildArchive(
+  overrides: { readonly packageVersion?: string; readonly monitor?: Buffer } = {},
+): Buffer {
+  const tar = Buffer.concat([
+    member({
+      path: `${PKG}/package.json`,
+      body: JSON.stringify({ name: "t3", version: overrides.packageVersion ?? VERSION }),
+    }),
+    member({ path: `${PKG}/dist/bin.mjs`, body: "#!/usr/bin/env node\n", mode: 0o755 }),
+    member({ path: `${PKG}/dist/service-launcher.mjs`, body: "export {};\n" }),
+    member({ path: `${PKG}/dist/client/index.html`, body: "<!doctype html>\n" }),
+    member({
+      path: `${PKG}/dist/resource-monitor/darwin-arm64/t3-resource-monitor`,
+      body: overrides.monitor ?? machOArm64(),
+      mode: 0o755,
+    }),
+    member({ path: `${DEP_DIR}/index.js`, body: "module.exports = 1;\n" }),
+    member({ path: `${PKG}/node_modules/dep`, type: "SymbolicLink", linkpath: DEP_LINK }),
+    Buffer.alloc(2 * BLOCK),
+  ]);
+  return NodeZlib.gzipSync(pad(tar, 10240));
+}
+
+const ARCHIVE = buildArchive();
+
+// --- fakes ----------------------------------------------------------------------------
+
+interface Hold {
+  readonly entered: Deferred.Deferred<string>;
+  readonly release: Deferred.Deferred<void>;
+}
+
+const hold = (): Hold => ({
+  entered: Deferred.makeUnsafe<string>(),
+  release: Deferred.makeUnsafe<void>(),
+});
+
+/** A promise-level hold for a mocked filesystem call: `entered` settles when the call starts, `release` lets it finish. */
+function gate() {
+  let enter!: () => void;
+  let release!: () => void;
+  const entered = new Promise<void>((resolve) => {
+    enter = resolve;
+  });
+  const released = new Promise<void>((resolve) => {
+    release = resolve;
+  });
+  return { entered, released, enter, release };
+}
+
+/** Blocks until released; interruption also waits for release, like a child that has not yet exited. */
+const heldUntil = (held: Hold, entered: string) =>
+  Deferred.succeed(held.entered, entered).pipe(
+    Effect.andThen(Deferred.await(held.release)),
+    Effect.onInterrupt(() => Deferred.await(held.release)),
+  );
+
+interface CandidateCall {
+  readonly kind: string;
+  readonly entryPath?: string;
+  readonly snapshotPath?: string;
+}
+
+function output(stdout: string, code = 0): ManagedCandidateOutput {
+  return {
+    code,
+    signal: null,
+    stdout,
+    stderr: "",
+    stdoutTruncated: false,
+    stderrTruncated: false,
+    stdoutInvalidUtf8: false,
+    stderrInvalidUtf8: false,
+    timedOut: false,
+  };
+}
+
+const READY_PREFLIGHT = `${JSON.stringify({ status: "ready", version: VERSION, launcherProtocol: SERVICE_LAUNCHER_PROTOCOL })}\n`;
+const READY_MIGRATION = `${JSON.stringify({ preflightProtocol: MIGRATION_PREFLIGHT_PROTOCOL, version: VERSION, launcherProtocol: SERVICE_LAUNCHER_PROTOCOL, status: "ready" })}\n`;
+
+function fakeCandidate(
+  overrides: {
+    readonly identity?: Partial<ManagedNodeIdentity>;
+    readonly stdout?: Partial<Record<string, string>>;
+    readonly holdKind?: string;
+    readonly onMigration?: (snapshotPath: string) => Promise<void>;
+  } = {},
+) {
+  const calls: Array<CandidateCall> = [];
+  const held = hold();
+  const identity: ManagedNodeIdentity = {
+    version: MANAGED_CANDIDATE_NODE_VERSION,
+    modulesAbi: "137",
+    platform: "darwin",
+    arch: "arm64",
+    glibcVersionRuntime: undefined,
+    ...overrides.identity,
+  };
+  const stdout: Record<string, string> = {
+    version: `t3 v${VERSION}\n`,
+    "service-preflight": READY_PREFLIGHT,
+    "migration-preflight": READY_MIGRATION,
+    ...overrides.stdout,
+  };
+  const candidate: ManagedCandidateProcess = {
+    inspectNode: Effect.suspend(() => {
+      calls.push({ kind: "inspect-node" });
+      return overrides.holdKind === "inspect-node"
+        ? heldUntil(held, "").pipe(Effect.as(identity))
+        : Effect.succeed(identity);
+    }),
+    run: (input) =>
+      Effect.suspend(() => {
+        const operation = input.operation;
+        calls.push({
+          kind: operation.kind,
+          entryPath: input.entryPath,
+          ...(operation.kind === "migration-preflight"
+            ? { snapshotPath: operation.snapshotPath }
+            : {}),
+        });
+        const result = Effect.succeed(output(stdout[operation.kind] as string));
+        const observed =
+          operation.kind === "migration-preflight" && overrides.onMigration !== undefined
+            ? Effect.promise(() => overrides.onMigration?.(operation.snapshotPath) as Promise<void>)
+            : Effect.void;
+        return overrides.holdKind === operation.kind
+          ? heldUntil(held, input.entryPath).pipe(Effect.andThen(observed), Effect.andThen(result))
+          : observed.pipe(Effect.andThen(result));
+      }),
+  };
+  return { candidate, calls, held, kinds: () => calls.map((call) => call.kind) };
+}
+
+function fakeMigration(
+  overrides: {
+    readonly onProbe?: (probe: ManagedMigrationProbe) => Promise<void>;
+    readonly held?: Hold;
+    readonly reject?: string;
+  } = {},
+) {
+  const probes: Array<ManagedMigrationProbe> = [];
+  const validate: ManagedMigrationValidator = (probe) =>
+    Effect.gen(function* () {
+      probes.push(probe);
+      if (overrides.onProbe !== undefined) {
+        yield* Effect.promise(() => overrides.onProbe?.(probe) as Promise<void>);
+      }
+      if (overrides.held !== undefined) yield* heldUntil(overrides.held, probe.entryPath);
+      if (overrides.reject !== undefined) {
+        return yield* new ManagedRuntimeStageError({
+          step: "rehearsing migrations",
+          reason: overrides.reject,
+        });
+      }
+    });
+  return { validate, probes };
+}
+
+function chunked(bytes: Buffer, size = 1000): Array<Uint8Array> {
+  const chunks: Array<Uint8Array> = [];
+  for (let offset = 0; offset < bytes.length; offset += size) {
+    chunks.push(new Uint8Array(bytes.subarray(offset, offset + size)));
+  }
+  return chunks;
+}
+
+function fakeSource(
+  overrides: {
+    readonly documents?: ManagedReleaseDocuments;
+    readonly body?: Buffer;
+    readonly hangAfterFirstChunk?: Deferred.Deferred<void>;
+  } = {},
+) {
+  const state = { documentReads: 0, opened: 0, closed: 0 };
+  const documents = overrides.documents ?? documentsFor(ARCHIVE);
+  const chunks = chunked(overrides.body ?? ARCHIVE);
+  const source: ManagedArtifactSource = {
+    readDocuments: () =>
+      Effect.sync(() => {
+        state.documentReads += 1;
+        return documents;
+      }),
+    openArchive: () =>
+      Effect.gen(function* () {
+        state.opened += 1;
+        yield* Effect.addFinalizer(() =>
+          Effect.sync(() => {
+            state.closed += 1;
+          }),
+        );
+        const hang = overrides.hangAfterFirstChunk;
+        return hang === undefined
+          ? Stream.fromIterable(chunks)
+          : Stream.concat(
+              Stream.fromIterable(chunks.slice(0, 1)),
+              Stream.fromEffect(Deferred.await(hang)).pipe(
+                Stream.flatMap(() => Stream.fromIterable(chunks.slice(1))),
+              ),
+            );
+      }),
+  };
+  return { source, state };
+}
+
+// --- harness --------------------------------------------------------------------------
+
+const exists = (path: string) =>
+  NodeFSP.lstat(path).then(
+    () => true,
+    () => false,
+  );
+
+const isPending = (fiber: Fiber.Fiber<unknown, unknown>) =>
+  Effect.yieldNow.pipe(Effect.map(() => fiber.pollUnsafe() === undefined));
+
+const setup = Effect.fn("setup")(function* (
+  overrides: {
+    readonly candidate?: ReturnType<typeof fakeCandidate>;
+    readonly migration?: ReturnType<typeof fakeMigration>;
+    readonly source?: ReturnType<typeof fakeSource>;
+  } = {},
+) {
+  const fs = yield* FileSystem.FileSystem;
+  const root = yield* fs.makeTempDirectoryScoped({ prefix: "managed-runtime-" });
+  const baseDir = NodePath.join(root, "base");
+  yield* Effect.promise(() => NodeFSP.mkdir(baseDir));
+  const realBase = yield* Effect.promise(() => NodeFSP.realpath(baseDir));
+  const versionsDir = NodePath.join(realBase, "runtime", "versions");
+  const versionDir = NodePath.join(versionsDir, VERSION);
+  const entryPath = NodePath.join(versionDir, "node_modules", "t3", "dist", "bin.mjs");
+  const candidate = overrides.candidate ?? fakeCandidate();
+  const migration = overrides.migration ?? fakeMigration();
+  const source = overrides.source ?? fakeSource();
+  const stager = yield* makeManagedRuntimeStager({
+    baseDir,
+    hostTarget: DARWIN,
+    candidate: candidate.candidate,
+    source: source.source,
+    validateMigration: migration.validate,
+  });
+  return { baseDir, versionsDir, versionDir, entryPath, candidate, migration, source, stager };
+});
+
+type Harness = Effect.Success<ReturnType<typeof setup>>;
+
+/** A second stager over the same base directory, sharing the harness fakes unless overridden. */
+const sibling = (
+  harness: Harness,
+  overrides: {
+    readonly candidate?: ManagedCandidateProcess;
+    readonly validateMigration?: ManagedMigrationValidator;
+  } = {},
+) =>
+  makeManagedRuntimeStager({
+    baseDir: harness.baseDir,
+    hostTarget: DARWIN,
+    candidate: overrides.candidate ?? harness.candidate.candidate,
+    source: harness.source.source,
+    validateMigration: overrides.validateMigration ?? harness.migration.validate,
+  });
+
+/** Every probe entry lives in a private staging payload, never in the published version directory. */
+const assertPrivateEntry = (harness: Harness, entryPath: string | undefined, label: string) => {
+  assert.isDefined(entryPath, label);
+  assert.notStrictEqual(entryPath, harness.entryPath, label);
+  assert.isTrue(entryPath.startsWith(`${harness.versionsDir}/.staging-`), `${label}: ${entryPath}`);
+  assert.isTrue(
+    entryPath.endsWith("/payload/node_modules/t3/dist/bin.mjs"),
+    `${label}: ${entryPath}`,
+  );
+  assert.isFalse(entryPath.startsWith(`${harness.versionDir}/`), `${label}: ${entryPath}`);
+};
+
+const expectedArtifactId = `managed-server-darwin-arm64@sha256:${sha256Hex(ARCHIVE)}`;
+
+const failure = (stager: ManagedRuntimeStager, version = VERSION) =>
+  stager.stage(version).pipe(
+    Effect.flip,
+    Effect.map((error) => ({ step: error.step, reason: error.reason })),
+  );
+
+/** After a refused staging nothing may remain beside published versions: no staging directory. */
+const onlyPublished = async (versionsDir: string, ...published: Array<string>) => {
+  const entries = (await exists(versionsDir)) ? await NodeFSP.readdir(versionsDir) : [];
+  assert.deepStrictEqual(entries.sort(), [...published].sort());
+};
+
+/** Writes a fully published-looking version directory by hand, for refusal and reuse tests. */
+async function writePublished(
+  versionDir: string,
+  parts: { readonly sentinel?: string; readonly record?: unknown },
+): Promise<void> {
+  await NodeFSP.mkdir(NodePath.join(versionDir, "node_modules", "t3", "dist"), {
+    recursive: true,
+  });
+  await NodeFSP.writeFile(NodePath.join(versionDir, "node_modules", "t3", "dist", "bin.mjs"), "x");
+  if (parts.sentinel !== undefined) {
+    await NodeFSP.writeFile(
+      NodePath.join(versionDir, MANAGED_INSTALL_SENTINEL_FILE),
+      parts.sentinel,
+    );
+  }
+  if (parts.record !== undefined) {
+    await NodeFSP.writeFile(
+      NodePath.join(versionDir, MANAGED_ARTIFACT_RECORD_FILE),
+      JSON.stringify(parts.record),
+    );
+  }
+}
+
+/** Every file's mode and bytes and every symlink's target below `root`, in a stable order. */
+async function snapshotTree(root: string): Promise<Array<[string, string]>> {
+  const entries: Array<[string, string]> = [];
+  const pending = [root];
+  while (pending.length > 0) {
+    const directory = pending.pop() as string;
+    for (const entry of await NodeFSP.readdir(directory, { withFileTypes: true })) {
+      const absolute = NodePath.join(directory, entry.name);
+      if (entry.isDirectory()) {
+        pending.push(absolute);
+      } else if (entry.isSymbolicLink()) {
+        entries.push([absolute, `link:${await NodeFSP.readlink(absolute)}`]);
+      } else {
+        const mode = ((await NodeFSP.lstat(absolute)).mode & 0o777).toString(8);
+        entries.push([absolute, `${mode}:${await NodeFSP.readFile(absolute, "utf8")}`]);
+      }
+    }
+  }
+  return entries.sort();
+}
+
+const clearLayoutTrace = () => {
+  vi.mocked(NodeFSP.mkdir).mockClear();
+  vi.mocked(NodeFSP.open).mockClear();
+  vi.mocked(NodeFSP.rename).mockClear();
+};
+
+/**
+ * The order of layout-parent creation and sync, record and sentinel creation,
+ * and the publishing rename since the last `clearLayoutTrace`, as
+ * `<op> <label>` strings. Parents are labelled `base`, `runtime`, `versions`.
+ */
+function layoutTrace(harness: Harness): Array<string> {
+  const runtimeDir = NodePath.dirname(harness.versionsDir);
+  const realBase = NodePath.dirname(runtimeDir);
+  const mkdir = vi.mocked(NodeFSP.mkdir);
+  const open = vi.mocked(NodeFSP.open);
+  const rename = vi.mocked(NodeFSP.rename);
+  const label = (path: string) =>
+    path === realBase
+      ? "base"
+      : path === runtimeDir
+        ? "runtime"
+        : path === harness.versionsDir
+          ? "versions"
+          : NodePath.basename(path);
+  const watched = new Set([
+    "base",
+    "runtime",
+    "versions",
+    MANAGED_ARTIFACT_RECORD_FILE,
+    MANAGED_INSTALL_SENTINEL_FILE,
+  ]);
