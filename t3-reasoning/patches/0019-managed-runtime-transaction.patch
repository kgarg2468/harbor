+import { SERVICE_LAUNCHER_FILE, SERVICE_LAUNCHER_PROTOCOL } from "./serviceProtocol.ts";
+
+/**
+ * Stages one exact managed release into the pinned runtime directory as an
+ * immutable transaction: authenticate the release documents, download and
+ * hash the archive into an exclusively owned file, extract it into a private
+ * sibling directory, prove the extracted server with isolated candidate
+ * probes and a migration rehearsal on a fresh snapshot, then publish with a
+ * single rename after the content record and the sentinel are durable.
+ *
+ * A version directory that already exists is never modified: it is either
+ * exactly the release being staged (same sentinel and content record) and is
+ * re-proven in full, or it is refused untouched. Nothing here installs from
+ * npm, accepts a version-only sentinel, or removes an incomplete directory.
+ */
+
+export const MANAGED_ARTIFACT_RECORD_FILE = ".managed-artifact.json";
+export const MANAGED_INSTALL_SENTINEL_FILE = ".install-complete";
+export const MANAGED_ARTIFACT_RECORD_SCHEMA_VERSION = 1;
+/** Root command name; the CLI prints `<name> v<version>` for `--version` on a non-TTY stdout. */
+const CLI_NAME = "t3";
+const PACKAGE_DIR = "node_modules/t3";
+const PACKAGE_NAME = "t3";
+const STAGING_PREFIX = ".staging-";
+const PAYLOAD_DIR = "payload";
+const ARCHIVE_FILE = "archive.tar.gz";
+const MAX_RECORD_BYTES = 64 * 1024;
+const MAX_SENTINEL_BYTES = 4 * 1024;
+const MAX_PACKAGE_JSON_BYTES = 1024 * 1024;
+const HEADER_BYTES = 64;
+const READ_CHUNK_BYTES = 64 * 1024;
+const PERMISSION_BITS = 0o7777;
+const MH_MAGIC_64 = 0xfeedfacf;
