+/** Opens without following a final symlink; the caller owns the handle. */
+function openNoFollow(target: string): Promise<NodeFSP.FileHandle> {
+  return NodeFSP.open(target, NodeFS.constants.O_RDONLY | NodeFS.constants.O_NOFOLLOW);
+}
+
+async function readBounded(step: string, target: string, maxBytes: number): Promise<Buffer> {
+  const handle = await openNoFollow(target);
+  try {
+    const stats = await handle.stat();
+    if (!stats.isFile()) throw stageError(step, `${target} is not a regular file`);
+    if (stats.size > maxBytes) throw stageError(step, `${target} is larger than ${maxBytes} bytes`);
+    const buffer = Buffer.alloc(stats.size);
+    let offset = 0;
+    while (offset < buffer.length) {
+      const { bytesRead } = await handle.read(buffer, offset, buffer.length - offset, offset);
+      if (bytesRead === 0) throw stageError(step, `${target} changed while reading`);
+      offset += bytesRead;
+    }
+    return buffer;
+  } finally {
+    await handle.close();
+  }
+}
+
+async function readHeader(target: string): Promise<Buffer> {
+  const handle = await openNoFollow(target);
+  try {
+    const buffer = Buffer.alloc(HEADER_BYTES);
+    const { bytesRead } = await handle.read(buffer, 0, HEADER_BYTES, 0);
+    return buffer.subarray(0, bytesRead);
+  } finally {
+    await handle.close();
+  }
+}
+
+/** Reads a regular file of any size through `onChunk`, never following a final symlink. */
+async function readChunks(
+  target: string,
+  onChunk: (chunk: Buffer) => Promise<void>,
+): Promise<void> {
+  const handle = await openNoFollow(target);
+  try {
+    const buffer = Buffer.allocUnsafe(READ_CHUNK_BYTES);
+    for (;;) {
+      const { bytesRead } = await handle.read(buffer, 0, buffer.length, null);
+      if (bytesRead === 0) return;
+      await onChunk(buffer.subarray(0, bytesRead));
+    }
+  } finally {
+    await handle.close();
+  }
+}
+
+async function writeAll(handle: NodeFSP.FileHandle, bytes: Uint8Array): Promise<void> {
+  let offset = 0;
+  while (offset < bytes.byteLength) {
+    const { bytesWritten } = await handle.write(bytes, offset, bytes.byteLength - offset);
+    offset += bytesWritten;
+  }
+}
+
+function decodeUtf8Strict(step: string, bytes: Uint8Array, label: string): string {
+  try {
+    return new TextDecoder("utf-8", { fatal: true, ignoreBOM: true }).decode(bytes);
+  } catch {
+    throw stageError(step, `${label} is not valid UTF-8`);
+  }
+}
+
+/** Strict UTF-8 then JSON; the shape is decoded by the caller's schema. */
+function parseJsonDocument(step: string, bytes: Uint8Array, label: string): unknown {
+  const text = decodeUtf8Strict(step, bytes, label);
+  try {
+    return JSON.parse(text) as unknown;
+  } catch {
+    throw stageError(step, `${label} is not valid JSON`);
+  }
+}
+
+function parseJsonLine(line: string): unknown | undefined {
+  try {
+    return JSON.parse(line) as unknown;
+  } catch {
+    return undefined;
+  }
+}
+
+const quote = (value: string): string => JSON.stringify(value);
+
+/** Creates the file exclusively, writes it whole, and fsyncs it before closing. */
+async function writeExclusiveSynced(target: string, content: string): Promise<void> {
+  const handle = await NodeFSP.open(
+    target,
+    NodeFS.constants.O_WRONLY |
+      NodeFS.constants.O_CREAT |
+      NodeFS.constants.O_EXCL |
+      NodeFS.constants.O_NOFOLLOW,
+    0o600,
+  );
+  try {
+    const bytes = Buffer.from(content, "utf8");
+    let offset = 0;
+    while (offset < bytes.length) {
+      const { bytesWritten } = await handle.write(bytes, offset, bytes.length - offset);
+      offset += bytesWritten;
+    }
+    await handle.sync();
+  } finally {
+    await handle.close();
+  }
+}
+
+async function syncPath(target: string): Promise<void> {
+  const handle = await openNoFollow(target);
+  try {
+    await handle.sync();
+  } finally {
+    await handle.close();
+  }
+}
