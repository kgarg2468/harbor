+// --- filesystem primitives --------------------------------------------------------------
+
+async function lstatOrUndefined(target: string): Promise<NodeFS.Stats | undefined> {
+  try {
+    return await NodeFSP.lstat(target);
+  } catch (error) {
+    if (isEnoent(error)) return undefined;
+    throw error;
+  }
+}
