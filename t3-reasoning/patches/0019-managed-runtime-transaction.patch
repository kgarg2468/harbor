+  const stats = yield* fsStep(step, () => lstatOrUndefined(paths.versionDir));
+  if (stats === undefined) return { kind: "absent" } as ExistingVersion;
+  if (!stats.isDirectory()) {
+    return yield* stageError(step, `${paths.versionDir} exists but is not a directory`);
+  }
+  const sentinel = yield* fsStep(step, async () => {
+    const stats = await lstatOrUndefined(paths.sentinelPath);
+    if (stats === undefined)
+      throw stageError(step, "the version directory has no install sentinel");
+    if (!stats.isFile()) throw stageError(step, "the install sentinel is not a regular file");
+    return readBounded(step, paths.sentinelPath, MAX_SENTINEL_BYTES);
+  });
+  if (!sentinel.equals(Buffer.from(`${version}\n`, "utf8"))) {
+    return yield* stageError(step, "the install sentinel does not name this exact version");
+  }
+  const recordPath = NodePath.join(paths.versionDir, MANAGED_ARTIFACT_RECORD_FILE);
+  const parsed = yield* fsStep(step, async () => {
+    const stats = await lstatOrUndefined(recordPath);
+    if (stats === undefined) {
+      throw stageError(step, "the version directory has no managed artifact record");
+    }
+    if (!stats.isFile())
+      throw stageError(step, "the managed artifact record is not a regular file");
+    return parseJsonDocument(
+      step,
+      await readBounded(step, recordPath, MAX_RECORD_BYTES),
+      "the managed artifact record",
+    );
+  });
+  const record = yield* decodeRecord(parsed, { onExcessProperty: "error" }).pipe(
+    Effect.mapError((error) =>
+      stageError(step, `the managed artifact record is malformed: ${error.message}`),
+    ),
+  );
+  if (record.version !== version) {
+    return yield* stageError(step, "the managed artifact record names a different version");
+  }
+  return { kind: "present", record } as ExistingVersion;
+});
+
+// --- candidate probes -------------------------------------------------------------------
+
+const candidateFailure =
+  (step: string) =>
+  (error: ManagedCandidateError): ManagedRuntimeStageError =>
+    stageError(step, error.message, error);
+
+/** Node identity, exact `--version`, and the service identity probe. */
+const probeCandidate = Effect.fn("cloud.managed_runtime.probe_candidate")(function* (input: {
+  readonly candidate: ManagedCandidateProcess;
+  readonly hostTarget: ManagedServerTarget;
+  readonly entryPath: string;
+  readonly version: string;
+}) {
+  const identity = yield* input.candidate.inspectNode.pipe(
+    Effect.mapError(candidateFailure("inspecting the candidate Node runtime")),
+  );
+  if (identity.platform !== input.hostTarget.platform || identity.arch !== input.hostTarget.arch) {
+    return yield* stageError(
+      "inspecting the candidate Node runtime",
+      `Node runs on ${identity.platform}-${identity.arch}, not the selected ${input.hostTarget.platform}-${input.hostTarget.arch}`,
+    );
+  }
+
+  const versionStep = "checking the candidate version";
+  const versionOutput = yield* input.candidate
+    .run({ entryPath: input.entryPath, operation: { kind: "version" } })
+    .pipe(Effect.mapError(candidateFailure(versionStep)));
+  if (versionOutput.code !== 0) {
+    return yield* stageError(versionStep, `exited with code ${versionOutput.code}`);
+  }
+  const expectedVersionLine = `${CLI_NAME} v${input.version}\n`;
+  if (versionOutput.stdout !== expectedVersionLine) {
+    return yield* stageError(
+      versionStep,
+      `printed ${quote(versionOutput.stdout)} instead of ${quote(expectedVersionLine)}`,
+    );
+  }
+
+  const preflightStep = "checking the candidate service identity";
+  const preflight = yield* input.candidate
+    .run({ entryPath: input.entryPath, operation: { kind: "service-preflight" } })
+    .pipe(Effect.mapError(candidateFailure(preflightStep)));
+  if (preflight.code !== 0) {
+    return yield* stageError(preflightStep, `exited with code ${preflight.code}`);
+  }
+  const lines = preflight.stdout.split("\n");
+  if (lines.length !== 2 || lines[1] !== "") {
+    return yield* stageError(preflightStep, "did not print exactly one line");
+  }
+  const parsed = parseJsonLine(lines[0] as string);
+  if (parsed === undefined) return yield* stageError(preflightStep, "output is not JSON");
+  const result = decodeServicePreflightResult(parsed);
+  if (result === undefined) {
+    return yield* stageError(preflightStep, "output is not a service preflight result");
+  }
+  if (result.status !== "ready") return yield* stageError(preflightStep, result.reason);
+  if (result.version !== input.version) {
+    return yield* stageError(preflightStep, `reported version ${result.version}`);
+  }
+  if (result.launcherProtocol !== SERVICE_LAUNCHER_PROTOCOL) {
+    return yield* stageError(
+      preflightStep,
+      `reported launcher protocol ${result.launcherProtocol}`,
+    );
+  }
+});
+
+/**
+ * The production migration validator: snapshots the live database through
+ * the existing helper, runs the candidate's migration rehearsal against that
+ * snapshot only, and accepts the result with the existing acceptance rule.
+ * The runner never sees the live path.
+ */
+export const makeSnapshotMigrationValidator = Effect.fn(
+  "cloud.managed_runtime.make_snapshot_migration_validator",
+)(function* (input: {
+  readonly liveDatabasePath: string;
+  readonly candidate: ManagedCandidateProcess;
+}) {
+  const fs = yield* FileSystem.FileSystem;
+  const path = yield* Path.Path;
+  const step = "rehearsing migrations on a database snapshot";
+  const validator: ManagedMigrationValidator = (probe) =>
+    withMigrationSnapshot({
+      liveDatabasePath: input.liveDatabasePath,
+      use: (snapshotPath) =>
+        input.candidate
+          .run({
+            entryPath: probe.entryPath,
+            operation: { kind: "migration-preflight", snapshotPath },
+          })
+          .pipe(
+            Effect.mapError(candidateFailure(step)),
+            Effect.flatMap((output) => {
+              const acceptance = acceptMigrationPreflightOutput({
+                output,
+                expectedVersion: probe.version,
+                expectedLauncherProtocol: SERVICE_LAUNCHER_PROTOCOL,
+              });
+              return acceptance.accepted
+                ? Effect.void
+                : Effect.fail(stageError(step, acceptance.reason));
+            }),
+          ),
+    }).pipe(
+      Effect.catchTag("MigrationSnapshotError", (error) =>
+        Effect.fail(stageError("preparing the migration snapshot", error.message, error)),
+      ),
+      Effect.provideService(FileSystem.FileSystem, fs),
+      Effect.provideService(Path.Path, path),
+    );
+  return validator;
+});
+
+// --- directories ------------------------------------------------------------------------
+
+interface RuntimeLayout {
+  /** Canonical base; ordinary outer aliases such as /tmp -> /private/tmp are resolved here. */
+  readonly baseDir: string;
+  readonly versionsDir: string;
+}
+
+/**
+ * Canonicalizes the base and requires `runtime` and `runtime/versions` to be
+ * real directories directly under it; a symlink there would redirect the
+ * install and is refused. Missing parents are created privately. When
+ * creating is allowed, the directory holding each entry is synced on every
+ * resolution, not only after a mkdir: an entry left behind by an attempt
+ * whose parent sync failed would otherwise never be anchored, and a later
+ * install could publish on top of it without durable ancestry. The
+ * read-only resolution used to verify a staged runtime syncs nothing.
+ */
+async function resolveLayout(baseDir: string, create: boolean): Promise<RuntimeLayout> {
+  const step = "preparing the managed runtime directories";
+  if (!NodePath.isAbsolute(baseDir)) throw stageError(step, "base directory is not absolute");
+  const realBase = await NodeFSP.realpath(baseDir);
+  const runtimeDir = NodePath.join(realBase, "runtime");
+  const versionsDir = NodePath.join(runtimeDir, "versions");
+  for (const [parent, directory] of [
+    [realBase, runtimeDir],
+    [runtimeDir, versionsDir],
+  ] as const) {
+    let stats = await lstatOrUndefined(directory);
+    if (stats === undefined) {
+      if (!create) throw stageError(step, `${directory} does not exist`);
+      await NodeFSP.mkdir(directory, { mode: 0o700 });
+      stats = await NodeFSP.lstat(directory);
+    }
+    if (!stats.isDirectory()) throw stageError(step, `${directory} is not a real directory`);
+    if (create) await syncPath(parent);
+  }
+  return { baseDir: realBase, versionsDir };
+}
+
+/**
+ * A private transaction directory beside the version directories. Creation is
+ * one uninterruptible acquisition: a directory whose chmod fails is removed by
+ * the acquire itself, and once acquired it is removed when the scope closes,
+ * which is only after everything running inside it has settled.
+ */
+const acquireStagingDirectory = (versionsDir: string) =>
+  Effect.acquireRelease(
+    fsStep("creating the staging directory", async () => {
+      const directory = await NodeFSP.mkdtemp(NodePath.join(versionsDir, STAGING_PREFIX));
+      try {
+        await NodeFSP.chmod(directory, 0o700);
+      } catch (error) {
+        await NodeFSP.rm(directory, { recursive: true, force: true }).catch(() => {});
+        throw error;
+      }
+      return directory;
+    }),
+    (directory) =>
+      Effect.promise(() => NodeFSP.rm(directory, { recursive: true, force: true }).catch(() => {})),
+  );
+
+// --- stager -----------------------------------------------------------------------------
+
+export const makeManagedRuntimeStager = Effect.fn("cloud.managed_runtime.make")(function* (
+  options: ManagedRuntimeStagerOptions,
+) {
+  const path = yield* Path.Path;
+  const archiveLimits: ManagedRuntimeArchiveLimits = {
+    ...DEFAULT_MANAGED_RUNTIME_ARCHIVE_LIMITS,
+    ...options.archiveLimits,
+  };
+  const requiredFiles = managedRuntimeRequiredFiles(options.hostTarget);
+
+  const validateVersion = (step: string, version: string) =>
+    parseManagedReleaseVersion(version) === undefined
+      ? Effect.fail(stageError(step, `${JSON.stringify(version)} is not a managed release version`))
+      : Effect.void;
+
+  /** Tree and required-file proof of a runtime rooted at `root`; reads only. */
+  const proveLayout = (root: string, version: string, topLevel: ReadonlySet<string>) =>
+    fsStep("verifying the runtime tree", (signal) => verifyTree(root, topLevel, signal)).pipe(
+      Effect.andThen(
+        fsStep("verifying the runtime layout", () =>
+          verifyRequiredFiles(root, options.hostTarget, version),
+        ),
+      ),
+    );
+
+  const takeInventory = (root: string) =>
+    fsStep("taking the runtime inventory", (signal) => inventoryTree(root, signal));
+
+  /**
+   * Candidate probes and the migration rehearsal against the private runtime
+   * at `root`, which must hold exactly `inventory` afterwards: bytes a probe
+   * changed are not the bytes that were authenticated, so any difference
+   * refuses the runtime.
+   */
+  const proveCandidate = Effect.fn("cloud.managed_runtime.prove_candidate")(function* (input: {
+    readonly root: string;
+    readonly version: string;
+    readonly inventory: TreeInventory;
+  }) {
+    const entryPath = NodePath.join(input.root, ...MANAGED_SERVER_ENTRY.split("/"));
+    yield* probeCandidate({
+      candidate: options.candidate,
+      hostTarget: options.hostTarget,
+      entryPath,
+      version: input.version,
+    });
+    yield* options.validateMigration({ entryPath, version: input.version });
+    const step = "verifying the runtime after the candidate probes";
+    const after = yield* fsStep(step, (signal) => inventoryTree(input.root, signal));
+    const difference = inventoryDifference(input.inventory, after);
+    if (difference !== undefined) {
+      return yield* stageError(step, `the candidate probes changed the runtime: ${difference}`);
+    }
+  });
+
+  /** Streams the archive into an exclusively created file, counting and hashing every byte. */
+  const download = Effect.fn("cloud.managed_runtime.download")(function* (
+    asset: VerifiedManagedServerAsset,
+    archivePath: string,
+  ) {
+    const step = "downloading the archive";
+    if (asset.bytes > archiveLimits.maxCompressedBytes) {
+      return yield* stageError(step, "the archive is larger than the compressed limit");
+    }
+    // Opened and registered for closing in one uninterruptible step, so a
+    // descriptor that arrives after interruption is still closed.
+    const handle = yield* Effect.acquireRelease(
+      fsStep(step, () =>
+        NodeFSP.open(
+          archivePath,
+          NodeFS.constants.O_WRONLY |
+            NodeFS.constants.O_CREAT |
+            NodeFS.constants.O_EXCL |
+            NodeFS.constants.O_NOFOLLOW,
+          0o600,
+        ),
+      ),
+      (handle) => Effect.promise(() => handle.close().catch(() => {})),
+    );
+    const stream = yield* options.source
+      .openArchive(asset)
+      .pipe(Effect.mapError((error) => stageError(step, error.message, error)));
+    const hash = NodeCrypto.createHash("sha256");
+    let received = 0;
+    yield* Stream.runForEach(stream, (chunk) =>
+      Effect.suspend(() => {
+        received += chunk.byteLength;
+        if (received > asset.bytes) {
+          return Effect.fail(stageError(step, "the archive is longer than the manifest declares"));
+        }
+        hash.update(chunk);
+        return fsStep(step, async () => {
+          let offset = 0;
+          while (offset < chunk.byteLength) {
+            const { bytesWritten } = await handle.write(chunk, offset, chunk.byteLength - offset);
+            offset += bytesWritten;
+          }
+        });
+      }),
+    ).pipe(
+      Effect.mapError((error) =>
+        isStageError(error) ? error : stageError(step, error.message, error),
+      ),
+    );
+    if (received !== asset.bytes) {
+      return yield* stageError(step, "the archive is shorter than the manifest declares");
+    }
+    if (hash.digest("hex") !== asset.sha256) {
+      return yield* stageError(step, "the archive hash does not match the manifest");
+    }
+  }, Effect.scoped);
+
+  /**
+   * Fresh staging inside a private sibling of the version directory. The
+   * finalizer removes only this transaction's directory; once the payload has
+   * been renamed out, the version directory is never touched again.
+   */
+  const transact = Effect.fn("cloud.managed_runtime.transact")(function* (input: {
+    readonly layout: RuntimeLayout;
+    readonly paths: PinnedRuntimePaths;
+    readonly asset: VerifiedManagedServerAsset;
+    readonly record: ManagedArtifactRecord;
+  }) {
+    const { layout, paths, asset } = input;
+    const transactionDir = yield* acquireStagingDirectory(layout.versionsDir);
+    const archivePath = NodePath.join(transactionDir, ARCHIVE_FILE);
+    const payloadDir = NodePath.join(transactionDir, PAYLOAD_DIR);
+
+    yield* download(asset, archivePath);
+    yield* extractManagedRuntimeArchiveEffect({
+      archivePath,
+      destination: payloadDir,
+      limits: archiveLimits,
+      requiredFiles,
+    }).pipe(Effect.mapError((error) => stageError("extracting the archive", error.message, error)));
+    yield* fsStep("removing the archive", () => NodeFSP.rm(archivePath, { force: true }));
+
+    yield* proveLayout(payloadDir, asset.version, new Set(["node_modules"]));
+    // The inventory covers the extracted bytes only; the record and sentinel
+    // join the payload after the probes have left it unchanged.
+    const inventory = yield* takeInventory(payloadDir);
+    yield* proveCandidate({ root: payloadDir, version: asset.version, inventory });
+
+    yield* fsStep("syncing the payload", (signal) => syncTree(payloadDir, signal));
+    // Finite bookkeeping that must not be abandoned half-done: record, then
+    // sentinel last, then the rename that publishes and the parent sync that
+    // makes the rename durable.
+    yield* Effect.uninterruptible(
+      Effect.gen(function* () {
+        yield* fsStep("recording the managed artifact", () =>
+          writeExclusiveSynced(
+            NodePath.join(payloadDir, MANAGED_ARTIFACT_RECORD_FILE),
+            `${JSON.stringify(input.record, null, 2)}\n`,
+          ),
+        );
+        yield* fsStep("recording the completed install", () =>
+          writeExclusiveSynced(
+            NodePath.join(payloadDir, MANAGED_INSTALL_SENTINEL_FILE),
+            `${asset.version}\n`,
+          ),
+        );
+        yield* fsStep("syncing the payload directory", () => syncPath(payloadDir));
+        // Another process may publish the same version at any point; a
+        // nonempty destination makes the rename fail with EEXIST or ENOTEMPTY
+        // and the winner is left untouched. The precheck only gives the same
+        // error earlier.
+        yield* fsStep("publishing the managed runtime", async () => {
+          const appeared = stageError(
+            "publishing the managed runtime",
+            "the version directory appeared during staging",
+          );
+          if ((await lstatOrUndefined(paths.versionDir)) !== undefined) throw appeared;
+          try {
+            await NodeFSP.rename(payloadDir, paths.versionDir);
+          } catch (error) {
+            const code = (error as NodeJS.ErrnoException).code;
+            if (code === "EEXIST" || code === "ENOTEMPTY") throw appeared;
+            throw error;
+          }
+        });
+        // Published: from here the version directory is complete and is left alone whatever happens.
+        yield* fsStep("syncing the versions directory", () => syncPath(layout.versionsDir));
+      }),
+    );
+  }, Effect.scoped);
+
+  /**
+   * Re-proves a published runtime without touching it. After the read-only
+   * layout proof, the probes run against a private byte-for-byte copy in a
+   * staging sibling that is proven equal to the published tree first and is
+   * removed only once every probe has settled.
+   */
+  const reuse = Effect.fn("cloud.managed_runtime.reuse")(function* (input: {
+    readonly layout: RuntimeLayout;
+    readonly paths: PinnedRuntimePaths;
+    readonly version: string;
+  }) {
+    const { layout, paths, version } = input;
+    yield* proveLayout(
+      paths.versionDir,
+      version,
+      new Set(["node_modules", MANAGED_ARTIFACT_RECORD_FILE, MANAGED_INSTALL_SENTINEL_FILE]),
+    );
+    const published = yield* takeInventory(paths.versionDir);
+    const transactionDir = yield* acquireStagingDirectory(layout.versionsDir);
+    const copyDir = NodePath.join(transactionDir, PAYLOAD_DIR);
+    const step = "copying the published runtime";
+    yield* fsStep(step, (signal) => copyTree(paths.versionDir, copyDir, signal));
+    const copied = yield* fsStep(step, (signal) => inventoryTree(copyDir, signal));
+    const difference = inventoryDifference(published, copied);
+    if (difference !== undefined) {
+      return yield* stageError(
+        step,
+        `the private copy differs from the published runtime: ${difference}`,
+      );
+    }
+    yield* proveCandidate({ root: copyDir, version, inventory: published });
+  }, Effect.scoped);
+
+  const stage: ManagedRuntimeStager["stage"] = (targetVersion) =>
+    stagingLock.withPermit(
+      Effect.gen(function* () {
+        yield* validateVersion("validating the requested version", targetVersion);
+        const layout = yield* fsStep("preparing the managed runtime directories", () =>
+          resolveLayout(options.baseDir, true),
+        );
+        const paths = pinnedRuntimePaths(path, layout.baseDir, targetVersion);
+
+        const documents = yield* options.source
+          .readDocuments(targetVersion)
+          .pipe(
+            Effect.mapError((error) =>
+              stageError("fetching release documents", error.message, error),
+            ),
+          );
+        const asset = yield* verifyManagedReleaseDocuments({
+          manifestBytes: documents.manifestBytes,
+          sumsBytes: documents.sumsBytes,
+          targetVersion,
+          hostTarget: options.hostTarget,
+        }).pipe(
+          Effect.mapError((error) =>
+            stageError("verifying release documents", error.message, error),
+          ),
+        );
+        const record = managedArtifactRecordFor(asset);
+        const staged: StagedArtifact = { version: asset.version, artifactId: record.artifactId };
+
+        const existing = yield* readPublished(paths, targetVersion);
+        if (existing.kind === "present") {
+          if (!sameRecord(existing.record, record)) {
+            return yield* stageError(
+              "inspecting the existing version directory",
+              "the version directory holds different content for this version",
+            );
+          }
+          yield* reuse({ layout, paths, version: targetVersion });
+          return staged;
+        }
+
+        yield* transact({ layout, paths, asset, record });
+        return staged;
+      }).pipe(Effect.scoped, Effect.withSpan("cloud.managed_runtime.stage")),
+    );
+
+  const verifyStaged = Effect.fn("cloud.managed_runtime.verify_staged")(function* (
+    staged: StagedArtifact,
+  ) {
+    const step = "verifying the staged runtime";
+    yield* validateVersion(step, staged.version);
+    const layout = yield* fsStep(step, () => resolveLayout(options.baseDir, false));
+    const paths = pinnedRuntimePaths(path, layout.baseDir, staged.version);
+    const existing = yield* readPublished(paths, staged.version);
+    if (existing.kind === "absent") {
+      return yield* stageError(step, `${staged.version} is not staged`);
+    }
+    const { record } = existing;
+    if (record.artifactId !== staged.artifactId) {
+      return yield* stageError(step, "the staged runtime holds a different artifact");
+    }
+    if (
+      record.releaseArtifactId !== selectManagedServerArtifactId(options.hostTarget) ||
+      record.platform !== options.hostTarget.platform ||
+      record.arch !== options.hostTarget.arch ||
+      record.artifactId !==
+        managedArtifactContentId({
+          releaseArtifactId: record.releaseArtifactId,
+          sha256: record.archiveSha256,
+        })
+    ) {
+      return yield* stageError(step, "the managed artifact record does not describe this host");
+    }
+    yield* fsStep(step, () =>
+      verifyRequiredFiles(paths.versionDir, options.hostTarget, staged.version),
+    );
+    return paths;
+  });
+
+  return { stage, verifyStaged } satisfies ManagedRuntimeStager;
+});
