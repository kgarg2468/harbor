+/** fsyncs every regular file and directory below `root` (root included); symlink entries are never followed. */
+async function syncTree(root: string, signal: AbortSignal): Promise<void> {
+  const pending: Array<string> = [root];
+  while (pending.length > 0) {
+    signal.throwIfAborted();
+    const directory = pending.pop() as string;
+    const entries = await NodeFSP.readdir(directory, { withFileTypes: true });
+    for (const entry of entries) {
+      signal.throwIfAborted();
+      const absolute = NodePath.join(directory, entry.name);
+      if (entry.isDirectory()) pending.push(absolute);
+      else if (entry.isFile()) await syncPath(absolute);
+    }
+    await syncPath(directory);
+  }
+}
+
+// --- tree inventory and private copies ----------------------------------------------------
+
+/** Relative entry path to its description; equal maps mean equal trees. */
+type TreeInventory = ReadonlyMap<string, string>;
+
+/** Inventory key of the root itself; its type and permission bits are published too. */
+const ROOT_ENTRY = ".";
+
+/**
+ * Describes `root` and every entry below it: type and permission bits, plus
+ * byte count and SHA-256 for files and the target for symlinks, which are
+ * never followed. Taken before the candidate probes and compared afterwards,
+ * so the bytes that get published are exactly the bytes that were
+ * authenticated and proven. The root is included because the payload
+ * directory becomes the version directory, so a probe widening its mode
+ * would otherwise be published unnoticed.
+ */
+async function inventoryTree(root: string, signal: AbortSignal): Promise<TreeInventory> {
+  const inventory = new Map<string, string>();
+  const rootStats = await NodeFSP.lstat(root);
+  inventory.set(
+    ROOT_ENTRY,
+    `${rootStats.isDirectory() ? "directory" : "non-directory"} mode=${(rootStats.mode & PERMISSION_BITS).toString(8)}`,
+  );
+  const pending: Array<string> = [root];
+  while (pending.length > 0) {
+    signal.throwIfAborted();
+    const directory = pending.pop() as string;
+    const entries = await NodeFSP.readdir(directory, { withFileTypes: true });
+    for (const entry of entries) {
+      signal.throwIfAborted();
+      const absolute = NodePath.join(directory, entry.name);
+      const relative = NodePath.relative(root, absolute);
+      const stats = await NodeFSP.lstat(absolute);
+      const mode = (stats.mode & PERMISSION_BITS).toString(8);
+      if (stats.isDirectory()) {
+        pending.push(absolute);
+        inventory.set(relative, `directory mode=${mode}`);
+      } else if (stats.isSymbolicLink()) {
+        inventory.set(relative, `symlink target=${quote(await NodeFSP.readlink(absolute))}`);
+      } else if (stats.isFile()) {
+        const hash = NodeCrypto.createHash("sha256");
+        let bytes = 0;
+        await readChunks(absolute, async (chunk) => {
+          bytes += chunk.byteLength;
+          hash.update(chunk);
+        });
+        inventory.set(relative, `file mode=${mode} bytes=${bytes} sha256=${hash.digest("hex")}`);
+      } else {
+        inventory.set(relative, "special file");
+      }
+    }
+  }
+  return inventory;
+}
+
+/** Names the first entry that differs, or undefined when the trees are identical. */
+function inventoryDifference(expected: TreeInventory, actual: TreeInventory): string | undefined {
+  for (const [relative, description] of expected) {
+    const found = actual.get(relative);
+    if (found === undefined) return `${relative} was removed`;
+    if (found !== description) return `${relative} changed (${found}, was ${description})`;
+  }
+  for (const relative of actual.keys()) {
+    if (!expected.has(relative)) return `${relative} was added`;
+  }
+  return undefined;
+}
+
+/** Re-writes one regular file into a new exclusive inode with the same permission bits. */
+async function copyFileNoFollow(source: string, destination: string, mode: number): Promise<void> {
+  const handle = await NodeFSP.open(
+    destination,
+    NodeFS.constants.O_WRONLY |
+      NodeFS.constants.O_CREAT |
+      NodeFS.constants.O_EXCL |
+      NodeFS.constants.O_NOFOLLOW,
+    mode,
+  );
+  try {
+    await handle.chmod(mode);
+    await readChunks(source, (chunk) => writeAll(handle, chunk));
+  } finally {
+    await handle.close();
+  }
+}
+
+/**
+ * Copies the tree at `source` into the new directory `destination` as fresh
+ * private inodes: files are re-written byte for byte (never hard-linked,
+ * never followed), symlinks keep their targets, and every entry keeps its
+ * permission bits. Directories are created writable and receive their final
+ * mode once their contents are in place.
+ */
+async function copyTree(source: string, destination: string, signal: AbortSignal): Promise<void> {
+  const step = "copying the published runtime";
+  const directories: Array<[string, number]> = [];
+  const rootMode = (await NodeFSP.lstat(source)).mode & PERMISSION_BITS;
+  await NodeFSP.mkdir(destination, { mode: 0o700 });
+  directories.push([destination, rootMode]);
+  const pending: Array<string> = [""];
+  while (pending.length > 0) {
+    signal.throwIfAborted();
+    const relative = pending.pop() as string;
+    const entries = await NodeFSP.readdir(NodePath.join(source, relative), { withFileTypes: true });
+    for (const entry of entries) {
+      signal.throwIfAborted();
+      const childRelative = NodePath.join(relative, entry.name);
+      const from = NodePath.join(source, childRelative);
+      const to = NodePath.join(destination, childRelative);
+      const stats = await NodeFSP.lstat(from);
+      const mode = stats.mode & PERMISSION_BITS;
+      if (stats.isDirectory()) {
+        await NodeFSP.mkdir(to, { mode: 0o700 });
+        directories.push([to, mode]);
+        pending.push(childRelative);
+      } else if (stats.isSymbolicLink()) {
+        await NodeFSP.symlink(await NodeFSP.readlink(from), to);
+      } else if (stats.isFile()) {
+        await copyFileNoFollow(from, to, mode);
+      } else {
+        throw stageError(step, `${childRelative} is not a file, directory, or symlink`);
+      }
+    }
+  }
+  for (const [directory, mode] of directories) {
+    signal.throwIfAborted();
+    await NodeFSP.chmod(directory, mode);
+  }
+}
+
+// --- layout -----------------------------------------------------------------------------
+
+function monitorHeaderProblem(head: Buffer, target: ManagedServerTarget): string | undefined {
+  if (target.platform === "darwin") {
+    if (head.length < 16 || head.readUInt32LE(0) !== MH_MAGIC_64) {
+      return "resource monitor is not a 64-bit Mach-O file";
+    }
+    if (head.readUInt32LE(4) !== MH_CPU_TYPE_ARM64)
+      return "resource monitor is not built for arm64";
+    if (head.readUInt32LE(12) !== MH_EXECUTE) return "resource monitor is not a Mach-O executable";
+    return undefined;
+  }
+  if (head.length < 20 || !ELF_MAGIC.every((byte, index) => head[index] === byte)) {
+    return "resource monitor is not an ELF file";
+  }
+  if (head[4] !== ELF_CLASS_64 || head[5] !== ELF_DATA_LITTLE_ENDIAN) {
+    return "resource monitor is not a little-endian 64-bit ELF file";
+  }
+  const elfType = head.readUInt16LE(16);
+  if (elfType !== ELF_TYPE_EXEC && elfType !== ELF_TYPE_DYN) {
+    return "resource monitor is not an ELF executable";
+  }
+  if (head.readUInt16LE(18) !== ELF_MACHINE_X86_64)
+    return "resource monitor is not built for x86-64";
+  return undefined;
+}
+
+/**
+ * Proves the five required members are real, nonempty, unlinked regular files
+ * naming the exact package and version, with an executable monitor built for
+ * the host. Runs on a fresh payload and again on every reuse.
+ */
+async function verifyRequiredFiles(
+  root: string,
+  target: ManagedServerTarget,
+  version: string,
+): Promise<void> {
+  const step = "verifying the runtime layout";
+  const required = managedRuntimeRequiredFiles(target);
+  for (const relative of required) {
+    const stats = await lstatOrUndefined(NodePath.join(root, ...relative.split("/")));
+    if (stats === undefined) throw stageError(step, `${relative} is missing`);
+    if (!stats.isFile()) throw stageError(step, `${relative} is not a regular file`);
+    if (stats.size === 0) throw stageError(step, `${relative} is empty`);
+    if (stats.nlink !== 1) throw stageError(step, `${relative} is hard-linked`);
+  }
+  const [packageJsonPath, , , , monitorPath] = required.map((relative) =>
+    NodePath.join(root, ...relative.split("/")),
+  ) as [string, string, string, string, string];
+
+  const manifest = parseJsonDocument(
+    step,
+    await readBounded(step, packageJsonPath, MAX_PACKAGE_JSON_BYTES),
+    "package.json",
+  );
+  if (typeof manifest !== "object" || manifest === null || Array.isArray(manifest)) {
+    throw stageError(step, "package.json is not an object");
+  }
+  const record = manifest as Record<string, unknown>;
+  if (record.name !== PACKAGE_NAME) throw stageError(step, `package name is not ${PACKAGE_NAME}`);
+  if (record.version !== version) {
+    throw stageError(step, `package version ${String(record.version)} is not ${version}`);
+  }
+
+  const monitorStats = await NodeFSP.lstat(monitorPath);
+  if ((monitorStats.mode & 0o100) === 0)
+    throw stageError(step, "resource monitor is not executable");
+  const headerProblem = monitorHeaderProblem(await readHeader(monitorPath), target);
+  if (headerProblem !== undefined) throw stageError(step, headerProblem);
+}
+
+/**
+ * Walks the whole tree: only the expected top-level entries, `node_modules`
+ * holding exactly `t3`, ordinary files, directories, and relative symlinks
+ * whose final paths stay inside the package.
+ */
+async function verifyTree(
+  root: string,
+  expectedTopLevel: ReadonlySet<string>,
+  signal: AbortSignal,
+): Promise<void> {
+  const step = "verifying the runtime tree";
+  const realRoot = await NodeFSP.realpath(root);
+  const packagePrefix = `${NodePath.join(realRoot, ...PACKAGE_DIR.split("/"))}${NodePath.sep}`;
+
+  const topLevel = await NodeFSP.readdir(root, { withFileTypes: true });
+  const names = new Set(topLevel.map((entry) => entry.name));
+  for (const expected of expectedTopLevel) {
+    if (!names.has(expected)) throw stageError(step, `${expected} is missing`);
+  }
+  for (const entry of topLevel) {
+    if (!expectedTopLevel.has(entry.name)) throw stageError(step, `unexpected entry ${entry.name}`);
+    if (entry.name === "node_modules" ? !entry.isDirectory() : !entry.isFile()) {
+      throw stageError(step, `${entry.name} has the wrong type`);
+    }
+  }
+  const nodeModules = NodePath.join(root, "node_modules");
+  const packages = await NodeFSP.readdir(nodeModules, { withFileTypes: true });
+  if (packages.length !== 1 || packages[0]?.name !== PACKAGE_NAME || !packages[0].isDirectory()) {
+    throw stageError(step, `node_modules must contain exactly the ${PACKAGE_NAME} directory`);
+  }
+
+  const pending: Array<string> = [NodePath.join(nodeModules, PACKAGE_NAME)];
+  while (pending.length > 0) {
+    signal.throwIfAborted();
+    const directory = pending.pop() as string;
+    const entries = await NodeFSP.readdir(directory, { withFileTypes: true });
+    for (const entry of entries) {
+      const absolute = NodePath.join(directory, entry.name);
+      if (entry.isDirectory()) {
+        pending.push(absolute);
+      } else if (entry.isSymbolicLink()) {
+        signal.throwIfAborted();
+        const target = await NodeFSP.readlink(absolute);
+        if (NodePath.isAbsolute(target)) {
+          throw stageError(step, `${absolute} is an absolute symlink`);
+        }
+        const real = await NodeFSP.realpath(absolute).catch(() => undefined);
+        if (real === undefined || !real.startsWith(packagePrefix)) {
+          throw stageError(step, `${absolute} does not resolve inside the package`);
+        }
+      } else if (!entry.isFile()) {
+        throw stageError(step, `${absolute} is not a file, directory, or symlink`);
+      }
+    }
+  }
+}
+
+// --- published directory ----------------------------------------------------------------
+
+type ExistingVersion =
+  | { readonly kind: "absent" }
+  | { readonly kind: "present"; readonly record: ManagedArtifactRecord };
