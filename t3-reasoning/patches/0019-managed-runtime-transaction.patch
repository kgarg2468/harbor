+// --- errors ---------------------------------------------------------------------------
+
+const isStageError = Schema.is(ManagedRuntimeStageError);
+
+function describe(error: unknown): string {
+  return error instanceof Error ? error.message : String(error);
+}
+
+function stageError(step: string, reason: string, cause?: unknown): ManagedRuntimeStageError {
+  return new ManagedRuntimeStageError({
+    step,
+    reason,
+    ...(cause === undefined ? {} : { cause }),
+  });
+}
+
+function toStageError(step: string, error: unknown): ManagedRuntimeStageError {
+  return isStageError(error) ? error : stageError(step, describe(error), error);
+}
+
+/**
+ * Runs one filesystem step. Interruption aborts the signal and waits for the
+ * promise to settle, so cleanup never races a call still in flight.
+ */
+function fsStep<A>(
+  step: string,
+  start: (signal: AbortSignal) => Promise<A>,
+): Effect.Effect<A, ManagedRuntimeStageError> {
+  return Effect.callback<A, ManagedRuntimeStageError>((resume, signal) => {
+    const settled = start(signal).then(
+      (value) => resume(Effect.succeed(value)),
+      (error: unknown) => resume(Effect.fail(toStageError(step, error))),
+    );
+    return Effect.promise(() => settled);
+  });
+}
+
+const isEnoent = (error: unknown) => (error as NodeJS.ErrnoException).code === "ENOENT";
