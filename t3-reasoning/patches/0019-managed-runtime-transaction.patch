+const MH_EXECUTE = 2;
+const ELF_MAGIC = [0x7f, 0x45, 0x4c, 0x46] as const;
+const ELF_CLASS_64 = 2;
+const ELF_DATA_LITTLE_ENDIAN = 1;
+const ELF_TYPE_EXEC = 2;
+const ELF_TYPE_DYN = 3;
+const ELF_MACHINE_X86_64 = 0x3e;
