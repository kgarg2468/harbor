+/**
+ * Managed releases ship exactly two server artifacts. Every other host keeps a
+ * dormant queue whose exact-version resolver fails; there is no fallback
+ * target, so an unsupported host can never stage a runtime built for another.
+ */
+export function resolveManagedServerTarget(
+  platform: NodeJS.Platform,
+  architecture: NodeJS.Architecture,
+  linuxLibc: ResourceMonitorBinary.ResourceMonitorLinuxLibc | undefined,
+): ManagedServerTarget | undefined {
+  if (platform === "darwin" && architecture === "arm64") {
+    return { platform: "darwin", arch: "arm64" };
+  }
+  if (platform === "linux" && architecture === "x64" && linuxLibc === "gnu") {
+    return { platform: "linux", arch: "x64", libc: "glibc" };
+  }
+  return undefined;
+}
+
+/**
+ * Binds each exact resolution to the feed selection it came from: a fresh
+ * stager over that selection's source, reporting that selection's version and
+ * artifact ID. The queue only ever asks for an exact version, so `latest` is
+ * deliberately outside the accepted feed interface.
+ */
+export const makeSelectionBoundManagedRuntimeResolver =
+  (input: {
+    readonly feed: Pick<ManagedReleaseFeed, "resolve">;
+    readonly makeStager: (
+      selection: ManagedReleaseSelection,
+    ) => Effect.Effect<ManagedRuntimeStager>;
+  }): ManagedQueuedUpdate.ResolveManagedRuntime =>
+  (exactVersion) =>
