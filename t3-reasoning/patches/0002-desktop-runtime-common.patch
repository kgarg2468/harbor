+  readPathFromLaunchctl: (): string | undefined => {
+    throw new Error("launchctl must not run");
+  },
+};
+
+it("skips the login shell and keeps the inherited PATH when the desktop prepared the env", () => {
+  const env: NodeJS.ProcessEnv = {
+    T3CODE_SKIP_LOGIN_SHELL: "1",
+    PATH: "/electron/bin:/usr/bin",
+  };
+
+  hydratePosixPath(env, "darwin", {
+    ...forbiddenReaders,
+    readPathFromLaunchctl: () => "/launchctl/bin:/usr/bin",
+  });
+
+  // Inherited entries stay first; launchctl only appends what is missing.
+  assert.equal(env.PATH, "/electron/bin:/usr/bin:/launchctl/bin");
+});
+
+it("skips both the login shell and launchctl on linux when the desktop prepared the env", () => {
+  const env: NodeJS.ProcessEnv = {
+    T3CODE_SKIP_LOGIN_SHELL: "1",
+    PATH: "/inherited/bin:/usr/bin",
+  };
+
+  hydratePosixPath(env, "linux", forbiddenReaders);
+
+  assert.equal(env.PATH, "/inherited/bin:/usr/bin");
+});
+
+it("keeps the inherited PATH when the desktop prepared the env and launchctl has nothing", () => {
+  const env: NodeJS.ProcessEnv = {
+    T3CODE_SKIP_LOGIN_SHELL: "1",
+    PATH: "/electron/bin:/usr/bin",
+  };
+
+  hydratePosixPath(env, "darwin", {
+    ...forbiddenReaders,
+    readPathFromLaunchctl: () => undefined,
+  });
+
+  assert.equal(env.PATH, "/electron/bin:/usr/bin");
+});
+
+it("still reads the login shell when the desktop signal is absent", () => {
+  const env: NodeJS.ProcessEnv = { SHELL: "/bin/zsh", PATH: "/usr/bin" };
+  const observedShells: string[] = [];
+
+  hydratePosixPath(env, "darwin", {
+    ...forbiddenReaders,
+    readPathFromLoginShell: (shell) => {
+      observedShells.push(shell);
+      return "/login/bin";
+    },
+  });
+
+  assert.deepEqual(observedShells, ["/bin/zsh"]);
+  assert.equal(env.PATH, "/login/bin:/usr/bin");
+});
 
