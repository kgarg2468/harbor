+++ b/apps/desktop/src/updates/ManagedDesktopInstaller.ts
@@ -0,0 +1,237 @@
+// @effect-diagnostics nodeBuiltinImport:off globalTimers:off -- Native detached process handoff.
+import * as fs from "node:fs/promises";
+import path from "node:path";
+import { randomUUID } from "node:crypto";
+import { spawn, type ChildProcess } from "node:child_process";
+import type { Duplex } from "node:stream";
+import type {
+  createManagedDesktopArtifactPreparer,
+  PreparedManagedDesktopArtifact,
+} from "./ManagedDesktopArtifact.ts";
+import { durableRecord, type ManagedDesktopInstallTask } from "./managedDesktopInstallHelper.ts";
+
+export interface ManagedDesktopInstallerOptions {
+  readonly preparer: Pick<ReturnType<typeof createManagedDesktopArtifactPreparer>, "claim">;
+  readonly stateDir: string;
+  readonly helperPath: string;
+  readonly quit: () => void;
+}
+export interface ManagedDesktopInstallerSeams {
+  readonly spawn: (
+    executable: string,
+    args: readonly string[],
+    options: Parameters<typeof spawn>[2],
+  ) => ChildProcess;
+  readonly executable: string;
+  readonly pid: number;
+  readonly uid: number;
+  readonly timeoutMs: number;
+}
+const defaults: ManagedDesktopInstallerSeams = {
+  spawn: (executable, args, options) => spawn(executable, [...args], options),
+  executable: process.execPath,
+  pid: process.pid,
+  uid: process.getuid?.() ?? -1,
+  timeoutMs: 30_000,
+};
+export function createManagedDesktopInstaller(
+  options: ManagedDesktopInstallerOptions,
+  seams: ManagedDesktopInstallerSeams = defaults,
+) {
+  return {
+    async prepareInstall(
+      token: PreparedManagedDesktopArtifact,
+      request: { readonly signal?: AbortSignal } = {},
+    ) {
+      const handoff = await options.preparer.claim(token);
+      let directory: string | undefined;
+      let child: ChildProcess | undefined;
+      let pipe: Duplex | undefined;
+      let phase:
+        | "preparing"
+        | "ready"
+        | "stopping"
+        | "accepted-failed"
+        | "committed"
+        | "armed"
+        | "cancelled" = "preparing";
+      let failed: Error | undefined;
+      let pending:
+        | { expected: string; resolve: () => void; reject: (e: Error) => void }
+        | undefined;
+      let buffer = "";
+      const fail = (error: Error) => {
+        failed ??= error;
+        pending?.reject(failed);
+        pending = undefined;
+        if (phase === "ready") void cancel().catch(() => {});
+      };
+      const wait = (expected: string) =>
+        new Promise<void>((resolve, reject) => {
+          if (failed) {
+            reject(failed);
+            return;
+          }
+          const timer = setTimeout(() => {
+            pending = undefined;
+            reject(new Error(`Installer ${expected} timeout`));
+          }, seams.timeoutMs);
+          pending = {
+            expected,
+            resolve: () => {
+              clearTimeout(timer);
+              resolve();
+            },
+            reject: (error) => {
+              clearTimeout(timer);
+              reject(error);
+            },
+          };
+        });
+      // After COMMIT was written ownership is uncertain until ARMED. Never delete a
+      // possibly committed task or staging tree, even if its acknowledgement is lost.
+      let cleanupPromise: Promise<void> | undefined;
+      const cancel = async () => {
+        if (
+          phase === "stopping" ||
+          phase === "accepted-failed" ||
+          phase === "committed" ||
+          phase === "armed"
+        )
+          return;
+        if (cleanupPromise) return cleanupPromise;
+        phase = "cancelled";
+        fail(new Error("Managed desktop installation cancelled"));
+        request.signal?.removeEventListener("abort", onAbort);
+        pipe?.destroy();
+        cleanupPromise = (async () => {
+          await handoff.cleanup();
+          if (directory) await fs.rm(directory, { recursive: true, force: true });
+        })();
+        return cleanupPromise;
+      };
+      const onAbort = () => {
+        void cancel().catch(() => {});
+      };
+      try {
+        if (request.signal?.aborted) throw new Error("Managed desktop installation cancelled");
+        await fs.mkdir(options.stateDir, { recursive: true, mode: 0o700 });
+        const state = await fs.lstat(options.stateDir);
+        if (
+          !state.isDirectory() ||
+          state.isSymbolicLink() ||
+          state.uid !== seams.uid ||
+          (await fs.realpath(options.stateDir)) !== options.stateDir
+        )
+          throw new Error("Unsafe installer state directory");
+        directory = await fs.mkdtemp(path.join(options.stateDir, "install-"));
+        await fs.chmod(directory, 0o700);
+        const id = randomUUID();
+        const task: ManagedDesktopInstallTask = {
+          schemaVersion: 1,
+          id,
+          uid: seams.uid,
+          parentPid: seams.pid,
+          installedBundle: handoff.installedBundle,
+          stagedBundle: handoff.stagedBundle,
+          installedOwner: handoff.installedOwner,
+          stagedOwner: handoff.stagedOwner,
+          backupBundle: path.join(
+            path.dirname(handoff.installedBundle),
+            `.${handoff.productName}.previous-${id}.app`,
+          ),
+          digest: handoff.digest,
+          bundleId: handoff.bundleId,
+          productName: handoff.productName,
+          targetVersion: handoff.targetVersion,
+          urlSchemes: handoff.urlSchemes,
+        };
+        await durableRecord(directory, "task.json", task);
+        child = seams.spawn(
+          seams.executable,
+          [
+            options.helperPath,
+            "--managed-desktop-install-helper",
+            path.join(directory, "task.json"),
+          ],
+          {
+            detached: true,
+            shell: false,
+            env: { ...process.env, ELECTRON_RUN_AS_NODE: "1" },
+            stdio: ["ignore", "ignore", "ignore", "pipe"],
+          },
+        );
+        child.on("error", fail);
+        child.on("exit", () => fail(new Error("Installer helper exited")));
+        pipe = child.stdio[3] as Duplex | undefined;
+        if (!pipe) throw new Error("Installer control pipe unavailable");
+        pipe.on("error", fail);
+        pipe.on("close", () => fail(new Error("Installer control pipe closed")));
+        pipe.on("data", (data: Buffer) => {
+          buffer += data.toString("utf8");
+          if (buffer.length > 128) {
+            fail(new Error("Invalid helper response"));
+            return;
+          }
+          while (buffer.includes("\n")) {
+            const end = buffer.indexOf("\n");
+            const message = buffer.slice(0, end);
+            buffer = buffer.slice(end + 1);
+            if (!pending || message !== pending.expected) {
+              fail(new Error("Unexpected helper response"));
+              return;
+            }
+            const current = pending;
+            pending = undefined;
+            current.resolve();
+          }
+        });
+        request.signal?.addEventListener("abort", onAbort, { once: true });
+        if (request.signal?.aborted) throw new Error("Managed desktop installation cancelled");
+        await wait("READY");
+        phase = "ready";
+        return Object.freeze({
+          cancel,
+          /** Invoke only inside the reservation controller's accepted phase. The
+           * caller captures the exact owned backend generations in this callback. */
+          async stopAndInstall(stopBackend: () => Promise<void>): Promise<void> {
+            if (phase !== "ready" || failed)
+              throw failed ?? new Error("Installer handoff already used");
+            phase = "stopping";
+            request.signal?.removeEventListener("abort", onAbort);
+            try {
+              await stopBackend();
+              if (failed) throw failed;
+              const armed = wait("ARMED");
+              phase = "committed";
+              try {
+                pipe!.write(`COMMIT ${id}\n`, (error) => {
+                  if (error) fail(error);
+                });
+              } catch (error) {
+                fail(error instanceof Error ? error : new Error(String(error)));
+              }
+              await armed;
+              phase = "armed";
+              request.signal?.removeEventListener("abort", onAbort);
+              child!.unref();
+              pipe!.destroy();
+              options.quit();
+            } catch (error) {
+              if (phase === "stopping") {
+                phase = "accepted-failed";
+                // Accepted work cannot be cancelled or retried: some generations
+                // may already be stopped and the caller retains its lifecycle fence.
+                pipe!.destroy();
+              }
+              throw error;
+            }
+          },
+        });
+      } catch (error) {
+        await cancel();
+        throw error;
+      }
+    },
+  };
+}
