@@ -0,0 +1,212 @@
+// @effect-diagnostics nodeBuiltinImport:off -- Fake child and private temporary handoff records.
+import { afterEach, describe, expect, it } from "@effect/vitest";
+import * as fs from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { Duplex } from "node:stream";
+import { EventEmitter } from "node:events";
+import type { ChildProcess } from "node:child_process";
+import {
+  createManagedDesktopInstaller,
+  type ManagedDesktopInstallerSeams,
+} from "./ManagedDesktopInstaller.ts";
+import type { PreparedManagedDesktopArtifact } from "./ManagedDesktopArtifact.ts";
+const roots: string[] = [];
+afterEach(async () => {
+  for (const root of roots.splice(0)) await fs.rm(root, { recursive: true, force: true });
+});
+async function fixture() {
+  const root = await fs.realpath(await fs.mkdtemp(path.join(os.tmpdir(), "installer-test-")));
+  roots.push(root);
+  const events: string[] = [];
+  const writes: string[] = [];
+  let arm = true;
+  let ready = true;
+  let spawnFailure = false;
+  const pipe = new Duplex({
+    read() {},
+    write(chunk, _encoding, callback) {
+      writes.push(String(chunk));
+      events.push("commit");
+      callback();
+      if (arm) queueMicrotask(() => pipe.push("ARMED\n"));
+    },
+  });
+  const child = Object.assign(new EventEmitter(), {
+    stdio: [null, null, null, pipe],
+    unref: () => {
+      events.push("unref");
+    },
+  }) as unknown as ChildProcess;
+  const token = Object.freeze({}) as PreparedManagedDesktopArtifact;
+  let used = false;
+  const seams: ManagedDesktopInstallerSeams = {
+    executable: "/fake/electron",
+    pid: 12345,
+    uid: process.getuid!(),
+    timeoutMs: 50,
+    spawn: (executable, args, options) => {
+      if (spawnFailure) throw new Error("spawn failed");
+      expect(executable).toBe("/fake/electron");
+      expect(args[1]).toBe("--managed-desktop-install-helper");
+      expect(options).toMatchObject({
+        detached: true,
+        shell: false,
+        env: { ELECTRON_RUN_AS_NODE: "1" },
+        stdio: ["ignore", "ignore", "ignore", "pipe"],
+      });
+      queueMicrotask(() => {
+        if (ready) pipe.push("READY\n");
+      });
+      return child;
+    },
+  };
+  const installer = createManagedDesktopInstaller(
+    {
+      stateDir: root,
+      helperPath: "/fake/helper.cjs",
+      quit: () => {
+        events.push("quit");
+      },
+      preparer: {
+        claim: async (t) => {
+          if (t !== token || used) throw new Error("invalid token");
+          used = true;
+          return {
+            installedBundle: path.join(root, "Product.app"),
+            stagedBundle: path.join(root, ".Product.managed-test.app"),
+            installedOwner: { dev: 1, ino: 1 },
+            stagedOwner: { dev: 1, ino: 2 },
+            digest: "a".repeat(64),
+            bundleId: "com.example",
+            productName: "Product",
+            urlSchemes: ["product"],
+            targetVersion: "1.2.3",
+            cleanup: async () => {
+              events.push("cleanup");
+            },
+          };
+        },
+      },
+    },
+    seams,
+  );
+  return {
+    root,
+    installer,
+    token,
+    events,
+    writes,
+    pipe,
+    child,
+    setSpawnFailure: () => {
+      spawnFailure = true;
+    },
+    setArm: (v: boolean) => {
+      arm = v;
+    },
+    setReady: (v: boolean) => {
+      ready = v;
+    },
+  };
+}
+describe("installer accepted-phase handoff", () => {
+  it("READY precedes stop; COMMIT follows stop; ARMED precedes quit", async () => {
+    const f = await fixture();
+    const reservation = await f.installer.prepareInstall(f.token);
+    expect(f.events).toEqual([]);
+    await reservation.stopAndInstall(async () => {
+      f.events.push("stop");
+    });
+    expect(f.events).toEqual(["stop", "commit", "unref", "quit"]);
+    await expect(reservation.stopAndInstall(async () => {})).rejects.toThrow();
+  });
+  it("cancels READY handoff without a commit", async () => {
+    const f = await fixture();
+    const r = await f.installer.prepareInstall(f.token);
+    await r.cancel();
+    expect(f.writes).toEqual([]);
+    expect(f.events).toEqual(["cleanup"]);
+    await expect(r.stopAndInstall(async () => {})).rejects.toThrow();
+  });
+  it("READY timeout cleans staging and never stops backend", async () => {
+    const f = await fixture();
+    f.setReady(false);
+    await expect(f.installer.prepareInstall(f.token)).rejects.toThrow("timeout");
+    expect(f.events).toEqual(["cleanup"]);
+  });
+  it("backend stop failure never commits", async () => {
+    const f = await fixture();
+    const r = await f.installer.prepareInstall(f.token);
+    await expect(
+      r.stopAndInstall(async () => {
+        throw new Error("stop failed");
+      }),
+    ).rejects.toThrow("stop failed");
+    expect(f.writes).toEqual([]);
+    expect(f.events).toEqual([]);
+    await r.cancel();
+    await expect(r.stopAndInstall(async () => {})).rejects.toThrow();
+    expect((await fs.readdir(f.root)).length).toBe(1);
+    expect(f.events).toEqual([]);
+  });
+  it("missing ARMED retains committed ownership and does not quit", async () => {
+    const f = await fixture();
+    f.setArm(false);
+    const r = await f.installer.prepareInstall(f.token);
+    await expect(r.stopAndInstall(async () => {})).rejects.toThrow("timeout");
+    await r.cancel();
+    expect(f.events).toEqual(["commit"]);
+    expect((await fs.readdir(f.root)).length).toBe(1);
+    f.pipe.destroy();
+  });
+  it("accepted-phase abort and cancel during backend stop retain staging and commit", async () => {
+    const f = await fixture();
+    const controller = new AbortController();
+    const r = await f.installer.prepareInstall(f.token, { signal: controller.signal });
+    await r.stopAndInstall(async () => {
+      controller.abort();
+      await r.cancel();
+      expect(f.pipe.destroyed).toBe(false);
+      expect(f.events).toEqual([]);
+      expect((await fs.readdir(f.root)).length).toBe(1);
+    });
+    expect(f.events).toEqual(["commit", "unref", "quit"]);
+  });
+  it("cannot reclaim the same prepared token", async () => {
+    const f = await fixture();
+    const r = await f.installer.prepareInstall(f.token);
+    await expect(f.installer.prepareInstall(f.token)).rejects.toThrow("token");
+    await r.cancel();
+  });
+  it("pipe failure while ready cannot stop backend", async () => {
+    const f = await fixture();
+    const r = await f.installer.prepareInstall(f.token);
+    f.pipe.emit("error", new Error("pipe failed"));
+    await expect(
+      r.stopAndInstall(async () => {
+        f.events.push("stop");
+      }),
+    ).rejects.toThrow("pipe failed");
+    await r.cancel();
+    expect(f.events).toEqual(["cleanup"]);
+  });
+  it("cleans a failed spawn without committing", async () => {
+    const f = await fixture();
+    f.setSpawnFailure();
+    await expect(f.installer.prepareInstall(f.token)).rejects.toThrow("spawn failed");
+    expect(f.events).toEqual(["cleanup"]);
+    expect(f.writes).toEqual([]);
+    expect(await fs.readdir(f.root)).toEqual([]);
+  });
+  it("cannot cancel an ARMED helper or return ownership", async () => {
+    const f = await fixture();
+    const controller = new AbortController();
+    const r = await f.installer.prepareInstall(f.token, { signal: controller.signal });
+    await r.stopAndInstall(async () => {});
+    controller.abort();
+    await r.cancel();
+    expect(f.events).toEqual(["commit", "unref", "quit"]);
+    await expect(f.installer.prepareInstall(f.token)).rejects.toThrow("token");
+  });
+});
