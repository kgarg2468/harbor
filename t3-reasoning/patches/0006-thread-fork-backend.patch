--- a/apps/server/src/attachmentStore.ts
+++ b/apps/server/src/attachmentStore.ts
@@ -214,6 +214,58 @@ export function planAttachmentClaim(input: {
   };
 }
 
+export type AttachmentCopyPlan =
+  | {
+      readonly ok: true;
+      /** The source attachment re-keyed to a destination-owned id. */
+      readonly attachment: ChatAttachment;
+      readonly sourcePath: string;
+      readonly destinationPath: string;
+    }
+  | { readonly ok: false; readonly reason: string };
+
+/**
+ * Plan duplicating a stored attachment into another thread's ownership (thread
+ * fork). The copy gets a fresh id under the destination thread segment so
+ * deleting the source thread never removes the fork's file. Unknown attachment
+ * types and missing files are reported, not copied: the caller drops them
+ * from the seed with a warning instead of carrying a payload it cannot serve.
+ */
+export function planAttachmentCopy(input: {
+  readonly attachmentsDir: string;
+  readonly attachment: ChatAttachment;
+  readonly destinationThreadId: string;
+}): AttachmentCopyPlan {
+  const relativePath = attachmentRelativePath(input.attachment);
+  if (!relativePath) {
+    return { ok: false, reason: `unsupported attachment type '${input.attachment.type}'` };
+  }
+  const sourcePath = resolveAttachmentRelativePath({
+    attachmentsDir: input.attachmentsDir,
+    relativePath,
+  });
+  if (!sourcePath) {
+    return { ok: false, reason: "invalid attachment id" };
+  }
+  if (!NodeFS.existsSync(sourcePath)) {
+    return { ok: false, reason: "attachment file not found" };
+  }
+  const extension = NodePath.extname(sourcePath).replace(/^\./, "");
+  const destinationId = createAttachmentId(input.destinationThreadId, extension);
+  if (!destinationId) {
+    return { ok: false, reason: "invalid destination thread id" };
+  }
+  const attachment: ChatAttachment = { ...input.attachment, id: destinationId };
+  const destinationPath = resolveAttachmentPath({
+    attachmentsDir: input.attachmentsDir,
+    attachment,
+  });
+  if (!destinationPath) {
+    return { ok: false, reason: "failed to resolve destination attachment path" };
+  }
+  return { ok: true, attachment, sourcePath, destinationPath };
+}
