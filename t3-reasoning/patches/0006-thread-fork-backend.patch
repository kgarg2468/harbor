+  Crypto.make({
+    randomBytes: (size) => new Uint8Array(size),
+    digest: (_algorithm, data) => Effect.succeed(data),
+  }),
+);
+
+const MODEL_SELECTION = { instanceId: ProviderInstanceId.make("claude"), model: "claude-opus-5" };
+
+const makeHarness = Effect.fn("TestThreadCommands.makeHarness")(function* () {
+  const sent: string[] = [];
+  const createLatch = Latch.makeUnsafe();
+  const client = {
+    [ORCHESTRATION_WS_METHODS.dispatchCommand]: (command: ClientOrchestrationCommand) =>
+      Effect.gen(function* () {
+        sent.push(`${command.type}:${"threadId" in command ? command.threadId : ""}`);
+        if (command.type === "thread.create") {
+          yield* createLatch.await;
+        }
+        return { sequence: sent.length };
+      }),
+    [ORCHESTRATION_WS_METHODS.forkThread]: (input: OrchestrationForkThreadInput) =>
+      Effect.sync(() => {
+        sent.push(`fork:${input.sourceThreadId}->${input.threadId}`);
+        return { sequence: sent.length, threadId: input.threadId, warnings: [] };
+      }),
+  } as unknown as WsRpcProtocolClient;
+  const session: RpcSession = {
+    client,
+    initialConfig: Effect.never,
+    subscribeServerConfig: (input) => client.subscribeServerConfig(input),
+    ready: Effect.void,
+    probe: Effect.void,
+    closed: Effect.never,
+  };
+  const supervisor = EnvironmentSupervisor.EnvironmentSupervisor.of({
+    target: TARGET,
+    state: yield* SubscriptionRef.make(AVAILABLE_CONNECTION_STATE),
+    session: yield* SubscriptionRef.make(Option.some(session)),
+    prepared: yield* SubscriptionRef.make(Option.none<PreparedConnection>()),
+    connect: Effect.void,
+    disconnect: Effect.void,
+    retryNow: Effect.void,
+  } satisfies EnvironmentSupervisor.EnvironmentSupervisor["Service"]);
+  const run: EnvironmentRegistry.EnvironmentRegistry["Service"]["run"] = (_environmentId, effect) =>
+    Effect.provideService(effect, EnvironmentSupervisor.EnvironmentSupervisor, supervisor);
+  const followStream: EnvironmentRegistry.EnvironmentRegistry["Service"]["followStream"] = (
+    _environmentId,
+    stream,
+  ) => Stream.provideService(stream, EnvironmentSupervisor.EnvironmentSupervisor, supervisor);
+  const registry = EnvironmentRegistry.EnvironmentRegistry.of({
+    run,
+    followStream,
+  } as unknown as EnvironmentRegistry.EnvironmentRegistry["Service"]);
+  const runtime = Atom.runtime(
+    Layer.mergeAll(
+      Layer.succeed(EnvironmentRegistry.EnvironmentRegistry, registry),
+      TEST_CRYPTO_LAYER,
+    ),
+  );
+  return { atoms: createThreadEnvironmentAtoms(runtime), sent, createLatch };
+});
+
+function forkInput(sourceThreadId: string, threadId: string) {
+  return {
+    threadId: ThreadId.make(threadId),
+    sourceThreadId: ThreadId.make(sourceThreadId),
+    sourceTurnId: TurnId.make("turn-1"),
+    title: "Forked",
+    modelSelection: MODEL_SELECTION,
+    runtimeMode: "full-access" as const,
+    interactionMode: "default" as const,
+    workspaceMode: "shared" as const,
+    createdAt: "2026-06-06T00:00:00.000Z",
+  };
+}
+
+describe("thread fork command", () => {
+  it.effect("serializes on the destination thread, not the source", () =>
+    Effect.gen(function* () {
+      const { atoms, sent, createLatch } = yield* makeHarness();
+      const atomRegistry = AtomRegistry.make();
+      const environmentId = TARGET.environmentId;
+
+      // Hold the lane for thread-2 with a pending create.
+      const create = atoms.create.run(atomRegistry, {
+        environmentId,
+        input: {
+          threadId: ThreadId.make("thread-2"),
+          projectId: ProjectId.make("project-1"),
+          title: "Destination",
+          modelSelection: MODEL_SELECTION,
+          runtimeMode: "full-access",
+          interactionMode: "default",
+          branch: null,
+          worktreePath: null,
+          createdAt: "2026-06-06T00:00:00.000Z",
+        },
+      });
+      // A fork *into* thread-2 must wait behind that lane...
+      const forkIntoBusy = atoms.fork.run(atomRegistry, {
+        environmentId,
+        input: forkInput("thread-1", "thread-2"),
+      });
+      // ...while a fork *from* thread-2 into a fresh thread proceeds now.
+      const forkFromBusy = atoms.fork.run(atomRegistry, {
+        environmentId,
+        input: forkInput("thread-2", "thread-3"),
+      });
+      yield* Effect.promise(() => forkFromBusy);
+      expect(sent).toEqual(["thread.create:thread-2", "fork:thread-2->thread-3"]);
+
+      createLatch.openUnsafe();
+      const results = yield* Effect.promise(() => Promise.all([create, forkIntoBusy]));
+      expect(results.map((result) => result._tag)).toEqual(["Success", "Success"]);
+      expect(sent).toEqual([
+        "thread.create:thread-2",
+        "fork:thread-2->thread-3",
+        "fork:thread-1->thread-2",
+      ]);
+      expect(results[1]).toMatchObject({
+        value: { sequence: 3, threadId: "thread-2", warnings: [] },
+      });
+      atomRegistry.dispose();
+    }),
+  );
+});
