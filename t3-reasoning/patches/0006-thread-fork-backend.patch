+/**
+ * Thread fork materialization for `orchestration.forkThread`.
+ *
+ * Resolves the source thread's authoritative history up to one completed turn,
+ * duplicates its attachments into the destination's ownership, optionally
+ * restores the turn's checkpoint into a fresh worktree, and dispatches a single
+ * internal `thread.fork.materialize` command so the destination thread and its
+ * seed messages land in one engine transaction. Nothing here starts a provider
+ * turn; the fork's first real send is where the handoff context is consumed.
+ *
+ * Client input is intent only (source ids, destination model, workspace mode).
+ * Copied text, attachments and workspace state always come from the projection
+ * and the filesystem this server owns.
+ *
+ * Retries are checked against the original request: the same command id with a
+ * different source, destination, title, model, mode or workspace choice is
+ * rejected instead of silently returning the earlier fork. `createdAt` is a
+ * per-call stamp and never part of that comparison.
+ */
+import {
+  isReasoningMessage,
+  type ChatAttachment,
+  type ModelSelection,
+  type OrchestrationCommand,
+  type OrchestrationForkThreadInput,
+  type OrchestrationForkThreadResult,
+  type ThreadForkContext,
+  type ThreadForkSeedMessage,
+  type ThreadForkSourceTurn,
+  type TurnId,
+} from "@t3tools/contracts";
+import { buildTemporaryWorktreeBranchName } from "@t3tools/shared/git";
+import * as Cause from "effect/Cause";
+import * as Crypto from "effect/Crypto";
+import * as Deferred from "effect/Deferred";
+import * as Effect from "effect/Effect";
+import * as Exit from "effect/Exit";
+import * as FileSystem from "effect/FileSystem";
+import * as Option from "effect/Option";
+import * as Schema from "effect/Schema";
+
+import { planAttachmentCopy } from "../attachmentStore.ts";
+import * as CheckpointStore from "../checkpointing/CheckpointStore.ts";
+import * as ServerConfig from "../config.ts";
+import * as GitWorkflowService from "../git/GitWorkflowService.ts";
+import {
+  ProjectionThreadRepository,
+  type ProjectionThread,
+  type ProjectionThreadForkIntent,
+} from "../persistence/Services/ProjectionThreads.ts";
+import { ProjectSetupScriptRunner } from "../project/ProjectSetupScriptRunner.ts";
+import * as ProviderRegistry from "../provider/Services/ProviderRegistry.ts";
+import type { OrchestrationDispatchError } from "./Errors.ts";
+import {
+  ProjectionSnapshotQuery,
+  type ProjectionThreadForkSource,
+  type ProjectionThreadForkSourceToolActivity,
+  type ProjectionThreadForkSourceTurn,
+} from "./Services/ProjectionSnapshotQuery.ts";
+
+/** Practical ceilings on copied history, enforced before any filesystem work. */
+export const THREAD_FORK_MAX_MESSAGES = 2_000;
+export const THREAD_FORK_MAX_HISTORY_BYTES = 8 * 1024 * 1024;
+/** Upper bound on the serialized handoff sent to the destination provider. */
+export const THREAD_FORK_MAX_CONTEXT_CHARS = 100_000;
+export const THREAD_FORK_TRUNCATION_MARKER =
+  "[Earlier conversation omitted: the forked history was truncated to fit the provider input limit.]";
+/**
+ * Emitted when even the most recent exchange alone exceeds the cap. The
+ * handoff then carries the tail of that exchange, and says so, rather than
+ * pretending whole exchanges were the only unit dropped.
+ */
+export const THREAD_FORK_PARTIAL_EXCHANGE_MARKER =
+  "[Partial exchange: the most recent exchange alone exceeded the provider input limit, so only its ending is included below.]";
+/** Bounds on the tool summaries included per copied turn. */
+export const THREAD_FORK_MAX_TOOL_SUMMARIES_PER_TURN = 20;
+export const THREAD_FORK_MAX_TOOL_SUMMARY_CHARS = 200;
+
+export class ThreadForkError extends Schema.TaggedErrorClass<ThreadForkError>()("ThreadForkError", {
+  message: Schema.String,
+  cause: Schema.optional(Schema.Defect()),
+}) {}
+
+const isThreadForkError = Schema.is(ThreadForkError);
+
+export interface ThreadForkDependencies {
+  readonly dispatch: (
+    command: OrchestrationCommand,
+  ) => Effect.Effect<{ readonly sequence: number }, OrchestrationDispatchError>;
+  /**
+   * Invoked once, after durable commit, when this call created a new worktree
+   * for the fork (ws uses it to refresh git status). Never invoked on retries.
+   */
+  readonly onWorktreeCreated?: (worktreePath: string) => Effect.Effect<void>;
+}
+
+export interface ThreadForkRunner {
+  /**
+   * Fork a thread. Concurrent requests with the same command id and the same
+   * intent share one execution; a retry after success returns the same created
+   * fork via the engine's command receipt without redoing filesystem work.
+   */
+  readonly forkThread: (
+    input: OrchestrationForkThreadInput,
+    deps: ThreadForkDependencies,
+  ) => Effect.Effect<OrchestrationForkThreadResult, ThreadForkError>;
+}
+
+export interface ThreadForkHistorySelection {
+  readonly selectedTurn: ProjectionThreadForkSourceTurn;
+  readonly seedMessages: ReadonlyArray<ThreadForkSeedMessage>;
+  readonly sourceTurns: ReadonlyArray<ThreadForkSourceTurn>;
+  /** Completed tool summaries of the seeded turns, in source order. */
+  readonly toolActivities: ReadonlyArray<ProjectionThreadForkSourceToolActivity>;
+}
+
+export type ThreadForkHistorySelectionResult =
+  | { readonly ok: true; readonly selection: ThreadForkHistorySelection }
+  | { readonly ok: false; readonly message: string };
+
+const isSeedableTurn = (
+  turn: ProjectionThreadForkSourceTurn,
+): turn is ProjectionThreadForkSourceTurn & {
+  readonly turnId: TurnId;
+  readonly completedAt: string;
+} => turn.turnId !== null && turn.state === "completed" && turn.completedAt !== null;
+
+/**
+ * Pick the visible history through `sourceTurnId` using the ordered projection
+ * turns as the boundary, so a source thread that keeps running newer turns
+ * (even ones whose messages share timestamps with the selected turn) never
+ * leaks later content into the fork. Streaming messages are never copied.
+ */
+export function selectForkHistory(
+  source: ProjectionThreadForkSource,
+  sourceTurnId: TurnId,
+): ThreadForkHistorySelectionResult {
+  const selectedIndex = source.turns.findIndex((turn) => turn.turnId === sourceTurnId);
+  const selectedTurn = selectedIndex >= 0 ? source.turns[selectedIndex] : undefined;
+  if (selectedTurn === undefined) {
+    return { ok: false, message: `Turn '${sourceTurnId}' was not found on the source thread.` };
+  }
+  if (selectedTurn.state !== "completed" || selectedTurn.completedAt === null) {
+    return {
+      ok: false,
+      message: `Turn '${sourceTurnId}' is ${selectedTurn.state}; only a completed turn can be forked.`,
+    };
+  }
+  const selectedCompletedAt = selectedTurn.completedAt;
+
+  const includedTurns = source.turns.slice(0, selectedIndex + 1);
+  const laterTurns = source.turns.slice(selectedIndex + 1);
+  const nextTurn = laterTurns[0];
+  const includedTurnIds = new Set<TurnId>();
+  const includedPendingMessageIds = new Set<string>();
+  for (const turn of includedTurns) {
+    if (turn.turnId !== null) includedTurnIds.add(turn.turnId);
+    if (turn.pendingMessageId !== null) includedPendingMessageIds.add(turn.pendingMessageId);
+  }
+  const laterTurnIds = new Set<TurnId>();
+  const laterPendingMessageIds = new Set<string>();
+  for (const turn of laterTurns) {
+    if (turn.turnId !== null) laterTurnIds.add(turn.turnId);
+    if (turn.pendingMessageId !== null) laterPendingMessageIds.add(turn.pendingMessageId);
+  }
+
+  const seedableTurnIds = new Set<TurnId>(
+    includedTurns.filter(isSeedableTurn).map((turn) => turn.turnId),
+  );
+
+  const isBeforeBoundary = (createdAt: string) =>
+    nextTurn !== undefined ? createdAt < nextTurn.requestedAt : createdAt <= selectedCompletedAt;
+
+  const seedMessages: Array<ThreadForkSeedMessage> = [];
+  const seededMessageIds = new Set<string>();
+  for (const message of source.messages) {
+    if (message.streaming) continue;
+    let include: boolean;
+    if (message.turnId !== null) {
+      include = includedTurnIds.has(message.turnId)
+        ? true
+        : laterTurnIds.has(message.turnId)
+          ? false
+          : isBeforeBoundary(message.createdAt);
+    } else if (laterPendingMessageIds.has(message.id)) {
+      include = false;
+    } else if (includedPendingMessageIds.has(message.id)) {
+      include = true;
+    } else {
+      include = isBeforeBoundary(message.createdAt);
+    }
+    if (!include) continue;
+    seededMessageIds.add(message.id);
+    seedMessages.push({
+      sourceMessageId: message.id,
+      sourceTurnId:
+        message.turnId !== null && seedableTurnIds.has(message.turnId) ? message.turnId : null,
+      role: message.role,
+      ...(message.channel !== undefined ? { channel: message.channel } : {}),
+      text: message.text,
+      ...(message.attachments !== undefined && message.attachments.length > 0
+        ? { attachments: message.attachments }
+        : {}),
+      createdAt: message.createdAt,
+      updatedAt: message.updatedAt,
+    });
+  }
+
+  const sourceTurns: Array<ThreadForkSourceTurn> = includedTurns
+    .filter(isSeedableTurn)
+    .map((turn) => ({
+      sourceTurnId: turn.turnId,
+      sourceUserMessageId:
+        turn.pendingMessageId !== null && seededMessageIds.has(turn.pendingMessageId)
+          ? turn.pendingMessageId
+          : null,
+      sourceAssistantMessageId:
+        turn.assistantMessageId !== null && seededMessageIds.has(turn.assistantMessageId)
+          ? turn.assistantMessageId
+          : null,
+      requestedAt: turn.requestedAt,
+      startedAt: turn.startedAt,
+      completedAt: turn.completedAt,
+    }));
+
+  const toolActivities = source.toolActivities.filter((activity) =>
+    seedableTurnIds.has(activity.turnId),
+  );
+
+  return { ok: true, selection: { selectedTurn, seedMessages, sourceTurns, toolActivities } };
+}
+
+export interface ThreadForkContextText {
+  readonly text: string;
+  /** Whole older exchanges were dropped, or the last exchange was cut. */
+  readonly truncated: boolean;
+  /** The most recent exchange alone exceeded the cap and is included in part. */
+  readonly partialLastExchange: boolean;
+}
+
+function renderToolActivityBlock(
+  summaries: ReadonlyArray<ProjectionThreadForkSourceToolActivity>,
+): string | null {
+  const lines: Array<string> = [];
+  for (const activity of summaries) {
+    const summary = activity.summary.trim();
+    if (summary.length === 0) continue;
+    if (lines.length === THREAD_FORK_MAX_TOOL_SUMMARIES_PER_TURN) {
+      lines.push(`… and ${summaries.length - lines.length} more tool calls`);
+      break;
+    }
+    lines.push(
+      `- ${
+        summary.length > THREAD_FORK_MAX_TOOL_SUMMARY_CHARS
+          ? `${summary.slice(0, THREAD_FORK_MAX_TOOL_SUMMARY_CHARS - 1)}…`
+          : summary
+      }`,
+    );
+  }
+  return lines.length === 0 ? null : `## Tool activity\n${lines.join("\n")}`;
+}
+
+/**
+ * Serialize the visible exchanges (user prompts, the source thread's rendered
+ * tool summaries, and canonical assistant replies; reasoning is display-only)
+ * into the provider handoff. When the result exceeds the cap, whole oldest
+ * exchanges are dropped first. If the most recent exchange alone still does
+ * not fit, its ending is kept and labeled as partial.
+ */
+export function buildForkContextText(
+  seedMessages: ReadonlyArray<ThreadForkSeedMessage>,
+  maxChars: number = THREAD_FORK_MAX_CONTEXT_CHARS,
+  toolActivities: ReadonlyArray<ProjectionThreadForkSourceToolActivity> = [],
+  sourceTurns: ReadonlyArray<ThreadForkSourceTurn> = [],
+): ThreadForkContextText {
+  const toolsByTurn = new Map<TurnId, Array<ProjectionThreadForkSourceToolActivity>>();
+  for (const activity of toolActivities) {
+    const list = toolsByTurn.get(activity.turnId);
+    if (list === undefined) toolsByTurn.set(activity.turnId, [activity]);
+    else list.push(activity);
+  }
+  // User prompts carry no turn id in the projection; the turn row links them.
+  const turnByUserMessageId = new Map<string, TurnId>();
+  for (const turn of sourceTurns) {
+    if (turn.sourceUserMessageId !== null) {
+      turnByUserMessageId.set(turn.sourceUserMessageId, turn.sourceTurnId);
+    }
+  }
+  const takeToolBlock = (turnId: TurnId | null) => {
+    if (turnId === null) return null;
+    const tools = toolsByTurn.get(turnId);
+    if (tools === undefined) return null;
+    toolsByTurn.delete(turnId);
+    return renderToolActivityBlock(tools);
+  };
+
+  const exchanges: Array<Array<string>> = [];
+  for (const message of seedMessages) {
+    if (isReasoningMessage(message)) continue;
+    const text = message.text.trim();
+    if (text.length === 0) continue;
+    const block = `## ${message.role === "user" ? "User" : "Assistant"}\n${text}`;
+    if (message.role === "user") {
+      exchanges.push([block]);
+      // Tool calls happen between the prompt and the reply; place them there once.
+      const toolBlock = takeToolBlock(
+        turnByUserMessageId.get(message.sourceMessageId) ?? message.sourceTurnId,
+      );
+      if (toolBlock !== null) exchanges[exchanges.length - 1]!.push(toolBlock);
+    } else {
+      if (exchanges.length === 0) exchanges.push([]);
+      const toolBlock = takeToolBlock(message.sourceTurnId);
+      if (toolBlock !== null) exchanges[exchanges.length - 1]!.push(toolBlock);
+      exchanges[exchanges.length - 1]!.push(block);
+    }
+  }
+  const render = (groups: ReadonlyArray<ReadonlyArray<string>>) =>
+    groups.map((group) => group.join("\n\n")).join("\n\n");
+
+  let text = render(exchanges);
+  if (text.length <= maxChars) {
+    return { text, truncated: false, partialLastExchange: false };
+  }
+  const budget = Math.max(0, maxChars - THREAD_FORK_TRUNCATION_MARKER.length - 2);
+  let retained = exchanges;
+  while (retained.length > 1 && render(retained).length > budget) {
+    retained = retained.slice(1);
+  }
+  text = render(retained);
+  if (text.length <= budget) {
+    return {
+      text: `${THREAD_FORK_TRUNCATION_MARKER}\n\n${text}`,
+      truncated: true,
+      partialLastExchange: false,
+    };
+  }
+  const partialBudget = Math.max(0, budget - THREAD_FORK_PARTIAL_EXCHANGE_MARKER.length - 2);
+  return {
+    text: `${THREAD_FORK_TRUNCATION_MARKER}\n${THREAD_FORK_PARTIAL_EXCHANGE_MARKER}\n\n${text.slice(text.length - partialBudget)}`,
+    truncated: true,
+    partialLastExchange: true,
+  };
+}
+
+const TRUNCATION_WARNING = `The handoff sent to the provider was truncated to ${THREAD_FORK_MAX_CONTEXT_CHARS} characters; the fork still shows the full copied history.`;
+const PARTIAL_EXCHANGE_WARNING =
+  "The most recent exchange alone exceeded the provider input limit, so only its ending was sent to the provider; the fork still shows the full copied history.";
+
+const forkErrorFromCause = (cause: Cause.Cause<unknown>, fallback: string): ThreadForkError => {
+  const failure = Cause.findErrorOption(cause);
+  if (Option.isSome(failure)) {
+    const error = failure.value;
+    if (isThreadForkError(error)) return error;
+    return new ThreadForkError({
+      message: error instanceof Error && error.message.length > 0 ? error.message : fallback,
+      cause: error,
+    });
+  }
+  return new ThreadForkError({ message: fallback, cause: Cause.squash(cause) });
+};
+
+/** Structural equality for JSON-shaped values (model option selections). */
+function jsonValueEquals(left: unknown, right: unknown): boolean {
+  if (left === right) return true;
+  if (typeof left !== "object" || typeof right !== "object" || left === null || right === null) {
+    return false;
+  }
+  if (Array.isArray(left) || Array.isArray(right)) {
+    if (!Array.isArray(left) || !Array.isArray(right) || left.length !== right.length) return false;
+    return left.every((value, index) => jsonValueEquals(value, right[index]));
+  }
+  const leftRecord = left as Record<string, unknown>;
+  const rightRecord = right as Record<string, unknown>;
+  const leftKeys = Object.keys(leftRecord).filter((key) => leftRecord[key] !== undefined);
+  const rightKeys = Object.keys(rightRecord).filter((key) => rightRecord[key] !== undefined);
+  if (leftKeys.length !== rightKeys.length) return false;
+  return leftKeys.every(
+    (key) => key in rightRecord && jsonValueEquals(leftRecord[key], rightRecord[key]),
+  );
+}
+
+function sameModelSelection(left: ModelSelection, right: ModelSelection): boolean {
+  return (
+    left.instanceId === right.instanceId &&
+    left.model === right.model &&
+    jsonValueEquals(left.options ?? null, right.options ?? null)
+  );
+}
+
+/**
+ * Semantic fork intent: everything a client chooses, minus the per-call
+ * `createdAt` stamp. Two requests with equal intent describe the same fork.
+ */
+interface ForkIntent extends ProjectionThreadForkIntent {
+  readonly sourceThreadId: string;
+  readonly sourceTurnId: string;
+  readonly threadId: string;
+}
+
+const forkIntentOf = (input: OrchestrationForkThreadInput): ForkIntent => ({
+  sourceThreadId: input.sourceThreadId,
+  sourceTurnId: input.sourceTurnId,
+  threadId: input.threadId,
+  title: input.title,
+  modelSelection: input.modelSelection,
+  runtimeMode: input.runtimeMode,
+  interactionMode: input.interactionMode,
+  workspaceMode: input.workspaceMode,
+});
+
+/** Names the first field that differs, or null when the intents match. */
+function describeIntentMismatch(
+  expected: ProjectionThreadForkIntent &
+    Partial<Pick<ForkIntent, "sourceThreadId" | "sourceTurnId" | "threadId">>,
+  actual: ForkIntent,
+): string | null {
+  if (expected.sourceThreadId !== undefined && expected.sourceThreadId !== actual.sourceThreadId) {
+    return "source thread";
+  }
+  if (expected.sourceTurnId !== undefined && expected.sourceTurnId !== actual.sourceTurnId) {
+    return "source turn";
+  }
+  if (expected.threadId !== undefined && expected.threadId !== actual.threadId) {
+    return "destination thread";
+  }
+  if (expected.title !== actual.title) return "title";
+  if (!sameModelSelection(expected.modelSelection, actual.modelSelection)) return "model";
+  if (expected.runtimeMode !== actual.runtimeMode) return "runtime mode";
+  if (expected.interactionMode !== actual.interactionMode) return "interaction mode";
+  if (expected.workspaceMode !== actual.workspaceMode) return "workspace mode";
+  return null;
+}
+
+/** Mutable per-call ownership record shared by the runner and its finalizer. */
+interface ForkRunState {
+  /** Git cwd of the source (its worktree or workspace root); set before any git work. */
+  sourceCwd: string | null;
+  copiedPaths: Array<string>;
+  worktree: { readonly path: string; readonly refName: string } | null;
+  /** The materialize command was handed to the engine; its outcome may be unknown. */
+  dispatchAttempted: boolean;
+  /** Set only once the engine acknowledged the commit; never cleaned up after. */
+  committedResult: OrchestrationForkThreadResult | null;
+}
+
+export const makeThreadForkRunner: Effect.Effect<
+  ThreadForkRunner,
+  never,
+  | ProjectionSnapshotQuery
+  | ProjectionThreadRepository
+  | ProviderRegistry.ProviderRegistry
+  | GitWorkflowService.GitWorkflowService
+  | CheckpointStore.CheckpointStore
+  | ProjectSetupScriptRunner
+  | ServerConfig.ServerConfig
+  | FileSystem.FileSystem
+  | Crypto.Crypto
+> = Effect.gen(function* () {
+  const snapshotQuery = yield* ProjectionSnapshotQuery;
+  const threadRepository = yield* ProjectionThreadRepository;
+  const providerRegistry = yield* ProviderRegistry.ProviderRegistry;
+  const gitWorkflow = yield* GitWorkflowService.GitWorkflowService;
+  const checkpointStore = yield* CheckpointStore.CheckpointStore;
+  const projectSetupScriptRunner = yield* ProjectSetupScriptRunner;
+  const config = yield* ServerConfig.ServerConfig;
+  const fileSystem = yield* FileSystem.FileSystem;
+  const crypto = yield* Crypto.Crypto;
+
+  const inFlightForks = new Map<
+    string,
+    {
+      readonly intent: ForkIntent;
+      readonly deferred: Deferred.Deferred<OrchestrationForkThreadResult, ThreadForkError>;
+    }
+  >();
+
+  const fail = (message: string) => Effect.fail(new ThreadForkError({ message }));
+
+  // Raw projection row, including deleted and archived threads: a deleted fork
+  // must be reported as such rather than treated as a free destination id.
+  const readDestinationRow = (threadId: OrchestrationForkThreadInput["threadId"]) =>
+    threadRepository
+      .getById({ threadId })
+      .pipe(
+        Effect.mapError(
+          (cause) =>
+            new ThreadForkError({ message: "Failed to read the destination thread.", cause }),
+        ),
+      );
+
+  const lineageMatches = (row: ProjectionThread, intent: ForkIntent) =>
+    row.forkedFromThreadId === intent.sourceThreadId &&
+    row.forkedFromTurnId === intent.sourceTurnId;
+
+  const warningsFromContext = (context: ThreadForkContext | null | undefined) => {
+    const warnings: Array<string> = [];
+    if (context?.truncated) {
+      warnings.push(TRUNCATION_WARNING);
+      if (context.text.includes(THREAD_FORK_PARTIAL_EXCHANGE_MARKER)) {
+        warnings.push(PARTIAL_EXCHANGE_WARNING);
+      }
+    }
+    return warnings;
+  };
+
+  const runFork = Effect.fn("threadFork.runFork")(function* (
+    input: OrchestrationForkThreadInput,
+    deps: ThreadForkDependencies,
+    state: ForkRunState,
+  ) {
+    const dispatch = (command: OrchestrationCommand) =>
+      deps
+        .dispatch(command)
+        .pipe(
+          Effect.catchCause((cause) =>
+            Effect.fail(forkErrorFromCause(cause, "Failed to materialize the forked thread.")),
+          ),
+        );
+    const intent = forkIntentOf(input);
+    const forkedFrom = { threadId: input.sourceThreadId, turnId: input.sourceTurnId };
+
+    // Retry of an already-materialized fork: the engine receipt keyed by this
+    // command id returns the original sequence without running the decider or
+    // touching the filesystem again. The destination must have been created by
+    // this same fork intent, and must still exist.
+    const existingRow = yield* readDestinationRow(input.threadId);
+    if (Option.isSome(existingRow)) {
+      const row = existingRow.value;
+      if (!lineageMatches(row, intent)) {
+        return yield* fail(
+          `Thread '${input.threadId}' already exists and is not a fork of turn '${input.sourceTurnId}'.`,
+        );
+      }
+      const mismatch =
+        row.forkIntent === undefined || row.forkIntent === null
+          ? null
+          : describeIntentMismatch(row.forkIntent, intent);
+      if (mismatch !== null) {
+        return yield* fail(
+          `Thread '${input.threadId}' was already created by a fork request with a different ${mismatch}; retries must repeat the original request.`,
+        );
+      }
+      if (row.deletedAt !== null) {
+        return yield* fail(
+          `Fork thread '${input.threadId}' was created earlier and has since been deleted; start a new fork with a new thread id.`,
+        );
+      }
+      const { sequence } = yield* dispatch({
+        type: "thread.fork.materialize",
+        commandId: input.commandId,
+        threadId: input.threadId,
+        projectId: row.projectId,
+        title: input.title,
+        modelSelection: input.modelSelection,
+        runtimeMode: input.runtimeMode,
+        interactionMode: input.interactionMode,
+        branch: null,
+        worktreePath: null,
+        workspaceMode: input.workspaceMode,
+        forkedFrom,
+        forkContext: { text: "", attachments: [], truncated: false },
+        seedMessages: [],
+        sourceTurns: [],
+        createdAt: input.createdAt,
+      });
+      return {
+        sequence,
+        threadId: input.threadId,
+        // Attachment-skip warnings are not persisted; the truncation state is.
+        warnings: warningsFromContext(row.forkContext),
+      } satisfies OrchestrationForkThreadResult;
+    }
+
+    const sourceOption = yield* snapshotQuery
+      .getThreadForkSource(input.sourceThreadId)
+      .pipe(
+        Effect.mapError(
+          (cause) => new ThreadForkError({ message: "Failed to read the source thread.", cause }),
+        ),
+      );
+    if (Option.isNone(sourceOption)) {
+      return yield* fail(`Source thread '${input.sourceThreadId}' was not found.`);
+    }
+    const source = sourceOption.value;
+
+    const history = selectForkHistory(source, input.sourceTurnId);
+    if (!history.ok) {
+      return yield* fail(history.message);
+    }
+    const { selectedTurn, sourceTurns, toolActivities } = history.selection;
+    if (history.selection.seedMessages.length > THREAD_FORK_MAX_MESSAGES) {
+      return yield* fail(
+        `The selected history has ${history.selection.seedMessages.length} messages, above the fork limit of ${THREAD_FORK_MAX_MESSAGES}. Fork from an earlier turn.`,
+      );
+    }
+    const historyBytes = history.selection.seedMessages.reduce(
+      (total, message) => total + Buffer.byteLength(message.text, "utf8"),
+      0,
+    );
+    if (historyBytes > THREAD_FORK_MAX_HISTORY_BYTES) {
+      return yield* fail(
+        `The selected history is ${historyBytes} bytes of text, above the fork limit of ${THREAD_FORK_MAX_HISTORY_BYTES} bytes. Fork from an earlier turn.`,
+      );
+    }
+
+    // Destination model must exist on a usable provider instance. The provider
+    // is never started here; the fork's first send does that.
+    const providers = yield* providerRegistry.getProviders;
+    const instanceId = input.modelSelection.instanceId;
+    const provider = providers.find((candidate) => candidate.instanceId === instanceId);
+    if (provider === undefined) {
+      return yield* fail(`Provider instance '${instanceId}' is not configured on this server.`);
+    }
+    if (!provider.enabled) {
+      return yield* fail(`Provider instance '${instanceId}' is disabled.`);
+    }
+    if (!provider.installed) {
+      return yield* fail(`Provider instance '${instanceId}' is not installed.`);
+    }
+    const model = input.modelSelection.model;
+    if (
+      provider.models.length > 0 &&
+      !provider.models.some((entry) => entry.slug === model || entry.aliases?.includes(model))
+    ) {
+      return yield* fail(`Model '${model}' is not available on provider instance '${instanceId}'.`);
+    }
+
+    // A new worktree needs a ready checkpoint for exactly the selected turn;
+    // there is no HEAD fallback because HEAD is not the state the user chose.
+    const sourceCwd = source.thread.worktreePath ?? source.thread.workspaceRoot;
+    state.sourceCwd = sourceCwd;
+    let checkpointRef: ProjectionThreadForkSourceTurn["checkpointRef"] = null;
+    if (input.workspaceMode === "new-worktree") {
+      if (selectedTurn.checkpointRef === null || selectedTurn.checkpointStatus !== "ready") {
+        return yield* fail(
+          `Turn '${input.sourceTurnId}' has no ready checkpoint, so a new worktree cannot be created from it. Fork into the shared workspace instead.`,
+        );
+      }
+      checkpointRef = selectedTurn.checkpointRef;
+      const hasRef = yield* checkpointStore
+        .hasCheckpointRef({ cwd: sourceCwd, checkpointRef })
+        .pipe(
+          Effect.mapError(
+            (cause) =>
+              new ThreadForkError({
+                message: `Failed to look up the checkpoint for turn '${input.sourceTurnId}'.`,
+                cause,
+              }),
+          ),
+        );
+      if (!hasRef) {
+        return yield* fail(
+          `The checkpoint for turn '${input.sourceTurnId}' is missing from the repository, so a new worktree cannot be created from it. Fork into the shared workspace instead.`,
+        );
+      }
+    }
+
+    const warnings: Array<string> = [];
+    const copies: Array<{ readonly sourcePath: string; readonly destinationPath: string }> = [];
+    const copiedAttachments: Array<ChatAttachment> = [];
+    const seedMessages: Array<ThreadForkSeedMessage> = history.selection.seedMessages.map(
+      (message) => {
+        if (message.attachments === undefined) return message;
+        const kept: Array<ChatAttachment> = [];
+        for (const attachment of message.attachments) {
+          const plan = planAttachmentCopy({
+            attachmentsDir: config.attachmentsDir,
+            attachment,
+            destinationThreadId: input.threadId,
+          });
+          if (!plan.ok) {
+            warnings.push(`Attachment '${attachment.name}' was not copied: ${plan.reason}.`);
+            continue;
+          }
+          copies.push({ sourcePath: plan.sourcePath, destinationPath: plan.destinationPath });
+          copiedAttachments.push(plan.attachment);
+          kept.push(plan.attachment);
+        }
+        const { attachments: _dropped, ...rest } = message;
+        return kept.length > 0 ? { ...rest, attachments: kept } : rest;
+      },
+    );
+
+    const rendered = buildForkContextText(
+      seedMessages,
+      THREAD_FORK_MAX_CONTEXT_CHARS,
+      toolActivities,
+      sourceTurns,
+    );
+    if (rendered.truncated) warnings.push(TRUNCATION_WARNING);
+    if (rendered.partialLastExchange) warnings.push(PARTIAL_EXCHANGE_WARNING);
+    const forkContext: ThreadForkContext = {
+      text: rendered.text,
+      attachments: copiedAttachments,
+      truncated: rendered.truncated,
+    };
+
+    // Everything below creates resources this operation owns. Acquisition runs
+    // under an interruption mask so ownership is always recorded in `state`
+    // before the finalizer can observe it; interruption is honored only at the
+    // explicit checkpoints between steps, while nothing is half-created.
+    return yield* Effect.uninterruptibleMask((restore) =>
+      Effect.gen(function* () {
+        for (const copy of copies) {
+          yield* fileSystem.copyFile(copy.sourcePath, copy.destinationPath).pipe(
+            Effect.mapError(
+              (cause) =>
+                new ThreadForkError({
+                  message: "Failed to copy an attachment for the fork.",
+                  cause,
+                }),
+            ),
+          );
+          state.copiedPaths.push(copy.destinationPath);
+          yield* restore(Effect.yieldNow);
+        }
+
+        let branch = source.thread.branch;
+        let worktreePath = source.thread.worktreePath;
+        if (checkpointRef !== null) {
+          const randomHex = yield* crypto.randomUUIDv4.pipe(
+            Effect.map((uuid) => uuid.replace(/-/g, "")),
+            Effect.mapError(
+              (cause) =>
+                new ThreadForkError({
+                  message: "Failed to generate a branch name for the fork worktree.",
+                  cause,
+                }),
+            ),
+          );
+          const created = yield* gitWorkflow
+            .createWorktree({
+              cwd: sourceCwd,
+              // Normal ancestry: branch from the source branch (or the real HEAD
+              // when detached), then restore the checkpoint tree on top.
+              refName: source.thread.branch ?? "HEAD",
+              newRefName: buildTemporaryWorktreeBranchName(() => randomHex),
+              path: null,
+            })
+            .pipe(
+              Effect.mapError(
+                (cause) =>
+                  new ThreadForkError({
+                    message: `Failed to create a worktree for the fork: ${cause.message}`,
+                    cause,
+                  }),
+              ),
+            );
+          state.worktree = created.worktree;
+          const restored = yield* checkpointStore
+            .restoreCheckpoint({
+              cwd: created.worktree.path,
+              checkpointRef,
+              fallbackToHead: false,
+            })
+            .pipe(
+              Effect.mapError(
+                (cause) =>
+                  new ThreadForkError({
+                    message: `Failed to restore the checkpoint for turn '${input.sourceTurnId}' into the new worktree.`,
+                    cause,
+                  }),
+              ),
+            );
+          if (!restored) {
+            return yield* fail(
+              `The checkpoint for turn '${input.sourceTurnId}' disappeared before it could be restored into the new worktree.`,
+            );
+          }
+          branch = created.worktree.refName;
+          worktreePath = created.worktree.path;
+        }
+
+        // Last chance to honor a caller interruption before anything durable.
+        yield* restore(Effect.yieldNow);
+
+        state.dispatchAttempted = true;
+        const { sequence } = yield* dispatch({
+          type: "thread.fork.materialize",
+          commandId: input.commandId,
+          threadId: input.threadId,
+          projectId: source.thread.projectId,
+          title: input.title,
+          modelSelection: input.modelSelection,
+          runtimeMode: input.runtimeMode,
+          interactionMode: input.interactionMode,
+          branch,
+          worktreePath,
+          workspaceMode: input.workspaceMode,
+          forkedFrom,
+          forkContext,
+          seedMessages,
+          sourceTurns,
+          createdAt: input.createdAt,
+        });
+        const result = {
+          sequence,
+          threadId: input.threadId,
+          warnings,
+        } satisfies OrchestrationForkThreadResult;
+        state.committedResult = result;
+
+        // Post-commit, worktree-only follow-ups. A failure here is a warning
+        // on a fork that is kept; the setup script never starts the provider.
+        // Retries never reach this point, so setup runs at most once per fork.
+        if (state.worktree !== null) {
+          if (deps.onWorktreeCreated !== undefined) {
+            yield* deps.onWorktreeCreated(state.worktree.path);
+          }
+          yield* projectSetupScriptRunner
+            .runForThread({
+              threadId: input.threadId,
+              projectId: source.thread.projectId,
+              projectCwd: source.thread.workspaceRoot,
+              worktreePath: state.worktree.path,
+            })
+            .pipe(
+              Effect.catchCause((cause) =>
+                Effect.sync(() => {
+                  warnings.push(
+                    `The project setup script could not be started in the new worktree: ${
+                      forkErrorFromCause(cause, "unknown error").message
+                    }. The fork and its worktree were kept.`,
+                  );
+                }),
+              ),
+            );
+        }
+        return result;
+      }),
+    );
+  });
+
+  // Removes only what this call created, in dependency order: the worktree
+  // first, then its exact branch (never the source branch or any other ref),
+  // then the copied attachment files. Errors are logged, never rethrown.
+  const cleanupOwnedResources = (state: ForkRunState) =>
+    Effect.gen(function* () {
+      const worktree = state.worktree;
+      const sourceCwd = state.sourceCwd;
+      if (worktree !== null && sourceCwd !== null) {
+        const removed = yield* gitWorkflow
+          .removeWorktree({ cwd: sourceCwd, path: worktree.path, force: true })
+          .pipe(
+            Effect.as(true),
+            Effect.catchCause((cause) =>
+              Effect.logWarning(
+                "threadFork: failed to remove the fork worktree during cleanup",
+                cause,
+              ).pipe(Effect.as(false)),
+            ),
+          );
+        if (removed) {
+          yield* gitWorkflow
+            .deleteBranch({ cwd: sourceCwd, branch: worktree.refName })
+            .pipe(Effect.ignoreCause({ log: true }));
+        }
+      }
+      for (const copiedPath of state.copiedPaths) {
+        yield* fileSystem
+          .remove(copiedPath, { force: true })
+          .pipe(Effect.ignoreCause({ log: true }));
+      }
+    });
+
+  // Decides whether a failed or interrupted run may remove its resources. Once
+  // the engine acknowledged the commit the answer is always no. If the command
+  // was dispatched but the outcome is unknown, the destination row is the
+  // authority: a matching fork means committed; a read error means uncertain,
+  // and uncertainty is never permission to delete.
+  const finalizeFailedRun = (input: OrchestrationForkThreadInput, state: ForkRunState) =>
+    Effect.gen(function* () {
+      if (state.committedResult !== null) return;
+      if (state.worktree === null && state.copiedPaths.length === 0) return;
+      if (state.dispatchAttempted) {
+        const verified = yield* readDestinationRow(input.threadId).pipe(
+          Effect.map((row) => ({ ok: true as const, row })),
+          Effect.catchCause(() => Effect.succeed({ ok: false as const })),
+        );
+        if (!verified.ok) {
+          yield* Effect.logWarning(
+            `threadFork: could not verify whether fork '${input.threadId}' was committed; keeping its resources.`,
+          );
+          return;
+        }
+        // A row under this id (ours after all, or a foreign thread) means the
+        // resources may be in use; only a confirmed absence permits cleanup.
+        if (Option.isSome(verified.row)) return;
+      }
+      yield* cleanupOwnedResources(state);
+    });
+
+  const forkThread: ThreadForkRunner["forkThread"] = (input, deps) =>
+    Effect.gen(function* () {
+      const intent = forkIntentOf(input);
+      const existing = inFlightForks.get(input.commandId);
+      if (existing !== undefined) {
+        const mismatch = describeIntentMismatch(existing.intent, intent);
+        if (mismatch !== null) {
+          return yield* fail(
+            `A fork request with command id '${input.commandId}' is already in progress with a different ${mismatch}.`,
+          );
+        }
+        return yield* Deferred.await(existing.deferred);
+      }
+      const deferred = yield* Deferred.make<OrchestrationForkThreadResult, ThreadForkError>();
+      inFlightForks.set(input.commandId, { intent, deferred });
+      const state: ForkRunState = {
+        sourceCwd: null,
+        copiedPaths: [],
+        worktree: null,
+        dispatchAttempted: false,
+        committedResult: null,
+      };
+      return yield* runFork(input, deps, state).pipe(
+        Effect.onExit((exit) =>
+          Effect.gen(function* () {
+            if (!Exit.isSuccess(exit)) {
+              yield* finalizeFailedRun(input, state);
+            }
+            inFlightForks.delete(input.commandId);
+            // Waiters sharing this command id get the committed fork even when
+            // the fiber that did the work was interrupted after commit.
+            yield* Deferred.done(
+              deferred,
+              state.committedResult !== null && !Exit.isSuccess(exit)
+                ? Exit.succeed(state.committedResult)
+                : exit,
+            );
+          }),
+        ),
+      );
+    });
+
+  return { forkThread };
+});
