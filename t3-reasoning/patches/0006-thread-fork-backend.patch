new file mode 100644
index 000000000..7b1cae1d2
--- /dev/null
+++ b/apps/server/src/persistence/ForkSchema.ts
@@ -0,0 +1,59 @@
+/**
+ * Thread fork schema for the projection tables.
+ *
+ * Like the Reasoning schema, fork lineage lives outside the numbered migration
+ * manifest so a nightly rebase never collides with upstream's next migration.
+ * `runMigrations` calls `ensureForkSchema` after the upstream manifest and the
+ * Reasoning schema on every full run; it is idempotent and cheap.
+ *
+ * All columns are nullable: rows written before this build stay valid and read
+ * back as "not a fork".
+ */
+
+import * as Effect from "effect/Effect";
+import * as SqlClient from "effect/unstable/sql/SqlClient";
+
+export const FORK_SCHEMA_COLUMNS = [
+  "forked_from_thread_id",
+  "forked_from_turn_id",
+  "fork_context_json",
+  "fork_handoff_consumed_at",
+  "fork_intent_json",
+] as const;
+
+/**
+ * Adds the nullable fork columns to `projection_threads` when they are
+ * missing. Returns true when at least one column was added.
+ */
+export const ensureForkSchema = Effect.fn("ensureForkSchema")(function* () {
+  const sql = yield* SqlClient.SqlClient;
+  const columns = yield* sql<{ readonly name: string }>`
+    PRAGMA table_info(projection_threads)
+  `;
+  if (columns.length === 0) {
+    return false;
+  }
+  const existing = new Set(columns.map((column) => column.name));
+  let added = false;
+  if (!existing.has("forked_from_thread_id")) {
+    yield* sql`ALTER TABLE projection_threads ADD COLUMN forked_from_thread_id TEXT`;
+    added = true;
+  }
+  if (!existing.has("forked_from_turn_id")) {
+    yield* sql`ALTER TABLE projection_threads ADD COLUMN forked_from_turn_id TEXT`;
+    added = true;
+  }
+  if (!existing.has("fork_context_json")) {
+    yield* sql`ALTER TABLE projection_threads ADD COLUMN fork_context_json TEXT`;
+    added = true;
+  }
+  if (!existing.has("fork_handoff_consumed_at")) {
+    yield* sql`ALTER TABLE projection_threads ADD COLUMN fork_handoff_consumed_at TEXT`;
+    added = true;
+  }
+  if (!existing.has("fork_intent_json")) {
+    yield* sql`ALTER TABLE projection_threads ADD COLUMN fork_intent_json TEXT`;
+    added = true;
+  }
+  return added;
+});
