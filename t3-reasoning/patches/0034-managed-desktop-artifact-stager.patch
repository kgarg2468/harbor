@@ -0,0 +1,116 @@
+import * as NodeAssert from "node:assert/strict";
+import * as NodeFS from "node:fs";
+import * as NodeOS from "node:os";
+import * as NodePath from "node:path";
+import * as NodeProcess from "node:process";
+import * as NodeURL from "node:url";
+import * as NodeChildProcess from "node:child_process";
+import * as NodeTest from "node:test";
+import { MANAGED_DESKTOP_ARTIFACT_MAX_BYTES } from "../../../packages/contracts/src/managedDesktopUpdate.ts";
+import {
+  buildDesktopArtifactHelper,
+  validateDesktopArtifactHelper,
+} from "./build-desktop-artifact-helper.mjs";
+
+const descriptor = [
+  "T3DESKTOP1",
+  "0.0.39-nightly.20260909.0.managed.1.paaaaaaaaaaaa",
+  "reasoning",
+  "3",
+  "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
+  "b".repeat(64),
+  "a".repeat(64),
+  "",
+].join("\n");
+NodeTest.test("unsupported helper targets refuse before compilation", () => {
+  NodeAssert.throws(() =>
+    buildDesktopArtifactHelper({ platform: "linux", arch: "arm64", output: "/unused" }),
+  );
+  NodeAssert.throws(() =>
+    buildDesktopArtifactHelper({ platform: "darwin", arch: "x64", output: "/unused" }),
+  );
+});
+NodeTest.test(
+  "packaged helper self-check and real EOF-before-COMMIT protocol",
+  { skip: NodeProcess.platform !== "darwin" || NodeProcess.arch !== "arm64" },
+  async () => {
+    const root = NodeFS.realpathSync(
+      NodeFS.mkdtempSync(NodePath.join(NodeOS.tmpdir(), "artifact-helper-build-")),
+    );
+    const output = NodePath.join(root, "prod-resources/desktop-artifact/t3-desktop-artifact");
+    try {
+      const nativeTests = NodePath.join(root, "native-tests");
+      NodeChildProcess.execFileSync("/usr/bin/cc", [
+        "-std=c11",
+        "-O2",
+        "-Wall",
+        "-Wextra",
+        "-Werror",
+        "-Wno-deprecated-declarations",
+        "-Wno-unused-function",
+        NodeURL.fileURLToPath(new URL("../../../native/desktop-artifact/test.c", import.meta.url)),
+        "-o",
+        nativeTests,
+      ]);
+      NodeAssert.equal(
+        NodeChildProcess.execFileSync(nativeTests, [], { encoding: "utf8", timeout: 10000 }),
+        "native desktop artifact tests passed (13 groups)\n",
+      );
+      buildDesktopArtifactHelper({ output });
+      validateDesktopArtifactHelper(output);
+      NodeFS.chmodSync(output, 0o600);
+      NodeAssert.throws(() => validateDesktopArtifactHelper(output));
+      NodeFS.chmodSync(output, 0o755);
+      const stage = async (commit, archive = "abc", header = descriptor) => {
+        const child = NodeChildProcess.spawn(output, ["--stage", root], {
+          stdio: ["pipe", "pipe", "pipe", "pipe"],
+        });
+        const lines = [];
+        let buffer = "";
+        const exit = new Promise((resolve, reject) => {
+          child.once("error", reject);
+          child.once("close", resolve);
+        });
+        child.stdout.on("data", (data) => {
+          buffer += data.toString();
+          while (buffer.includes("\n")) {
+            const end = buffer.indexOf("\n");
+            const line = buffer.slice(0, end);
+            buffer = buffer.slice(end + 1);
+            lines.push(line);
+            if (line === "READY") child.stdio[3].end(archive);
+            if (line === "VERIFIED") child.stdin.end(commit ? "COMMIT\n" : "");
+          }
+        });
+        child.stdin.write(header);
+        return { code: await exit, lines };
+      };
+      const parent = NodePath.join(
+        root,
+        "runtime/desktop-artifacts/v1/reasoning-darwin-arm64/0.0.39-nightly.20260909.0.managed.1.paaaaaaaaaaaa",
+      );
+      const aborted = await stage(false);
+      NodeAssert.deepEqual(aborted, { code: 2, lines: ["READY", "VERIFIED"] });
+      NodeAssert.deepEqual(NodeFS.readdirSync(parent), []);
+      const maxHeader = descriptor.replace("\n3\n", `\n${MANAGED_DESKTOP_ARTIFACT_MAX_BYTES}\n`);
+      const overHeader = descriptor.replace(
+        "\n3\n",
+        `\n${MANAGED_DESKTOP_ARTIFACT_MAX_BYTES + 1}\n`,
+      );
+      NodeAssert.deepEqual(await stage(true, "", maxHeader), { code: 2, lines: ["READY"] });
+      NodeAssert.deepEqual(await stage(true, "", overHeader), { code: 2, lines: [] });
+      NodeAssert.deepEqual(await stage(true, "ab"), { code: 2, lines: ["READY"] });
+      NodeAssert.deepEqual(await stage(true), {
+        code: 0,
+        lines: ["READY", "VERIFIED", "PUBLISHED"],
+      });
+      const beforeReuse = NodeFS.readdirSync(parent).sort();
+      for (let i = 0; i < 3; i++) {
+        NodeAssert.deepEqual(await stage(true), { code: 0, lines: ["REUSED"] });
+        NodeAssert.deepEqual(NodeFS.readdirSync(parent).sort(), beforeReuse);
+      }
+    } finally {
+      NodeFS.rmSync(root, { recursive: true, force: true });
+    }
+  },
+);
diff --git a/apps/server/src/cloud/managedDesktopArtifact.test.ts b/apps/server/src/cloud/managedDesktopArtifact.test.ts
