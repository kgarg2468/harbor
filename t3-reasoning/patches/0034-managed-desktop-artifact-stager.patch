+    if (kind == 3) assert(!linkat(dir,"descriptor.json",dir,"other",0));
+    if (kind == 4) { assert(!renameat(dir,"descriptor.json",dir,"other")); assert(!symlinkat("other",dir,"descriptor.json")); }
