index 00000000..fd037b0e
--- /dev/null
+++ b/apps/desktop/scripts/build-desktop-artifact-helper.mjs
@@ -0,0 +1,79 @@
+import * as NodeChildProcess from "node:child_process";
+import * as NodeFS from "node:fs";
+import * as NodePath from "node:path";
+import * as NodeURL from "node:url";
+import * as NodeUtil from "node:util";
+import * as NodeProcess from "node:process";
+
+export function validateDesktopArtifactHelper(file) {
+  const stat = NodeFS.lstatSync(file);
+  if (!stat.isFile() || stat.nlink !== 1 || !(stat.mode & 0o111)) {
+    throw new Error("Desktop artifact helper must be an executable regular file with one link.");
+  }
+  const header = NodeFS.readFileSync(file).subarray(0, 12);
+  if (
+    header.length < 12 ||
+    header.readUInt32LE(0) !== 0xfeedfacf ||
+    header.readUInt32LE(4) !== 0x0100000c
+  ) {
+    throw new Error("Desktop artifact helper must be a Mach-O arm64 executable.");
+  }
+  const output = NodeChildProcess.execFileSync(file, ["--self-check"], {
+    encoding: "utf8",
+    timeout: 10000,
+    maxBuffer: 128,
+  });
+  if (output !== "T3DESKTOP1 darwin arm64\n")
+    throw new Error("Desktop artifact helper self-check failed.");
+}
+
+export function buildDesktopArtifactHelper({
+  output,
+  arch = NodeProcess.arch,
+  platform = NodeProcess.platform,
+}) {
+  if (platform !== "darwin" || arch !== "arm64")
+    throw new Error("Desktop artifact helper requires a macOS arm64 target on macOS.");
+  const source = NodeURL.fileURLToPath(
+    new URL("../../../native/desktop-artifact/main.c", import.meta.url),
+  );
+  NodeFS.mkdirSync(NodePath.dirname(output), { recursive: true });
+  const temporary = `${output}.${NodeProcess.pid}.tmp`;
+  try {
+    NodeChildProcess.execFileSync(
+      "/usr/bin/cc",
+      [
+        "-arch",
+        "arm64",
+        "-std=c11",
+        "-O2",
+        "-Wall",
+        "-Wextra",
+        "-Werror",
+        "-Wno-deprecated-declarations",
+        source,
+        "-o",
+        temporary,
+      ],
+      { stdio: "inherit" },
+    );
+    NodeFS.chmodSync(temporary, 0o755);
+    validateDesktopArtifactHelper(temporary);
+    NodeFS.renameSync(temporary, output);
+    validateDesktopArtifactHelper(output);
+  } finally {
+    NodeFS.rmSync(temporary, { force: true });
+  }
+}
+
+if (
+  NodeProcess.argv[1] &&
+  NodeFS.realpathSync(NodeProcess.argv[1]) ===
+    NodeFS.realpathSync(NodeURL.fileURLToPath(import.meta.url))
+) {
+  const { values } = NodeUtil.parseArgs({
+    options: { output: { type: "string" }, arch: { type: "string", default: NodeProcess.arch } },
+  });
+  if (!values.output) throw new Error("--output is required");
+  buildDesktopArtifactHelper({ output: values.output, arch: values.arch });
+}
diff --git a/apps/desktop/scripts/build-desktop-artifact-helper.test.mjs b/apps/desktop/scripts/build-desktop-artifact-helper.test.mjs
