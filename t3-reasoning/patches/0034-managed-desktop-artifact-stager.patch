@@ -0,0 +1,64 @@
+import * as Schema from "effect/Schema";
+
+export const ManagedDesktopPresentationVariant = Schema.Literals(["managed-nightly", "reasoning"]);
+export type ManagedDesktopPresentationVariant = typeof ManagedDesktopPresentationVariant.Type;
+export const ManagedDesktopReleaseArtifactId = Schema.Literals([
+  "managed-nightly-darwin-arm64",
+  "reasoning-darwin-arm64",
+]);
+export type ManagedDesktopReleaseArtifactId = typeof ManagedDesktopReleaseArtifactId.Type;
+
+/** Anonymous pre-COMMIT spool limit; mirrored by the bundled native helper. */
+export const MANAGED_DESKTOP_ARTIFACT_MAX_BYTES = 512 * 1024 * 1024;
+
+const digest = Schema.String.check(Schema.isPattern(/^[0-9a-f]{64}$/));
+const numeric = "(?:0|[1-9]\\d*)";
+const versionPattern = new RegExp(
+  `^${numeric}\\.${numeric}\\.${numeric}-nightly\\.[1-9]\\d{7}\\.${numeric}\\.managed\\.([1-9]\\d*)\\.p([0-9a-f]{12})$`,
+);
+
+/** Closed wire record. Paths and download URLs are never part of the contract. */
+export const ManagedDesktopArtifactDescriptor = Schema.Struct({
+  schemaVersion: Schema.Literal(1),
+  targetVersion: Schema.String.check(Schema.isPattern(versionPattern)),
+  releaseArtifactId: ManagedDesktopReleaseArtifactId,
+  presentationVariant: ManagedDesktopPresentationVariant,
+  bytes: Schema.Int.check(
+    Schema.isGreaterThan(0),
+    Schema.isLessThanOrEqualTo(MANAGED_DESKTOP_ARTIFACT_MAX_BYTES),
+  ),
+  sha256: digest,
+  manifestSha256: digest,
+  releaseInputSha256: digest,
+})
+  .check(
+    Schema.makeFilter((value) => {
+      const version = versionPattern.exec(value.targetVersion);
+      return (
+        value.releaseArtifactId === `${value.presentationVariant}-darwin-arm64` &&
+        version !== null &&
+        Number.isSafeInteger(Number(version[1])) &&
+        version[2] === value.releaseInputSha256.slice(0, 12)
+      );
+    }),
+  )
+  .annotate({ parseOptions: { onExcessProperty: "error" } });
+export type ManagedDesktopArtifactDescriptor = typeof ManagedDesktopArtifactDescriptor.Type;
+
+const decodeDescriptor = Schema.decodeUnknownSync(ManagedDesktopArtifactDescriptor);
+
+/** Revalidates even typed callers before deriving filesystem segments. */
+export function managedDesktopArtifactStorageSegments(
+  descriptor: ManagedDesktopArtifactDescriptor,
+): ReadonlyArray<string> {
+  const value = decodeDescriptor(descriptor);
+  return [
+    "runtime",
+    "desktop-artifacts",
