+import { describe, expect, it } from "vite-plus/test";
+import * as Schema from "effect/Schema";
+import {
+  ManagedDesktopArtifactDescriptor,
+  MANAGED_DESKTOP_ARTIFACT_MAX_BYTES,
+  managedDesktopArtifactStorageSegments,
+} from "./managedDesktopUpdate.ts";
+
+const descriptor = {
+  schemaVersion: 1 as const,
+  targetVersion: "0.0.39-nightly.20260909.0.managed.1.paaaaaaaaaaaa",
+  releaseArtifactId: "reasoning-darwin-arm64" as const,
+  presentationVariant: "reasoning" as const,
+  bytes: 42,
+  sha256: "b".repeat(64),
+  manifestSha256: "c".repeat(64),
+  releaseInputSha256: "a".repeat(64),
+};
+const decode = Schema.decodeUnknownSync(ManagedDesktopArtifactDescriptor);
+describe("ManagedDesktopArtifactDescriptor", () => {
+  it("accepts both fixed variants and derives only fixed storage segments", () => {
+    expect(decode(descriptor)).toEqual(descriptor);
+    expect(
+      decode({
+        ...descriptor,
+        presentationVariant: "managed-nightly",
+        releaseArtifactId: "managed-nightly-darwin-arm64",
+      }),
+    ).toBeDefined();
+    expect(managedDesktopArtifactStorageSegments(descriptor)).toEqual([
+      "runtime",
+      "desktop-artifacts",
+      "v1",
+      descriptor.releaseArtifactId,
+      descriptor.targetVersion,
+      descriptor.sha256,
+      "archive.zip",
+    ]);
+  });
+  it.each([
+    { path: "/tmp/archive.zip" },
+    { url: "https://example.com/archive.zip" },
+    { schemaVersion: 2 },
+    { bytes: 0 },
+    { bytes: 1.5 },
+    { bytes: Number.MAX_SAFE_INTEGER + 1 },
+    { sha256: "A".repeat(64) },
+    { manifestSha256: "a" },
+    { targetVersion: "../escape" },
+    { targetVersion: "1.2.3" },
+    { targetVersion: "0.0.39-nightly.20260909.0.managed.9007199254740992.paaaaaaaaaaaa" },
+    { releaseInputSha256: "d".repeat(64) },
+    { presentationVariant: "managed-nightly" },
+    { releaseArtifactId: "reasoning-linux-x64" },
+  ])("refuses malformed or extra fields %j", (change) => {
+    expect(() => decode({ ...descriptor, ...change })).toThrow();
+  });
+  it("bounds the anonymous spool at exactly 512 MiB", () => {
+    expect(MANAGED_DESKTOP_ARTIFACT_MAX_BYTES).toBe(536870912);
+    expect(decode({ ...descriptor, bytes: MANAGED_DESKTOP_ARTIFACT_MAX_BYTES }).bytes).toBe(
+      MANAGED_DESKTOP_ARTIFACT_MAX_BYTES,
+    );
+    expect(() =>
+      decode({ ...descriptor, bytes: MANAGED_DESKTOP_ARTIFACT_MAX_BYTES + 1 }),
+    ).toThrow();
+  });
+  it("stays closed when nested in another schema", () => {
+    const nested = Schema.decodeUnknownSync(
+      Schema.Struct({ artifact: ManagedDesktopArtifactDescriptor }),
+    );
+    expect(() => nested({ artifact: { ...descriptor, archivePath: "x" } })).toThrow();
+  });
+});
