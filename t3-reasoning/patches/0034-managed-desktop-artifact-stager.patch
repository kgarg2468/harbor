+static int rename_substitution;
+static int substituting_rename(int a, const char *source, int b, const char *destination, unsigned flags) {
+  int replacement;
+  if (rename_substitution < 2) {
+    assert(!renameat(a, source, a, "held-source")); assert(!mkdirat(a, source, 0700));
+    replacement = openat(a, source, DIRFLAGS); assert(replacement >= 0);
+    descriptor d = fixture(); put(replacement, "descriptor.json", d.record);
+  } else {
+    replacement = openat(a, source, DIRFLAGS); assert(replacement >= 0);
+    assert(!renameat(replacement, "archive.zip", replacement, "held-archive"));
+  }
+  put(replacement, "archive.zip", rename_substitution % 2 ? "abc" : "bad"); close(replacement);
+  return renameatx_np(a, source, b, destination, flags);
+}
+static void test_rename_source_substitution(void) {
+  for (rename_substitution = 0; rename_substitution < 4; ++rename_substitution) {
+    transaction t; setup(&t); feed(&t); rename_call = substituting_rename;
+    assert(publish(&t) == -1); rename_call = renameatx_np;
+    int parent = dup(t.version); cleanup(&t);
+    int replaced = openat(parent, t.d.sha, DIRFLAGS); assert(replaced >= 0);
+    content(replaced, "archive.zip", rename_substitution % 2 ? "abc" : "bad");
+    close(replaced); close(parent); remove_fixture(AT_FDCWD, root);
+  }
+}
+static int rename_exit_mode;
+static int interrupted_rename(int a, const char *source, int b, const char *destination, unsigned flags) {
+  if (rename_exit_mode == 0) { errno = EIO; return -1; }
+  if (rename_exit_mode == 1) _exit(91);
+  assert(!renameatx_np(a, source, b, destination, flags)); _exit(92);
+}
+static void test_prerename_failure_and_process_exit(void) {
+  for (rename_exit_mode = 0; rename_exit_mode < 3; ++rename_exit_mode) {
+    transaction t; setup(&t); feed(&t); rename_call = interrupted_rename;
+    if (rename_exit_mode == 0) { assert(publish(&t) == -1); }
+    else {
+      pid_t child = fork(); assert(child >= 0);
+      if (!child) { publish(&t); _exit(99); }
+      int status; assert(waitpid(child, &status, 0) == child);
+      assert(WIFEXITED(status) && WEXITSTATUS(status) == (rename_exit_mode == 1 ? 91 : 92));
+    }
+    rename_call = renameatx_np;
+    if (rename_exit_mode < 2) { absent(&t); healthy_retry(0); }
+    else { assert(!verify_existing(&t)); healthy_retry(1); }
+    finish(&t);
+  }
+}
+static void test_reuse_files(void) {
+  for (int kind = 0; kind < 5; ++kind) {
+    transaction t; setup(&t); feed(&t); assert(!publish(&t));
+    int dir = openat(t.version, t.d.sha, DIRFLAGS); assert(dir >= 0);
+    if (kind == 0) { int fd = openat(dir,"archive.zip",O_WRONLY); assert(write(fd,"abd",3)==3); close(fd); }
