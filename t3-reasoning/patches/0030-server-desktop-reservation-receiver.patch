+      command.action === "reserve"
+        ? preparation.request.pipe(
+            Effect.flatMap((state) =>
+              state.phase === "preparing" ? preparation.settled : Effect.succeed(state),
+            ),
+            Effect.andThen(reservation.handle(command)),
+          )
+        : reservation.handle(command),
+    );
+    return reservation;
+  }),
+);
