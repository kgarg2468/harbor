+    const coordinator = yield* IdleUpdateCoordinator.IdleUpdateCoordinator;
+    const preparation = yield* IdleUpdatePreparation.IdleUpdatePreparation;
+    const receiver = yield* DesktopTelemetryReceiver.DesktopTelemetryReceiver;
