+/**
+ * UpdateActivityFanout - event fanout whose required consumers own their
+ * deliveries in the UpdateActivity registry.
+ *
+ * Each required consumer gets a fixed queue at construction, so a publish can
+ * never race a late registration, and a lease travels with every queued
+ * event. Ordinary observers read a plain PubSub and hold nothing.
+ *
+ * @module UpdateActivityFanout
+ */
+import * as Effect from "effect/Effect";
+import * as Exit from "effect/Exit";
+import * as PubSub from "effect/PubSub";
+import * as Queue from "effect/Queue";
+import type * as Scope from "effect/Scope";
+import * as Semaphore from "effect/Semaphore";
+import * as Stream from "effect/Stream";
+
+import {
+  UpdateActivityUnavailableError,
+  type ActivityBlocker,
+  type ActivityLease,
+  type UpdateActivityShape,
+} from "./updateActivity.ts";
+
+export interface RequiredSubscription<A> {
+  /** Consumes this consumer's queue in order. Exactly one run per subscription. */
+  readonly run: <E, R>(
+    handle: (event: A) => Effect.Effect<void, E, R>,
+  ) => Effect.Effect<void, E | UpdateActivityUnavailableError, R>;
+}
+
+export interface TrackedFanout<A> {
+  /** Delivers to every live required queue and to observers. A dead required channel is skipped: it is already permanently blocked. */
+  readonly publish: (event: A) => Effect.Effect<void, UpdateActivityUnavailableError>;
+  /** Claims a configured consumer name once. Registration swaps the missing blocker for a not-running one that only a started `run` clears. */
+  readonly subscribeRequired: (
+    name: string,
+  ) => Effect.Effect<RequiredSubscription<A>, UpdateActivityUnavailableError, Scope.Scope>;
+  /** Untracked observer stream; each run subscribes on its own. */
+  readonly streamObservers: Stream.Stream<A>;
+  /** Untracked observer stream subscribed eagerly into the caller's scope. */
+  readonly subscribeObservers: Effect.Effect<Stream.Stream<A>, never, Scope.Scope>;
+}
+
+interface Delivery<A> {
+  readonly event: A;
+  readonly lease: ActivityLease;
+}
+
+interface Channel<A> {
+  readonly consumer: string;
+  readonly queue: Queue.Queue<Delivery<A>>;
+  readonly missing: ActivityBlocker;
+  notRunning: ActivityBlocker | undefined;
+  owned: boolean;
+  running: boolean;
+  closed: boolean;
+  unavailable: ActivityBlocker | undefined;
+}
+
+export const makeTrackedFanout = <A>(
+  activity: UpdateActivityShape,
+  name: string,
+  requiredConsumers: ReadonlyArray<string>,
+): Effect.Effect<TrackedFanout<A>, never, Scope.Scope> =>
+  Effect.gen(function* () {
+    const observers = yield* Effect.acquireRelease(PubSub.unbounded<A>(), PubSub.shutdown);
+    const publishLock = yield* Semaphore.make(1);
+    const channels = new Map<string, Channel<A>>();
+    for (const consumer of requiredConsumers) {
+      channels.set(consumer, {
+        consumer,
+        queue: yield* Queue.unbounded<Delivery<A>>(),
+        missing: activity.block(`required subscriber not registered: ${name}/${consumer}`),
+        notRunning: undefined,
+        owned: false,
+        running: false,
+        closed: false,
+        unavailable: undefined,
+      });
+    }
+    let fanoutUnavailable: ActivityBlocker | undefined;
+    let fanoutClosed = false;
+
+    // Blocker first, diagnostic blockers and pending leases second, in one
+    // synchronous step.
+    const closeChannel = (channel: Channel<A>) =>
+      Effect.sync(() => {
+        if (channel.closed) return;
+        channel.closed = true;
+        channel.unavailable ??= activity.block(
+          `required subscriber unavailable: ${name}/${channel.consumer}`,
+        );
+        channel.missing.clear();
+        channel.notRunning?.clear();
+        for (
+          let item = Queue.takeUnsafe(channel.queue);
+          item !== undefined && Exit.isSuccess(item);
+          item = Queue.takeUnsafe(channel.queue)
+        ) {
+          item.value.lease.release();
+        }
+      }).pipe(Effect.andThen(Queue.shutdown(channel.queue)));
+
+    yield* Effect.addFinalizer(() =>
+      Effect.sync(() => {
+        fanoutClosed = true;
+      }).pipe(Effect.andThen(Effect.forEach(channels.values(), closeChannel, { discard: true }))),
+    );
+
+    const acquireDeliveries = Effect.gen(function* () {
+      const leases: Array<ActivityLease> = [];
+      for (const channel of channels.values()) {
+        const lease = yield* Effect.exit(activity.acquire(`${name} delivery ${channel.consumer}`));
+        if (Exit.isFailure(lease)) {
+          for (const acquired of leases) acquired.release();
+          return yield* Effect.failCause(lease.cause);
+        }
+        leases.push(lease.value);
+      }
+      return leases;
+    });
+
+    const deliver = (event: A, leases: ReadonlyArray<ActivityLease>) =>
+      Effect.suspend(() => {
+        let index = 0;
+        let accepted = !fanoutClosed;
+        for (const channel of channels.values()) {
+          const lease = leases[index]!;
+          index += 1;
+          // A closed channel is already permanently blocked, so skipping it
+          // loses nothing that idleness could miss.
+          if (accepted && !channel.closed) {
+            if (Queue.offerUnsafe(channel.queue, { event, lease })) continue;
+            fanoutUnavailable ??= activity.block(`fanout unavailable: ${name}`);
+            accepted = false;
+          }
+          // Leases already offered belong to their queues; only the rest come back.
+          lease.release();
+        }
+        if (!PubSub.publishUnsafe(observers, event) && !fanoutClosed) {
+          fanoutUnavailable ??= activity.block(`fanout unavailable: ${name}`);
+        }
+        return accepted
+          ? Effect.void
+          : Effect.fail(new UpdateActivityUnavailableError({ reason: "closed" }));
+      });
+
+    const publish: TrackedFanout<A>["publish"] = (event) =>
+      Effect.uninterruptibleMask((restore) =>
+        Effect.flatMap(activity.acquire(`${name} publish`), (producer) =>
+          restore(
+            publishLock.withPermits(1)(
+              Effect.uninterruptible(Effect.flatMap(acquireDeliveries, (leases) => deliver(event, leases))),
+            ),
+          ).pipe(Effect.ensuring(Effect.sync(producer.release))),
+        ),
+      );
+
+    // Death cleanup is installed before the not-running blocker clears, so a run
+    // fiber canceled before its body starts stays visibly blocked. The delivery
+    // finalizer is installed before `handle` is constructed; the mask keeps the
+    // dequeue-to-finalizer handoff atomic while waiting and handling stay
+    // interruptible.
+    const runChannel = <E, R>(channel: Channel<A>, handle: (event: A) => Effect.Effect<void, E, R>) =>
+      Effect.onExit(
+        Effect.sync(() => channel.notRunning?.clear()).pipe(
+          Effect.andThen(
+            Effect.uninterruptibleMask((restore) =>
+              Effect.flatMap(restore(Queue.take(channel.queue)), (delivery) =>
+                Effect.onExit(
+                  restore(Effect.suspend(() => handle(delivery.event))),
+                  (exit) =>
+                    Effect.sync(() => {
+                      if (!Exit.isSuccess(exit)) {
+                        channel.unavailable ??= activity.block(
+                          `required subscriber unavailable: ${name}/${channel.consumer}`,
+                        );
+                      }
+                      delivery.lease.release();
+                    }),
+                ),
+              ),
+            ).pipe(Effect.forever),
+          ),
+        ),
+        () => closeChannel(channel),
+      );
+
+    const subscribeRequired: TrackedFanout<A>["subscribeRequired"] = (consumer) =>
+      Effect.uninterruptible(
+        Effect.gen(function* () {
+          const channel = channels.get(consumer);
+          if (channel === undefined) {
+            return yield* new UpdateActivityUnavailableError({ reason: "unknown-subscriber" });
+          }
+          if (channel.owned) {
+            return yield* new UpdateActivityUnavailableError({ reason: "subscriber-already-owned" });
+          }
+          channel.owned = true;
+          yield* Effect.addFinalizer(() => closeChannel(channel));
+          // Registration owns the queue but is not yet eligible for an update:
+          // a parked run (waiting on ServerActivation) blocks idle until its
+          // body starts. Startup must therefore never wait on an idle claim.
+          channel.notRunning = activity.block(
+            `required subscriber not running: ${name}/${consumer}`,
+          );
+          channel.missing.clear();
+          const run: RequiredSubscription<A>["run"] = <E, R>(
+            handle: (event: A) => Effect.Effect<void, E, R>,
+          ) =>
+            Effect.suspend((): Effect.Effect<void, E | UpdateActivityUnavailableError, R> => {
+              if (channel.running) {
+                return Effect.fail(new UpdateActivityUnavailableError({ reason: "subscriber-already-owned" }));
+              }
+              if (channel.closed) return Effect.fail(new UpdateActivityUnavailableError({ reason: "closed" }));
+              channel.running = true;
+              return runChannel(channel, handle);
+            });
+          return { run } satisfies RequiredSubscription<A>;
+        }),
+      );
+
+    return {
+      publish,
+      subscribeRequired,
+      streamObservers: Stream.fromPubSub(observers),
+      subscribeObservers: Effect.map(PubSub.subscribe(observers), Stream.fromSubscription),
+    } satisfies TrackedFanout<A>;
+  });
