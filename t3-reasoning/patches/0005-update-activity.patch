+/**
+ * UpdateActivity - ownership registry deciding when the server is idle enough
+ * to apply an update.
+ *
+ * Every piece of in-flight work holds a lease; anything that cannot prove its
+ * work is finished holds a blocker. `trySealIdle` only succeeds while nothing
+ * is outstanding and nothing is blocked, and a seal keeps new work out until
+ * it is released. All state transitions are synchronous so ownership can be
+ * transferred between fibers without an unowned gap.
+ *
+ * @module UpdateActivity
+ */
+import * as Context from "effect/Context";
+import * as Deferred from "effect/Deferred";
+import * as Effect from "effect/Effect";
+import * as Exit from "effect/Exit";
+import type * as Fiber from "effect/Fiber";
+import * as Layer from "effect/Layer";
+import * as Queue from "effect/Queue";
+import * as Schema from "effect/Schema";
+import type * as Scope from "effect/Scope";
+
+export interface ActivityLease {
+  readonly release: () => void;
+}
+
+export interface ActivityBlocker {
+  readonly clear: () => void;
+}
+
+export interface ActivitySeal {
+  readonly release: () => void;
+}
+
+export interface UpdateActivityState {
+  readonly phase: "open" | "sealed" | "closed";
+  readonly revision: number;
+  readonly outstanding: number;
+  readonly blockers: ReadonlyArray<string>;
+}
+
+export class UpdateActivityUnavailableError extends Schema.TaggedErrorClass<UpdateActivityUnavailableError>()(
+  "UpdateActivityUnavailableError",
+  {
+    reason: Schema.Literals([
+      "sealed",
+      "closed",
+      "worker-closed",
+      "unknown-subscriber",
+      "subscriber-already-owned",
+    ]),
+  },
+) {
+  override get message(): string {
+    return `Update activity unavailable: ${this.reason}`;
+  }
+}
+
+export type IdleClaim =
+  | { readonly status: "sealed"; readonly seal: ActivitySeal }
+  | { readonly status: "busy"; readonly state: UpdateActivityState };
+
+export interface UpdateActivityShape {
+  /** Counts one unit of in-flight work until the returned handle is released. */
+  readonly acquire: (label: string) => Effect.Effect<ActivityLease, UpdateActivityUnavailableError>;
+  /** Runs an effect while holding a lease; the lease ends with the effect, not with any later work. */
+  readonly track: <A, E, R>(
+    label: string,
+    effect: Effect.Effect<A, E, R>,
+  ) => Effect.Effect<A, E | UpdateActivityUnavailableError, R>;
+  /** Forks into `scope` holding a lease that the child's exit releases, even if it never starts. */
+  readonly forkTracked: <A, E, R>(
+    label: string,
+    effect: Effect.Effect<A, E, R>,
+    scope: Scope.Scope,
+  ) => Effect.Effect<Fiber.Fiber<A, E>, UpdateActivityUnavailableError, R>;
+  /** Marks uncertainty synchronously. Identity is the handle: equal reasons are separate blockers. */
+  readonly block: (reason: string) => ActivityBlocker;
+  readonly state: Effect.Effect<UpdateActivityState>;
+  /** Resolves once the revision moves past `afterRevision`, or immediately once closed. */
+  readonly awaitChange: (afterRevision: number) => Effect.Effect<UpdateActivityState>;
+  /** Atomically seals an open, unblocked, empty registry. Never waits. */
+  readonly trySealIdle: Effect.Effect<IdleClaim>;
+}
+
+export class UpdateActivity extends Context.Service<UpdateActivity, UpdateActivityShape>()(
+  "t3/updateActivity",
+) {}
+
+export const make = (): Effect.Effect<UpdateActivityShape, never, Scope.Scope> =>
+  Effect.gen(function* () {
+    let phase: UpdateActivityState["phase"] = "open";
+    let revision = 0;
+    let outstanding = 0;
+    let sealToken: object | undefined;
+    const blockers = new Set<{ readonly reason: string }>();
+    const waiters = new Set<Deferred.Deferred<UpdateActivityState>>();
+
+    const snapshot = (): UpdateActivityState => ({
+      phase,
+      revision,
+      outstanding,
+      blockers: Array.from(blockers, (blocker) => blocker.reason),
+    });
+
+    const bump = (): void => {
+      revision += 1;
+      if (waiters.size === 0) return;
+      const state = Effect.succeed(snapshot());
+      const woken = Array.from(waiters);
+      waiters.clear();
+      for (const waiter of woken) Deferred.doneUnsafe(waiter, state);
+    };
+
+    const acquireUnsafe = (): ActivityLease | undefined => {
+      if (phase !== "open") return undefined;
+      outstanding += 1;
+      bump();
+      let released = false;
+      return {
+        release: () => {
+          if (released) return;
+          released = true;
+          outstanding -= 1;
+          bump();
+        },
+      };
+    };
+
+    const acquire: UpdateActivityShape["acquire"] = (_label) =>
+      Effect.suspend(() => {
+        const lease = acquireUnsafe();
+        return lease === undefined
+          ? Effect.fail(
+              new UpdateActivityUnavailableError({ reason: phase === "sealed" ? "sealed" : "closed" }),
+            )
+          : Effect.succeed(lease);
+      });
+
+    const track: UpdateActivityShape["track"] = (label, effect) =>
+      Effect.uninterruptibleMask((restore) =>
+        Effect.flatMap(acquire(label), (lease) =>
+          Effect.ensuring(restore(effect), Effect.sync(lease.release)),
+        ),
+      );
+
+    const forkTracked: UpdateActivityShape["forkTracked"] = (label, effect, scope) =>
+      Effect.uninterruptible(
+        Effect.flatMap(acquire(label), (lease) =>
+          Effect.map(Effect.forkIn(effect, scope, { uninterruptible: false }), (fiber) => {
+            // Observers on an already-finished fiber run immediately, so a child
+            // canceled before its body starts still releases here.
+            fiber.addObserver(() => lease.release());
+            return fiber;
+          }),
+        ),
+      );
+
+    const block: UpdateActivityShape["block"] = (reason) => {
+      const entry = { reason };
+      blockers.add(entry);
+      bump();
+      return {
+        clear: () => {
+          if (blockers.delete(entry)) bump();
+        },
+      };
+    };
+
+    const awaitChange: UpdateActivityShape["awaitChange"] = (afterRevision) =>
+      Effect.suspend(() => {
+        if (phase === "closed" || revision !== afterRevision) return Effect.succeed(snapshot());
+        const waiter = Deferred.makeUnsafe<UpdateActivityState>();
+        waiters.add(waiter);
+        return Effect.onInterrupt(Deferred.await(waiter), () => Effect.sync(() => waiters.delete(waiter)));
+      });
+
+    const trySealIdle: UpdateActivityShape["trySealIdle"] = Effect.sync(() => {
+      if (phase !== "open" || outstanding !== 0 || blockers.size !== 0) {
+        return { status: "busy", state: snapshot() } as const;
+      }
+      const token = {};
+      sealToken = token;
+      phase = "sealed";
+      bump();
+      return {
+        status: "sealed",
+        seal: {
+          release: () => {
+            if (phase !== "sealed" || sealToken !== token) return;
+            sealToken = undefined;
+            phase = "open";
+            bump();
+          },
+        },
+      } as const;
+    });
+
+    yield* Effect.addFinalizer(() =>
+      Effect.sync(() => {
+        phase = "closed";
+        sealToken = undefined;
+        bump();
+      }),
+    );
+
+    return {
+      acquire,
+      track,
+      forkTracked,
+      block,
+      state: Effect.sync(snapshot),
+      awaitChange,
+      trySealIdle,
+    } satisfies UpdateActivityShape;
+  });
+
+export const UpdateActivityLive = Layer.effect(UpdateActivity, make());
+
+export interface TrackedWorker<A> {
+  /** Transfers a lease to the worker with the item. Caller cancellation after acceptance cannot release it. */
+  readonly enqueue: (value: A) => Effect.Effect<void, UpdateActivityUnavailableError>;
+  /** Resolves when this worker's queued and in-flight items are done. Local convenience, never the global proof. */
+  readonly drain: Effect.Effect<void>;
+}
+
+interface TrackedItem<A> {
+  readonly value: A;
+  readonly lease: ActivityLease;
+}
+
+/**
+ * A queue worker whose items each own a registry lease from acceptance until
+ * processing ends. An uncaught failure kills the worker and leaves a permanent
+ * blocker so lost work can never look like idleness.
+ */
+export const makeTrackedWorker = <A, E, R>(
+  activity: UpdateActivityShape,
+  name: string,
+  process: (value: A) => Effect.Effect<void, E, R>,
+): Effect.Effect<TrackedWorker<A>, never, R | Scope.Scope> =>
+  Effect.gen(function* () {
+    const queue = yield* Queue.unbounded<TrackedItem<A>>();
+    let closed = false;
+    let localOutstanding = 0;
+    let unavailable: ActivityBlocker | undefined;
+    const drainWaiters = new Set<Deferred.Deferred<void>>();
+
+    const settle = (lease: ActivityLease): void => {
+      lease.release();
+      localOutstanding -= 1;
+      if (localOutstanding > 0 || drainWaiters.size === 0) return;
+      const woken = Array.from(drainWaiters);
+      drainWaiters.clear();
+      for (const waiter of woken) Deferred.doneUnsafe(waiter, Effect.void);
+    };
+
+    const markUnavailable = (): void => {
+      unavailable ??= activity.block(`worker unavailable: ${name}`);
+    };
+
+    // Blocker first, then pending leases, all in one synchronous step so no
+    // observer can see the count hit zero without the blocker.
+    const shutdown = Effect.sync(() => {
+      if (closed) return;
+      closed = true;
+      markUnavailable();
+      for (let item = Queue.takeUnsafe(queue); item !== undefined && Exit.isSuccess(item); item = Queue.takeUnsafe(queue)) {
+        settle(item.value.lease);
+      }
+    }).pipe(Effect.andThen(Queue.shutdown(queue)));
+
+    // The item finalizer is installed before `process` is even constructed, so a
+    // callback that throws synchronously still settles its lease. The mask keeps
+    // the dequeue-to-finalizer handoff atomic while waiting and processing stay
+    // interruptible.
+    const processItem = (item: TrackedItem<A>, restore: <X, XE, XR>(e: Effect.Effect<X, XE, XR>) => Effect.Effect<X, XE, XR>) =>
+      Effect.onExit(
+        restore(Effect.suspend(() => process(item.value))),
+        (exit) =>
+          Effect.sync(() => {
+            if (!Exit.isSuccess(exit)) markUnavailable();
+            settle(item.lease);
+          }),
+      );
+
+    yield* Effect.uninterruptibleMask((restore) =>
+      Effect.flatMap(restore(Queue.take(queue)), (item) => processItem(item, restore)),
+    ).pipe(
+      Effect.forever,
+      Effect.onExit(() => shutdown),
+      Effect.forkScoped,
+    );
+    yield* Effect.addFinalizer(() => shutdown);
+
+    const enqueue: TrackedWorker<A>["enqueue"] = (value) =>
+      Effect.uninterruptible(
+        Effect.flatMap(activity.acquire(`${name} item`), (lease) =>
+          Effect.suspend(() => {
+            if (!closed && Queue.offerUnsafe(queue, { value, lease })) {
+              localOutstanding += 1;
+              return Effect.void;
+            }
+            lease.release();
+            return Effect.fail(new UpdateActivityUnavailableError({ reason: "worker-closed" }));
+          }),
+        ),
+      );
+
+    const drain: TrackedWorker<A>["drain"] = Effect.suspend(() => {
+      if (localOutstanding === 0) return Effect.void;
+      const waiter = Deferred.makeUnsafe<void>();
+      drainWaiters.add(waiter);
+      return Effect.onInterrupt(Deferred.await(waiter), () => Effect.sync(() => drainWaiters.delete(waiter)));
+    });
+
+    return { enqueue, drain } satisfies TrackedWorker<A>;
+  });
