+import { expect, it } from "@effect/vitest";
+import * as Deferred from "effect/Deferred";
+import * as Effect from "effect/Effect";
+import * as Exit from "effect/Exit";
+import * as Fiber from "effect/Fiber";
+import * as Scope from "effect/Scope";
+
+import {
+  make,
+  makeTrackedWorker,
+  UpdateActivityUnavailableError,
+  type UpdateActivityState,
+} from "./updateActivity.ts";
+
+const expectBusy = (activity: { readonly trySealIdle: Effect.Effect<unknown> }) =>
+  Effect.map(activity.trySealIdle, (claim) => {
+    expect(claim).toMatchObject({ status: "busy" });
+    return claim as { readonly status: "busy"; readonly state: UpdateActivityState };
+  });
+
+const expectSealed = (activity: { readonly trySealIdle: Effect.Effect<unknown> }) =>
+  Effect.map(activity.trySealIdle, (claim) => {
+    expect(claim).toMatchObject({ status: "sealed" });
+    return claim as { readonly status: "sealed"; readonly seal: { release: () => void } };
+  });
+
+it.effect("forkTracked keeps the child counted after the parent ends and releases on pre-start cancel", () =>
+  Effect.gen(function* () {
+    const activity = yield* make();
+    const parent = yield* activity.acquire("parent");
+
+    // Child that will actually run later.
+    const childScope = yield* Scope.make();
+    const childGate = yield* Deferred.make<void>();
+    const childStarted = yield* Deferred.make<void>();
+    const child = yield* activity.forkTracked(
+      "child",
+      Deferred.succeed(childStarted, undefined).pipe(Effect.andThen(Deferred.await(childGate))),
+      childScope,
+    );
+
+    // Child that is canceled before its body ever runs.
+    const canceledScope = yield* Scope.make();
+    const canceledStarted = yield* Deferred.make<void>();
+    const canceled = yield* activity.forkTracked(
+      "canceled",
+      Deferred.succeed(canceledStarted, undefined),
+      canceledScope,
+    );
+    yield* Scope.close(canceledScope, Exit.void);
+    const canceledExit = yield* Fiber.await(canceled);
+    expect(Exit.isFailure(canceledExit)).toBe(true);
+    expect(yield* Deferred.isDone(canceledStarted)).toBe(false);
+
+    parent.release();
+    parent.release();
+    const busy = yield* expectBusy(activity);
+    expect(busy.state.outstanding).toBe(1);
+
+    yield* Deferred.await(childStarted);
+    yield* Deferred.succeed(childGate, undefined);
+    yield* Fiber.join(child);
+    yield* expectSealed(activity);
+    yield* Scope.close(childScope, Exit.void);
+  }),
+);
+
+it.effect("track releases exactly once on success, failure, and interruption", () =>
+  Effect.gen(function* () {
+    const activity = yield* make();
+    yield* activity.track("ok", Effect.void);
+    const failed = yield* Effect.exit(activity.track("fail", Effect.fail("boom")));
+    expect(failed).toEqual(Exit.fail("boom"));
+
+    const entered = yield* Deferred.make<void>();
+    const fiber = yield* Effect.forkChild(
+      activity.track("hang", Deferred.succeed(entered, undefined).pipe(Effect.andThen(Effect.never))),
+    );
+    yield* Deferred.await(entered);
+    yield* expectBusy(activity);
+    yield* Fiber.interrupt(fiber);
+    const sealed = yield* expectSealed(activity);
+    expect((yield* activity.state).outstanding).toBe(0);
+    sealed.seal.release();
+  }),
+);
+
+it.effect("tracked worker items survive caller cancel and a closed worker rejects offers", () =>
+  Effect.gen(function* () {
+    const activity = yield* make();
+    const entered = yield* Deferred.make<string>();
+    const gate = yield* Deferred.make<void>();
+    const worker = yield* makeTrackedWorker<string, never, never>(activity, "test", (value) =>
+      Deferred.succeed(entered, value).pipe(Effect.andThen(Deferred.await(gate))),
+    );
+
+    const offered = yield* Deferred.make<void>();
+    const caller = yield* Effect.forkChild(
+      worker.enqueue("job").pipe(
+        Effect.andThen(Deferred.succeed(offered, undefined)),
+        Effect.andThen(Effect.never),
+      ),
+    );
+    yield* Deferred.await(offered);
+    yield* Fiber.interrupt(caller);
+
+    expect(yield* Deferred.await(entered)).toBe("job");
+    const drained = yield* Deferred.make<void>();
+    yield* Effect.forkChild(worker.drain.pipe(Effect.andThen(Deferred.succeed(drained, undefined))));
+    yield* Effect.yieldNow;
+    expect(yield* Deferred.isDone(drained)).toBe(false);
+    const busy = yield* expectBusy(activity);
+    expect(busy.state.outstanding).toBe(1);
+
+    yield* Deferred.succeed(gate, undefined);
+    yield* Deferred.await(drained);
+    yield* worker.drain;
+    const sealed = yield* expectSealed(activity);
+    sealed.seal.release();
+
+    // A worker whose scope closed cannot accept work, and the false offer leaks nothing.
+    const closedScope = yield* Scope.make();
+    const closedWorker = yield* makeTrackedWorker<string, never, never>(activity, "closed", () =>
+      Effect.void,
+    ).pipe(Scope.provide(closedScope));
+    yield* Scope.close(closedScope, Exit.void);
+    const rejected = yield* Effect.flip(closedWorker.enqueue("late"));
+    expect(rejected).toBeInstanceOf(UpdateActivityUnavailableError);
+    expect(rejected.reason).toBe("worker-closed");
+    yield* closedWorker.drain;
+    const state = yield* activity.state;
+    expect(state.outstanding).toBe(0);
+    expect(state.blockers).toEqual(["worker unavailable: closed"]);
+    yield* expectBusy(activity);
+  }),
+);
+
+it.effect("worker death blocks before its counters reach zero and finishes local drains", () =>
+  Effect.gen(function* () {
+    const activity = yield* make();
+    const entered = yield* Deferred.make<void>();
+    const gate = yield* Deferred.make<void>();
+    const worker = yield* makeTrackedWorker<number, string, never>(activity, "dying", (value) =>
+      value === 1
+        ? Deferred.succeed(entered, undefined).pipe(
+            Effect.andThen(Deferred.await(gate)),
+            Effect.andThen(Effect.fail("handler exploded")),
+          )
+        : Effect.void,
+    );
+    yield* worker.enqueue(1);
+    yield* worker.enqueue(2);
+    yield* Deferred.await(entered);
+
+    const seen: Array<UpdateActivityState> = [];
+    const watcher = yield* Effect.forkChild(
+      Effect.gen(function* () {
+        let current = yield* activity.state;
+        while (current.outstanding > 0) {
+          current = yield* activity.awaitChange(current.revision);
+          seen.push(current);
+        }
+      }),
+    );
+
+    yield* Deferred.succeed(gate, undefined);
+    yield* worker.drain;
+    yield* Fiber.join(watcher);
+    for (const snapshot of seen) {
+      expect(snapshot.outstanding > 0 || snapshot.blockers.length > 0).toBe(true);
+    }
+    const state = yield* activity.state;
+    expect(state.outstanding).toBe(0);
+    expect(state.blockers).toEqual(["worker unavailable: dying"]);
+    const rejected = yield* Effect.flip(worker.enqueue(3));
+    expect(rejected.reason).toBe("worker-closed");
+    yield* expectBusy(activity);
+  }),
+);
+
+it.effect("a process callback that throws while constructing its effect still settles and blocks", () =>
+  Effect.gen(function* () {
+    const activity = yield* make();
+    const worker = yield* makeTrackedWorker<number, never, never>(activity, "throwing", (): Effect.Effect<void> => {
+      throw new Error("construction defect");
+    });
+    const blocked = yield* Effect.forkChild(
+      Effect.gen(function* () {
+        let current = yield* activity.state;
+        while (current.blockers.length === 0) current = yield* activity.awaitChange(current.revision);
+      }),
+    );
+    yield* worker.enqueue(1);
+    yield* Fiber.join(blocked);
+    yield* worker.drain;
+    const state = yield* activity.state;
+    expect(state.outstanding).toBe(0);
+    expect(state.blockers).toEqual(["worker unavailable: throwing"]);
+    yield* expectBusy(activity);
+  }),
+);
+
+it.effect("acquire and trySealIdle race atomically; stale seals and closed scopes cannot reopen", () =>
+  Effect.gen(function* () {
+    const activity = yield* make();
+    const go = yield* Deferred.make<void>();
+    const acquirer = yield* Effect.forkChild(
+      Deferred.await(go).pipe(Effect.andThen(Effect.exit(activity.acquire("racer")))),
+    );
+    const sealer = yield* Effect.forkChild(Deferred.await(go).pipe(Effect.andThen(activity.trySealIdle)));
+    yield* Deferred.succeed(go, undefined);
+    const acquired = yield* Fiber.join(acquirer);
+    const claim = yield* Fiber.join(sealer);
+    if (Exit.isSuccess(acquired)) {
+      expect(claim.status).toBe("busy");
+      acquired.value.release();
+    } else {
+      expect(claim.status).toBe("sealed");
+      expect(acquired).toEqual(Exit.fail(new UpdateActivityUnavailableError({ reason: "sealed" })));
+      if (claim.status === "sealed") claim.seal.release();
+    }
+
+    const first = yield* expectSealed(activity);
+    yield* expectBusy(activity);
+    const rejected = yield* Effect.flip(activity.acquire("while sealed"));
+    expect(rejected.reason).toBe("sealed");
+    first.seal.release();
+    const second = yield* expectSealed(activity);
+    first.seal.release();
+    expect((yield* activity.state).phase).toBe("sealed");
+    second.seal.release();
+    expect((yield* activity.state).phase).toBe("open");
+
+    // Blockers keep the registry busy; only the owning handle clears them.
+    const blockerA = activity.block("same reason");
+    const blockerB = activity.block("same reason");
+    blockerA.clear();
+    blockerA.clear();
+    expect((yield* activity.state).blockers).toEqual(["same reason"]);
+    yield* expectBusy(activity);
+    blockerB.clear();
+    const third = yield* expectSealed(activity);
+    third.seal.release();
+
+    // Closing the owning scope is permanent.
+    const scope = yield* Scope.make();
+    const scopedActivity = yield* make().pipe(Scope.provide(scope));
+    const lease = yield* scopedActivity.acquire("before close");
+    const seal = yield* scopedActivity.trySealIdle;
+    expect(seal.status).toBe("busy");
+    yield* Scope.close(scope, Exit.void);
+    lease.release();
+    expect((yield* scopedActivity.state).phase).toBe("closed");
+    const closedAcquire = yield* Effect.flip(scopedActivity.acquire("after close"));
+    expect(closedAcquire.reason).toBe("closed");
+    const closedClaim = yield* scopedActivity.trySealIdle;
+    expect(closedClaim).toMatchObject({ status: "busy", state: { phase: "closed" } });
+  }),
+);
+
+it.effect("awaitChange wakes on the next revision, returns stale revisions immediately, and survives interruption", () =>
+  Effect.gen(function* () {
+    const scope = yield* Scope.make();
+    const activity = yield* make().pipe(Scope.provide(scope));
+    const initial = yield* activity.state;
+
+    const woke = yield* Deferred.make<UpdateActivityState>();
+    yield* Effect.forkChild(activity.awaitChange(initial.revision).pipe(Effect.andThen((s) => Deferred.succeed(woke, s))));
+    const abandoned = yield* Effect.forkChild(activity.awaitChange(initial.revision));
+    yield* Effect.yieldNow;
+    yield* Fiber.interrupt(abandoned);
+    expect(yield* Deferred.isDone(woke)).toBe(false);
+
+    const lease = yield* activity.acquire("wake");
+    const next = yield* Deferred.await(woke);
+    expect(next.revision).toBe(initial.revision + 1);
+    expect(next.outstanding).toBe(1);
+
+    const stale = yield* activity.awaitChange(initial.revision);
+    expect(stale.revision).toBe(next.revision);
+
+    const closing = yield* Effect.forkChild(activity.awaitChange(next.revision));
+    yield* Effect.yieldNow;
+    yield* Scope.close(scope, Exit.void);
+    const closed = yield* Fiber.join(closing);
+    expect(closed.phase).toBe("closed");
+    expect(closed.revision).toBeGreaterThan(next.revision);
+    // Closed registries answer immediately even at the current revision.
+    expect((yield* activity.awaitChange(closed.revision)).phase).toBe("closed");
+    lease.release();
+  }),
+);
