+describe("deriveMessagesTimelineRows reasoning presentation gate", () => {
+  const userEntry = {
+    id: "user-entry",
+    kind: "message" as const,
+    createdAt: "2026-01-01T00:00:00Z",
+    message: {
+      id: "user-1" as never,
+      role: "user" as const,
+      text: "Explain",
+      turnId: null,
+      createdAt: "2026-01-01T00:00:00Z",
+      updatedAt: "2026-01-01T00:00:00Z",
+      streaming: false,
+    },
+  };
+  const reasoningEntry = (streaming: boolean, turnId: string | null = "turn-1") => ({
+    id: "reasoning-entry",
+    kind: "message" as const,
+    createdAt: "2026-01-01T00:00:01Z",
+    message: {
+      id: "reasoning-1" as never,
+      role: "assistant" as const,
+      channel: "reasoning" as const,
+      text: "Weighing the options",
+      turnId: turnId as never,
+      createdAt: "2026-01-01T00:00:01Z",
+      updatedAt: "2026-01-01T00:00:05Z",
+      streaming,
+    },
+  });
+  const answerEntry = {
+    id: "answer-entry",
+    kind: "message" as const,
+    createdAt: "2026-01-01T00:00:06Z",
+    message: {
+      id: "answer-1" as never,
+      role: "assistant" as const,
+      text: "Here is the answer.",
+      turnId: "turn-1" as never,
+      createdAt: "2026-01-01T00:00:06Z",
+      updatedAt: "2026-01-01T00:00:08Z",
+      streaming: false,
+    },
+  };
+  const workEntry = (id: string, createdAt: string) => ({
+    id: `${id}-entry`,
+    kind: "work" as const,
+    createdAt,
+    entry: {
+      id,
+      createdAt,
+      label: "Ran command",
+      tone: "tool" as const,
+      itemType: "command_execution" as const,
+      toolLifecycleStatus: "completed" as const,
+    },
+  });
+  const settledTurn = {
+    turnId: "turn-1" as never,
+    state: "completed" as const,
+    startedAt: "2026-01-01T00:00:00Z",
+    completedAt: "2026-01-01T00:00:08Z",
+  };
+  const settledInput = {
+    isWorking: false,
+    activeTurnStartedAt: null,
+    turnDiffSummaryByAssistantMessageId: new Map(),
+    revertTurnCountByUserMessageId: new Map(),
+  };
+  const messageRows = (rows: ReturnType<typeof deriveMessagesTimelineRows>) =>
+    rows.flatMap((row) => (row.kind === "message" ? [row] : []));
+
+  it("shows the reasoning disclosure with the presentation and hides it without", () => {
+    const input = {
+      timelineEntries: [userEntry, reasoningEntry(false), answerEntry],
+      latestTurn: settledTurn,
+      // Expanded so the settled turn's fold does not hide the leading thought.
+      expandedTurnIds: new Set(["turn-1" as never]),
+      ...settledInput,
+    };
+
+    const withPresentation = deriveMessagesTimelineRows({
+      ...input,
+      reasoningPresentation: true,
+    });
+    expect(withPresentation.some((row) => row.kind === "turn-fold")).toBe(true);
+    expect(messageRows(withPresentation).map((row) => row.message.id)).toEqual([
+      "user-1",
+      "reasoning-1",
+      "answer-1",
+    ]);
+
+    const withoutPresentation = deriveMessagesTimelineRows({
+      ...input,
+      reasoningPresentation: false,
+    });
+    expect(messageRows(withoutPresentation).map((row) => row.message.id)).toEqual([
+      "user-1",
+      "answer-1",
+    ]);
+    expect(withoutPresentation.some((row) => row.id === "reasoning-entry")).toBe(false);
+    // Nothing is left to fold once the thought is gone.
+    expect(withoutPresentation.some((row) => row.kind === "turn-fold")).toBe(false);
+  });
+
+  it("never promotes a hidden reasoning message to the turn's answer", () => {
+    // Without the presentation a turn whose only assistant message is reasoning
+    // has no answer at all: no assistant row, no copy button, no fold anchored
+    // at the thought, and no assistant meta row.
+    const rows = deriveMessagesTimelineRows({
+      timelineEntries: [userEntry, reasoningEntry(false)],
+      latestTurn: settledTurn,
+      reasoningPresentation: false,
+      ...settledInput,
+    });
+
+    expect(rows.map((row) => row.kind)).toEqual(["message"]);
+    expect(rows[0]).toMatchObject({ message: { id: "user-1" } });
+    expect(rows.some((row) => row.kind === "assistant-meta")).toBe(false);
+    expect(rows.some((row) => row.kind === "turn-fold")).toBe(false);
+  });
+
+  it("keeps the terminal answer and its duration start when reasoning is hidden", () => {
+    const rows = deriveMessagesTimelineRows({
+      timelineEntries: [userEntry, reasoningEntry(false), answerEntry],
+      latestTurn: settledTurn,
+      reasoningPresentation: false,
+      ...settledInput,
+    });
+    const answerRow = messageRows(rows).find((row) => row.message.id === "answer-1");
+
