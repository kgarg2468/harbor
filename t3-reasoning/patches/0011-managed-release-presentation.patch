diff --git a/apps/desktop/src/updates/updateChannels.test.ts b/apps/desktop/src/updates/updateChannels.test.ts
new file mode 100644
index 000000000..c44d8d03b
--- /dev/null
+++ b/apps/desktop/src/updates/updateChannels.test.ts
@@ -0,0 +1,37 @@
+import { describe, expect, it } from "vite-plus/test";
+
+import { isNightlyDesktopVersion, resolveDefaultDesktopUpdateChannel } from "./updateChannels.ts";
+
+describe("updateChannels", () => {
+  it("keeps upstream nightly and release versions on their existing channels", () => {
+    expect(resolveDefaultDesktopUpdateChannel("0.0.39-nightly.20260905.1284")).toBe("nightly");
+    expect(resolveDefaultDesktopUpdateChannel("0.0.39")).toBe("latest");
+    expect(resolveDefaultDesktopUpdateChannel("0.0.39-pr.8182.1")).toBe("latest");
+  });
+
+  it("recognizes the managed nightly prerelease suffix as nightly", () => {
+    expect(isNightlyDesktopVersion("0.0.39-nightly.20260905.1284.managed.1.p0123456789ab")).toBe(
+      true,
+    );
+    expect(
+      resolveDefaultDesktopUpdateChannel("0.0.39-nightly.20260905.1284.managed.17.pdeadbeefcafe"),
+    ).toBe("nightly");
+  });
+
+  it("rejects malformed managed suffixes instead of guessing a channel", () => {
+    for (const version of [
+      "0.0.39-nightly.20260905.1284.managed.0.p0123456789ab",
+      "0.0.39-nightly.20260905.1284.managed.01.p0123456789ab",
+      "0.0.39-nightly.20260905.1284.managed.1.p0123456789a",
+      "0.0.39-nightly.20260905.1284.managed.1.p0123456789abc",
+      "0.0.39-nightly.20260905.1284.managed.1.pXYZ456789abc",
+      "0.0.39-nightly.20260905.1284.managed.1.p0123456789ab+meta",
+      "0.0.39-nightly.20260905.1284.managed.1.p0123456789ab.extra",
+      "0.0.39-nightly.20260905.1284.managed",
+      "0.0.39-managed.1.p0123456789ab",
+    ]) {
+      expect(isNightlyDesktopVersion(version), version).toBe(false);
+      expect(resolveDefaultDesktopUpdateChannel(version), version).toBe("latest");
+    }
+  });
+});
