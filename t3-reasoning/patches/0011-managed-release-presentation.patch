-const NIGHTLY_VERSION_PATTERN = /-nightly\.\d{8}\.\d+$/;
+// Upstream nightlies end at `-nightly.<yyyymmdd>.<run>`. A managed release
+// appends `.managed.<releaseCounter>.p<12-hex digest>` to that prerelease so it
+// still sorts after the nightly it was cut from; it stays on the nightly
+// channel. Mirrors resolveDesktopUpdateChannel in scripts/build-desktop-artifact.ts.
+const NIGHTLY_VERSION_PATTERN = /-nightly\.\d{8}\.\d+(?:\.managed\.[1-9]\d*\.p[0-9a-f]{12})?$/;
 
 export function isNightlyDesktopVersion(version: string): boolean {
   return NIGHTLY_VERSION_PATTERN.test(version);
