+import { assert, describe, it } from "@effect/vitest";
+
+import {
+  isManagedNightlyVersion,
+  parseProductVariant,
+  resolveReasoningPresentation,
+} from "./product-variant.ts";
+
+describe("product-variant", () => {
+  it("accepts the exact managed nightly prerelease suffix", () => {
+    assert.isTrue(isManagedNightlyVersion("0.0.39-nightly.20260905.1284.managed.1.p0123456789ab"));
+    assert.isTrue(isManagedNightlyVersion("0.0.39-nightly.20260905.1284.managed.42.pdeadbeefcafe"));
+  });
+
+  it("rejects malformed managed suffixes and plain nightly or release versions", () => {
+    for (const version of [
+      "0.0.39-nightly.20260905.1284",
+      "0.0.39",
+      "0.0.39-nightly.20260905.1284.managed.0.p0123456789ab",
+      "0.0.39-nightly.20260905.1284.managed.01.p0123456789ab",
+      "0.0.39-nightly.20260905.1284.managed.1.p0123456789a",
+      "0.0.39-nightly.20260905.1284.managed.1.p0123456789abc",
+      "0.0.39-nightly.20260905.1284.managed.1.p0123456789AB",
+      "0.0.39-nightly.20260905.1284.managed.1.0123456789ab",
+      "0.0.39-nightly.20260905.1284.managed.1.p0123456789ab+meta",
+      "0.0.39-managed.1.p0123456789ab",
+      "0.0.39-nightly.20260905.1284.managed.1.p0123456789ab.extra",
+    ]) {
+      assert.isFalse(isManagedNightlyVersion(version), version);
+    }
+  });
+
+  it("parses the explicit product variant input and treats blank as unconfigured", () => {
+    assert.equal(parseProductVariant("managed-nightly"), "managed-nightly");
+    assert.equal(parseProductVariant(" reasoning "), "reasoning");
+    assert.equal(parseProductVariant(undefined), undefined);
+    assert.equal(parseProductVariant("   "), undefined);
+  });
+
+  it("rejects unknown product variants", () => {
+    assert.throws(() => parseProductVariant("nightly"), /T3CODE_PRODUCT_VARIANT/);
+    assert.throws(() => parseProductVariant("Managed-Nightly"), /T3CODE_PRODUCT_VARIANT/);
+  });
+
+  it("keeps the Reasoning presentation unless the managed Nightly variant is explicit", () => {
+    assert.isTrue(resolveReasoningPresentation(undefined));
+    assert.isTrue(resolveReasoningPresentation("reasoning"));
+    assert.isFalse(resolveReasoningPresentation("managed-nightly"));
+  });
+});
diff --git a/scripts/lib/product-variant.ts b/scripts/lib/product-variant.ts
new file mode 100644
index 000000000..dc598d25f
--- /dev/null
+++ b/scripts/lib/product-variant.ts
@@ -0,0 +1,45 @@
+// The managed release identity is one explicit, non-secret build input. It is
+// never inferred from a bundle name, package manifest, or ambient CI variable:
+// a managed build that forgot to set it must fail loudly rather than ship the
+// wrong renderer presentation or the upstream update feed.
+export const PRODUCT_VARIANT_ENV = "T3CODE_PRODUCT_VARIANT";
+export const PRODUCT_VARIANTS = ["managed-nightly", "reasoning"] as const;
+export type ProductVariant = (typeof PRODUCT_VARIANTS)[number];
+
+// Managed builds append `.managed.<releaseCounter>.p<12-hex digest>` to the
+// upstream nightly `-nightly.<yyyymmdd>.<run>` prerelease. The suffix stays in
+// the prerelease segment (never `+build` metadata) so exact-SemVer comparison
+// still orders it after the upstream nightly it was cut from.
+export const MANAGED_NIGHTLY_VERSION_PATTERN =
+  /-nightly\.\d{8}\.\d+\.managed\.[1-9]\d*\.p[0-9a-f]{12}$/;
+
+export function isManagedNightlyVersion(version: string): boolean {
+  return MANAGED_NIGHTLY_VERSION_PATTERN.test(version);
+}
+
+export function isProductVariant(value: string): value is ProductVariant {
+  return (PRODUCT_VARIANTS as ReadonlyArray<string>).includes(value);
+}
+
+/**
+ * Parse the raw `T3CODE_PRODUCT_VARIANT` value. Unset or blank means the build
+ * is unconfigured (ordinary development); anything else must be one of the
+ * known variants.
+ */
+export function parseProductVariant(raw: string | undefined): ProductVariant | undefined {
+  const value = raw?.trim();
+  if (!value) return undefined;
+  if (isProductVariant(value)) return value;
+  throw new Error(
+    `Invalid ${PRODUCT_VARIANT_ENV} value ${JSON.stringify(raw)}; expected one of ${PRODUCT_VARIANTS.join(", ")}.`,
+  );
+}
+
+/**
+ * Whether the renderer shows the Reasoning presentation (reasoning message
+ * disclosures and thread fork surfaces). Unconfigured development keeps the
+ * existing Reasoning presentation; only an explicit managed Nightly hides it.
+ */
+export function resolveReasoningPresentation(variant: ProductVariant | undefined): boolean {
+  return variant !== "managed-nightly";
+}
