+interface FakeRunChannel {
+  readonly run: OwnedBackendRun;
+  /** Every control message this generation's callback received. */
+  readonly handled: Array<{
+    readonly message: DesktopTelemetryControlMessageValue;
+    readonly closedBefore: boolean;
+  }>;
+  /** Resolved with the first close reason; later closes are no-ops. */
+  readonly closed: Deferred.Deferred<string>;
+  readonly closeCalls: Array<string>;
+  readonly pending: Array<Deferred.Deferred<DesktopUpdateReservationExchange>>;
+}
+
+interface FakeReservationTransport {
+  readonly transport: DesktopTelemetryPublisher.DesktopUpdateReservationTransport;
+  readonly opened: Array<FakeRunChannel>;
+  readonly channelFor: (run: OwnedBackendRun) => FakeRunChannel | undefined;
+}
+
+// Records what the manager does with the reservation transport without any
+// real correlation logic: each opened generation gets its own recording
+// channel, and a channel that closes settles whatever exchange was pending
+// on it as unanswered. Correlation itself is the publisher's job and is
+// tested there.
+function makeFakeReservationTransport(options?: {
+  readonly encoded?: Stream.Stream<Uint8Array>;
+  readonly onControl?: (message: DesktopTelemetryControlMessageValue) => Effect.Effect<void>;
+  /** Runs inside `openRun` once the channel is recorded, before it is returned. */
+  readonly onOpen?: (run: OwnedBackendRun) => Effect.Effect<void>;
+}): FakeReservationTransport {
+  const opened: Array<FakeRunChannel> = [];
+  const channelFor = (run: OwnedBackendRun) =>
+    opened.find(
+      (channel) => channel.run.instanceId === run.instanceId && channel.run.runId === run.runId,
+    );
+  const transport: DesktopTelemetryPublisher.DesktopUpdateReservationTransport = {
+    openRun: (run) =>
+      Effect.gen(function* () {
+        const channel: FakeRunChannel = {
+          run: { instanceId: run.instanceId, runId: run.runId },
+          handled: [],
+          closed: yield* Deferred.make<string>(),
+          closeCalls: [],
+          pending: [],
+        };
+        opened.push(channel);
+        yield* options?.onOpen?.(channel.run) ?? Effect.void;
+        return {
+          encoded: options?.encoded ?? Stream.empty,
+          handleControl: (message) =>
+            Effect.gen(function* () {
+              channel.handled.push({
+                message,
+                closedBefore: yield* Deferred.isDone(channel.closed),
+              });
+              yield* options?.onControl?.(message) ?? Effect.void;
+            }),
+          close: (reason) =>
+            Effect.gen(function* () {
+              channel.closeCalls.push(reason);
+              if (!(yield* Deferred.succeed(channel.closed, reason))) return;
+              const waiters = channel.pending.splice(0);
+              yield* Effect.forEach(
+                waiters,
+                (waiter) =>
+                  Deferred.succeed(waiter, {
+                    _tag: "unanswered",
+                    reason: `${run.instanceId} run ${run.runId} closed: ${reason}`,
+                  }),
+                { discard: true },
+              );
+            }),
+        } satisfies DesktopTelemetryPublisher.DesktopTelemetryRunChannel;
+      }),
+    exchange: (run, _command: DesktopUpdateReservationCommand) =>
+      Effect.gen(function* () {
+        const channel = channelFor(run);
+        if (channel === undefined || (yield* Deferred.isDone(channel.closed))) {
+          return {
+            _tag: "unanswered",
+            reason: `${run.instanceId} run ${run.runId} is not open`,
+          } satisfies DesktopUpdateReservationExchange;
+        }
+        const waiter = yield* Deferred.make<DesktopUpdateReservationExchange>();
+        channel.pending.push(waiter);
+        return yield* Deferred.await(waiter);
+      }),
+  };
+  return { transport, opened, channelFor };
+}
