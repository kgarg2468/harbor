+            control.definitivelyRejected();
+            return { status: "busy", reason: "peer aborted" } as const;
+          }),
+        );
+        assert.deepStrictEqual(rejected, { status: "busy", reason: "peer aborted" });
+        yield* assertOpen(env);
+
+        // Accepted: the reservation parks with both gates retained, and only
+        // the owning scope ends it. The queue is never notified.
+        const exposed = yield* Deferred.make<void>();
+        const reservation = yield* Effect.forkIn(
+          env.coordinator.tryReserve((control) =>
+            Effect.sync(() => control.dispatchStarted()).pipe(
+              Effect.andThen(Deferred.succeed(exposed, undefined)),
+              Effect.andThen(control.accepted),
+              Effect.as(declined),
+            ),
+          ),
+          scope,
+        );
+        yield* Deferred.await(exposed);
+        yield* Effect.yieldNow;
+        yield* Effect.yieldNow;
+        assert.isFalse(yield* isSettled(reservation));
+        assert.deepStrictEqual(yield* env.coordinator.state, { phase: "accepted" });
+        yield* assertLatched(env);
+        yield* assertUnstealable(env);
+        assert.equal(env.notifications(), 0);
+
+        yield* Scope.close(scope, Exit.void);
+        const exit = yield* Fiber.await(reservation);
+        assert.isTrue(Exit.isFailure(exit) && Cause.hasInterrupts(exit.cause));
+        yield* assertLatched(env);
+        assert.deepStrictEqual(yield* env.coordinator.state, { phase: "accepted" });
+      }),
+    );
+  });
 });
