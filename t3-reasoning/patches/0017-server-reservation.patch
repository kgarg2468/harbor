+          yield* assertLatched(env);
+        }),
+    );
+
+    it.effect("declines busy while an attempt, a lease or a client command is live", () =>
+      Effect.gen(function* () {
+        const env = yield* setup();
+        const scope = yield* Scope.make();
+        let invoked = false;
+        const session = () => {
+          invoked = true;
+          return Effect.succeed(declined);
+        };
+
+        const attempt = yield* forkAttempt(
+          env,
+          scope,
+          () => Effect.void,
+          () => Effect.succeed(declined),
+        );
+        assert.equal((yield* env.coordinator.tryReserve(session)).status, "busy");
+        yield* Deferred.succeed(attempt.resume, undefined);
+        assert.deepStrictEqual(yield* Fiber.join(attempt.fiber), declined);
+        yield* assertOpen(env);
+
+        const lease = yield* env.activity.acquire("turn waiting for approval");
+        assert.deepStrictEqual(yield* env.coordinator.tryReserve(session), {
+          status: "busy",
+          reason: "1 agent operation(s) in flight",
+        });
+        assert.deepStrictEqual(yield* env.admission.state, { phase: "open", inFlight: 0 });
+        // The approval that finishes the turn is still admitted.
+        yield* env.admission.withAdmission(Effect.sync(() => lease.release()));
+        yield* assertOpen(env);
+
+        const release = yield* Deferred.make<void>();
+        const command = yield* env.admission
+          .withAdmission(Deferred.await(release))
+          .pipe(Effect.forkChild);
+        yield* Effect.yieldNow;
+        assert.equal((yield* env.coordinator.tryReserve(session)).status, "busy");
+        assert.deepStrictEqual(yield* env.admission.state, { phase: "open", inFlight: 1 });
+        yield* Deferred.succeed(release, undefined);
+        yield* Fiber.join(command);
+
+        assert.isFalse(invoked);
+        yield* assertOpen(env);
+        yield* Scope.close(scope, Exit.void);
+      }),
+    );
+
+    it.effect("its own session holds, releases on rejection and parks once accepted", () =>
+      Effect.gen(function* () {
+        const env = yield* setup();
+        const scope = yield* Scope.make();
+
+        // Held gates, then a definite rejection: everything reopens.
+        const rejected = yield* env.coordinator.tryReserve((control) =>
