index 000000000..8a3a83492
--- /dev/null
+++ b/apps/server/src/cloud/migrationPreflight.test.ts
@@ -0,0 +1,492 @@
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import { assert, describe, expect, it } from "@effect/vitest";
+import { HostProcessPlatform } from "@t3tools/shared/hostProcess";
+import * as NodeSqliteClient from "@t3tools/shared/nodeSqliteClient";
+import { symlinksSupported } from "@t3tools/shared/testing/symlinks";
+import * as Cause from "effect/Cause";
+import * as Effect from "effect/Effect";
+import * as Exit from "effect/Exit";
+import * as Fiber from "effect/Fiber";
+import * as FileSystem from "effect/FileSystem";
+import * as Path from "effect/Path";
+import * as SqlClient from "effect/unstable/sql/SqlClient";
+
+import packageJson from "../../package.json" with { type: "json" };
+import { FORK_SCHEMA_COLUMNS } from "../persistence/ForkSchema.ts";
+import { migrationManifest, runMigrations } from "../persistence/Migrations.ts";
+import {
+  LEGACY_REASONING_MIGRATION_ID,
+  LEGACY_REASONING_MIGRATION_NAME,
+} from "../persistence/ReasoningSchema.ts";
+import {
+  decodeMigrationPreflightResult,
+  MIGRATION_PREFLIGHT_DIRECTORY_PREFIX,
+  MIGRATION_PREFLIGHT_PROTOCOL,
+  MIGRATION_PREFLIGHT_SNAPSHOT_BASENAME,
+  runMigrationPreflight,
+} from "./migrationPreflight.ts";
+import { SERVICE_LAUNCHER_PROTOCOL } from "./serviceProtocol.ts";
+
+const UPSTREAM_MIGRATION_NAME = "ClearAutomaticProjectModelDefaults";
+const MANIFEST_IDS = migrationManifest.map(([id]) => id);
+
+const expectedBase = {
+  preflightProtocol: MIGRATION_PREFLIGHT_PROTOCOL,
+  version: packageJson.version,
+  launcherProtocol: SERVICE_LAUNCHER_PROTOCOL,
+} as const;
+
+/** Runs against a plain file-backed connection that closes when the effect ends. */
+const withDatabase = <A, E>(filename: string, effect: Effect.Effect<A, E, SqlClient.SqlClient>) =>
+  effect.pipe(Effect.provide(NodeSqliteClient.layer({ filename })));
+
+const withReadonlyDatabase = <A, E>(
+  filename: string,
+  effect: Effect.Effect<A, E, SqlClient.SqlClient>,
+) => effect.pipe(Effect.provide(NodeSqliteClient.layer({ filename, readonly: true })));
+
+/** Upstream through 43 plus the channel column recorded as legacy migration 44. */
+const seedLegacyReasoningFixture = (filename: string) =>
+  withDatabase(
+    filename,
+    Effect.gen(function* () {
+      const sql = yield* SqlClient.SqlClient;
+      yield* runMigrations({ toMigrationInclusive: LEGACY_REASONING_MIGRATION_ID - 1 });
+      yield* sql`ALTER TABLE projection_thread_messages ADD COLUMN channel TEXT`;
+      yield* sql`
+        INSERT INTO effect_sql_migrations (migration_id, name)
+        VALUES (${LEGACY_REASONING_MIGRATION_ID}, ${LEGACY_REASONING_MIGRATION_NAME})
+      `;
+      yield* sql`
+        INSERT INTO projection_thread_messages (
+          message_id, thread_id, turn_id, role, text, is_streaming, created_at, updated_at, channel
+        )
+        VALUES
+          ('reasoning-1', 'thread-1', 'turn-1', 'assistant', 'Thinking', 0, '2026-06-01T00:00:00.000Z', '2026-06-01T00:00:00.000Z', 'reasoning'),
+          ('answer-1', 'thread-1', 'turn-1', 'assistant', 'Done', 0, '2026-06-01T00:00:01.000Z', '2026-06-01T00:00:01.000Z', NULL)
+      `;
+    }),
+  );
+
+const seedCurrentFixture = (filename: string) =>
+  withDatabase(filename, runMigrations().pipe(Effect.asVoid));
+
+/** Migration 44 recorded under a name the repair refuses to guess at. */
+const seedUnknownMigration44Fixture = (filename: string) =>
+  withDatabase(
+    filename,
+    Effect.gen(function* () {
+      const sql = yield* SqlClient.SqlClient;
+      yield* runMigrations({ toMigrationInclusive: LEGACY_REASONING_MIGRATION_ID - 1 });
+      yield* sql`
+        INSERT INTO effect_sql_migrations (migration_id, name)
+        VALUES (${LEGACY_REASONING_MIGRATION_ID}, 'SomeOtherForkMigration')
+      `;
+    }),
+  );
+
+interface SchemaState {
+  readonly ledger: ReadonlyArray<readonly [number, string]>;
+  readonly channelColumn: boolean;
+  readonly forkColumns: ReadonlyArray<string>;
+  readonly channels: ReadonlyArray<readonly [string, string | null]>;
+}
+
+const readSchemaState = (filename: string) =>
+  withReadonlyDatabase(
+    filename,
+    Effect.gen(function* () {
+      const sql = yield* SqlClient.SqlClient;
+      const ledger = yield* sql<{ readonly migration_id: number; readonly name: string }>`
+        SELECT migration_id, name FROM effect_sql_migrations ORDER BY migration_id ASC
+      `;
+      const messageColumns = yield* sql<{ readonly name: string }>`
+        PRAGMA table_info(projection_thread_messages)
+      `;
+      const threadColumns = yield* sql<{ readonly name: string }>`
+        PRAGMA table_info(projection_threads)
+      `;
+      const channelColumn = messageColumns.some((column) => column.name === "channel");
+      const messages = channelColumn
+        ? yield* sql<{ readonly message_id: string; readonly channel: string | null }>`
+            SELECT message_id, channel FROM projection_thread_messages ORDER BY message_id ASC
+          `
+        : [];
+      const state: SchemaState = {
+        ledger: ledger.map((row) => [row.migration_id, row.name] as const),
+        channelColumn,
+        forkColumns: threadColumns
+          .map((column) => column.name)
+          .filter((name) => (FORK_SCHEMA_COLUMNS as ReadonlyArray<string>).includes(name)),
+        channels: messages.map((row) => [row.message_id, row.channel] as const),
+      };
+      return state;
+    }),
+  );
+
+/**
+ * A fresh parent-style private directory. Returns both the path as created
+ * (which on macOS goes through the symlinked temp root) and its canonical form.
+ */
+const makeSnapshotDirectory = Effect.gen(function* () {
+  const fs = yield* FileSystem.FileSystem;
+  const path = yield* Path.Path;
+  const created = yield* fs.makeTempDirectoryScoped({
+    prefix: MIGRATION_PREFLIGHT_DIRECTORY_PREFIX,
+  });
+  const canonical = yield* fs.realPath(created);
+  return {
+    created,
+    canonical,
+    snapshotPath: path.join(created, MIGRATION_PREFLIGHT_SNAPSHOT_BASENAME),
+    canonicalSnapshotPath: path.join(canonical, MIGRATION_PREFLIGHT_SNAPSHOT_BASENAME),
+  };
+});
+
+const preflight = (snapshotPath: string, launcherProtocol: number = SERVICE_LAUNCHER_PROTOCOL) =>
+  runMigrationPreflight({ snapshotPath, launcherProtocol });
+
+/** Sibling files SQLite creates as soon as it writes; their absence shows the file was never opened for writing. */
+const journalFilesExist = (snapshotPath: string) =>
+  Effect.gen(function* () {
+    const fs = yield* FileSystem.FileSystem;
+    const wal = yield* fs.exists(`${snapshotPath}-wal`);
+    const journal = yield* fs.exists(`${snapshotPath}-journal`);
+    return wal || journal;
+  });
+
+it.layer(NodeServices.layer)("runMigrationPreflight", (it) => {
+  it.effect(
+    "migrates a legacy Reasoning snapshot through the full chain and leaves the fixture alone",
+    () =>
+      Effect.gen(function* () {
+        const fs = yield* FileSystem.FileSystem;
+        const path = yield* Path.Path;
+        const root = yield* fs.makeTempDirectoryScoped({ prefix: "t3-preflight-test-" });
+        const fixture = path.join(root, "state.sqlite");
+        yield* seedLegacyReasoningFixture(fixture);
+        const fixtureBytes = yield* fs.readFile(fixture);
+        const fixtureBefore = yield* readSchemaState(fixture);
+        assert.equal(fixtureBefore.ledger.at(-1)?.[1], LEGACY_REASONING_MIGRATION_NAME);
+        assert.deepStrictEqual(fixtureBefore.forkColumns, []);
+
+        const directory = yield* makeSnapshotDirectory;
+        yield* fs.copyFile(fixture, directory.snapshotPath);
+
+        // The path as the parent created it: on macOS an alias through /var -> /private/var.
+        const result = yield* preflight(directory.snapshotPath);
+        assert.deepStrictEqual(result, { ...expectedBase, status: "ready" });
+
+        const migrated = yield* readSchemaState(directory.canonicalSnapshotPath);
+        assert.deepStrictEqual(
+          migrated.ledger.map(([id]) => id),
+          MANIFEST_IDS,
+        );
+        assert.equal(
+          migrated.ledger.find(([id]) => id === LEGACY_REASONING_MIGRATION_ID)?.[1],
+          UPSTREAM_MIGRATION_NAME,
+        );
+        assert.isTrue(migrated.channelColumn);
+        assert.deepStrictEqual([...migrated.forkColumns].sort(), [...FORK_SCHEMA_COLUMNS].sort());
+        assert.deepStrictEqual(migrated.channels, [
+          ["answer-1", null],
+          ["reasoning-1", "reasoning"],
+        ]);
+
+        // Only the snapshot changed.
+        assert.deepStrictEqual(yield* fs.readFile(fixture), fixtureBytes);
+        assert.deepStrictEqual(yield* readSchemaState(fixture), fixtureBefore);
+        assert.isFalse(yield* journalFilesExist(fixture));
+      }),
+  );
+
+  it.effect("reports ready for an already-current snapshot without changing its ledger", () =>
+    Effect.gen(function* () {
+      const fs = yield* FileSystem.FileSystem;
+      const path = yield* Path.Path;
+      const root = yield* fs.makeTempDirectoryScoped({ prefix: "t3-preflight-test-" });
+      const fixture = path.join(root, "state.sqlite");
+      yield* seedCurrentFixture(fixture);
+      const before = yield* readSchemaState(fixture);
+      assert.deepStrictEqual(
+        before.ledger.map(([id]) => id),
+        MANIFEST_IDS,
+      );
+
+      const directory = yield* makeSnapshotDirectory;
+      yield* fs.copyFile(fixture, directory.snapshotPath);
+
+      const result = yield* preflight(directory.canonicalSnapshotPath);
+      assert.deepStrictEqual(result, { ...expectedBase, status: "ready" });
+      assert.deepStrictEqual(yield* readSchemaState(directory.canonicalSnapshotPath), before);
+    }),
+  );
+
+  it.effect("blocks on a corrupt snapshot", () =>
+    Effect.gen(function* () {
+      const fs = yield* FileSystem.FileSystem;
+      const directory = yield* makeSnapshotDirectory;
+      yield* fs.writeFile(directory.snapshotPath, new Uint8Array(4096).fill(0x5a));
+
+      const result = yield* preflight(directory.canonicalSnapshotPath);
+      assert.equal(result.status, "blocked");
+      assert.match(
+        result.status === "blocked" ? result.reason : "",
+        /^Migrating the database snapshot failed: /,
+      );
+    }),
+  );
+
+  it.effect("blocks when a migration fails and never reports ready", () =>
+    Effect.gen(function* () {
+      const fs = yield* FileSystem.FileSystem;
+      const path = yield* Path.Path;
+      const root = yield* fs.makeTempDirectoryScoped({ prefix: "t3-preflight-test-" });
+      const fixture = path.join(root, "state.sqlite");
+      yield* seedUnknownMigration44Fixture(fixture);
+      const directory = yield* makeSnapshotDirectory;
+      yield* fs.copyFile(fixture, directory.snapshotPath);
+
+      const result = yield* preflight(directory.canonicalSnapshotPath);
+      assert.equal(result.status, "blocked");
+      assert.match(result.status === "blocked" ? result.reason : "", /SomeOtherForkMigration/);
+
+      // The refused record stays put and nothing past it ran.
+      const after = yield* readSchemaState(directory.canonicalSnapshotPath);
+      assert.deepStrictEqual(after.ledger.at(-1), [
+        LEGACY_REASONING_MIGRATION_ID,
+        "SomeOtherForkMigration",
+      ]);
+      assert.isFalse(after.channelColumn);
+      assert.deepStrictEqual(after.forkColumns, []);
+    }),
+  );
+
+  it.effect("refuses the wrong launcher protocol before touching the snapshot", () =>
+    Effect.gen(function* () {
+      const fs = yield* FileSystem.FileSystem;
+      const path = yield* Path.Path;
+      const root = yield* fs.makeTempDirectoryScoped({ prefix: "t3-preflight-test-" });
+      const fixture = path.join(root, "state.sqlite");
+      yield* seedLegacyReasoningFixture(fixture);
+      const directory = yield* makeSnapshotDirectory;
+      yield* fs.copyFile(fixture, directory.snapshotPath);
+      const bytes = yield* fs.readFile(directory.canonicalSnapshotPath);
+
+      const result = yield* preflight(
+        directory.canonicalSnapshotPath,
+        SERVICE_LAUNCHER_PROTOCOL - 1,
+      );
+      assert.deepStrictEqual(result, {
+        ...expectedBase,
+        status: "blocked",
+        reason:
+          "This release requires a newer T3 Code service launcher. Update it on the server machine.",
+      });
+      assert.deepStrictEqual(yield* fs.readFile(directory.canonicalSnapshotPath), bytes);
+      assert.isFalse(yield* journalFilesExist(directory.canonicalSnapshotPath));
+    }),
+  );
+
+  it.effect("refuses mistaken snapshot paths before opening anything", () =>
+    Effect.gen(function* () {
+      const fs = yield* FileSystem.FileSystem;
+      const path = yield* Path.Path;
+      const root = yield* fs.makeTempDirectoryScoped({ prefix: "t3-preflight-test-" });
+      const fixture = path.join(root, "state.sqlite");
+      yield* seedLegacyReasoningFixture(fixture);
+      const fixtureBytes = yield* fs.readFile(fixture);
+      const directory = yield* makeSnapshotDirectory;
+
+      const wrongBasename = path.join(directory.canonical, "state.sqlite");
+      yield* fs.copyFile(fixture, wrongBasename);
+      const plainParent = path.join(root, "plain");
+      yield* fs.makeDirectory(plainParent);
+      const outsidePrefix = path.join(plainParent, MIGRATION_PREFLIGHT_SNAPSHOT_BASENAME);
+      yield* fs.copyFile(fixture, outsidePrefix);
+      const emptyDirectory = yield* makeSnapshotDirectory;
+      yield* fs.writeFile(emptyDirectory.snapshotPath, new Uint8Array(0));
+      const directoryAsSnapshot = yield* makeSnapshotDirectory;
+      yield* fs.makeDirectory(directoryAsSnapshot.snapshotPath);
+      const hardLinked = yield* makeSnapshotDirectory;
+      yield* fs.link(fixture, hardLinked.snapshotPath);
+
+      const cases: ReadonlyArray<readonly [string, RegExp]> = [
+        [MIGRATION_PREFLIGHT_SNAPSHOT_BASENAME, /must be absolute/],
+        [wrongBasename, /must be named snapshot\.sqlite/],
+        [outsidePrefix, /must live in a t3-migration-preflight-\* directory/],
+        [
+          path.join(
+            root,
+            `${MIGRATION_PREFLIGHT_DIRECTORY_PREFIX}absent`,
+            MIGRATION_PREFLIGHT_SNAPSHOT_BASENAME,
+          ),
+          /directory is missing/,
+        ],
+        [directory.canonicalSnapshotPath, /snapshot is missing/],
+        [emptyDirectory.canonicalSnapshotPath, /snapshot is empty/],
+        [directoryAsSnapshot.canonicalSnapshotPath, /not a regular file/],
+        [hardLinked.canonicalSnapshotPath, /hard-linked/],
+      ];
+      for (const [snapshotPath, reason] of cases) {
+        const result = yield* preflight(snapshotPath);
+        assert.equal(result.status, "blocked", snapshotPath);
+        assert.match(result.status === "blocked" ? result.reason : "", reason, snapshotPath);
+      }
+
+      for (const candidate of [wrongBasename, outsidePrefix, hardLinked.canonicalSnapshotPath]) {
+        assert.deepStrictEqual(yield* fs.readFile(candidate), fixtureBytes, candidate);
+        assert.isFalse(yield* journalFilesExist(candidate), candidate);
+      }
+      assert.deepStrictEqual(yield* fs.readFile(fixture), fixtureBytes);
+    }),
+  );
+
+  it.effect.skipIf(HostProcessPlatform.defaultValue() === "win32")(
+    "refuses a snapshot directory that is not owner-only before opening anything",
+    () =>
+      Effect.gen(function* () {
+        const fs = yield* FileSystem.FileSystem;
+        const path = yield* Path.Path;
+        const root = yield* fs.makeTempDirectoryScoped({ prefix: "t3-preflight-test-" });
+        const fixture = path.join(root, "state.sqlite");
+        yield* seedLegacyReasoningFixture(fixture);
+        const fixtureBytes = yield* fs.readFile(fixture);
+        const before = yield* readSchemaState(fixture);
+
+        const directory = yield* makeSnapshotDirectory;
+        yield* fs.copyFile(fixture, directory.snapshotPath);
+        yield* fs.chmod(directory.canonical, 0o777);
+
+        for (const snapshotPath of [directory.snapshotPath, directory.canonicalSnapshotPath]) {
+          const result = yield* preflight(snapshotPath);
+          assert.deepStrictEqual(
+            result,
+            {
+              ...expectedBase,
+              status: "blocked",
+              reason: "The migration preflight snapshot directory is not private.",
+            },
+            snapshotPath,
+          );
+        }
+        assert.deepStrictEqual(yield* fs.readFile(directory.canonicalSnapshotPath), fixtureBytes);
+        assert.deepStrictEqual(yield* readSchemaState(directory.canonicalSnapshotPath), before);
+        assert.isFalse(yield* journalFilesExist(directory.canonicalSnapshotPath));
+
+        // Restoring the parent's private mode is all it takes to be accepted again.
+        yield* fs.chmod(directory.canonical, 0o700);
+        assert.deepStrictEqual(yield* preflight(directory.canonicalSnapshotPath), {
+          ...expectedBase,
+          status: "ready",
+        });
+      }),
+  );
+
+  it.effect.skipIf(!symlinksSupported)(
+    "rejects a symlinked snapshot or snapshot directory but accepts an aliased ancestor",
+    () =>
+      Effect.gen(function* () {
+        const fs = yield* FileSystem.FileSystem;
+        const path = yield* Path.Path;
+        const root = yield* fs.makeTempDirectoryScoped({ prefix: "t3-preflight-test-" });
+        const fixture = path.join(root, "state.sqlite");
+        yield* seedLegacyReasoningFixture(fixture);
+        const fixtureBytes = yield* fs.readFile(fixture);
+
+        const linkedFile = yield* makeSnapshotDirectory;
+        yield* fs.symlink(fixture, linkedFile.snapshotPath);
+        const viaLinkedFile = yield* preflight(linkedFile.canonicalSnapshotPath);
+        assert.deepStrictEqual(viaLinkedFile, {
+          ...expectedBase,
+          status: "blocked",
+          reason: "The migration preflight snapshot is a symlink.",
+        });
+
+        const real = yield* fs.makeTempDirectoryScoped({
+          directory: root,
+          prefix: MIGRATION_PREFLIGHT_DIRECTORY_PREFIX,
+        });
+        yield* fs.copyFile(fixture, path.join(real, MIGRATION_PREFLIGHT_SNAPSHOT_BASENAME));
+        const linkedDirectory = path.join(root, `${MIGRATION_PREFLIGHT_DIRECTORY_PREFIX}link`);
+        yield* fs.symlink(real, linkedDirectory);
+        const viaLinkedDirectory = yield* preflight(
+          path.join(linkedDirectory, MIGRATION_PREFLIGHT_SNAPSHOT_BASENAME),
+        );
+        assert.deepStrictEqual(viaLinkedDirectory, {
+          ...expectedBase,
+          status: "blocked",
+          reason: "The migration preflight snapshot directory is a symlink.",
+        });
+        assert.deepStrictEqual(yield* fs.readFile(fixture), fixtureBytes);
+        assert.isFalse(yield* journalFilesExist(fixture));
+
+        // An alias higher up, like macOS's /tmp, is an ordinary way to reach the real directory.
+        const rootAlias = path.join(
+          yield* fs.makeTempDirectoryScoped({ prefix: "t3-alias-" }),
+          "root",
+        );
+        yield* fs.symlink(root, rootAlias);
+        const viaAliasedAncestor = yield* preflight(
+          path.join(rootAlias, path.basename(real), MIGRATION_PREFLIGHT_SNAPSHOT_BASENAME),
+        );
+        assert.deepStrictEqual(viaAliasedAncestor, { ...expectedBase, status: "ready" });
+        const migrated = yield* readSchemaState(
+          path.join(real, MIGRATION_PREFLIGHT_SNAPSHOT_BASENAME),
+        );
+        assert.deepStrictEqual(
+          migrated.ledger.map(([id]) => id),
+          MANIFEST_IDS,
+        );
+      }),
+  );
+
+  it.effect("stays interrupted rather than reporting a result", () =>
+    Effect.gen(function* () {
+      const fs = yield* FileSystem.FileSystem;
+      const path = yield* Path.Path;
+      const root = yield* fs.makeTempDirectoryScoped({ prefix: "t3-preflight-test-" });
+      const fixture = path.join(root, "state.sqlite");
+      yield* seedLegacyReasoningFixture(fixture);
+      const directory = yield* makeSnapshotDirectory;
+      yield* fs.copyFile(fixture, directory.snapshotPath);
+      const bytes = yield* fs.readFile(directory.canonicalSnapshotPath);
+
+      const fiber = yield* Effect.forkChild(preflight(directory.canonicalSnapshotPath));
+      yield* Fiber.interrupt(fiber);
+      const exit = yield* Fiber.await(fiber);
+      assert.isTrue(Exit.isFailure(exit) && Cause.hasInterruptsOnly(exit.cause));
+      assert.deepStrictEqual(yield* fs.readFile(directory.canonicalSnapshotPath), bytes);
+    }),
+  );
+});
+
+describe("decodeMigrationPreflightResult", () => {
+  const ready = { ...expectedBase, status: "ready" };
+
+  it("decodes exact ready and blocked documents", () => {
+    expect(decodeMigrationPreflightResult(ready)).toEqual(ready);
+    expect(decodeMigrationPreflightResult({ ...ready, status: "blocked", reason: "why" })).toEqual({
+      ...expectedBase,
+      status: "blocked",
+      reason: "why",
+    });
+  });
+
+  it("rejects other shapes", () => {
+    const rejected: ReadonlyArray<unknown> = [
+      undefined,
+      null,
+      "ready",
+      { status: "ready", version: "1.2.3", launcherProtocol: SERVICE_LAUNCHER_PROTOCOL },
+      { ...ready, preflightProtocol: 2 },
+      { ...ready, launcherProtocol: "2" },
+      { ...ready, version: 1 },
+      { ...ready, status: "blocked" },
+      { ...ready, status: "done" },
+    ];
+    for (const value of rejected) {
+      expect(decodeMigrationPreflightResult(value), JSON.stringify(value)).toBeUndefined();
+    }
+  });
+});
