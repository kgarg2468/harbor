--- /dev/null
+++ b/apps/server/src/cloud/migrationPreflight.ts
@@ -0,0 +1,219 @@
+import { HostProcessPlatform } from "@t3tools/shared/hostProcess";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Layer from "effect/Layer";
+import * as Logger from "effect/Logger";
+import * as Option from "effect/Option";
+import * as Path from "effect/Path";
+import * as Schema from "effect/Schema";
+
+import packageJson from "../../package.json" with { type: "json" };
+import { makeSqlitePersistenceLive } from "../persistence/Layers/Sqlite.ts";
+import { SERVICE_LAUNCHER_PROTOCOL } from "./serviceProtocol.ts";
+
+/**
+ * Isolated migration preflight run by a staged candidate release.
+ *
+ * Unlike `__service-preflight`, which stays protocol-only because its callers
+ * hand it the live database path, this command migrates a disposable snapshot
+ * that the parent created with `withMigrationSnapshot`. The snapshot proves the
+ * candidate can migrate a coherent point-in-time copy; it is never installed
+ * over the live database.
+ */
+
+export const MIGRATION_PREFLIGHT_PROTOCOL = 1 as const;
+/** Parent-created private temp directories carry this prefix; the candidate accepts nothing else. */
+export const MIGRATION_PREFLIGHT_DIRECTORY_PREFIX = "t3-migration-preflight-";
+export const MIGRATION_PREFLIGHT_SNAPSHOT_BASENAME = "snapshot.sqlite";
+
+export type MigrationPreflightResult = {
+  readonly preflightProtocol: typeof MIGRATION_PREFLIGHT_PROTOCOL;
+  readonly version: string;
+  readonly launcherProtocol: number;
+} & ({ readonly status: "ready" } | { readonly status: "blocked"; readonly reason: string });
+
+const MigrationPreflightResultJson = Schema.Union([
+  Schema.Struct({
+    preflightProtocol: Schema.Literal(MIGRATION_PREFLIGHT_PROTOCOL),
+    version: Schema.String,
+    launcherProtocol: Schema.Int,
+    status: Schema.Literal("ready"),
+  }),
+  Schema.Struct({
+    preflightProtocol: Schema.Literal(MIGRATION_PREFLIGHT_PROTOCOL),
+    version: Schema.String,
+    launcherProtocol: Schema.Int,
+    status: Schema.Literal("blocked"),
+    reason: Schema.String,
+  }),
+]);
+
+const decodeResultJson = Schema.decodeUnknownOption(MigrationPreflightResultJson);
+
+export function decodeMigrationPreflightResult(
+  value: unknown,
+): MigrationPreflightResult | undefined {
+  const decoded = decodeResultJson(value);
+  if (Option.isNone(decoded)) {
+    return undefined;
+  }
+  const result = decoded.value;
+  const base = {
+    preflightProtocol: MIGRATION_PREFLIGHT_PROTOCOL,
+    version: result.version,
+    launcherProtocol: result.launcherProtocol,
+  } as const;
+  return result.status === "ready"
+    ? { ...base, status: "ready" }
+    : { ...base, status: "blocked", reason: result.reason };
+}
+
+class SnapshotRejectedError extends Schema.TaggedErrorClass<SnapshotRejectedError>()(
+  "SnapshotRejectedError",
+  { reason: Schema.String },
+) {
+  override get message(): string {
+    return this.reason;
+  }
+}
+
+const reject = (reason: string) => new SnapshotRejectedError({ reason });
+
+/**
+ * `mkdtemp` creates the parent with exactly these permission bits. Anything
+ * else is not the private directory the parent made, so it is refused on the
+ * platforms where mode bits carry meaning. Windows stat modes are synthetic
+ * and are not checked.
+ */
+const PRIVATE_DIRECTORY_MODE = 0o700;
+const PERMISSION_BITS = 0o777;
+
+/**
+ * Accepts only the file `withMigrationSnapshot` produces: an absolute path with
+ * the fixed basename whose parent is a real (non-symlink) directory carrying the
+ * preflight prefix with owner-only permissions, resolving to an existing,
+ * nonempty, unlinked regular file. Ancestors may be ordinary aliases such as
+ * macOS's symlinked temp root. These checks catch mistaken paths, link aliases,
+ * and shared directories before SQLite opens anything.
+ */
+const resolveSnapshotPath = Effect.fn("resolveMigrationPreflightSnapshotPath")(function* (
+  snapshotPath: string,
+) {
+  const fs = yield* FileSystem.FileSystem;
+  const path = yield* Path.Path;
+
+  if (!path.isAbsolute(snapshotPath)) {
+    return yield* reject("The migration preflight snapshot path must be absolute.");
+  }
+  if (path.basename(snapshotPath) !== MIGRATION_PREFLIGHT_SNAPSHOT_BASENAME) {
+    return yield* reject(
+      `The migration preflight snapshot must be named ${MIGRATION_PREFLIGHT_SNAPSHOT_BASENAME}.`,
+    );
+  }
+  const parent = path.dirname(snapshotPath);
+  if (!path.basename(parent).startsWith(MIGRATION_PREFLIGHT_DIRECTORY_PREFIX)) {
+    return yield* reject(
+      `The migration preflight snapshot must live in a ${MIGRATION_PREFLIGHT_DIRECTORY_PREFIX}* directory.`,
+    );
+  }
+  if (yield* isSymbolicLink(fs, parent)) {
+    return yield* reject("The migration preflight snapshot directory is a symlink.");
+  }
+  const parentInfo = yield* fs
+    .stat(parent)
+    .pipe(Effect.mapError(() => reject("The migration preflight snapshot directory is missing.")));
+  if (parentInfo.type !== "Directory") {
+    return yield* reject("The migration preflight snapshot directory is not a directory.");
+  }
+  const canonicalParent = yield* fs
+    .realPath(parent)
+    .pipe(
+      Effect.mapError(() =>
+        reject("The migration preflight snapshot directory could not be resolved."),
+      ),
+    );
+  if (!path.basename(canonicalParent).startsWith(MIGRATION_PREFLIGHT_DIRECTORY_PREFIX)) {
+    return yield* reject(
+      `The migration preflight snapshot must live in a ${MIGRATION_PREFLIGHT_DIRECTORY_PREFIX}* directory.`,
+    );
+  }
+  // `parent` is not a symlink and resolves to `canonicalParent`, so this is the canonical directory's mode.
+  const platform = yield* HostProcessPlatform;
+  if (platform !== "win32" && (parentInfo.mode & PERMISSION_BITS) !== PRIVATE_DIRECTORY_MODE) {
+    return yield* reject("The migration preflight snapshot directory is not private.");
+  }
+  const canonicalPath = path.join(canonicalParent, MIGRATION_PREFLIGHT_SNAPSHOT_BASENAME);
+  if (yield* isSymbolicLink(fs, canonicalPath)) {
+    return yield* reject("The migration preflight snapshot is a symlink.");
+  }
+  const info = yield* fs
+    .stat(canonicalPath)
+    .pipe(Effect.mapError(() => reject("The migration preflight snapshot is missing.")));
+  if (info.type !== "File") {
+    return yield* reject("The migration preflight snapshot is not a regular file.");
+  }
+  if (Number(info.size) === 0) {
+    return yield* reject("The migration preflight snapshot is empty.");
+  }
+  if (Option.isNone(info.nlink) || info.nlink.value !== 1) {
+    return yield* reject("The migration preflight snapshot is hard-linked.");
+  }
+  return canonicalPath;
+});
+
+/** `readLink` succeeds only for symlinks; any failure (missing, not a link) means "not a symlink" here. */
+const isSymbolicLink = (fs: FileSystem.FileSystem, target: string) =>
+  fs.readLink(target).pipe(
+    Effect.as(true),
+    Effect.orElseSucceed(() => false),
+  );
+
+/**
+ * Builds and closes the full production persistence layer against the
+ * snapshot: same pragmas, the legacy Reasoning repair, every upstream
+ * migration, then the Reasoning and fork schema. Migration logs are silenced so
+ * the command's stdout carries exactly one JSON document.
+ */
+const migrateSnapshot = Effect.fn("migrateMigrationPreflightSnapshot")(
+  function* (snapshotPath: string) {
+    yield* Layer.build(makeSqlitePersistenceLive(snapshotPath));
+  },
+  Effect.scoped,
+  Effect.provide(Logger.layer([], { mergeWithExisting: false })),
+);
+
+export const runMigrationPreflight = Effect.fn("runMigrationPreflight")(function* (input: {
+  readonly snapshotPath: string;
+  readonly launcherProtocol: number;
+}): Effect.fn.Return<MigrationPreflightResult, never, FileSystem.FileSystem | Path.Path> {
+  const base = {
+    preflightProtocol: MIGRATION_PREFLIGHT_PROTOCOL,
+    version: packageJson.version,
+    launcherProtocol: SERVICE_LAUNCHER_PROTOCOL,
+  } as const;
+  const blocked = (reason: string): MigrationPreflightResult => ({
+    ...base,
+    status: "blocked",
+    reason,
+  });
+
+  if (input.launcherProtocol !== SERVICE_LAUNCHER_PROTOCOL) {
+    return blocked(
+      "This release requires a newer T3 Code service launcher. Update it on the server machine.",
+    );
+  }
+
+  return yield* resolveSnapshotPath(input.snapshotPath).pipe(
+    Effect.flatMap(migrateSnapshot),
+    Effect.as<MigrationPreflightResult>({ ...base, status: "ready" }),
+    Effect.catch((error) =>
+      Effect.succeed(
+        blocked(
+          error._tag === "SnapshotRejectedError"
+            ? error.message
+            : `Migrating the database snapshot failed: ${error.message}`,
+        ),
+      ),
+    ),
+  );
+});
