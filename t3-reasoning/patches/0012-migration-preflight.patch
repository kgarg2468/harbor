@@ -0,0 +1,24 @@
+import * as Console from "effect/Console";
+import * as Effect from "effect/Effect";
+import { Command, Flag } from "effect/unstable/cli";
+
+import { runMigrationPreflight } from "../cloud/migrationPreflight.ts";
+
+/**
+ * Hidden candidate command run by the managed update stager. It takes only the
+ * disposable snapshot path and the launcher protocol: no database alias, home
+ * override, or server settings, and it never resolves ServerConfig or starts
+ * the server. Stdout is exactly one JSON result document.
+ */
+export const migrationPreflightCommand = Command.make("__migration-preflight", {
+  snapshotPath: Flag.string("snapshot-path"),
+  launcherProtocol: Flag.integer("launcher-protocol"),
+}).pipe(
+  Command.withHidden,
+  Command.withHandler(({ snapshotPath, launcherProtocol }) =>
+    runMigrationPreflight({ snapshotPath, launcherProtocol }).pipe(
+      Effect.flatMap((result) => Console.log(JSON.stringify(result))),
+      Effect.asVoid,
+    ),
+  ),
+);
diff --git a/apps/server/src/cloud/managedMigrationPreflight.test.ts b/apps/server/src/cloud/managedMigrationPreflight.test.ts
new file mode 100644
index 000000000..b207242d1
--- /dev/null
+++ b/apps/server/src/cloud/managedMigrationPreflight.test.ts
@@ -0,0 +1,357 @@
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import { assert, describe, expect, it } from "@effect/vitest";
+import * as NodeSqliteClient from "@t3tools/shared/nodeSqliteClient";
+import * as Cause from "effect/Cause";
+import * as Context from "effect/Context";
+import * as Deferred from "effect/Deferred";
+import * as Effect from "effect/Effect";
+import * as Exit from "effect/Exit";
+import * as Fiber from "effect/Fiber";
+import * as FileSystem from "effect/FileSystem";
+import * as Layer from "effect/Layer";
+import * as Path from "effect/Path";
+import * as Schema from "effect/Schema";
+import * as SqlClient from "effect/unstable/sql/SqlClient";
+
+import {
+  acceptMigrationPreflightOutput,
+  migrationPreflightCandidateArgs,
+  MigrationSnapshotError,
+  withMigrationSnapshot,
+} from "./managedMigrationPreflight.ts";
+import {
+  MIGRATION_PREFLIGHT_DIRECTORY_PREFIX,
+  MIGRATION_PREFLIGHT_PROTOCOL,
+  MIGRATION_PREFLIGHT_SNAPSHOT_BASENAME,
+} from "./migrationPreflight.ts";
+import { SERVICE_LAUNCHER_PROTOCOL } from "./serviceProtocol.ts";
+
+class UseFailed extends Schema.TaggedErrorClass<UseFailed>()("UseFailed", {}) {}
+
+/** Opens a connection in the current scope; the writer connections stay open on purpose. */
+const openDatabase = (filename: string, readonly = false) =>
+  Layer.build(NodeSqliteClient.layer({ filename, readonly })).pipe(
+    Effect.map((context) => Context.get(context, SqlClient.SqlClient)),
+  );
+
+const countRows = (sql: SqlClient.SqlClient, table: string) =>
+  sql
+    .unsafe<{ readonly count: number }>(`SELECT count(*) AS count FROM ${table}`)
+    .pipe(Effect.map((rows) => rows[0]?.count ?? 0));
+
+const ledger = (sql: SqlClient.SqlClient) =>
+  sql<{ readonly migration_id: number; readonly name: string }>`
+    SELECT migration_id, name FROM effect_sql_migrations ORDER BY migration_id ASC
+  `.pipe(Effect.map((rows) => rows.map((row) => [row.migration_id, row.name] as const)));
+
+/**
+ * Every connection open on a WAL database holds a shared lock on it, so leaving
+ * WAL mode fails with SQLITE_BUSY while any other connection exists and
+ * succeeds once the last one closed. Returns to WAL when the switch succeeded.
+ */
+const noOtherConnectionsOpen = (writer: SqlClient.SqlClient) =>
+  writer`PRAGMA journal_mode = DELETE`.pipe(
+    Effect.andThen(writer`PRAGMA journal_mode = WAL`),
+    Effect.as(true),
+    Effect.orElseSucceed(() => false),
+  );
+
+const seedWalDatabase = Effect.fn("test.seedWalDatabase")(function* (filename: string) {
+  const sql = yield* openDatabase(filename);
+  yield* sql`PRAGMA journal_mode = WAL`;
+  // Keep every write in the WAL so the main file alone lacks the committed rows.
+  yield* sql`PRAGMA wal_autocheckpoint = 0`;
+  yield* sql`CREATE TABLE effect_sql_migrations (migration_id INTEGER PRIMARY KEY, name TEXT NOT NULL)`;
+  yield* sql`INSERT INTO effect_sql_migrations (migration_id, name) VALUES (1, 'One'), (2, 'Two')`;
+  yield* sql`CREATE TABLE items (id INTEGER PRIMARY KEY, name TEXT NOT NULL)`;
+  for (let index = 0; index < 25; index += 1) {
+    yield* sql`INSERT INTO items (name) VALUES (${`item-${index}`})`;
+  }
+  return sql;
+});
+
+it.layer(NodeServices.layer)("withMigrationSnapshot", (it) => {
+  it.effect("snapshots committed WAL content through a readonly copy and cleans up after use", () =>
+    Effect.gen(function* () {
+      const fs = yield* FileSystem.FileSystem;
+      const path = yield* Path.Path;
+      const root = yield* fs.makeTempDirectoryScoped({ prefix: "t3-snapshot-test-" });
+      const source = path.join(root, "state.sqlite");
+      const writer = yield* seedWalDatabase(source);
+      const walPath = `${source}-wal`;
+      const walSizeBefore = Number((yield* fs.stat(walPath)).size);
+      assert.ok(walSizeBefore > 0);
+
+      // The main file by itself has none of the committed schema or rows yet.
+      const mainOnly = path.join(root, "main-only.sqlite");
+      yield* fs.copyFile(source, mainOnly);
+      const mainOnlyTables = yield* Effect.scoped(
+        openDatabase(mainOnly, true).pipe(Effect.flatMap((sql) => countRows(sql, "sqlite_master"))),
+      );
+      assert.equal(mainOnlyTables, 0);
+
+      const ledgerBefore = yield* ledger(writer);
+
+      let seen: string | undefined;
+      let snapshotDirectory: string | undefined;
+      const rows = yield* withMigrationSnapshot({
+        liveDatabasePath: source,
+        use: (snapshotPath) =>
+          Effect.gen(function* () {
+            seen = snapshotPath;
+            snapshotDirectory = path.dirname(snapshotPath);
+            assert.notEqual(snapshotPath, source);
+            assert.equal(path.basename(snapshotPath), MIGRATION_PREFLIGHT_SNAPSHOT_BASENAME);
+            assert.ok(
+              path.basename(snapshotDirectory).startsWith(MIGRATION_PREFLIGHT_DIRECTORY_PREFIX),
+            );
+            assert.equal(snapshotDirectory, yield* fs.realPath(snapshotDirectory));
+            const directoryInfo = yield* fs.stat(snapshotDirectory);
+            assert.equal(directoryInfo.mode & 0o777, 0o700);
+
+            // Simulate the candidate's disposable journal files next to the snapshot.
+            yield* fs.writeFileString(`${snapshotPath}-wal`, "");
+            yield* fs.writeFileString(`${snapshotPath}-shm`, "");
+
+            return yield* Effect.scoped(
+              openDatabase(snapshotPath, true).pipe(
+                Effect.flatMap((sql) =>
+                  Effect.all({
+                    items: countRows(sql, "items"),
+                    ledger: ledger(sql),
+                  }),
+                ),
+              ),
+            );
+          }),
+      });
+
+      assert.equal(rows.items, 25);
+      assert.deepStrictEqual(rows.ledger, ledgerBefore);
+      assert.ok(seen !== undefined && snapshotDirectory !== undefined);
+      assert.isFalse(yield* fs.exists(snapshotDirectory));
+
+      // The live database was only read: same ledger, still WAL, WAL not checkpointed.
+      assert.deepStrictEqual(yield* ledger(writer), ledgerBefore);
+      const mode = yield* writer<{ readonly journal_mode: string }>`PRAGMA journal_mode`;
+      assert.equal(mode[0]?.journal_mode, "wal");
+      assert.equal(Number((yield* fs.stat(walPath)).size), walSizeBefore);
+      assert.equal(yield* countRows(writer, "items"), 25);
+    }),
+  );
+
+  it.effect("closes the readonly source connection before use runs", () =>
+    Effect.gen(function* () {
+      const fs = yield* FileSystem.FileSystem;
+      const path = yield* Path.Path;
+      const root = yield* fs.makeTempDirectoryScoped({ prefix: "t3-snapshot-test-" });
+      const source = path.join(root, "state.sqlite");
+      const writer = yield* seedWalDatabase(source);
+
+      // Control: the probe does see a reader that, like the snapshot copy, has read the database.
+      const leaked = yield* Effect.gen(function* () {
+        const reader = yield* openDatabase(source, true);
+        yield* countRows(reader, "items");
+        return yield* noOtherConnectionsOpen(writer);
+      }).pipe(Effect.scoped);
+      assert.isFalse(leaked);
+      assert.isTrue(yield* noOtherConnectionsOpen(writer));
+
+      const duringUse = yield* withMigrationSnapshot({
+        liveDatabasePath: source,
+        use: () => noOtherConnectionsOpen(writer),
+      });
+      assert.isTrue(duringUse);
+    }),
+  );
+
+  it.effect("keeps the source handle readonly", () =>
+    Effect.gen(function* () {
+      const fs = yield* FileSystem.FileSystem;
+      const path = yield* Path.Path;
+      const root = yield* fs.makeTempDirectoryScoped({ prefix: "t3-snapshot-test-" });
+      const source = path.join(root, "state.sqlite");
+      yield* Effect.scoped(seedWalDatabase(source));
+
+      const error = yield* Effect.scoped(
+        openDatabase(source, true).pipe(
+          Effect.flatMap((sql) => sql`INSERT INTO items (name) VALUES ('nope')`),
+        ),
+      ).pipe(Effect.flip);
+      assert.equal(error._tag, "SqlError");
+    }),
+  );
+
+  it.effect("handles a quote in the source path and fails on a missing source", () =>
+    Effect.gen(function* () {
+      const fs = yield* FileSystem.FileSystem;
+      const path = yield* Path.Path;
+      const root = yield* fs.makeTempDirectoryScoped({ prefix: "t3-snapshot-test-" });
+      const quoted = path.join(root, "o'brien");
+      yield* fs.makeDirectory(quoted);
+      const source = path.join(quoted, "state.sqlite");
+      yield* Effect.scoped(seedWalDatabase(source));
+
+      const items = yield* withMigrationSnapshot({
+        liveDatabasePath: source,
+        use: (snapshotPath) =>
+          Effect.scoped(
+            openDatabase(snapshotPath, true).pipe(Effect.flatMap((sql) => countRows(sql, "items"))),
+          ),
+      });
+      assert.equal(items, 25);
+
+      let used = false;
+      const missing = yield* withMigrationSnapshot({
+        liveDatabasePath: path.join(root, "absent.sqlite"),
+        use: () => Effect.sync(() => void (used = true)),
+      }).pipe(Effect.flip);
+      assert.instanceOf(missing, MigrationSnapshotError);
+      assert.equal(missing.step, "resolving the live database");
+      assert.isFalse(used);
+
+      const directory = yield* withMigrationSnapshot({
+        liveDatabasePath: quoted,
+        use: () => Effect.sync(() => void (used = true)),
+      }).pipe(Effect.flip);
+      assert.instanceOf(directory, MigrationSnapshotError);
+      assert.isFalse(used);
+    }),
+  );
+
+  it.effect("removes the snapshot directory after a failed candidate", () =>
+    Effect.gen(function* () {
+      const fs = yield* FileSystem.FileSystem;
+      const path = yield* Path.Path;
+      const root = yield* fs.makeTempDirectoryScoped({ prefix: "t3-snapshot-test-" });
+      const source = path.join(root, "state.sqlite");
+      yield* Effect.scoped(seedWalDatabase(source));
+
+      let snapshotDirectory: string | undefined;
+      const error = yield* withMigrationSnapshot({
+        liveDatabasePath: source,
+        use: (snapshotPath) =>
+          Effect.gen(function* () {
+            snapshotDirectory = path.dirname(snapshotPath);
+            yield* fs.writeFileString(`${snapshotPath}-wal`, "");
+            return yield* new UseFailed();
+          }),
+      }).pipe(Effect.flip);
+      assert.instanceOf(error, UseFailed);
+      assert.ok(snapshotDirectory !== undefined);
+      assert.isFalse(yield* fs.exists(snapshotDirectory));
+    }),
+  );
+
+  it.effect("removes the snapshot directory only after a cancelled candidate exits", () =>
+    Effect.gen(function* () {
+      const fs = yield* FileSystem.FileSystem;
+      const path = yield* Path.Path;
+      const root = yield* fs.makeTempDirectoryScoped({ prefix: "t3-snapshot-test-" });
+      const source = path.join(root, "state.sqlite");
+      yield* Effect.scoped(seedWalDatabase(source));
+
+      const entered = yield* Deferred.make<string>();
+      const released = yield* Deferred.make<void>();
+      const fiber = yield* withMigrationSnapshot({
+        liveDatabasePath: source,
+        use: (snapshotPath) =>
+          Deferred.succeed(entered, snapshotPath).pipe(
+            Effect.andThen(Effect.never),
+            // The candidate process is still winding down while interruption lands.
+            Effect.onInterrupt(() =>
+              Effect.gen(function* () {
+                assert.isTrue(yield* fs.exists(snapshotPath));
+                yield* Deferred.succeed(released, undefined);
+              }),
+            ),
+          ),
+      }).pipe(Effect.forkChild);
+
+      const snapshotPath = yield* Deferred.await(entered);
+      assert.isTrue(yield* fs.exists(snapshotPath));
+      yield* Fiber.interrupt(fiber);
+      const exit = yield* Fiber.await(fiber);
+      assert.isTrue(Exit.isFailure(exit) && Cause.hasInterruptsOnly(exit.cause));
+      yield* Deferred.await(released);
+      assert.isFalse(yield* fs.exists(path.dirname(snapshotPath)));
+    }),
+  );
+});
+
+describe("acceptMigrationPreflightOutput", () => {
+  const ready = {
+    preflightProtocol: MIGRATION_PREFLIGHT_PROTOCOL,
+    version: "1.2.3",
+    launcherProtocol: SERVICE_LAUNCHER_PROTOCOL,
+    status: "ready",
+  };
+  const output = (stdout: string, code: number | null = 0) => ({
+    code,
+    stdout,
+    stdoutTruncated: false,
+    timedOut: false,
+  });
+  const accept = (candidate: ReturnType<typeof output>) =>
+    acceptMigrationPreflightOutput({
+      output: candidate,
+      expectedVersion: "1.2.3",
+      expectedLauncherProtocol: SERVICE_LAUNCHER_PROTOCOL,
+    });
+
+  it("authorizes only an exact ready result", () => {
+    expect(accept(output(`${JSON.stringify(ready)}\n`))).toEqual({
+      accepted: true,
+      result: ready,
+    });
+  });
+
+  it("declines every mismatch and malformed output", () => {
+    const declined = [
+      output(JSON.stringify({ ...ready, version: "1.2.4" })),
+      output(JSON.stringify({ ...ready, preflightProtocol: 2 })),
+      output(JSON.stringify({ ...ready, launcherProtocol: SERVICE_LAUNCHER_PROTOCOL + 1 })),
+      output(JSON.stringify(ready), 1),
+      output(JSON.stringify(ready), null),
+      output("not json"),
+      output(`Migrations ran successfully\n${JSON.stringify(ready)}`),
+      output(`${JSON.stringify(ready)}\n${JSON.stringify(ready)}`),
+      output(JSON.stringify({ ...ready, status: "blocked", reason: "needs a newer launcher" })),
+      // The legacy service preflight shape lacks the preflight protocol.
+      output(
+        JSON.stringify({
+          status: "ready",
+          version: "1.2.3",
+          launcherProtocol: SERVICE_LAUNCHER_PROTOCOL,
+        }),
+      ),
+      // A legacy candidate without the hidden command prints help and exits nonzero.
+      output("Unknown subcommand: __migration-preflight\n\nUSAGE: t3 <subcommand>", 1),
+      { ...output(JSON.stringify(ready)), stdoutTruncated: true },
+      { ...output("", null), timedOut: true },
+    ];
+    for (const candidate of declined) {
+      expect(accept(candidate)).toMatchObject({ accepted: false });
+    }
+    expect(
+      accept(
+        output(JSON.stringify({ ...ready, status: "blocked", reason: "needs a newer launcher" })),
+      ),
+    ).toEqual({ accepted: false, reason: "needs a newer launcher" });
+  });
+
+  it("spawns the candidate with only the snapshot path and launcher protocol", () => {
+    expect(
+      migrationPreflightCandidateArgs({
+        snapshotPath: "/private/tmp/t3-migration-preflight-abc/snapshot.sqlite",
+        launcherProtocol: SERVICE_LAUNCHER_PROTOCOL,
+      }),
+    ).toEqual([
+      "__migration-preflight",
+      "--snapshot-path",
+      "/private/tmp/t3-migration-preflight-abc/snapshot.sqlite",
+      "--launcher-protocol",
+      String(SERVICE_LAUNCHER_PROTOCOL),
+    ]);
+  });
+});
diff --git a/apps/server/src/cloud/managedMigrationPreflight.ts b/apps/server/src/cloud/managedMigrationPreflight.ts
new file mode 100644
index 000000000..a4e2bdbd0
--- /dev/null
+++ b/apps/server/src/cloud/managedMigrationPreflight.ts
@@ -0,0 +1,217 @@
+import * as NodeSqliteClient from "@t3tools/shared/nodeSqliteClient";
+import * as Context from "effect/Context";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Layer from "effect/Layer";
+import * as Option from "effect/Option";
+import * as Path from "effect/Path";
+import * as Schema from "effect/Schema";
+import * as SqlClient from "effect/unstable/sql/SqlClient";
+
+import {
+  decodeMigrationPreflightResult,
+  MIGRATION_PREFLIGHT_DIRECTORY_PREFIX,
+  MIGRATION_PREFLIGHT_SNAPSHOT_BASENAME,
+  type MigrationPreflightResult,
+} from "./migrationPreflight.ts";
+
+/**
+ * Parent-side preparation for the isolated migration preflight. The running
+ * server snapshots its live database into a private temp directory and hands
+ * only that snapshot to the staged candidate. The candidate's process must have
+ * exited before `use` returns: the directory, including the candidate's -wal
+ * and -shm files, is removed when the callback scope closes.
+ */
+
+export class MigrationSnapshotError extends Schema.TaggedErrorClass<MigrationSnapshotError>()(
+  "MigrationSnapshotError",
+  {
+    step: Schema.String,
+    cause: Schema.optional(Schema.Defect()),
+  },
+) {
+  override get message(): string {
+    return `Preparing the migration preflight snapshot failed while ${this.step}.`;
+  }
+}
+
+const failWhile =
+  (step: string) =>
+  (cause: unknown): MigrationSnapshotError =>
+    new MigrationSnapshotError({ step, cause });
+
+/**
+ * A separate readonly connection makes the copy. `VACUUM INTO` writes one
+ * coherent snapshot of everything committed at the start of its read, including
+ * WAL content not yet checkpointed into the main file, without touching the live
+ * database's journal mode, ledger, or WAL. The destination is a bound
+ * parameter, never interpolated into SQL.
+ */
+const copyDatabase = Effect.fn("copyMigrationSnapshotDatabase")(function* (
+  sourcePath: string,
+  destinationPath: string,
+) {
+  const context = yield* Layer.build(
+    NodeSqliteClient.layer({ filename: sourcePath, readonly: true }),
+  );
+  const sql = Context.get(context, SqlClient.SqlClient);
+  // The server writes from this process too; wait rather than fail with SQLITE_BUSY.
+  yield* sql`PRAGMA busy_timeout = 5000`;
+  yield* sql`VACUUM INTO ${destinationPath}`;
+}, Effect.scoped);
+
+const verifySnapshot = Effect.fn("verifyMigrationSnapshot")(function* (snapshotPath: string) {
+  const fs = yield* FileSystem.FileSystem;
+  const isLink = yield* fs.readLink(snapshotPath).pipe(
+    Effect.as(true),
+    Effect.orElseSucceed(() => false),
+  );
+  if (isLink) {
+    return yield* new MigrationSnapshotError({ step: "verifying the snapshot is not a symlink" });
+  }
+  const info = yield* fs
+    .stat(snapshotPath)
+    .pipe(Effect.mapError(failWhile("verifying the snapshot file")));
+  if (info.type !== "File") {
+    return yield* new MigrationSnapshotError({ step: "verifying the snapshot is a regular file" });
+  }
+  if (Number(info.size) === 0) {
+    return yield* new MigrationSnapshotError({ step: "verifying the snapshot is not empty" });
+  }
+  if (Option.isNone(info.nlink) || info.nlink.value !== 1) {
+    return yield* new MigrationSnapshotError({ step: "verifying the snapshot has one link" });
+  }
+});
+
+export const withMigrationSnapshot = <A, E, R>(input: {
+  readonly liveDatabasePath: string;
+  readonly use: (snapshotPath: string) => Effect.Effect<A, E, R>;
+}): Effect.Effect<A, E | MigrationSnapshotError, R | FileSystem.FileSystem | Path.Path> =>
+  Effect.gen(function* () {
+    const fs = yield* FileSystem.FileSystem;
+    const path = yield* Path.Path;
+
+    // A missing or unreadable live database is a failed preparation, never an
+    // empty-database preflight.
+    const sourceInfo = yield* fs
+      .stat(input.liveDatabasePath)
+      .pipe(Effect.mapError(failWhile("resolving the live database")));
+    if (sourceInfo.type !== "File") {
+      return yield* new MigrationSnapshotError({
+        step: "resolving the live database to a regular file",
+      });
+    }
+
+    // mkdtemp creates the directory with mode 0700 and an unpredictable suffix.
+    // Scoped removal is recursive, so the candidate's -wal/-shm files go too.
+    const tempDirectory = yield* fs
+      .makeTempDirectoryScoped({ prefix: MIGRATION_PREFLIGHT_DIRECTORY_PREFIX })
+      .pipe(Effect.mapError(failWhile("creating the private snapshot directory")));
+    const snapshotDirectory = yield* fs
+      .realPath(tempDirectory)
+      .pipe(Effect.mapError(failWhile("resolving the private snapshot directory")));
+    const snapshotPath = path.join(snapshotDirectory, MIGRATION_PREFLIGHT_SNAPSHOT_BASENAME);
+    if (yield* fs.exists(snapshotPath).pipe(Effect.orElseSucceed(() => true))) {
+      return yield* new MigrationSnapshotError({
+        step: "reserving a fresh snapshot path",
+      });
+    }
+
+    // The readonly source handle lives in its own scope and is closed here,
+    // before the candidate ever runs.
+    yield* copyDatabase(input.liveDatabasePath, snapshotPath).pipe(
+      Effect.mapError(failWhile("snapshotting the live database")),
+    );
+    yield* verifySnapshot(snapshotPath);
+
+    return yield* input.use(snapshotPath);
+  }).pipe(Effect.scoped, Effect.withSpan("withMigrationSnapshot"));
+
+/** The only two values a parent may pass to the staged candidate. */
+export interface MigrationPreflightCandidateRequest {
+  readonly snapshotPath: string;
+  readonly launcherProtocol: number;
+}
+
+/** Argument array for spawning `<candidate bin> __migration-preflight ...` without a shell. */
+export function migrationPreflightCandidateArgs(
+  request: MigrationPreflightCandidateRequest,
+): ReadonlyArray<string> {
+  return [
+    "__migration-preflight",
+    "--snapshot-path",
+    request.snapshotPath,
+    "--launcher-protocol",
+    String(request.launcherProtocol),
+  ];
+}
+
+export interface MigrationPreflightCandidateOutput {
+  readonly code: number | null;
+  readonly stdout: string;
+  readonly stdoutTruncated: boolean;
+  readonly timedOut: boolean;
+}
+
+export type MigrationPreflightAcceptance =
+  | {
+      readonly accepted: true;
+      readonly result: MigrationPreflightResult & { readonly status: "ready" };
+    }
+  | { readonly accepted: false; readonly reason: string };
+
+/**
+ * Pure acceptance check for a finished candidate run. Only a clean exit whose
+ * complete stdout is exactly one result document, reporting the already
+ * selected artifact version and the expected launcher protocol, with status
+ * ready, authorizes staging. A legacy candidate without the hidden command
+ * exits nonzero or prints help and is declined the same way.
+ */
+export function acceptMigrationPreflightOutput(input: {
+  readonly output: MigrationPreflightCandidateOutput;
+  readonly expectedVersion: string;
+  readonly expectedLauncherProtocol: number;
+}): MigrationPreflightAcceptance {
+  const { output } = input;
+  if (output.timedOut) {
+    return { accepted: false, reason: "The migration preflight timed out." };
+  }
+  if (output.code !== 0) {
+    return {
+      accepted: false,
+      reason: `The migration preflight exited with code ${output.code ?? "null"}.`,
+    };
+  }
+  if (output.stdoutTruncated) {
+    return { accepted: false, reason: "The migration preflight output was truncated." };
+  }
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(output.stdout.trim());
+  } catch {
+    return { accepted: false, reason: "The migration preflight output was not a JSON document." };
+  }
+  const result = decodeMigrationPreflightResult(parsed);
+  if (result === undefined) {
+    return {
+      accepted: false,
+      reason: "The migration preflight output did not match the preflight protocol.",
+    };
+  }
+  if (result.version !== input.expectedVersion) {
+    return {
+      accepted: false,
+      reason: `The migration preflight reported version ${result.version}, expected ${input.expectedVersion}.`,
+    };
+  }
+  if (result.launcherProtocol !== input.expectedLauncherProtocol) {
+    return {
+      accepted: false,
+      reason: `The migration preflight reported launcher protocol ${result.launcherProtocol}, expected ${input.expectedLauncherProtocol}.`,
+    };
+  }
+  if (result.status === "blocked") {
+    return { accepted: false, reason: result.reason };
+  }
+  return { accepted: true, result };
+}
diff --git a/apps/server/src/cloud/migrationPreflight.test.ts b/apps/server/src/cloud/migrationPreflight.test.ts
