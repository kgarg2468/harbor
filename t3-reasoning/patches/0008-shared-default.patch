diff --git a/apps/web/src/components/chat/localWorkGuard.ts b/apps/web/src/components/chat/localWorkGuard.ts
new file mode 100644
index 0000000000000000000000000000000000000000..fb2a3e6ea6de63c3957b6a65abf2787e2dd4caa4
--- /dev/null
+++ b/apps/web/src/components/chat/localWorkGuard.ts
@@ -0,0 +1,31 @@
+/**
+ * How a composer submit resolves against the local new-work guard.
+ *
+ * Answering a question the agent already asked continues existing work, so
+ * it stays allowed while new work on this environment is refused. Only a new
+ * provider turn is blocked.
+ */
+export type ComposerSubmitRoute = "reply-to-pending-user-input" | "blocked" | "start-turn";
+
+export function resolveComposerSubmitRoute(input: {
+  readonly newWorkBlocked: boolean;
+  readonly hasPendingUserInput: boolean;
+}): ComposerSubmitRoute {
+  if (input.hasPendingUserInput) {
+    return "reply-to-pending-user-input";
+  }
+  return input.newWorkBlocked ? "blocked" : "start-turn";
+}
+
+export const NEW_WORK_SEND_DISABLED_REASON = "New work is disabled here";
+
+/**
+ * The disabled reason the composer shows for the guard, if any. Pending input
+ * must keep its Next/Submit form usable, so the reason is withheld then.
+ */
+export function resolveNewWorkSendDisabledReason(input: {
+  readonly newWorkBlocked: boolean;
+  readonly hasPendingUserInput: boolean;
+}): string | null {
+  return resolveComposerSubmitRoute(input) === "blocked" ? NEW_WORK_SEND_DISABLED_REASON : null;
+}
