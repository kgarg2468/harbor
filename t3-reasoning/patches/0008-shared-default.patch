diff --git a/apps/web/src/components/SharedEnvironmentStatus.tsx b/apps/web/src/components/SharedEnvironmentStatus.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..d39bc058e13ad5043f8411b423f358a6f9636045
--- /dev/null
+++ b/apps/web/src/components/SharedEnvironmentStatus.tsx
@@ -0,0 +1,78 @@
+import { useNavigate } from "@tanstack/react-router";
+import { useCallback } from "react";
+
+import { environmentCatalog } from "~/connection/catalog";
+import { ensureClientSettingsHydrated } from "~/hooks/useSettings";
+import { useAuthoritativeEnvironmentResolution, useEnvironment } from "~/state/environments";
+import {
+  isPinnedEnvironmentResolution,
+  resolveSharedEnvironmentIssue,
+} from "~/state/preferredEnvironment";
+import { useAtomCommand } from "~/state/use-atom-command";
+import { Button } from "./ui/button";
+
+/**
+ * Banner shown while the shared default cannot be used: its preference could
+ * not be read, it is unreachable, or it was removed from this client. It only
+ * describes where shared threads live; it never offers the local environment
+ * as a substitute. The fix is to retry or to pick a default in
+ * Settings → Connections.
+ */
+export function SharedEnvironmentStatus() {
+  const resolution = useAuthoritativeEnvironmentResolution();
+  const pinnedEnvironmentId = isPinnedEnvironmentResolution(resolution)
+    ? resolution.environmentId
+    : null;
+  const environment = useEnvironment(pinnedEnvironmentId);
+  const retryEnvironment = useAtomCommand(environmentCatalog.retryNow, { reportFailure: false });
+  const navigate = useNavigate();
+  const issue = resolveSharedEnvironmentIssue({
+    resolution,
+    connectionPhase: environment?.connection.phase ?? null,
+  });
+  const openConnections = useCallback(() => {
+    void navigate({ to: "/settings/connections" });
+  }, [navigate]);
+  const retry = useCallback(() => {
+    if (issue === "preference-unavailable") {
+      // A failed read stays retryable; a repeat failure is already logged and
+      // keeps the banner up.
+      void ensureClientSettingsHydrated().catch(() => undefined);
+      return;
+    }
+    if (pinnedEnvironmentId !== null) {
+      void retryEnvironment(pinnedEnvironmentId);
+    }
+  }, [issue, pinnedEnvironmentId, retryEnvironment]);
+
+  if (issue === null) {
+    return null;
+  }
+
+  const label = environment?.label ?? "Your shared environment";
+  const message =
+    issue === "preference-unavailable"
+      ? "Couldn't read which environment this device uses as its shared default. Retry, or choose one in Connections."
+      : issue === "missing"
+        ? "Your shared environment is no longer saved on this device. Its threads stay there; add it again or choose another in Connections."
+        : `${label} is unreachable right now. Its threads stay there until it reconnects.`;
+
+  return (
+    <div
+      role="status"
+      className="flex shrink-0 flex-wrap items-center justify-between gap-x-4 gap-y-2 border-t border-warning/30 bg-warning/8 px-4 pt-2 pb-[calc(max(env(safe-area-inset-bottom),0px)+0.5rem)] text-xs text-foreground"
+    >
+      <p className="min-w-0 flex-1">{message}</p>
+      <div className="flex shrink-0 items-center gap-2">
+        {issue !== "missing" ? (
+          <Button size="xs" variant="outline" onClick={retry}>
+            Retry
+          </Button>
+        ) : null}
+        <Button size="xs" variant="outline" onClick={openConnections}>
+          Open Connections
+        </Button>
+      </div>
+    </div>
+  );
+}
