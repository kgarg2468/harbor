+/**
+ * The environment that owns this client's threads, drafts and defaults. With
+ * no saved preference this is the platform primary; with one it is the saved
+ * environment even while it is offline, blocked or missing from the catalog.
+ */
+export const authoritativeEnvironmentResolutionAtom = Atom.make(
+  (get): AuthoritativeEnvironmentResolution => {
+    const catalog = get(environmentCatalog.catalogValueAtom);
+    return resolveAuthoritativeEnvironment({
+      preference: get(preferredEnvironmentStateAtom),
+      catalogReady: catalog.isReady,
+      hasCatalogEntry: (environmentId) => catalog.entries.has(environmentId),
+      platformPrimaryEnvironmentId: get(platformPrimaryEnvironmentIdAtom),
+    });
+  },
+).pipe(Atom.withLabel("web-authoritative-environment-resolution"));
+
+export const authoritativeEnvironmentIdAtom = Atom.make(
+  (get) => get(authoritativeEnvironmentResolutionAtom).environmentId,
+).pipe(Atom.withLabel("web-authoritative-environment-id"));
+
+/**
+ * "Primary" throughout the app means the authoritative environment. Code that
+ * needs the local control host must read `platformPrimaryEnvironmentIdAtom`.
+ */
+export const primaryEnvironmentIdAtom = authoritativeEnvironmentIdAtom;
+
+/**
+ * The platform primary while new work there is refused (a shared default is
+ * saved elsewhere, or the preference is unread/unreadable); null otherwise.
+ * Work-only selectors drop this environment from new-work choices while raw
+ * catalog, project and thread access stays intact for existing work.
+ */
+export const newWorkBlockedEnvironmentIdAtom = Atom.make((get): EnvironmentId | null => {
+  const platformPrimaryEnvironmentId = get(platformPrimaryEnvironmentIdAtom);
+  if (platformPrimaryEnvironmentId === null) {
+    return null;
+  }
+  const policy = resolveNewWorkPolicy({
+    resolution: get(authoritativeEnvironmentResolutionAtom),
+    platformPrimaryEnvironmentId,
+    targetEnvironmentId: platformPrimaryEnvironmentId,
+  });
+  return policy.allowed ? null : platformPrimaryEnvironmentId;
+}).pipe(Atom.withLabel("web-new-work-blocked-environment-id"));
+
+/** Current policy at call time, for handlers that run outside React. */
+export function readNewWorkPolicy(targetEnvironmentId: EnvironmentId | null): NewWorkPolicy {
+  return resolveNewWorkPolicy({
+    resolution: appAtomRegistry.get(authoritativeEnvironmentResolutionAtom),
+    platformPrimaryEnvironmentId: appAtomRegistry.get(platformPrimaryEnvironmentIdAtom),
+    targetEnvironmentId,
+  });
+}
