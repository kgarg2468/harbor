new file mode 100644
index 000000000..76b5f97ee
--- /dev/null
+++ b/apps/web/src/state/preferredEnvironment.ts
@@ -0,0 +1,247 @@
+import type { EnvironmentConnectionPhase } from "@t3tools/client-runtime/connection";
+import type { EnvironmentId } from "@t3tools/contracts";
+import { Atom } from "effect/unstable/reactivity";
+
+import { appAtomRegistry } from "../rpc/atomRegistry";
+
+/**
+ * Whether the persisted shared-default preference has been read.
+ * `loading` until the first read settles; `failed` when the read threw, which
+ * is different from a file that simply predates the preference (`loaded`
+ * with a null id).
+ */
+export type PreferredEnvironmentLoadStatus = "loading" | "loaded" | "failed";
+
+/**
+ * The persisted shared-default preference as the state layer sees it. Nothing
+ * downstream resolves a primary environment until the status is `loaded`, so
+ * schema defaults are never mistaken for an explicit "automatic" choice.
+ */
+export interface PreferredEnvironmentState {
+  readonly status: PreferredEnvironmentLoadStatus;
+  readonly preferredEnvironmentId: EnvironmentId | null;
+}
+
+const INITIAL_PREFERRED_ENVIRONMENT_STATE: PreferredEnvironmentState = {
+  status: "loading",
+  preferredEnvironmentId: null,
+};
+
+/**
+ * Bridge from the client-settings store into atoms. `useSettings` publishes
+ * here on every snapshot and hydration change; the primary-environment atoms
+ * read it. This module deliberately imports nothing from `useSettings` or
+ * `server`, which keeps the preference readable from the state layer without
+ * an import cycle.
+ */
+export const preferredEnvironmentStateAtom = Atom.make(INITIAL_PREFERRED_ENVIRONMENT_STATE).pipe(
+  Atom.keepAlive,
+  Atom.withLabel("web-preferred-environment-state"),
+);
+
+export function publishPreferredEnvironmentState(next: PreferredEnvironmentState): void {
+  const current = appAtomRegistry.get(preferredEnvironmentStateAtom);
+  if (
+    current.status === next.status &&
+    current.preferredEnvironmentId === next.preferredEnvironmentId
+  ) {
+    return;
+  }
+  appAtomRegistry.set(preferredEnvironmentStateAtom, next);
+}
+
+export function readPreferredEnvironmentState(): PreferredEnvironmentState {
+  return appAtomRegistry.get(preferredEnvironmentStateAtom);
+}
+
+/**
+ * Which environment owns threads, drafts and defaults for this client.
+ *
+ * - `unresolved`: the preference has not been read yet; nothing is primary.
+ * - `preference-unavailable`: reading the preference failed. Nothing is
+ *   primary until a retry succeeds; a failed read is not an automatic choice.
+ * - `automatic`: no preference saved; the platform primary (the environment
+ *   this app is served from or embeds) is used, as it always was.
+ * - `pinned`: the saved environment exists in the catalog. It stays
+ *   authoritative while offline or blocked; this never falls back to local.
+ * - `missing-preferred-target`: the saved environment is gone from the
+ *   catalog. The id is kept so the user can repair or replace it explicitly.
+ */
+export type AuthoritativeEnvironmentResolution =
+  | { readonly status: "unresolved"; readonly environmentId: null }
+  | { readonly status: "preference-unavailable"; readonly environmentId: null }
+  | { readonly status: "automatic"; readonly environmentId: EnvironmentId | null }
+  | { readonly status: "pinned"; readonly environmentId: EnvironmentId }
+  | { readonly status: "missing-preferred-target"; readonly environmentId: EnvironmentId };
+
+export function resolveAuthoritativeEnvironment(input: {
+  readonly preference: PreferredEnvironmentState;
+  readonly catalogReady: boolean;
+  readonly hasCatalogEntry: (environmentId: EnvironmentId) => boolean;
+  readonly platformPrimaryEnvironmentId: EnvironmentId | null;
+}): AuthoritativeEnvironmentResolution {
+  switch (input.preference.status) {
+    case "loading":
+      return { status: "unresolved", environmentId: null };
+    case "failed":
+      return { status: "preference-unavailable", environmentId: null };
+    case "loaded":
+      break;
+  }
+  const preferredEnvironmentId = input.preference.preferredEnvironmentId;
+  if (preferredEnvironmentId === null) {
+    return { status: "automatic", environmentId: input.platformPrimaryEnvironmentId };
+  }
+  // Before the catalog loads the entry cannot be judged missing; the pinned id
+  // is still the only acceptable answer, so it is reported as pinned.
+  if (input.catalogReady && !input.hasCatalogEntry(preferredEnvironmentId)) {
+    return { status: "missing-preferred-target", environmentId: preferredEnvironmentId };
+  }
+  return { status: "pinned", environmentId: preferredEnvironmentId };
+}
+
+export function isPinnedEnvironmentResolution(
+  resolution: AuthoritativeEnvironmentResolution,
+): resolution is Extract<
+  AuthoritativeEnvironmentResolution,
+  { status: "pinned" | "missing-preferred-target" }
+> {
+  return resolution.status === "pinned" || resolution.status === "missing-preferred-target";
+}
+
+/**
+ * Why new work on the platform primary is refused. Only the platform
+ * environment is ever refused: an explicitly chosen remote environment stays
+ * usable even while the pinned one is offline.
+ */
+export type NewWorkDenialReason = "unresolved" | "preference-unavailable" | "pinned-elsewhere";
+
+export type NewWorkPolicy =
+  | { readonly allowed: true; readonly reason: null }
+  | { readonly allowed: false; readonly reason: NewWorkDenialReason };
+
+const NEW_WORK_ALLOWED: NewWorkPolicy = { allowed: true, reason: null };
+
+/**
+ * Whether NEW work may start in `targetEnvironmentId`. Existing local threads
+ * keep their history, approvals, input replies and stop controls; this only
+ * decides whether another thread, turn, terminal, preview, project or
+ * checkout mutation may begin there. An unread or unreadable preference is
+ * not permission: until it resolves the platform primary is refused.
+ */
+export function resolveNewWorkPolicy(input: {
+  readonly resolution: AuthoritativeEnvironmentResolution;
+  readonly platformPrimaryEnvironmentId: EnvironmentId | null;
+  readonly targetEnvironmentId: EnvironmentId | null;
+}): NewWorkPolicy {
+  if (
+    input.targetEnvironmentId === null ||
+    input.platformPrimaryEnvironmentId === null ||
+    input.targetEnvironmentId !== input.platformPrimaryEnvironmentId
+  ) {
+    return NEW_WORK_ALLOWED;
+  }
+  switch (input.resolution.status) {
+    case "automatic":
+      return NEW_WORK_ALLOWED;
+    case "unresolved":
+      return { allowed: false, reason: "unresolved" };
+    case "preference-unavailable":
+      return { allowed: false, reason: "preference-unavailable" };
+    case "pinned":
+    case "missing-preferred-target":
+      return input.resolution.environmentId === input.targetEnvironmentId
+        ? NEW_WORK_ALLOWED
+        : { allowed: false, reason: "pinned-elsewhere" };
+  }
+}
+
+export function describeNewWorkDenial(reason: NewWorkDenialReason): string {
+  switch (reason) {
+    case "unresolved":
+      return "Waiting for this device's shared environment before starting work here.";
+    case "preference-unavailable":
+      return "Couldn't read which environment this device uses. Retry from the banner or choose one in Connections before starting work here.";
+    case "pinned-elsewhere":
+      return "New work goes to your shared environment. This app's built-in environment only keeps its existing threads.";
+  }
+}
+
+export class NewLocalWorkBlockedError extends Error {
+  readonly _tag = "NewLocalWorkBlockedError";
+  constructor(readonly reason: NewWorkDenialReason) {
+    super(describeNewWorkDenial(reason));
+    this.name = "NewLocalWorkBlockedError";
+  }
+}
+
+/**
+ * Commands that start new work in an environment. Everything else (approval
+ * and user-input replies, interrupt/stop, terminal close, preview close,
+ * metadata, history, connection retry, exposure and pairing administration)
+ * stays available so pre-existing local work can finish and be inspected.
+ */
+const NEW_WORK_COMMAND_LABELS: ReadonlySet<string> = new Set([
+  "environment-data:commands:thread:create",
+  "environment-data:commands:thread:fork",
+  "environment-data:commands:thread:start-turn",
+  "environment-data:commands:thread:revert-checkpoint",
+  "environment-data:commands:project:create",
+  "environment-data:projects:write-file",
+  "environment-data:vcs:pull",
+  "environment-data:vcs:create-worktree",
+  "environment-data:vcs:remove-worktree",
+  "environment-data:vcs:create-ref",
+  "environment-data:vcs:switch-ref",
+  "environment-data:vcs:init",
+  "environment-data:source-control:clone-repository",
+  "environment-data:source-control:publish-repository",
+  "environment-data:git:prepare-pull-request-thread",
+  "environment-data:terminal:open",
+  "environment-data:terminal:write",
+  "environment-data:terminal:restart",
+  "environment-data:preview:open",
+]);
+
+const NEW_WORK_COMMAND_LABEL_PREFIXES: ReadonlyArray<string> = ["vcs-action:run-stacked:"];
+
+/** Matches the command's own stable label, never a caller's presentation label. */
+export function isNewWorkCommandLabel(label: string): boolean {
+  return (
+    NEW_WORK_COMMAND_LABELS.has(label) ||
+    NEW_WORK_COMMAND_LABEL_PREFIXES.some((prefix) => label.startsWith(prefix))
+  );
+}
+
+export type SharedEnvironmentIssue = "preference-unavailable" | "missing" | "unreachable";
+
+/**
+ * Whether the shared default needs the user's attention. Connection attempts
+ * in flight are not an issue; the catalog is already retrying.
+ */
+export function resolveSharedEnvironmentIssue(input: {
+  readonly resolution: AuthoritativeEnvironmentResolution;
+  readonly connectionPhase: EnvironmentConnectionPhase | null;
+}): SharedEnvironmentIssue | null {
+  switch (input.resolution.status) {
+    case "unresolved":
+    case "automatic":
+      return null;
+    case "preference-unavailable":
+      return "preference-unavailable";
+    case "missing-preferred-target":
+      return "missing";
+    case "pinned":
+      switch (input.connectionPhase) {
+        case null:
+        case "connected":
+        case "connecting":
+        case "reconnecting":
+          return null;
+        case "available":
+        case "offline":
+        case "error":
+          return "unreachable";
+      }
+  }
+}
