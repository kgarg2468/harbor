+import type { AtomCommand } from "@t3tools/client-runtime/state/runtime";
+import { EnvironmentId } from "@t3tools/contracts";
+import * as Cause from "effect/Cause";
+import { AsyncResult, type Atom, AtomRegistry } from "effect/unstable/reactivity";
+import { beforeEach, describe, expect, it, vi } from "vite-plus/test";
+
+import type { AuthoritativeEnvironmentResolution } from "./preferredEnvironment";
+
+vi.mock("./primaryEnvironment", async () => {
+  const { Atom } = await import("effect/unstable/reactivity");
+  return {
+    authoritativeEnvironmentResolutionAtom: Atom.make<AuthoritativeEnvironmentResolution>({
+      status: "unresolved",
+      environmentId: null,
+    }).pipe(Atom.keepAlive),
+    platformPrimaryEnvironmentIdAtom: Atom.make<EnvironmentId | null>(null).pipe(Atom.keepAlive),
+  };
+});
+
+import {
+  authoritativeEnvironmentResolutionAtom,
+  platformPrimaryEnvironmentIdAtom,
+} from "./primaryEnvironment";
+import { runGuardedAtomCommand } from "./use-atom-command";
+
+const local = EnvironmentId.make("env-local");
+const pinnedRemote = EnvironmentId.make("env-remote-a");
+const otherRemote = EnvironmentId.make("env-remote-b");
+
+const registry = AtomRegistry.make();
+const resolutionAtom =
+  authoritativeEnvironmentResolutionAtom as unknown as Atom.Writable<AuthoritativeEnvironmentResolution>;
+const platformAtom =
+  platformPrimaryEnvironmentIdAtom as unknown as Atom.Writable<EnvironmentId | null>;
+
+function setResolution(resolution: AuthoritativeEnvironmentResolution) {
+  registry.set(resolutionAtom, resolution);
+}
+
+function makeCommand(label: string) {
+  const run = vi.fn(async () => AsyncResult.success<string, never>("ran"));
+  const command: AtomCommand<unknown, string, never> = { label, run };
+  return { command, run };
+}
+
+function environmentInput(environmentId: EnvironmentId) {
+  return { environmentId, input: {} };
+}
+
+const NEW_WORK_LABELS = [
+  "environment-data:commands:thread:create",
+  "environment-data:commands:thread:fork",
+  "environment-data:commands:thread:start-turn",
+  "environment-data:commands:thread:revert-checkpoint",
+  "environment-data:commands:project:create",
+  "environment-data:projects:write-file",
+  "environment-data:vcs:pull",
+  "environment-data:vcs:create-worktree",
+  "environment-data:vcs:switch-ref",
+  "environment-data:git:prepare-pull-request-thread",
+  "environment-data:terminal:open",
+  "environment-data:terminal:write",
+  "environment-data:terminal:restart",
+  "environment-data:preview:open",
+];
+
+const PRESERVED_LABELS = [
+  "environment-data:commands:thread:respond-to-approval",
+  "environment-data:commands:thread:respond-to-user-input",
+  "environment-data:commands:thread:interrupt-turn",
+  "environment-data:commands:thread:stop-session",
+  "environment-data:commands:thread:update-metadata",
+  "environment-data:commands:thread:archive",
+  "environment-data:terminal:close",
+  "environment-data:preview:close",
+  "environment-data:vcs:refresh-status",
+];
+
+beforeEach(() => {
+  registry.set(platformAtom, local);
+  setResolution({ status: "pinned", environmentId: pinnedRemote });
+});
+
+describe("runGuardedAtomCommand", () => {
+  it("refuses every new-work command on the platform primary without calling run", async () => {
+    for (const label of NEW_WORK_LABELS) {
+      const { command, run } = makeCommand(label);
+      const result = await runGuardedAtomCommand(registry, command, environmentInput(local), {
+        reportFailure: false,
+      });
+      expect(result._tag, label).toBe("Failure");
+      expect(run, label).not.toHaveBeenCalled();
+      if (result._tag === "Failure") {
+        const error = Cause.squash(result.cause);
+        expect(error).toBeInstanceOf(Error);
+        expect((error as Error).message).toMatch(/shared environment/);
+      }
+    }
+  });
+
+  it("still runs the same commands on the pinned and on any other explicit remote", async () => {
+    for (const label of NEW_WORK_LABELS) {
+      for (const environmentId of [pinnedRemote, otherRemote]) {
+        const { command, run } = makeCommand(label);
+        const result = await runGuardedAtomCommand(
+          registry,
+          command,
+          environmentInput(environmentId),
+        );
+        expect(result._tag, label).toBe("Success");
+        expect(run, label).toHaveBeenCalledTimes(1);
+      }
+    }
+  });
+
+  it("keeps approvals, input replies, stop, close and metadata working on old local work", async () => {
+    for (const label of PRESERVED_LABELS) {
+      const { command, run } = makeCommand(label);
+      const result = await runGuardedAtomCommand(registry, command, environmentInput(local));
+      expect(result._tag, label).toBe("Success");
+      expect(run, label).toHaveBeenCalledTimes(1);
+    }
+  });
+
+  it("restores local work in automatic mode", async () => {
+    setResolution({ status: "automatic", environmentId: local });
+    const { command, run } = makeCommand("environment-data:commands:thread:start-turn");
+    const result = await runGuardedAtomCommand(registry, command, environmentInput(local));
+    expect(result._tag).toBe("Success");
+    expect(run).toHaveBeenCalledTimes(1);
+  });
+
+  it("does not let an unread or unreadable preference permit local work", async () => {
+    for (const resolution of [
+      { status: "unresolved", environmentId: null },
+      { status: "preference-unavailable", environmentId: null },
+    ] as const) {
+      setResolution(resolution);
+      const localCommand = makeCommand("environment-data:terminal:open");
+      const localResult = await runGuardedAtomCommand(
+        registry,
+        localCommand.command,
+        environmentInput(local),
+        { reportFailure: false },
+      );
+      expect(localResult._tag, resolution.status).toBe("Failure");
+      expect(localCommand.run).not.toHaveBeenCalled();
+
+      const remoteCommand = makeCommand("environment-data:terminal:open");
+      await runGuardedAtomCommand(registry, remoteCommand.command, environmentInput(otherRemote));
+      expect(remoteCommand.run, resolution.status).toHaveBeenCalledTimes(1);
+    }
+  });
+
+  it("checks the policy at invocation so an old callback is blocked after a pin change", async () => {
+    setResolution({ status: "automatic", environmentId: local });
+    const { command, run } = makeCommand("environment-data:commands:thread:create");
+    const invoke = () =>
+      runGuardedAtomCommand(registry, command, environmentInput(local), { reportFailure: false });
+
+    expect((await invoke())._tag).toBe("Success");
+    setResolution({ status: "pinned", environmentId: pinnedRemote });
+    expect((await invoke())._tag).toBe("Failure");
+    expect(run).toHaveBeenCalledTimes(1);
+
+    setResolution({ status: "automatic", environmentId: local });
+    expect((await invoke())._tag).toBe("Success");
+    expect(run).toHaveBeenCalledTimes(2);
+  });
+
+  it("uses the explicit target resolver for closure-scoped commands", async () => {
+    const blocked = makeCommand("vcs-action:run-stacked:some-key");
+    const blockedResult = await runGuardedAtomCommand(
+      registry,
+      blocked.command,
+      { actionId: "a", action: "commit" },
+      { reportFailure: false, resolveTargetEnvironmentId: () => local },
+    );
+    expect(blockedResult._tag).toBe("Failure");
+    expect(blocked.run).not.toHaveBeenCalled();
+
+    const remote = makeCommand("vcs-action:run-stacked:other-key");
+    await runGuardedAtomCommand(
+      registry,
+      remote.command,
+      { actionId: "a", action: "commit" },
+      { resolveTargetEnvironmentId: () => otherRemote },
+    );
+    expect(remote.run).toHaveBeenCalledTimes(1);
+  });
+
+  it("prefers the resolver over an environmentId in the input", async () => {
+    const { command, run } = makeCommand("environment-data:terminal:write");
+    const result = await runGuardedAtomCommand(registry, command, environmentInput(otherRemote), {
+      reportFailure: false,
+      resolveTargetEnvironmentId: () => local,
+    });
+    expect(result._tag).toBe("Failure");
+    expect(run).not.toHaveBeenCalled();
+  });
+
+  it("does nothing special in the hosted app with no platform primary", async () => {
+    registry.set(platformAtom, null);
+    const { command, run } = makeCommand("environment-data:commands:thread:start-turn");
+    await runGuardedAtomCommand(registry, command, environmentInput(local));
+    expect(run).toHaveBeenCalledTimes(1);
+  });
+});
diff --git a/apps/web/src/state/use-atom-command.ts b/apps/web/src/state/use-atom-command.ts
index 37ce280e9..b7564bf62 100644
--- a/apps/web/src/state/use-atom-command.ts
+++ b/apps/web/src/state/use-atom-command.ts
@@ -5,19 +5,90 @@ import {
   type AtomCommandResult,
   runAtomCommand,
 } from "@t3tools/client-runtime/state/runtime";
+import type { EnvironmentId } from "@t3tools/contracts";
+import * as Cause from "effect/Cause";
+import { AsyncResult, type AtomRegistry } from "effect/unstable/reactivity";
 import { useCallback, useContext } from "react";
 
+import {
+  isNewWorkCommandLabel,
+  NewLocalWorkBlockedError,
+  resolveNewWorkPolicy,
+} from "./preferredEnvironment";
+import {
+  authoritativeEnvironmentResolutionAtom,
+  platformPrimaryEnvironmentIdAtom,
+} from "./primaryEnvironment";
+
+export interface WebAtomCommandOptions<W> extends AtomCommandOptions {
+  /**
+   * Where the command acts when its input carries no `environmentId`, such as
+   * a command created against a closure-scoped target. Environment commands
+   * (`{ environmentId, input }`) need no resolver.
+   */
+  readonly resolveTargetEnvironmentId?: (input: W) => EnvironmentId | null;
+}
+
+function readInputEnvironmentId(input: unknown): EnvironmentId | null {
+  if (typeof input !== "object" || input === null || !("environmentId" in input)) {
+    return null;
+  }
+  const environmentId = input.environmentId;
+  return typeof environmentId === "string" ? (environmentId as EnvironmentId) : null;
+}
+
+/**
+ * Web boundary for the managed shared default: a command that would start new
+ * work on the platform primary is refused at invocation time, against the
+ * policy in force right then, so a stale callback is blocked after a pin
+ * change. Denials settle as the ordinary Failure result so callers keep their
+ * existing error handling; nothing reaches the environment. Everything else
+ * runs untouched.
+ */
+export function runGuardedAtomCommand<W, A, E>(
+  registry: AtomRegistry.AtomRegistry,
+  command: AtomCommand<W, A, E>,
+  input: W,
+  options: WebAtomCommandOptions<W> = {},
+): Promise<AtomCommandResult<A, E>> {
+  if (isNewWorkCommandLabel(command.label)) {
+    const targetEnvironmentId = options.resolveTargetEnvironmentId
+      ? options.resolveTargetEnvironmentId(input)
+      : readInputEnvironmentId(input);
+    const policy = resolveNewWorkPolicy({
+      resolution: registry.get(authoritativeEnvironmentResolutionAtom),
+      platformPrimaryEnvironmentId: registry.get(platformPrimaryEnvironmentIdAtom),
+      targetEnvironmentId,
+    });
+    if (!policy.allowed) {
+      return Promise.resolve(
+        AsyncResult.failure<A, E>(Cause.die(new NewLocalWorkBlockedError(policy.reason))),
+      );
+    }
+  }
+  const { resolveTargetEnvironmentId: _resolveTargetEnvironmentId, ...runOptions } = options;
+  return runAtomCommand(registry, command, input, runOptions);
+}
+
 export function useAtomCommand<A, E, W>(
   command: AtomCommand<W, A, E>,
-  options?: string | AtomCommandOptions,
+  options?: string | WebAtomCommandOptions<W>,
 ): (value: W) => Promise<AtomCommandResult<A, E>> {
   const registry = useContext(RegistryContext);
   const label = typeof options === "string" ? options : (options?.label ?? command.label);
   const reportFailure = typeof options === "string" ? true : (options?.reportFailure ?? true);
   const reportDefect = typeof options === "string" ? true : (options?.reportDefect ?? true);
+  const resolveTargetEnvironmentId =
+    typeof options === "string" ? undefined : options?.resolveTargetEnvironmentId;
 
   return useCallback(
-    (value: W) => runAtomCommand(registry, command, value, { label, reportFailure, reportDefect }),
-    [command, label, registry, reportDefect, reportFailure],
+    (value: W) =>
+      runGuardedAtomCommand(registry, command, value, {
+        label,
+        reportFailure,
+        reportDefect,
+        ...(resolveTargetEnvironmentId === undefined ? {} : { resolveTargetEnvironmentId }),
+      }),
+    [command, label, registry, reportDefect, reportFailure, resolveTargetEnvironmentId],
   );
 }
