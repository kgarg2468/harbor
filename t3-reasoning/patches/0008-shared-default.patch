+import { EnvironmentId } from "@t3tools/contracts";
+import { describe, expect, it } from "vite-plus/test";
+
+import {
+  describeNewWorkDenial,
+  isNewWorkCommandLabel,
+  isPinnedEnvironmentResolution,
+  NewLocalWorkBlockedError,
+  publishPreferredEnvironmentState,
+  readPreferredEnvironmentState,
+  resolveAuthoritativeEnvironment,
+  resolveNewWorkPolicy,
+  resolveSharedEnvironmentIssue,
+  type AuthoritativeEnvironmentResolution,
+  type PreferredEnvironmentLoadStatus,
+} from "./preferredEnvironment";
+
+const platformId = EnvironmentId.make("env-platform");
+const sharedId = EnvironmentId.make("env-shared");
+
+function resolve(input: {
+  status?: PreferredEnvironmentLoadStatus;
+  preferredEnvironmentId?: EnvironmentId | null;
+  catalogReady?: boolean;
+  catalogIds?: ReadonlyArray<EnvironmentId>;
+  platformPrimaryEnvironmentId?: EnvironmentId | null;
+}) {
+  const catalogIds = new Set(input.catalogIds ?? [platformId, sharedId]);
+  return resolveAuthoritativeEnvironment({
+    preference: {
+      status: input.status ?? "loaded",
+      preferredEnvironmentId: input.preferredEnvironmentId ?? null,
+    },
+    catalogReady: input.catalogReady ?? true,
+    hasCatalogEntry: (environmentId) => catalogIds.has(environmentId),
+    platformPrimaryEnvironmentId:
+      input.platformPrimaryEnvironmentId === undefined
+        ? platformId
+        : input.platformPrimaryEnvironmentId,
+  });
+}
+
+describe("resolveAuthoritativeEnvironment", () => {
+  it("resolves nothing before client settings hydrate, even with a platform primary", () => {
+    expect(resolve({ status: "loading" })).toEqual({ status: "unresolved", environmentId: null });
+    expect(resolve({ status: "loading", preferredEnvironmentId: sharedId })).toEqual({
+      status: "unresolved",
+      environmentId: null,
+    });
+  });
+
+  it("never treats a failed settings read as an automatic choice", () => {
+    expect(resolve({ status: "failed" })).toEqual({
+      status: "preference-unavailable",
+      environmentId: null,
+    });
+  });
+
+  it("keeps the legacy automatic behavior when no preference is saved", () => {
+    expect(resolve({})).toEqual({ status: "automatic", environmentId: platformId });
+    expect(resolve({ platformPrimaryEnvironmentId: null })).toEqual({
+      status: "automatic",
+      environmentId: null,
+    });
+  });
+
+  it("pins the saved environment when the catalog has it", () => {
+    expect(resolve({ preferredEnvironmentId: sharedId })).toEqual({
+      status: "pinned",
+      environmentId: sharedId,
+    });
+  });
+
+  it("stays on the pinned id while the catalog is still loading", () => {
+    expect(
+      resolve({ preferredEnvironmentId: sharedId, catalogReady: false, catalogIds: [] }),
+    ).toEqual({ status: "pinned", environmentId: sharedId });
+  });
+
+  it("reports a missing target instead of falling back to the platform primary", () => {
+    expect(resolve({ preferredEnvironmentId: sharedId, catalogIds: [platformId] })).toEqual({
+      status: "missing-preferred-target",
+      environmentId: sharedId,
+    });
+  });
+
+  it("treats pinned and missing as the explicit preference", () => {
+    const cases: ReadonlyArray<[AuthoritativeEnvironmentResolution, boolean]> = [
+      [{ status: "unresolved", environmentId: null }, false],
+      [{ status: "preference-unavailable", environmentId: null }, false],
+      [{ status: "automatic", environmentId: platformId }, false],
+      [{ status: "pinned", environmentId: sharedId }, true],
+      [{ status: "missing-preferred-target", environmentId: sharedId }, true],
+    ];
+    for (const [resolution, expected] of cases) {
+      expect(isPinnedEnvironmentResolution(resolution)).toBe(expected);
+    }
+  });
+});
+
+describe("resolveSharedEnvironmentIssue", () => {
+  const pinned: AuthoritativeEnvironmentResolution = { status: "pinned", environmentId: sharedId };
+
+  it("never raises an issue in automatic or unresolved mode", () => {
+    expect(
+      resolveSharedEnvironmentIssue({
+        resolution: { status: "automatic", environmentId: platformId },
+        connectionPhase: "error",
+      }),
+    ).toBeNull();
+    expect(
+      resolveSharedEnvironmentIssue({
+        resolution: { status: "unresolved", environmentId: null },
+        connectionPhase: null,
+      }),
+    ).toBeNull();
+  });
+
+  it("flags an unreadable preference and a missing target regardless of connection state", () => {
+    expect(
+      resolveSharedEnvironmentIssue({
+        resolution: { status: "preference-unavailable", environmentId: null },
+        connectionPhase: null,
+      }),
+    ).toBe("preference-unavailable");
+    expect(
+      resolveSharedEnvironmentIssue({
+        resolution: { status: "missing-preferred-target", environmentId: sharedId },
+        connectionPhase: null,
+      }),
+    ).toBe("missing");
+  });
+
+  it("stays quiet while the pinned environment is connected or attempting", () => {
+    for (const connectionPhase of ["connected", "connecting", "reconnecting", null] as const) {
+      expect(resolveSharedEnvironmentIssue({ resolution: pinned, connectionPhase })).toBeNull();
+    }
+  });
+
+  it("reports an unreachable pinned environment", () => {
+    for (const connectionPhase of ["available", "offline", "error"] as const) {
+      expect(resolveSharedEnvironmentIssue({ resolution: pinned, connectionPhase })).toBe(
+        "unreachable",
+      );
+    }
+  });
+});
+
+describe("resolveNewWorkPolicy", () => {
+  const otherRemoteId = EnvironmentId.make("env-remote-b");
+  const policy = (
+    resolution: AuthoritativeEnvironmentResolution,
+    targetEnvironmentId: EnvironmentId | null,
+    platformPrimaryEnvironmentId: EnvironmentId | null = platformId,
+  ) => resolveNewWorkPolicy({ resolution, platformPrimaryEnvironmentId, targetEnvironmentId });
+
+  it("refuses the platform primary while a shared default is pinned elsewhere", () => {
+    expect(policy({ status: "pinned", environmentId: sharedId }, platformId)).toEqual({
+      allowed: false,
+      reason: "pinned-elsewhere",
+    });
+    expect(
+      policy({ status: "missing-preferred-target", environmentId: sharedId }, platformId),
+    ).toEqual({ allowed: false, reason: "pinned-elsewhere" });
+  });
+
+  it("keeps the pinned and every other explicit remote available", () => {
+    const pinned: AuthoritativeEnvironmentResolution = {
+      status: "pinned",
+      environmentId: sharedId,
+    };
+    expect(policy(pinned, sharedId).allowed).toBe(true);
+    expect(policy(pinned, otherRemoteId).allowed).toBe(true);
+  });
+
+  it("does not treat an unread or unreadable preference as permission", () => {
+    expect(policy({ status: "unresolved", environmentId: null }, platformId)).toEqual({
+      allowed: false,
+      reason: "unresolved",
+    });
+    expect(policy({ status: "preference-unavailable", environmentId: null }, platformId)).toEqual({
+      allowed: false,
+      reason: "preference-unavailable",
+    });
+    expect(policy({ status: "unresolved", environmentId: null }, otherRemoteId).allowed).toBe(true);
+  });
+
+  it("allows local work in automatic mode and when there is no platform primary", () => {
+    expect(policy({ status: "automatic", environmentId: platformId }, platformId).allowed).toBe(
+      true,
+    );
+    expect(policy({ status: "pinned", environmentId: sharedId }, platformId, null).allowed).toBe(
+      true,
+    );
+    expect(policy({ status: "pinned", environmentId: sharedId }, null).allowed).toBe(true);
+  });
+
+  it("explains each denial in the thrown error", () => {
+    for (const reason of ["unresolved", "preference-unavailable", "pinned-elsewhere"] as const) {
+      const error = new NewLocalWorkBlockedError(reason);
+      expect(error.message).toBe(describeNewWorkDenial(reason));
+      expect(error.reason).toBe(reason);
+    }
+  });
+});
+
+describe("isNewWorkCommandLabel", () => {
+  it("classifies commands that start new work, including closure-scoped stacked actions", () => {
+    for (const label of [
+      "environment-data:commands:thread:create",
+      "environment-data:commands:thread:start-turn",
+      "environment-data:commands:project:create",
+      "environment-data:projects:write-file",
+      "environment-data:vcs:switch-ref",
+      "environment-data:source-control:clone-repository",
+      "environment-data:git:prepare-pull-request-thread",
+      "environment-data:terminal:open",
+      "environment-data:terminal:write",
+      "environment-data:terminal:restart",
+      "environment-data:preview:open",
+      "vcs-action:run-stacked:any-key",
+    ]) {
+      expect(isNewWorkCommandLabel(label), label).toBe(true);
+    }
+  });
+
+  it("leaves replies, stop, close, metadata, history and administration alone", () => {
+    for (const label of [
+      "environment-data:commands:thread:respond-to-approval",
+      "environment-data:commands:thread:respond-to-user-input",
+      "environment-data:commands:thread:interrupt-turn",
+      "environment-data:commands:thread:stop-session",
+      "environment-data:commands:thread:update-metadata",
+      "environment-data:commands:thread:delete",
+      "environment-data:commands:project:update",
+      "environment-data:terminal:close",
+      "environment-data:preview:close",
+      "environment-data:vcs:status",
+      "environment-data:vcs:refresh-status",
+      "environment-data:provider:auth-start",
+      "terminal open",
+    ]) {
+      expect(isNewWorkCommandLabel(label), label).toBe(false);
+    }
+  });
+});
+
+describe("preferred environment bridge", () => {
+  it("starts loading and publishes only on change", () => {
+    expect(readPreferredEnvironmentState()).toEqual({
+      status: "loading",
+      preferredEnvironmentId: null,
+    });
+    publishPreferredEnvironmentState({ status: "loaded", preferredEnvironmentId: sharedId });
+    const published = readPreferredEnvironmentState();
+    expect(published).toEqual({ status: "loaded", preferredEnvironmentId: sharedId });
+    publishPreferredEnvironmentState({ status: "loaded", preferredEnvironmentId: sharedId });
+    expect(readPreferredEnvironmentState()).toBe(published);
+    publishPreferredEnvironmentState({ status: "loading", preferredEnvironmentId: null });
+  });
+});
