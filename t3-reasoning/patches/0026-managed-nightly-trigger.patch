+
+const INSTALLED = "0.0.38-nightly.20260906.1.managed.1.p6d1933416d7a";
+const OLDER = "0.0.37-nightly.20260905.1.managed.9.p6d1933416d7a";
+const TARGET = "0.0.38-nightly.20260906.1.managed.2.p6d1933416d7a";
+const NEWER = "0.0.38-nightly.20260906.1.managed.3.p6d1933416d7a";
+const NEWEST = "0.0.38-nightly.20260906.1.managed.4.p6d1933416d7a";
+const DISCOVERY = Duration.hours(4);
+const RETRY = Duration.seconds(30);
+
+/** A selection whose source must never be touched by the scheduler. */
+const selectionFor = (version: string): ManagedReleaseSelection => ({
+  repository: MANAGED_RELEASE_REPOSITORY,
+  releaseId: 1,
+  tag: `${MANAGED_RELEASE_TAG_PREFIX}${version}`,
+  version,
+  publishedAt: "2026-09-06T00:00:00Z",
+  githubImmutable: true,
+  manifestSha256: "a".repeat(64),
+  releaseInputSha256: "b".repeat(64),
+  artifactId: `managed-server-darwin-arm64@sha256:${"c".repeat(64)}`,
+  source: {
+    readDocuments: () => Effect.die(`documents of ${version} must not be read by the scheduler`),
+    openArchive: () => Effect.die(`archive of ${version} must not be opened by the scheduler`),
+  },
+});
+
+const artifactFor = (version: string): QueuedUpdate.StagedArtifact => ({
+  version,
+  artifactId: `artifact-${version}`,
+});
+
+/** Signed-looking text that must never reach a scheduler log. */
+const SIGNED_URL = "https://objects.example/asset?X-Amz-Signature=SECRET";
+
+// --- fakes ---------------------------------------------------------------------------
+
+/** In-memory queue with the real `awaitState` contract: durable matches only, waiters removed on interrupt. */
+const makeFakeQueue = (initial?: Partial<QueuedUpdateState>) => {
+  let state: QueuedUpdateState = {
+    stage: "current",
+    installedVersion: INSTALLED,
+    targetVersion: INSTALLED,
+    staged: undefined,
+    reason: undefined,
+    handoffAccepted: false,
+    durable: true,
+    ...initial,
+  };
+  const waiters = new Set<{
+    readonly predicate: (state: QueuedUpdateState) => boolean;
+    readonly deferred: Deferred.Deferred<QueuedUpdateState>;
+  }>();
+  const calls: Array<string> = [];
+  let reject: QueuedUpdateRejectedError["reason"] | undefined;
+
+  const set = (next: Partial<QueuedUpdateState>) => {
+    state = { ...state, ...next };
+    for (const waiter of waiters) {
+      if (state.durable && waiter.predicate(state)) {
+        waiters.delete(waiter);
+        Deferred.doneUnsafe(waiter.deferred, Effect.succeed(state));
+      }
+    }
+  };
+  const transition = (stage: QueuedUpdateStage, targetVersion: string, durable = true) =>
+    set({
+      stage,
+      targetVersion,
+      durable,
+      staged: stage === "queued" || stage === "updating" ? artifactFor(targetVersion) : undefined,
+      reason: undefined,
+    });
+
+  const shape: Pick<QueuedUpdateShape, "queue" | "getState" | "awaitState"> = {
+    queue: (targetVersion) =>
+      Effect.suspend(() => {
+        calls.push(targetVersion);
+        if (reject !== undefined) {
+          return Effect.fail(new QueuedUpdateRejectedError({ reason: reject }));
+        }
+        transition("downloading", targetVersion);
+        return Effect.succeed(state);
+      }),
+    getState: Effect.sync(() => state),
+    awaitState: (predicate) =>
+      Effect.suspend(() => {
+        if (state.durable && predicate(state)) return Effect.succeed(state);
+        const waiter = { predicate, deferred: Deferred.makeUnsafe<QueuedUpdateState>() };
+        waiters.add(waiter);
+        return Deferred.await(waiter.deferred).pipe(
+          Effect.onInterrupt(() => Effect.sync(() => waiters.delete(waiter))),
+        );
+      }),
+  };
+
+  return {
+    shape,
+    calls,
+    transition,
+    set,
+    rejectWith: (reason: QueuedUpdateRejectedError["reason"] | undefined) => {
+      reject = reason;
+    },
+    waiterCount: () => waiters.size,
+  };
+};
+
+/** In-memory preparation owner: `request` answers a scripted state and publishes it. */
+const makeFakePreparation = (initial: IdleUpdatePreparationState = { phase: "idle" }) => {
+  let state = initial;
+  let answer: IdleUpdatePreparationState = {
+    phase: "busy",
+    reason: "1 agent operation(s) in flight",
+  };
+  let requests = 0;
+  return {
+    shape: {
+      request: Effect.sync(() => {
+        requests += 1;
+        state = answer;
+        return state;
+      }),
+      state: Effect.sync(() => state),
+    },
+    requests: () => requests,
+    set: (next: IdleUpdatePreparationState) => {
+      state = next;
+    },
+    answerWith: (next: IdleUpdatePreparationState) => {
+      answer = next;
+    },
+  };
+};
+
+type Discovery = Effect.Effect<ManagedReleaseSelection | undefined, ManagedArtifactSourceError>;
+
+/** A feed whose next answer is scripted, counting evaluations and optionally holding each read. */
+const makeFakeFeed = (initial: string | undefined) => {
+  let version = initial;
+  let failure: ManagedArtifactSourceError | undefined;
+  let hold: Deferred.Deferred<void> | undefined;
+  let reads = 0;
+  const started = new Set<Deferred.Deferred<void>>();
+  const latest: Discovery = Effect.suspend(() => {
+    reads += 1;
+    for (const signal of started) Deferred.doneUnsafe(signal, Effect.void);
+    started.clear();
+    const gate = hold === undefined ? Effect.void : Deferred.await(hold);
+    return gate.pipe(
+      Effect.andThen(
+        Effect.suspend(() =>
+          failure !== undefined
+            ? Effect.fail(failure)
+            : Effect.succeed(version === undefined ? undefined : selectionFor(version)),
+        ),
+      ),
+    );
+  });
+  return {
+    latest,
+    reads: () => reads,
+    publish: (next: string | undefined) => {
+      version = next;
+      failure = undefined;
+    },
+    fail: (error: ManagedArtifactSourceError | undefined) => {
+      failure = error;
+    },
+    holdUntil: (gate: Deferred.Deferred<void> | undefined) => {
+      hold = gate;
+    },
+    /** Resolves when the next read begins. */
+    nextRead: Effect.suspend(() => {
+      const signal = Deferred.makeUnsafe<void>();
+      started.add(signal);
+      return Deferred.await(signal);
+    }),
+  };
+};
+
+interface Fixture {
+  readonly queue: ReturnType<typeof makeFakeQueue>;
+  readonly preparation: ReturnType<typeof makeFakePreparation>;
+  readonly feed: ReturnType<typeof makeFakeFeed>;
+  readonly scope: Scope.Closeable;
+  readonly close: Effect.Effect<void>;
+}
+
+/** Builds the scheduler in a manually owned scope so tests control its lifetime. */
+const start = Effect.fn("start")(function* (input?: {
+  readonly enabled?: boolean;
+  readonly feed?: string | undefined;
+  readonly queue?: Partial<QueuedUpdateState>;
+  readonly preparation?: IdleUpdatePreparationState;
+  readonly discoverLatest?: Discovery | undefined;
+}): Effect.fn.Return<Fixture, never, Scope.Scope> {
+  const queue = makeFakeQueue(input?.queue);
+  const preparation = makeFakePreparation(input?.preparation);
+  const feed = makeFakeFeed(input?.feed);
+  const scope = yield* Scope.make();
+  yield* Effect.addFinalizer(() => Scope.close(scope, Exit.void));
+  const deps: ManagedNightlyUpdateDependencies = {
+    enabled: input?.enabled ?? true,
+    installedVersion: INSTALLED,
+    discoveryInterval: DISCOVERY,
+    preparationRetryInterval: RETRY,
+    discoverLatest:
+      input !== undefined && "discoverLatest" in input ? input.discoverLatest : feed.latest,
+    queue: queue.shape,
+    preparation: preparation.shape,
+  };
+  yield* Scope.provide(make(deps), scope);
+  return { queue, preparation, feed, scope, close: Scope.close(scope, Exit.void) };
+});
+
+/** Lets every runnable fiber make progress without moving the clock. */
+const settle = Effect.gen(function* () {
+  for (let i = 0; i < 8; i += 1) yield* Effect.yieldNow;
+});
+
+const advance = (duration: Duration.Input) =>
+  TestClock.adjust(duration).pipe(Effect.andThen(settle));
+
+describe("managedNightlyUpdate", () => {
+  it.effect("disabled construction starts nothing and touches nothing", () =>
+    Effect.scoped(
+      Effect.gen(function* () {
+        const disabled = yield* start({ enabled: false, feed: NEWER });
+        const noFeed = yield* start({ discoverLatest: undefined, feed: NEWER });
+        yield* advance(Duration.times(DISCOVERY, 3));
+        for (const fixture of [disabled, noFeed]) {
+          assert.strictEqual(fixture.feed.reads(), 0);
+          assert.deepStrictEqual(fixture.queue.calls, []);
+          assert.strictEqual(fixture.queue.waiterCount(), 0);
+          assert.strictEqual(fixture.preparation.requests(), 0);
+        }
+      }),
+    ),
+  );
+
+  it.effect("queues the exact selected version at once and never prepares while downloading", () =>
+    Effect.scoped(
+      Effect.gen(function* () {
+        // Activity is notionally busy: preparation would answer busy, but it must not even be asked.
+        const fixture = yield* start({ feed: TARGET });
+        yield* settle;
+        assert.deepStrictEqual(fixture.queue.calls, [TARGET]);
+        assert.include(yield* fixture.queue.shape.getState, {
+          stage: "downloading",
+          targetVersion: TARGET,
+          durable: true,
+        });
+        assert.strictEqual(fixture.preparation.requests(), 0);
+
+        yield* advance(RETRY);
+        yield* advance(DISCOVERY);
+        assert.strictEqual(fixture.feed.reads(), 2);
+        assert.deepStrictEqual(fixture.queue.calls, [TARGET]);
+        assert.strictEqual(fixture.preparation.requests(), 0);
+      }),
+    ),
+  );
+
+  it.effect(
+    "requests preparation only for a durable queued target, retrying busy after the interval",
+    () =>
+      Effect.scoped(
+        Effect.gen(function* () {
+          const fixture = yield* start({ feed: TARGET });
+          yield* settle;
+
+          // Undurable `queued` is not acted on; only its barrier landing is.
+          fixture.queue.transition("queued", TARGET, false);
+          yield* settle;
+          assert.strictEqual(fixture.preparation.requests(), 0);
+          fixture.queue.set({ durable: true });
+          yield* settle;
+          assert.strictEqual(fixture.preparation.requests(), 1);
+          assert.deepStrictEqual(yield* fixture.preparation.shape.state, {
+            phase: "busy",
+            reason: "1 agent operation(s) in flight",
+          });
+
+          // Busy retries only once the retry interval has fully elapsed.
+          yield* advance(Duration.subtract(RETRY, Duration.seconds(1)));
+          assert.strictEqual(fixture.preparation.requests(), 1);
+          yield* advance(Duration.seconds(1));
+          assert.strictEqual(fixture.preparation.requests(), 2);
+
+          // Once the owner reports prepared, no further request is made.
+          fixture.preparation.answerWith({ phase: "prepared" });
+          yield* advance(RETRY);
+          assert.strictEqual(fixture.preparation.requests(), 3);
+          yield* advance(Duration.times(RETRY, 4));
+          assert.strictEqual(fixture.preparation.requests(), 3);
+
+          // Non-queued stages never request, however long they last.
+          fixture.preparation.set({ phase: "idle" });
+          for (const stage of ["current", "failed", "updating", "downloading"] as const) {
+            fixture.queue.transition(stage, stage === "current" ? INSTALLED : TARGET);
+            yield* advance(Duration.times(RETRY, 3));
+            assert.strictEqual(fixture.preparation.requests(), 3, stage);
+          }
+          assert.strictEqual(fixture.queue.calls.length, 1);
+        }),
+      ),
+  );
+
+  it.effect("never supersedes the target while preparation is preparing or prepared", () =>
+    Effect.scoped(
+      Effect.gen(function* () {
+        const fixture = yield* start({ feed: TARGET });
+        yield* settle;
+        // The owner is already running when staging finishes.
+        fixture.preparation.set({ phase: "preparing" });
+        fixture.queue.transition("queued", TARGET);
+        fixture.feed.publish(NEWER);
+
+        yield* advance(DISCOVERY);
+        assert.strictEqual(fixture.feed.reads(), 2);
+        assert.deepStrictEqual(fixture.queue.calls, [TARGET]);
+
+        fixture.preparation.set({ phase: "prepared" });
+        yield* advance(DISCOVERY);
+        assert.strictEqual(fixture.feed.reads(), 3);
+        assert.deepStrictEqual(fixture.queue.calls, [TARGET]);
+        // The preparation loop also leaves a prepared owner alone.
+        assert.strictEqual(fixture.preparation.requests(), 0);
+
+        // A stale or busy proof reopens supersession on the next discovery.
+        fixture.preparation.set({ phase: "busy", reason: "provider mutated since preparation" });
+        yield* advance(DISCOVERY);
+        assert.deepStrictEqual(fixture.queue.calls, [TARGET, NEWER]);
+        assert.include(yield* fixture.queue.shape.getState, {
+          stage: "downloading",
+          targetVersion: NEWER,
+        });
+      }),
+    ),
+  );
+
+  it.effect(
+    "a discovery result racing a queued-state preparation lands in one of two safe orders",
+    () =>
+      Effect.gen(function* () {
+        const run = Effect.fn("run")(function* (first: "discovery" | "preparation") {
+          const queue = makeFakeQueue({
+            stage: "queued",
+            targetVersion: TARGET,
+            staged: artifactFor(TARGET),
+          });
+          const preparation = makeFakePreparation();
+          preparation.answerWith({ phase: "preparing" });
+          const gate = yield* Semaphore.make(1);
+          const step: ManagedNightlyUpdateStep = {
+            installedVersion: INSTALLED,
+            discoverLatest: Effect.succeed(selectionFor(NEWER)),
+            queue: queue.shape,
+            preparation: preparation.shape,
+            gate,
+          };
+          // The test holds the permit: discovery has its network result, and
+          // the preparation loop has just seen durable `queued`; both now wait
+          // on the same permit in the order they arrived.
+          const held = yield* Deferred.make<void>();
+          const holder = yield* Effect.forkChild(gate.withPermits(1)(Deferred.await(held)));
+          yield* Effect.yieldNow;
+          const steps = {
+            discovery: () => Effect.forkChild(discoverAndQueue(step)),
+            preparation: () => Effect.forkChild(prepareIfQueued(step)),
+          };
+          const second = first === "discovery" ? "preparation" : "discovery";
+          const a = yield* steps[first]();
+          yield* Effect.yieldNow;
+          const b = yield* steps[second]();
+          yield* Effect.yieldNow;
+          yield* Deferred.succeed(held, undefined);
+          yield* Fiber.join(holder);
+          yield* Fiber.join(a);
+          yield* Fiber.join(b);
+          return {
+            queued: queue.calls,
+            requests: preparation.requests(),
+            state: yield* queue.shape.getState,
+            preparationState: yield* preparation.shape.state,
+          };
+        });
+
+        const discoveryFirst = yield* run("discovery");
+        assert.deepStrictEqual(discoveryFirst.queued, [NEWER]);
+        assert.strictEqual(discoveryFirst.requests, 0);
+        assert.include(discoveryFirst.state, { stage: "downloading", targetVersion: NEWER });
+        assert.deepStrictEqual(discoveryFirst.preparationState, { phase: "idle" });
+
+        const preparationFirst = yield* run("preparation");
+        assert.deepStrictEqual(preparationFirst.queued, []);
+        assert.strictEqual(preparationFirst.requests, 1);
+        assert.include(preparationFirst.state, { stage: "queued", targetVersion: TARGET });
+        assert.deepStrictEqual(preparationFirst.preparationState, { phase: "preparing" });
+      }),
+  );
+
+  it.effect("applies the exact version policy against installed and pending targets", () =>
+    Effect.scoped(
+      Effect.gen(function* () {
+        const fixture = yield* start({ feed: undefined });
+        yield* settle;
+        assert.strictEqual(fixture.feed.reads(), 1);
+
+        // Absent, equal, and older selections are no-ops against `current`.
+        for (const version of [undefined, INSTALLED, OLDER]) {
+          fixture.feed.publish(version);
+          yield* advance(DISCOVERY);
+          assert.deepStrictEqual(fixture.queue.calls, [], String(version));
+        }
+
+        // A strictly newer target is queued exactly as the feed named it.
+        fixture.feed.publish(TARGET);
+        yield* advance(DISCOVERY);
+        assert.deepStrictEqual(fixture.queue.calls, [TARGET]);
+
+        // An equal pending target that is downloading or queued is left to the queue.
+        for (const stage of ["downloading", "queued"] as const) {
+          fixture.queue.transition(stage, TARGET);
+          yield* advance(DISCOVERY);
+          assert.deepStrictEqual(fixture.queue.calls, [TARGET], stage);
+        }
+        // Older than the pending target: never a downgrade, even while it is failed.
+        fixture.queue.transition("failed", NEWER);
+        yield* advance(DISCOVERY);
+        assert.deepStrictEqual(fixture.queue.calls, [TARGET]);
+
+        // An equal failed target is restaged once per discovery tick.
+        fixture.queue.transition("failed", TARGET);
+        yield* advance(DISCOVERY);
+        assert.deepStrictEqual(fixture.queue.calls, [TARGET, TARGET]);
+        assert.include(yield* fixture.queue.shape.getState, { stage: "downloading" });
+        fixture.queue.transition("failed", TARGET);
+        fixture.preparation.set({ phase: "prepared" });
+        yield* advance(DISCOVERY);
+        assert.deepStrictEqual(fixture.queue.calls, [TARGET, TARGET]);
+        fixture.preparation.set({ phase: "idle" });
+
+        // A strictly newer target supersedes a downloading or queued one.
+        fixture.feed.publish(NEWER);
+        fixture.queue.transition("downloading", TARGET);
+        yield* advance(DISCOVERY);
+        assert.deepStrictEqual(fixture.queue.calls, [TARGET, TARGET, NEWER]);
+        fixture.feed.publish(NEWEST);
+        fixture.queue.transition("queued", NEWER);
+        yield* advance(DISCOVERY);
+        assert.deepStrictEqual(fixture.queue.calls, [TARGET, TARGET, NEWER, NEWEST]);
+
+        // Nothing is queued during an activation attempt or after a handoff.
+        fixture.queue.transition("updating", NEWEST);
+        fixture.feed.publish(NEWEST);
+        yield* advance(DISCOVERY);
+        fixture.queue.set({ handoffAccepted: true });
+        yield* advance(DISCOVERY);
+        fixture.queue.transition("queued", NEWEST);
+        fixture.queue.set({ handoffAccepted: true });
+        yield* advance(DISCOVERY);
+        assert.deepStrictEqual(fixture.queue.calls, [TARGET, TARGET, NEWER, NEWEST]);
+      }),
+    ),
+  );
+
+  it.effect("feed and queue failures leave preparation alone and do not end the loop", () =>
+    Effect.scoped(
+      Effect.gen(function* () {
+        const fixture = yield* start({ feed: TARGET });
+        fixture.feed.fail(
+          new ManagedArtifactSourceError({
+            reason: "listing releases page 1: GitHub returned HTTP 403 (rate limited or forbidden)",
+            cause: new Error(`request to ${SIGNED_URL} failed`),
+          }),
+        );
+        yield* settle;
+        assert.strictEqual(fixture.feed.reads(), 1);
+        assert.deepStrictEqual(fixture.queue.calls, []);
+        assert.strictEqual(fixture.preparation.requests(), 0);
+
+        // The next tick succeeds and queues normally.
+        fixture.feed.publish(TARGET);
+        yield* advance(DISCOVERY);
+        assert.deepStrictEqual(fixture.queue.calls, [TARGET]);
+
+        // A rejected queue command is logged; the loop keeps its cadence and
+        // the queue keeps whatever it held.
+        fixture.queue.transition("failed", TARGET);
+        fixture.queue.rejectWith("activation-in-progress");
+        yield* advance(DISCOVERY);
+        assert.deepStrictEqual(fixture.queue.calls, [TARGET, TARGET]);
+        assert.include(yield* fixture.queue.shape.getState, {
+          stage: "failed",
+          targetVersion: TARGET,
+        });
+        assert.strictEqual(fixture.preparation.requests(), 0);
+        fixture.queue.rejectWith(undefined);
+        yield* advance(DISCOVERY);
+        assert.deepStrictEqual(fixture.queue.calls, [TARGET, TARGET, TARGET]);
+        assert.include(yield* fixture.queue.shape.getState, { stage: "downloading" });
+      }),
+    ),
+  );
+
+  it.effect("scheduler warnings carry the feed's reason, never its cause", () => {
+    const logged: Array<string> = [];
+    // Scheduler logs pass their fields as a second message part, so the whole
+    // message is the surface an operator would see.
+    const logger = Logger.make<unknown, void>((options) => {
+      const parts = Array.isArray(options.message) ? options.message : [options.message];
+      logged.push(
+        parts.map((value) => (typeof value === "string" ? value : JSON.stringify(value))).join(" "),
+      );
+    });
+    return Effect.gen(function* () {
+      const queue = makeFakeQueue();
+      const preparation = makeFakePreparation();
+      const step: ManagedNightlyUpdateStep = {
+        installedVersion: INSTALLED,
+        discoverLatest: Effect.fail(
+          new ManagedArtifactSourceError({
+            reason: "downloading the manifest: request failed",
+            cause: new Error(`GET ${SIGNED_URL}`),
+          }),
+        ),
+        queue: queue.shape,
+        preparation: preparation.shape,
+        gate: yield* Semaphore.make(1),
+      };
+      yield* discoverAndQueue(step);
+      assert.strictEqual(logged.length, 1);
+      assert.include(logged[0], "downloading the manifest: request failed");
+      assert.notInclude(logged[0], "X-Amz-Signature");
+      assert.deepStrictEqual(queue.calls, []);
+      assert.strictEqual(preparation.requests(), 0);
+    }).pipe(Effect.provide(Logger.layer([logger], { mergeWithExisting: false })));
+  });
+
+  it.effect("closing the scheduler scope ends both fibers wherever they are waiting", () =>
+    Effect.scoped(
+      Effect.gen(function* () {
+        // In-flight discovery: the feed read is held open when the scope closes.
+        const inFlight = yield* start({ feed: TARGET });
+        yield* settle;
+        const gate = yield* Deferred.make<void>();
+        inFlight.feed.holdUntil(gate);
+        yield* advance(DISCOVERY);
+        assert.strictEqual(inFlight.feed.reads(), 2);
+        yield* inFlight.close;
