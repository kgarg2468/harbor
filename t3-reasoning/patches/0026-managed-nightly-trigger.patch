+        yield* advance(DISCOVERY);
+        assert.strictEqual(fixture.feed.reads(), 3);
+        yield* advance(Duration.times(DISCOVERY, 2));
+        assert.strictEqual(fixture.feed.reads(), 3);
+        fixture.feed.holdUntil(undefined);
+        yield* Deferred.succeed(slow, undefined);
+        yield* settle;
+        assert.strictEqual(fixture.feed.reads(), 3);
+        yield* advance(DISCOVERY);
+        assert.strictEqual(fixture.feed.reads(), 4);
+        assert.deepStrictEqual(fixture.queue.calls, []);
+      }),
+    ),
+  );
+});
