+/**
+ * ManagedNightlyUpdate - the server-scoped trigger that moves a managed
+ * server onto the next nightly release without any client involvement.
+ *
+ * Two independent loops, both owned by the server scope:
+ *
+ * - **Discovery** asks the fixed release feed for its latest managed version
+ *   immediately and then on a spaced interval, and durably queues a strictly
+ *   newer exact version. Download, verification and candidate checks then run
+ *   inside the queue while agents may still be working.
+ * - **Preparation** waits for the queue to hold a durable `queued` target and
+ *   only then asks the idle preparation owner to retire idle provider
+ *   resources; a busy answer is retried on a bounded interval. The queue's own
+ *   activation retry consumes the resulting proof and hands off.
+ *
+ * The feed read runs outside the scheduler's one permit; every state recheck
+ * together with the queue or preparation call runs under it, so discovery can
+ * never start a long download for a newer target after preparation has begun
+ * retiring resources for the current one, and preparation can never retire
+ * for a target that discovery has just superseded. The scheduler persists
+ * nothing: `QueuedUpdate.queue` is the durable record, and the queue's boot
+ * reconciliation resumes a nonterminal target on restart.
+ *
+ * @module ManagedNightlyUpdate
+ */
+import type * as Duration from "effect/Duration";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Semaphore from "effect/Semaphore";
+
+import {
+  IdleUpdatePreparation,
+  type IdleUpdatePreparationShape,
+  type IdleUpdatePreparationState,
+} from "./idleUpdatePreparation.ts";
+import { parseManagedReleaseVersion } from "./managedRelease.ts";
+import type { ManagedReleaseSelection } from "./managedReleaseSource.ts";
+import type { ManagedArtifactSourceError } from "./managedRuntime.ts";
+import { QueuedUpdate, type QueuedUpdateShape, type QueuedUpdateState } from "./queuedUpdate.ts";
+import { ServiceLauncherClient } from "./serviceLauncherClient.ts";
+import { compareExactServiceVersions } from "./serviceProtocol.ts";
+
+export interface ManagedNightlyUpdateDependencies {
+  /** False keeps the composed queue dormant: no fiber, timer, feed, queue, or preparation call. */
+  readonly enabled: boolean;
+  readonly installedVersion: string;
+  readonly discoveryInterval: Duration.Input;
+  readonly preparationRetryInterval: Duration.Input;
+  /** The constructed feed's `latest`; undefined on a host without a managed server target. */
+  readonly discoverLatest:
+    | Effect.Effect<ManagedReleaseSelection | undefined, ManagedArtifactSourceError>
+    | undefined;
+  readonly queue: Pick<QueuedUpdateShape, "queue" | "getState" | "awaitState">;
+  readonly preparation: Pick<IdleUpdatePreparationShape, "request" | "state">;
+}
+
+/**
+ * What one scheduler step needs: the enabled dependencies plus the permit
+ * both steps share. Exported so tests can drive one step at a time with the
+ * exact code the loops run.
+ */
+export interface ManagedNightlyUpdateStep {
+  readonly installedVersion: string;
+  readonly discoverLatest: Effect.Effect<
+    ManagedReleaseSelection | undefined,
+    ManagedArtifactSourceError
+  >;
+  readonly queue: ManagedNightlyUpdateDependencies["queue"];
+  readonly preparation: ManagedNightlyUpdateDependencies["preparation"];
+  /** One permit around every state recheck and the queue/preparation call; network reads stay outside it. */
+  readonly gate: Semaphore.Semaphore;
+}
+
+const isDurablyQueued = (state: QueuedUpdateState): boolean =>
+  state.durable && state.stage === "queued";
+
+/**
+ * Whether the selected exact version should be handed to `queue.queue` given
+ * the current queue and preparation state. Pure so the policy reads in one
+ * place; the caller has already taken the permit.
+ */
+const shouldQueue = (
+  selectedVersion: string,
+  installedVersion: string,
+  state: QueuedUpdateState,
+  preparationPhase: IdleUpdatePreparationState["phase"],
+): boolean => {
+  // A retirement in progress, or a valid proof waiting for the queue's next
+  // activation attempt, must not be undercut by a fresh long download.
+  if (preparationPhase === "preparing" || preparationPhase === "prepared") return false;
+  // Committed to restart, or an activation attempt whose answer is unknown.
+  if (state.handoffAccepted || state.stage === "updating") return false;
+  if (compareExactServiceVersions(selectedVersion, installedVersion) <= 0) return false;
+  if (state.stage === "current") return true;
+  const order = compareExactServiceVersions(selectedVersion, state.targetVersion);
+  // Never downgrade a pending target.
+  if (order < 0) return false;
+  // The queue already owns an equal target unless that target failed, in
+  // which case the same-target command is the queue's intentional restage.
+  if (order === 0) return state.stage === "failed";
+  return true;
+};
+
+/**
+ * One discovery step: read the feed outside the permit, then decide and queue
+ * under it. Feed and queue failures are logged and end the step; nothing
+ * cancels, edits, or prepares on their behalf. Error text is the feed's own
+ * reason, never a cause that may carry a signed redirect URL.
+ */
+export const discoverAndQueue = (step: ManagedNightlyUpdateStep): Effect.Effect<void> =>
+  step.discoverLatest.pipe(
+    Effect.flatMap((selection) => {
+      if (selection === undefined) return Effect.void;
+      const version = selection.version;
+      return step.gate.withPermits(1)(
+        Effect.gen(function* () {
+          const state = yield* step.queue.getState;
+          const preparation = yield* step.preparation.state;
+          if (!shouldQueue(version, step.installedVersion, state, preparation.phase)) return;
+          yield* step.queue.queue(version).pipe(
+            Effect.tap((queued) =>
+              Effect.logInfo("Managed nightly update queued.", {
+                targetVersion: queued.targetVersion,
+                stage: queued.stage,
+              }),
+            ),
+            Effect.catch((error) =>
+              Effect.logWarning("Managed nightly update could not be queued.", {
+                targetVersion: version,
+                reason: error.message,
+              }),
+            ),
+          );
+        }),
+      );
+    }),
+    Effect.catch((error) =>
+      Effect.logWarning("Managed nightly release discovery failed.", { reason: error.reason }),
+    ),
+  );
+
+/**
+ * One preparation step: under the permit, require a durable `queued` target
+ * and no owner or proof already in place, then ask for idle preparation once.
+ * The owner itself rechecks activity and admission; a busy answer is left for
+ * the next retry and never awaited here.
+ */
+export const prepareIfQueued = (step: ManagedNightlyUpdateStep): Effect.Effect<void> =>
+  step.gate.withPermits(1)(
+    Effect.gen(function* () {
+      const state = yield* step.queue.getState;
+      if (!isDurablyQueued(state) || state.handoffAccepted) return;
+      const preparation = yield* step.preparation.state;
+      if (preparation.phase === "preparing" || preparation.phase === "prepared") return;
+      const requested = yield* step.preparation.request;
+      yield* Effect.logDebug("Managed nightly update requested idle preparation.", {
+        targetVersion: state.targetVersion,
+        phase: requested.phase,
+      });
+    }),
+  );
+
+/**
+ * Starts at most one discovery fiber and one preparation fiber in the
+ * caller's scope and returns at once. Disabled construction does nothing.
+ */
+export const make = Effect.fn("cloud.managed_nightly_update.make")(function* (
+  deps: ManagedNightlyUpdateDependencies,
+) {
+  const { discoverLatest } = deps;
+  if (!deps.enabled || discoverLatest === undefined) return;
+  const step: ManagedNightlyUpdateStep = {
+    installedVersion: deps.installedVersion,
+    discoverLatest,
+    queue: deps.queue,
+    preparation: deps.preparation,
+    gate: yield* Semaphore.make(1),
+  };
+
+  // Immediate check, then one check per interval measured from the end of
+  // the previous one, so a slow feed read can never overlap the next.
+  const discovery = Effect.forever(
+    discoverAndQueue(step).pipe(Effect.andThen(Effect.sleep(deps.discoveryInterval))),
+  );
+  // Waiting on the queue happens outside the permit; the sleep after each
+  // step bounds retries while the target stays queued.
+  const preparation = Effect.forever(
+    deps.queue
+      .awaitState(isDurablyQueued)
+      .pipe(
+        Effect.andThen(prepareIfQueued(step)),
+        Effect.andThen(Effect.sleep(deps.preparationRetryInterval)),
+      ),
+  );
+
+  yield* Effect.forkScoped(discovery);
+  yield* Effect.forkScoped(preparation);
+  yield* Effect.logInfo("Managed nightly update scheduler started.", {
+    installedVersion: deps.installedVersion,
+  });
+});
+
+export interface ManagedNightlyUpdateLayerOptions {
+  readonly installedVersion: string;
+  readonly discoveryInterval: Duration.Input;
+  readonly preparationRetryInterval: Duration.Input;
+  readonly discoverLatest: ManagedNightlyUpdateDependencies["discoverLatest"];
+}
+
+/**
+ * Production wiring over the queue, preparation owner, and launcher client the
+ * managed update runtime already shares. Enabled only for a launcher-managed
+ * process running a managed release version on a host with a real feed, so a
+ * stock or development server is never moved onto the managed channel.
+ */
+export const layer = (options: ManagedNightlyUpdateLayerOptions) =>
+  Layer.effectDiscard(
+    Effect.gen(function* () {
+      const launcher = yield* ServiceLauncherClient;
+      const queue = yield* QueuedUpdate;
+      const preparation = yield* IdleUpdatePreparation;
+      const managedVersion = parseManagedReleaseVersion(options.installedVersion) !== undefined;
+      const enabled = launcher.managed && managedVersion && options.discoverLatest !== undefined;
+      if (!enabled) {
+        yield* Effect.logDebug("Managed nightly update scheduler is disabled.", {
+          launcherManaged: launcher.managed,
+          managedVersion,
+          supportedHost: options.discoverLatest !== undefined,
+        });
+      }
+      yield* make({ ...options, enabled, queue, preparation });
+    }),
+  );
