+import { assert, describe, it } from "@effect/vitest";
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import { HostProcessEnvironment } from "@t3tools/shared/hostProcess";
+import * as Deferred from "effect/Deferred";
+import * as Duration from "effect/Duration";
+import * as Effect from "effect/Effect";
+import * as Exit from "effect/Exit";
+import * as Fiber from "effect/Fiber";
+import * as FileSystem from "effect/FileSystem";
+import * as Path from "effect/Path";
+import * as Schema from "effect/Schema";
+import * as Scope from "effect/Scope";
+import { TestClock } from "effect/testing";
+
+import * as UpdateActivity from "../updateActivity.ts";
+import * as UpdateAdmission from "../updateAdmission.ts";
+import * as IdleUpdateCoordinator from "./idleUpdateCoordinator.ts";
+import { make, type ResolvedManagedRuntime } from "./managedQueuedUpdate.ts";
+import {
+  ManagedArtifactSourceError,
+  ManagedRuntimeStageError,
+  type ManagedRuntimeStager,
+} from "./managedRuntime.ts";
+import type { QueuedUpdateShape, StagedArtifact } from "./queuedUpdate.ts";
+import * as ServiceLauncherClient from "./serviceLauncherClient.ts";
+import {
+  SERVICE_LAUNCHER_CONTEXT_ENV,
+  SERVICE_LAUNCHER_PROTOCOL,
+  type ServiceLauncherChildMessage,
+  type ServiceLauncherParentMessage,
+} from "./serviceProtocol.ts";
+
+const INSTALLED = "0.0.38-nightly.20260905.3.managed.1.p6d1933416d7a";
+const TARGET = "0.0.38-nightly.20260905.3.managed.2.p6d1933416d7a";
+const NEWER = "0.0.38-nightly.20260905.3.managed.3.p6d1933416d7a";
+const DB_PATH = "/srv/t3/state.sqlite";
+const POLL = Duration.minutes(5);
+const ADMISSION_BUSY = "busy: client commands or another maintenance own update admission";
+
+const artifactFor = (version: string, cut = 1): string =>
+  `managed-server-darwin-arm64:${version}#${cut}`;
+
+const UnknownJson = Schema.fromJsonString(Schema.Unknown);
+const decodeJson = Schema.decodeUnknownEffect(UnknownJson);
+
+type SendMode = "ok" | "throw" | "callback-error" | "silent";
+
+/** In-process stand-in for the launcher's IPC channel, recording every send into the shared log. */
+class FakeLauncherProcess {
+  readonly connected = true;
+  readonly env: Record<string, string | undefined>;
+  readonly sent: ServiceLauncherChildMessage[] = [];
+  sendMode: SendMode = "silent";
+  readonly #listeners = new Map<string, Set<(...args: ReadonlyArray<unknown>) => void>>();
+  readonly #sendWaiters = new Set<{
+    readonly count: number;
+    readonly deferred: Deferred.Deferred<void>;
+  }>();
+  readonly #log: string[];
+
+  constructor(log: string[]) {
+    this.#log = log;
+    this.env = {
+      [SERVICE_LAUNCHER_CONTEXT_ENV]: JSON.stringify({
+        protocol: SERVICE_LAUNCHER_PROTOCOL,
+        childVersion: INSTALLED,
+      }),
+    };
+  }
+
+  send = (message: ServiceLauncherChildMessage, callback?: (error: Error | null) => void) => {
+    this.sent.push(message);
+    this.#log.push(
+      message.type === "request-update" ? `send:${message.targetVersion}` : "send:other",
+    );
+    for (const waiter of this.#sendWaiters) {
+      if (this.sent.length >= waiter.count) {
+        this.#sendWaiters.delete(waiter);
+        Deferred.doneUnsafe(waiter.deferred, Effect.void);
+      }
+    }
+    switch (this.sendMode) {
+      case "throw":
+        throw new Error("channel closed");
+      case "callback-error":
+        callback?.(new Error("EPIPE"));
+        return false;
+      case "silent":
+        return true;
+      case "ok":
+        callback?.(null);
+        return true;
+    }
+  };
+
+  /** Resolves once at least `count` messages have been sent. */
+  awaitSend(count = 1): Effect.Effect<void> {
+    return Effect.suspend(() => {
+      if (this.sent.length >= count) return Effect.void;
+      const deferred = Deferred.makeUnsafe<void>();
+      this.#sendWaiters.add({ count, deferred });
+      return Deferred.await(deferred);
+    });
+  }
+
+  on = (event: "message" | "disconnect", listener: (...args: ReadonlyArray<unknown>) => void) => {
+    const listeners = this.#listeners.get(event) ?? new Set();
+    listeners.add(listener);
+    this.#listeners.set(event, listeners);
+  };
+
+  off = (event: "message" | "disconnect", listener: (...args: ReadonlyArray<unknown>) => void) => {
+    this.#listeners.get(event)?.delete(listener);
+  };
+
+  emit(message: ServiceLauncherParentMessage) {
+    for (const listener of this.#listeners.get("message") ?? []) listener(message);
+  }
+
+  disconnect() {
+    for (const listener of this.#listeners.get("disconnect") ?? []) listener();
+  }
+}
+
+interface FakeRuntimeOptions {
+  /** What `stage` reports, when it should disagree with the selection. */
+  readonly stageResult?: StagedArtifact;
+  readonly verifyFails?: boolean;
+}
+
+/** One release selection with a stager bound to it; every call lands in the shared log. */
+const makeRuntime = (
+  log: string[],
+  version: string,
+  artifactId: string,
+  options: FakeRuntimeOptions = {},
+): ResolvedManagedRuntime => {
+  const stager: ManagedRuntimeStager = {
+    stage: (targetVersion) =>
+      Effect.sync(() => {
+        log.push(`stage:${targetVersion}@${artifactId}`);
+        return options.stageResult ?? { version, artifactId };
+      }),
+    verifyStaged: (staged) =>
+      Effect.suspend(() => {
+        log.push(`verify:${staged.version}@${staged.artifactId}`);
+        return options.verifyFails
+          ? Effect.fail(
+              new ManagedRuntimeStageError({
+                step: "verifying the staged runtime",
+                reason: "the staged runtime holds a different artifact",
+              }),
+            )
+          : Effect.succeed({ versionDir: "", entryPath: "", sentinelPath: "" });
+      }),
+  };
+  return { version, artifactId, stager };
+};
+
+/**
+ * The real coordinator on the real gates. The queue's handoff notification is
+ * observed on its way through so the tests can prove it ran exactly once; the
+ * coordinator's algorithm is untouched.
+ */
+const observeCoordinator = (
+  admission: UpdateAdmission.UpdateAdmissionShape,
+  activity: UpdateActivity.UpdateActivityShape,
+) => {
+  const real = IdleUpdateCoordinator.make({ admission, activity });
+  let acceptedRuns = 0;
+  const tryActivate: IdleUpdateCoordinator.IdleUpdateCoordinatorShape["tryActivate"] = (
+    handoff,
+    onHandoffAccepted,
+  ) =>
+    real.tryActivate(
+      handoff,
+      Effect.andThen(
+        Effect.sync(() => {
+          acceptedRuns += 1;
+        }),
+        onHandoffAccepted,
+      ),
+    );
+  const phase = Effect.map(real.state, (state) => state.phase);
+  return { tryActivate, phase, acceptedRuns: () => acceptedRuns };
+};
+
+const setup = Effect.fn("setup")(function* (options?: {
+  readonly statePath?: string;
+  /**
+   * Owns the coordinator, the launcher client and the controller. The gates
+   * are built in the enclosing scope: a server layer closes the queue before
+   * the admission and activity services it depends on, so this is the order
+   * a real shutdown observes.
+   */
+  readonly scope?: Scope.Scope;
+}) {
+  const fs = yield* FileSystem.FileSystem;
+  const path = yield* Path.Path;
+  const statePath =
+    options?.statePath ??
+    path.join(
+      yield* fs.makeTempDirectoryScoped({ prefix: "t3-managed-queued-update-test-" }),
+      "runtime",
+      "queued-update.json",
+    );
+  const log: string[] = [];
+  const runtimes = new Map<string, ResolvedManagedRuntime>([
+    [TARGET, makeRuntime(log, TARGET, artifactFor(TARGET))],
+    [NEWER, makeRuntime(log, NEWER, artifactFor(NEWER))],
+  ]);
+  const host = new FakeLauncherProcess(log);
+  const admission = yield* UpdateAdmission.make();
+  const activity = yield* UpdateActivity.make();
+
+  const process = Effect.gen(function* () {
+    const coordinator = observeCoordinator(admission, activity);
+    const launcher = yield* ServiceLauncherClient.make({ currentVersion: INSTALLED }).pipe(
+      Effect.provideService(ServiceLauncherClient.ServiceLauncherHostProcess, host),
+      Effect.provideService(HostProcessEnvironment, host.env),
+    );
+    const controller = yield* make({
+      statePath,
+      installedVersion: INSTALLED,
+      pollInterval: POLL,
+      dbPath: DB_PATH,
+      resolve: (exactVersion) =>
+        Effect.suspend(() => {
+          log.push(`resolve:${exactVersion}`);
+          const runtime = runtimes.get(exactVersion);
+          return runtime === undefined
+            ? Effect.fail(new ManagedArtifactSourceError({ reason: `no release ${exactVersion}` }))
+            : Effect.succeed(runtime);
+        }),
+      coordinator,
+      launcher,
+    });
+    return { coordinator, controller };
+  });
+  const started = yield* options?.scope ? Scope.provide(process, options.scope) : process;
+
+  const readState = fs.readFileString(statePath).pipe(Effect.flatMap(decodeJson));
+  return { ...started, admission, activity, log, runtimes, host, statePath, readState };
+});
+
+type Harness = Effect.Success<ReturnType<typeof setup>>;
+
+const awaitStage = (controller: QueuedUpdateShape, stage: string) =>
+  controller.awaitState((state) => state.stage === stage && state.reason !== undefined);
+
+const provide = <A, E>(
+  effect: Effect.Effect<A, E, FileSystem.FileSystem | Path.Path | Scope.Scope>,
+) => effect.pipe(Effect.scoped, Effect.provide(NodeServices.layer));
+
+const rejectedReason = (error: { readonly _tag: string; readonly reason?: unknown }) =>
+  error._tag === "QueuedUpdateRejectedError"
+    ? error.reason
+    : assert.fail(`unexpected ${error._tag}`);
+
+/** Both gates open, nothing outstanding, no shutdown authorized, and both usable. */
+const gatesOpen = Effect.fn("gatesOpen")(function* (harness: Harness) {
+  const { admission, activity } = harness;
+  assert.deepStrictEqual(yield* admission.state, { phase: "open", inFlight: 0 });
+  assert.include(yield* activity.state, {
+    phase: "open",
+    outstanding: 0,
+    idleShutdownAuthorized: false,
+  });
+  yield* admission.withAdmission(Effect.void);
+  (yield* activity.acquire("probe")).release();
+});
+
+/**
+ * Both gates latched for the rest of the process: client commands rejected,
+ * activity sealed with idle shutdown authorized, and the admission permit
+ * unstealable by any later maintenance claim.
+ */
+const gatesLatched = Effect.fn("gatesLatched")(function* (harness: Harness) {
+  const { admission, activity } = harness;
+  assert.deepStrictEqual(yield* admission.state, { phase: "maintenance", inFlight: 0 });
+  assert.include(yield* activity.state, { phase: "sealed", idleShutdownAuthorized: true });
+  assert.equal(
+    (yield* admission.withAdmission(Effect.void).pipe(Effect.flip))._tag,
+    "UpdateAdmissionClosedError",
+  );
+  assert.equal((yield* activity.acquire("late agent").pipe(Effect.flip)).reason, "sealed");
+  assert.deepStrictEqual(yield* admission.tryWithMaintenance(Effect.void), { status: "busy" });
+  assert.deepStrictEqual(yield* admission.tryWithHandoffMaintenance(() => Effect.void), {
+    status: "busy",
+  });
+});
+
+/** Every queue command is refused while the attempt owns `updating`. */
+const commandsRefused = Effect.fn("commandsRefused")(function* (
+  harness: Harness,
+  reason: "activation-in-progress" | "handoff-accepted",
+) {
+  const { controller } = harness;
+  assert.equal(rejectedReason(yield* controller.cancel.pipe(Effect.flip)), reason);
+  assert.equal(rejectedReason(yield* controller.retry.pipe(Effect.flip)), reason);
+  assert.equal(rejectedReason(yield* controller.queue(NEWER).pipe(Effect.flip)), reason);
+});
+
+const updatingOnDisk = Effect.fn("updatingOnDisk")(function* (harness: Harness, cut = 1) {
+  assert.deepStrictEqual(yield* harness.readState, {
+    version: 1,
+    stage: "updating",
+    targetVersion: TARGET,
+    staged: { version: TARGET, artifactId: artifactFor(TARGET, cut) },
+  });
+});
+
+/** Queue the target on an idle server and wait until the launcher request is on the wire. */
+const queueUntilDispatched = Effect.fn("queueUntilDispatched")(function* (harness: Harness) {
+  yield* harness.controller.queue(TARGET);
+  yield* harness.host.awaitSend();
+  assert.deepStrictEqual(harness.log, [
+    `resolve:${TARGET}`,
+    `stage:${TARGET}@${artifactFor(TARGET)}`,
+    `verify:${TARGET}@${artifactFor(TARGET)}`,
+    `send:${TARGET}`,
+  ]);
+  assert.deepStrictEqual(harness.host.sent, [
+    { type: "request-update", targetVersion: TARGET, dbPath: DB_PATH },
+  ]);
+  assert.equal(yield* harness.coordinator.phase, "attempting");
+  assert.equal((yield* harness.controller.getState).stage, "updating");
+});
+
+describe("managedQueuedUpdate", () => {
+  it.effect(
+    "stages the exact selection, rechecks it under the seal, and holds the gates once accepted",
+    () =>
+      provide(
+        Effect.gen(function* () {
+          const scope = yield* Scope.make();
+          const harness = yield* setup({ scope });
+          const { controller, coordinator, host } = harness;
+          yield* queueUntilDispatched(harness);
+          yield* gatesLatched(harness);
+
+          host.emit({ type: "update-accepted", updateId: "launcher-id" });
+          const handedOff = yield* controller.awaitState((state) => state.handoffAccepted);
+          assert.equal(handedOff.stage, "updating");
+          assert.equal(yield* coordinator.phase, "accepted");
+          assert.equal(coordinator.acceptedRuns(), 1);
+          yield* gatesLatched(harness);
+          yield* commandsRefused(harness, "handoff-accepted");
+
+          // The owning scope closing (process exit) interrupts the parked attempt
+          // but cannot revoke the acceptance, reopen a gate, or notify the queue
+          // a second time.
+          yield* Scope.close(scope, Exit.void);
+          assert.equal(yield* coordinator.phase, "accepted");
+          assert.equal(coordinator.acceptedRuns(), 1);
+          yield* gatesLatched(harness);
+          yield* commandsRefused(harness, "handoff-accepted");
+          yield* updatingOnDisk(harness);
+          assert.equal(host.sent.length, 1);
+        }),
+      ),
+  );
+
+  it.effect("a selection the stager does not reproduce fails before any recheck or IPC", () =>
+    provide(
+      Effect.gen(function* () {
+        const harness = yield* setup();
+        const { controller, log, runtimes, host, coordinator } = harness;
+        runtimes.set(
+          TARGET,
+          makeRuntime(log, TARGET, artifactFor(TARGET), {
+            stageResult: { version: TARGET, artifactId: artifactFor(TARGET, 2) },
+          }),
+        );
+        yield* controller.queue(TARGET);
+        const failedArtifact = yield* awaitStage(controller, "failed");
+        assert.include(failedArtifact.reason, "does not match its resolved release selection");
+
+        // A feed that answers with another version is equally not this target.
+        runtimes.set(TARGET, makeRuntime(log, NEWER, artifactFor(NEWER)));
+        yield* controller.retry;
+        const failedVersion = yield* awaitStage(controller, "failed");
+        assert.include(failedVersion.reason, `resolved t3@${TARGET} to t3@${NEWER}`);
+
+        runtimes.delete(TARGET);
+        yield* controller.retry;
+        const unresolved = yield* awaitStage(controller, "failed");
+        assert.include(unresolved.reason, `no release ${TARGET}`);
+
+        assert.deepStrictEqual(log, [
+          `resolve:${TARGET}`,
+          `stage:${TARGET}@${artifactFor(TARGET)}`,
+          `resolve:${TARGET}`,
+          `resolve:${TARGET}`,
+        ]);
+        assert.deepStrictEqual(host.sent, []);
+        assert.equal(yield* coordinator.phase, "ready");
+        yield* gatesOpen(harness);
+      }),
+    ),
+  );
+
+  it.effect("a superseding target activates only through its own selection's stager", () =>
+    provide(
+      Effect.gen(function* () {
+        const { controller, log, host, activity } = yield* setup();
+        const lease = yield* activity.acquire("agent turn");
+        yield* controller.queue(TARGET);
+        yield* awaitStage(controller, "queued");
+        yield* controller.queue(NEWER);
+        const waiting = yield* controller.awaitState(
+          (state) =>
+            state.stage === "queued" && state.targetVersion === NEWER && state.reason !== undefined,
+        );
+        assert.deepStrictEqual(waiting.staged, { version: NEWER, artifactId: artifactFor(NEWER) });
+        assert.deepStrictEqual(host.sent, []);
+
+        lease.release();
+        yield* TestClock.adjust(POLL);
+        yield* host.awaitSend();
+        assert.deepStrictEqual(log, [
+          `resolve:${TARGET}`,
+          `stage:${TARGET}@${artifactFor(TARGET)}`,
+          `resolve:${NEWER}`,
+          `stage:${NEWER}@${artifactFor(NEWER)}`,
+          `verify:${NEWER}@${artifactFor(NEWER)}`,
+          `send:${NEWER}`,
+        ]);
+        assert.deepStrictEqual(host.sent, [
+          { type: "request-update", targetVersion: NEWER, dbPath: DB_PATH },
+        ]);
+      }),
+    ),
+  );
+
+  it.effect("a restart re-resolves and re-stages the exact target before any activation", () =>
+    provide(
+      Effect.gen(function* () {
+        const first = yield* Scope.make();
+        const before = yield* setup({ scope: first });
+        const lease = yield* before.activity.acquire("agent turn");
+        yield* before.controller.queue(TARGET);
+        yield* awaitStage(before.controller, "queued");
+        lease.release();
+        yield* Scope.close(first, Exit.void);
+        assert.deepStrictEqual(yield* before.readState, {
+          version: 1,
+          stage: "queued",
+          targetVersion: TARGET,
+          staged: { version: TARGET, artifactId: artifactFor(TARGET) },
+          reason: "busy: 1 agent operation(s) in flight",
+        });
+        assert.deepStrictEqual(before.host.sent, []);
+
+        // The next process re-cuts the same version: the persisted artifact is
+        // discarded, the feed is asked again, and only the new artifact is
+        // rechecked and dispatched.
+        const after = yield* setup({ statePath: before.statePath });
+        after.runtimes.set(TARGET, makeRuntime(after.log, TARGET, artifactFor(TARGET, 2)));
+        const booted = yield* after.controller.getState;
+        assert.deepStrictEqual([booted.stage, booted.staged], ["downloading", undefined]);
+        yield* after.host.awaitSend();
+        assert.deepStrictEqual(after.log, [
+          `resolve:${TARGET}`,
+          `stage:${TARGET}@${artifactFor(TARGET, 2)}`,
+          `verify:${TARGET}@${artifactFor(TARGET, 2)}`,
+          `send:${TARGET}`,
+        ]);
+        yield* updatingOnDisk(after, 2);
+        assert.deepStrictEqual(
+          before.log.filter((entry) => entry.startsWith("verify")),
+          [],
+        );
+      }),
+    ),
+  );
+
+  it.effect("a busy server is answered promptly with both gates untouched", () =>
+    provide(
+      Effect.gen(function* () {
+        const harness = yield* setup();
+        const { controller, log, host, admission, activity, coordinator } = harness;
+        const lease = yield* activity.acquire("agent turn");
+        yield* controller.queue(TARGET);
+        const busy = yield* awaitStage(controller, "queued");
+        assert.equal(busy.reason, "busy: 1 agent operation(s) in flight");
+        assert.deepStrictEqual(log, [
+          `resolve:${TARGET}`,
+          `stage:${TARGET}@${artifactFor(TARGET)}`,
+        ]);
+        assert.deepStrictEqual(host.sent, []);
+        assert.equal(yield* coordinator.phase, "ready");
+        assert.deepStrictEqual(yield* admission.state, { phase: "open", inFlight: 0 });
+        assert.include(yield* activity.state, { phase: "open", idleShutdownAuthorized: false });
+        // The approval that finishes the turn is still admitted.
+        yield* admission.withAdmission(Effect.sync(() => lease.release()));
+        yield* gatesOpen(harness);
+
+        // An in-flight client command is busy too, with the seal never taken.
+        const command = yield* Deferred.make<void>();
+        const admitted = yield* Effect.forkChild(admission.withAdmission(Deferred.await(command)), {
+          startImmediately: true,
+        });
+        yield* TestClock.adjust(POLL);
+        const stillBusy = yield* controller.awaitState(
+          (state) => state.stage === "queued" && state.reason === ADMISSION_BUSY,
+        );
+        assert.equal(stillBusy.stage, "queued");
+        assert.include(yield* activity.state, { phase: "open", idleShutdownAuthorized: false });
+        assert.deepStrictEqual(host.sent, []);
+        yield* Deferred.succeed(command, undefined);
+        yield* Fiber.join(admitted);
+
+        yield* TestClock.adjust(POLL);
+        yield* host.awaitSend();
+        assert.deepStrictEqual(log.slice(2), [
+          `verify:${TARGET}@${artifactFor(TARGET)}`,
+          `send:${TARGET}`,
+        ]);
+        assert.equal(host.sent.length, 1);
+        assert.equal((yield* controller.getState).stage, "updating");
+        yield* gatesLatched(harness);
+      }),
+    ),
+  );
+
+  it.effect("a failed pre-dispatch identity recheck fails the attempt with nothing sent", () =>
+    provide(
+      Effect.gen(function* () {
+        const harness = yield* setup();
+        const { controller, log, runtimes, host, coordinator } = harness;
+        runtimes.set(TARGET, makeRuntime(log, TARGET, artifactFor(TARGET), { verifyFails: true }));
+        yield* controller.queue(TARGET);
+        const failed = yield* awaitStage(controller, "failed");
+        assert.equal(
+          failed.reason,
+          "Managed runtime staging failed while verifying the staged runtime: the staged runtime holds a different artifact",
+        );
+        assert.deepStrictEqual(failed.staged, { version: TARGET, artifactId: artifactFor(TARGET) });
+        assert.deepStrictEqual(log, [
+          `resolve:${TARGET}`,
+          `stage:${TARGET}@${artifactFor(TARGET)}`,
+          `verify:${TARGET}@${artifactFor(TARGET)}`,
+        ]);
+        assert.deepStrictEqual(host.sent, []);
+        assert.equal(yield* coordinator.phase, "ready");
+        yield* gatesOpen(harness);
+        yield* TestClock.adjust(POLL);
+        assert.equal(log.length, 3);
+      }),
+    ),
+  );
+
+  it.effect("a tagged launcher rejection reopens both gates and records the failure", () =>
+    provide(
+      Effect.gen(function* () {
+        const harness = yield* setup();
+        const { controller, host, coordinator } = harness;
+        yield* queueUntilDispatched(harness);
+
+        host.emit({ type: "update-rejected", reason: "requires local update" });
+        const failed = yield* awaitStage(controller, "failed");
+        assert.equal(failed.reason, "requires local update");
+        assert.isFalse(failed.handoffAccepted);
+        assert.equal(yield* coordinator.phase, "ready");
+        assert.equal(coordinator.acceptedRuns(), 0);
+        yield* gatesOpen(harness);
+
+        // The queue is usable again: retry re-stages and reaches a fresh handoff.
+        yield* controller.retry;
+        yield* host.awaitSend(2);
+        assert.equal(host.sent.length, 2);
+        assert.equal(yield* coordinator.phase, "attempting");
+        yield* gatesLatched(harness);
+      }),
+    ),
+  );
+
+  /**
+   * After dispatch, every exit but a tagged rejection is an unknown outcome:
+   * the launcher may already be restarting the service. The gates must stay
+   * latched and the queue must hold durable `updating` with no command able to
+   * retry or cancel, both while the process runs on and once its scope closes.
+   */
+  const uncertainAfterDispatch = (mode: SendMode | "disconnect" | "timeout" | "interrupt") =>
+    provide(
+      Effect.gen(function* () {
+        const scope = yield* Scope.make();
+        const harness = yield* setup({ scope });
+        const { controller, host, coordinator } = harness;
+        if (mode === "throw" || mode === "callback-error") host.sendMode = mode;
+        yield* controller.queue(TARGET);
+        yield* host.awaitSend();
+        switch (mode) {
+          case "disconnect":
+            host.disconnect();
+            break;
+          case "timeout":
+            yield* TestClock.adjust("30 seconds");
+            break;
+          case "interrupt":
+            // Process shutdown mid-request: the wait is interruptible, so the
+            // close returns promptly with the reservation still on disk.
+            yield* Scope.close(scope, Exit.void);
