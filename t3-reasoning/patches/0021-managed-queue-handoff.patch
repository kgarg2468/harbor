@@ -0,0 +1,179 @@
+/**
+ * ManagedQueuedUpdate - the managed-release adapter between the durable
+ * `QueuedUpdate` controller, the selection-bound `ManagedRuntimeStager`, the
+ * idle handoff coordinator, and the service launcher IPC.
+ *
+ * The queue owns staging order, retry timing, persistence, and the activation
+ * fiber; the coordinator owns the update gates. This module only binds each
+ * staging attempt to one exact feed selection and stager, rechecks that exact
+ * staged artifact under the coordinator's seal, and submits the protocol-2
+ * launcher request with its lifecycle points wired to the held gates.
+ *
+ * It never calls `ServerSelfUpdate.update` or `ensurePinnedRuntimeInstalled`:
+ * both may install stock npm bytes for a version-only sentinel, which is
+ * incompatible with managed artifact identity.
+ *
+ * @module ManagedQueuedUpdate
+ */
+import type * as Duration from "effect/Duration";
+import * as Effect from "effect/Effect";
+
+import type { IdleHandoffControl, IdleUpdateCoordinatorShape } from "./idleUpdateCoordinator.ts";
+import type { ManagedArtifactSourceError, ManagedRuntimeStager } from "./managedRuntime.ts";
+import * as QueuedUpdate from "./queuedUpdate.ts";
+import type { ServiceLauncherClient } from "./serviceLauncherClient.ts";
+
+/** One exact release selection, with the stager bound to that selection's source. */
+export interface ResolvedManagedRuntime {
+  readonly version: string;
+  readonly artifactId: string;
+  readonly stager: ManagedRuntimeStager;
+}
+
+/**
+ * Resolves an exact version, never `latest`, to its release selection. The
+ * production resolver is built from the release feed; HTTP policy lives there.
+ */
+export type ResolveManagedRuntime = (
+  exactVersion: string,
+) => Effect.Effect<ResolvedManagedRuntime, ManagedArtifactSourceError>;
+
+export interface ManagedQueuedUpdateDependencies {
+  readonly statePath: string;
+  readonly installedVersion: string;
+  readonly pollInterval: Duration.Input;
+  /** Live database the launcher snapshots and the candidate is trialled against. */
+  readonly dbPath: string;
+  readonly resolve: ResolveManagedRuntime;
+  /**
+   * Owns both update gates. Its handoff control's three members are exactly
+   * the launcher request's lifecycle points, so it is handed to the transport
+   * as is.
+   */
+  readonly coordinator: Pick<IdleUpdateCoordinatorShape, "tryActivate">;
+  readonly launcher: Pick<ServiceLauncherClient["Service"], "requestUpdate">;
+}
+
+interface Binding {
+  readonly staged: QueuedUpdate.StagedArtifact;
+  readonly stager: ManagedRuntimeStager;
+}
+
+const bindingKey = (staged: QueuedUpdate.StagedArtifact): string =>
+  `${staged.version}\0${staged.artifactId}`;
+
+const stepError = (
+  step: QueuedUpdate.QueuedUpdateStepError["step"],
+  reason: string,
+  cause?: unknown,
+) =>
+  cause === undefined
+    ? new QueuedUpdate.QueuedUpdateStepError({ step, reason })
+    : new QueuedUpdate.QueuedUpdateStepError({ step, reason, cause });
+
+export const make = Effect.fn("cloud.managed_queued_update.make")(function* (
+  deps: ManagedQueuedUpdateDependencies,
+) {
+  /**
+   * Exact `{ staged, stager }` associations made by this process, keyed by
+   * version and artifact ID. Activation uses only the stager that produced the
+   * artifact it is asked to activate; a later feed selection for the same
+   * version cannot substitute for it. Nothing here survives a restart: the
+   * queue re-enters `downloading` for a nonterminal target, so the resolver and
+   * stager run again before any activation.
+   */
+  const bindings = new Map<string, Binding>();
+
+  const stage = Effect.fn("cloud.managed_queued_update.stage")(function* (targetVersion: string) {
+    const resolved = yield* deps
+      .resolve(targetVersion)
+      .pipe(
+        Effect.mapError((error) =>
+          stepError(
+            "stage",
+            `Could not resolve managed release t3@${targetVersion}: ${error.reason}`,
+            error,
+          ),
+        ),
+      );
+    if (resolved.version !== targetVersion) {
+      return yield* stepError(
+        "stage",
+        `The managed release feed resolved t3@${targetVersion} to t3@${resolved.version}.`,
+      );
+    }
+    const staged = yield* resolved.stager
+      .stage(targetVersion)
+      .pipe(Effect.mapError((error) => stepError("stage", error.message, error)));
+    if (staged.version !== resolved.version || staged.artifactId !== resolved.artifactId) {
+      return yield* stepError(
+        "stage",
+        `The staged artifact for t3@${targetVersion} does not match its resolved release selection.`,
+      );
+    }
+    bindings.set(bindingKey(staged), { staged, stager: resolved.stager });
+    return staged;
+  });
+
+  /**
+   * Runs inside the coordinator's mask with both gates held. The client
+   * interprets the launcher's acknowledgement uninterruptibly, so `control`
+   * sees `dispatchStarted` immediately before the send, `definitivelyRejected`
+   * only for a tagged rejection, and `accepted` before the ID is returned.
+   * After acceptance the process is committed to restart, so this parks
+   * interruptibly instead of returning an answer the queue could act on.
+   */
+  const submitLauncherUpdate = (control: IdleHandoffControl, targetVersion: string) =>
+    deps.launcher.requestUpdate({ targetVersion, dbPath: deps.dbPath }, control).pipe(
+      Effect.mapError((error) =>
+        stepError(
+          "activate",
+          error._tag === "ServiceLauncherRejectedError"
+            ? error.reason
+            : `Could not ask the service launcher to activate t3@${targetVersion}: ${error.message}`,
+          error,
+        ),
+      ),
+      Effect.tap((updateId) =>
+        Effect.logInfo("Managed update handed off to the service launcher.", {
+          updateId,
+          targetVersion,
+        }),
+      ),
+      Effect.andThen(Effect.never),
+    );
+
+  const tryActivate: QueuedUpdate.QueuedUpdateDependencies["tryActivate"] = (
+    staged,
+    onHandoffAccepted,
+  ) =>
+    Effect.suspend(() => {
+      const binding = bindings.get(bindingKey(staged));
+      if (binding === undefined) {
+        return Effect.fail(
+          stepError(
+            "activate",
+            `t3@${staged.version} was not staged by this process; it must be staged again before activation.`,
+          ),
+        );
+      }
+      return deps.coordinator.tryActivate(
+        (control) =>
+          // The exact bound stager's cheap local identity recheck, then IPC.
+          // Never `stage`, a sentinel-only check, or a feed lookup here.
+          binding.stager.verifyStaged(staged).pipe(
+            Effect.mapError((error) => stepError("activate", error.message, error)),
+            Effect.andThen(submitLauncherUpdate(control, staged.version)),
+          ),
+        onHandoffAccepted,
+      );
+    });
+
+  return yield* QueuedUpdate.make({
+    statePath: deps.statePath,
+    installedVersion: deps.installedVersion,
+    pollInterval: deps.pollInterval,
+    stage,
+    tryActivate,
+  });
+});
