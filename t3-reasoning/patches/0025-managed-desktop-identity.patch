+import { describe, expect, it } from "vite-plus/test";
+
+import { isNightlyDesktopVersion, resolveDefaultDesktopUpdateChannel } from "./updateChannels.ts";
+
+const ORDINARY_NIGHTLY = "0.0.40-nightly.20260907.1359";
+const MANAGED_NIGHTLY = "0.0.40-nightly.20260907.1359.managed.1.p0123456789ab";
+
+describe("isNightlyDesktopVersion", () => {
+  it("recognizes ordinary and managed nightly versions", () => {
+    expect(isNightlyDesktopVersion(ORDINARY_NIGHTLY)).toBe(true);
+    expect(isNightlyDesktopVersion(MANAGED_NIGHTLY)).toBe(true);
+    expect(isNightlyDesktopVersion("0.0.40-nightly.20260907.1359.managed.12.pabcdef012345")).toBe(
+      true,
+    );
+    // Any positive safe integer is a valid managed counter.
+    expect(
+      isNightlyDesktopVersion(
+        "0.0.40-nightly.20260907.1359.managed.9007199254740991.p0123456789ab",
+      ),
+    ).toBe(true);
+    // Ordinary nightly classification stays suffix-only.
+    expect(isNightlyDesktopVersion("junk-nightly.20260907.1359")).toBe(true);
+  });
+
+  it("keeps stable and preview versions outside nightly", () => {
+    expect(isNightlyDesktopVersion("0.0.40")).toBe(false);
+    expect(isNightlyDesktopVersion("0.0.40-pr.8182.1")).toBe(false);
+  });
+
+  it("rejects near misses of the managed grammar", () => {
+    for (const version of [
+      // zero or malformed counter
+      "0.0.40-nightly.20260907.1359.managed.0.p0123456789ab",
+      "0.0.40-nightly.20260907.1359.managed.01.p0123456789ab",
+      "0.0.40-nightly.20260907.1359.managed.x.p0123456789ab",
+      "0.0.40-nightly.20260907.1359.managed..p0123456789ab",
+      // counter above Number.MAX_SAFE_INTEGER
+      "0.0.40-nightly.20260907.1359.managed.9007199254740992.p0123456789ab",
+      "0.0.40-nightly.20260907.1359.managed.99999999999999999999.p0123456789ab",
+      // junk or non-SemVer prefix before the nightly base
+      "junk-nightly.20260907.1359.managed.1.p0123456789ab",
+      "v0.0.40-nightly.20260907.1359.managed.1.p0123456789ab",
+      "0.40-nightly.20260907.1359.managed.1.p0123456789ab",
+      "0.0.40.1-nightly.20260907.1359.managed.1.p0123456789ab",
+      // leading zeros in the SemVer core, run id, or date
+      "00.0.40-nightly.20260907.1359.managed.1.p0123456789ab",
+      "0.00.40-nightly.20260907.1359.managed.1.p0123456789ab",
+      "0.0.040-nightly.20260907.1359.managed.1.p0123456789ab",
+      "0.0.40-nightly.20260907.01359.managed.1.p0123456789ab",
+      "0.0.40-nightly.02260907.1359.managed.1.p0123456789ab",
+      // digest length, case, or prefix
+      "0.0.40-nightly.20260907.1359.managed.1.p0123456789a",
+      "0.0.40-nightly.20260907.1359.managed.1.p0123456789abc",
+      "0.0.40-nightly.20260907.1359.managed.1.p0123456789AB",
+      "0.0.40-nightly.20260907.1359.managed.1.0123456789ab",
+      "0.0.40-nightly.20260907.1359.managed.1.pghijklmnopqr",
+      // missing or extra segments
+      "0.0.40-nightly.20260907.1359.managed.1",
+      "0.0.40-nightly.20260907.1359.managed.p0123456789ab",
+      "0.0.40-nightly.20260907.1359.managed.1.p0123456789ab.extra",
+      "0.0.40-nightly.20260907.1359.managed.1.p0123456789ab-dirty",
+      "0.0.40-nightly.20260907.1359-managed.1.p0123456789ab",
+      "0.0.40-nightly.20260907.1359.Managed.1.p0123456789ab",
+      // managed suffix on a non-nightly base
+      "0.0.40.managed.1.p0123456789ab",
+      "0.0.40-pr.8182.1.managed.1.p0123456789ab",
+      "0.0.40-nightly.2026090.1359.managed.1.p0123456789ab",
+    ]) {
+      expect(isNightlyDesktopVersion(version), version).toBe(false);
+    }
+  });
+});
+
+describe("resolveDefaultDesktopUpdateChannel", () => {
+  it("defaults managed nightly versions to the nightly channel", () => {
+    expect(resolveDefaultDesktopUpdateChannel(ORDINARY_NIGHTLY)).toBe("nightly");
+    expect(resolveDefaultDesktopUpdateChannel(MANAGED_NIGHTLY)).toBe("nightly");
+    expect(resolveDefaultDesktopUpdateChannel("0.0.40")).toBe("latest");
+    expect(
+      resolveDefaultDesktopUpdateChannel("0.0.40-nightly.20260907.1359.managed.1.p0123456789AB"),
+    ).toBe("latest");
+  });
+});
