+// @effect-diagnostics nodeBuiltinImport:off - streams a tar archive to disk with exclusive, no-follow opens that the Effect FileSystem does not expose.
+import * as NodeFS from "node:fs";
+import * as NodeFSP from "node:fs/promises";
+import * as NodePath from "node:path";
+import * as NodeStream from "node:stream";
+import * as NodeZlib from "node:zlib";
+
+import * as Effect from "effect/Effect";
+import * as Schema from "effect/Schema";
+import { Parser, type ReadEntry } from "tar";
+
+/**
+ * Confined extraction of a managed server archive (`managed-server-*.tar.gz`)
+ * into a brand-new private directory.
+ *
+ * The tar module only parses; every filesystem decision is made here from an
+ * explicit inventory so the managed contract is enforced by refusal rather
+ * than by the library's own skip-or-strip behaviour. Members are limited to
+ * ordinary files, directories, relative symbolic links, and internal hard
+ * links beneath `node_modules/t3`, which is what a pnpm production deploy
+ * produces (many essential relative symlinks; hard links when bsdtar folds
+ * duplicate content). Links are recorded during parsing and created only
+ * after every file and directory exists and the whole graph resolves inside
+ * the package, so an archive can never create a link and then write through
+ * it.
+ */
+
+const ARCHIVE_ROOT_DIR = "node_modules";
+const ARCHIVE_PACKAGE_DIR = "node_modules/t3";
+const PACKAGE_SEGMENTS = [ARCHIVE_ROOT_DIR, "t3"] as const;
+const MAX_LINK_HOPS = 40;
+const TAR_BLOCK = 512;
+const GZIP_MAGIC = [0x1f, 0x8b] as const;
+const ZSTD_MAGIC = [0x28, 0xb5, 0x2f, 0xfd] as const;
+const DIRECTORY_MODE = 0o755;
+const FILE_MODE_BASE = 0o644;
+const EXECUTE_BITS = 0o111;
+/** PAX keys the parser applies to an entry; anything else is platform metadata this contract refuses. */
+const ALLOWED_PAX_KEYS = new Set([
+  "path",
+  "linkpath",
+  "size",
+  "mtime",
+  "atime",
+  "ctime",
+  "uid",
+  "gid",
+  "uname",
+  "gname",
+  "charset",
+  "comment",
+  "hdrcharset",
+  "SCHILY.dev",
+  "SCHILY.ino",
+  "SCHILY.nlink",
+]);
+
+export const DEFAULT_REQUIRED_ARCHIVE_FILES: ReadonlyArray<string> = [
+  `${ARCHIVE_PACKAGE_DIR}/package.json`,
+  `${ARCHIVE_PACKAGE_DIR}/dist/bin.mjs`,
+];
+
+export interface ManagedRuntimeArchiveLimits {
+  readonly maxCompressedBytes: number;
+  /** Cap on the whole decompressed tar stream: headers, metadata, padding, and bodies. */
+  readonly maxExpandedBytes: number;
+  readonly maxEntries: number;
+  readonly maxFileBytes: number;
+  /** Cap on one PAX / GNU long-name metadata record. */
+  readonly maxMetaEntryBytes: number;
+  readonly maxPathBytes: number;
+  readonly maxPathDepth: number;
+}
+
+/** Starting policy; validate against real builder output before enabling publication. */
+export const DEFAULT_MANAGED_RUNTIME_ARCHIVE_LIMITS: ManagedRuntimeArchiveLimits = {
+  maxCompressedBytes: 2 * 1024 * 1024 * 1024,
+  maxExpandedBytes: 8 * 1024 * 1024 * 1024,
+  maxEntries: 200_000,
+  maxFileBytes: 1024 * 1024 * 1024,
+  maxMetaEntryBytes: 1024 * 1024,
+  maxPathBytes: 4096,
+  maxPathDepth: 64,
+};
+
+export type ArchiveMemberKind = "file" | "directory" | "symlink" | "hardlink";
+
+export interface ArchiveMember {
+  readonly kind: ArchiveMemberKind;
+  /** Normalized archive-relative POSIX path, e.g. `node_modules/t3/package.json`. */
+  readonly path: string;
+  /** Symlink: the literal relative target. Hard link: the normalized member it aliases. */
+  readonly target?: string;
+  readonly size?: number;
+  /** Implicit directories were created for a child before any explicit entry named them. */
+  readonly explicit: boolean;
+}
+
+export interface ExtractionInventory {
+  readonly members: ReadonlyMap<string, ArchiveMember>;
+  readonly files: number;
+  readonly directories: number;
+  readonly symlinks: number;
+  readonly hardlinks: number;
+  readonly compressedBytes: number;
+  readonly expandedBytes: number;
+  readonly payloadBytes: number;
+}
+
+export class ManagedRuntimeArchiveError extends Schema.TaggedErrorClass<ManagedRuntimeArchiveError>()(
+  "ManagedRuntimeArchiveError",
+  {
+    reason: Schema.String,
+    entryPath: Schema.optional(Schema.String),
+    cause: Schema.optional(Schema.Defect()),
+  },
+) {
+  override get message(): string {
+    return this.entryPath === undefined
+      ? `Managed runtime archive rejected: ${this.reason}`
+      : `Managed runtime archive rejected at ${JSON.stringify(this.entryPath)}: ${this.reason}`;
+  }
+}
+
+export interface ExtractManagedRuntimeArchiveInput {
+  /** An already authenticated, exclusively owned regular file. */
+  readonly archivePath: string;
+  /** Must not exist; created mode 0700 and removed again on any failure. */
+  readonly destination: string;
+  readonly limits?: Partial<ManagedRuntimeArchiveLimits>;
+  /** Members that must exist as regular files (never links) once extraction completes. */
+  readonly requiredFiles?: ReadonlyArray<string>;
+  readonly signal?: AbortSignal;
+}
+
+// --- path policy -----------------------------------------------------------------
+
+type PathCheck =
+  | { readonly ok: true; readonly segments: ReadonlyArray<string> }
+  | { readonly ok: false; readonly reason: string };
+
+function checkRawPath(raw: string, limits: ManagedRuntimeArchiveLimits): string | undefined {
+  if (raw === "") return "empty path";
+  if (/[\p{Cc}]/u.test(raw)) return "path contains control characters";
+  if (raw.includes("\\")) return "path contains a backslash";
+  if (raw.startsWith("/")) return "absolute path";
+  if (/^[A-Za-z]:/.test(raw)) return "drive-letter path";
+  if (Buffer.byteLength(raw) > limits.maxPathBytes) return "path is too long";
+  return undefined;
+}
+
+/**
+ * Effective member names must be canonical relative POSIX paths: an optional
+ * leading `./`, no empty, `.`, or `..` segments, and a trailing `/` only on
+ * directories.
+ */
+function parseMemberPath(
+  raw: string,
+  isDirectory: boolean,
+  limits: ManagedRuntimeArchiveLimits,
+): PathCheck {
+  const rawProblem = checkRawPath(raw, limits);
+  if (rawProblem !== undefined) return { ok: false, reason: rawProblem };
+  let name = raw.startsWith("./") ? raw.slice(2) : raw;
+  if (isDirectory && name.endsWith("/")) name = name.slice(0, -1);
+  if (name === "") return { ok: false, reason: "path names the archive root" };
+  const segments = name.split("/");
+  for (const segment of segments) {
+    if (segment === "") return { ok: false, reason: "path contains an empty segment" };
+    if (segment === "." || segment === "..")
+      return { ok: false, reason: `path contains a ${segment} segment` };
+  }
+  if (segments.length > limits.maxPathDepth)
+    return { ok: false, reason: "path is nested too deeply" };
+  return { ok: true, segments };
+}
+
+/** Only `node_modules` itself (a directory) and members below `node_modules/t3`. */
+function checkLocation(
+  segments: ReadonlyArray<string>,
+  kind: ArchiveMemberKind,
+): string | undefined {
+  if (segments[0] !== ARCHIVE_ROOT_DIR) return `only ${ARCHIVE_PACKAGE_DIR} may be extracted`;
+  if (segments.length === 1)
+    return kind === "directory" ? undefined : `${ARCHIVE_ROOT_DIR} must be a directory`;
+  if (segments[1] !== PACKAGE_SEGMENTS[1]) return `only ${ARCHIVE_PACKAGE_DIR} may be extracted`;
+  if (segments.length === 2 && kind !== "directory")
+    return `${ARCHIVE_PACKAGE_DIR} must be a directory`;
+  return undefined;
+}
+
+function isInsidePackage(segments: ReadonlyArray<string>): boolean {
+  return (
+    segments.length > 2 &&
+    segments[0] === PACKAGE_SEGMENTS[0] &&
+    segments[1] === PACKAGE_SEGMENTS[1]
+  );
+}
+
+/** Resolves a relative link target lexically against its parent; undefined when it climbs above the archive root. */
+function resolveLexically(
+  parent: ReadonlyArray<string>,
+  target: string,
+): ReadonlyArray<string> | undefined {
+  const resolved = [...parent];
+  for (const segment of target.split("/")) {
+    if (segment === "" || segment === ".") continue;
+    if (segment === "..") {
+      if (resolved.length === 0) return undefined;
+      resolved.pop();
+      continue;
+    }
+    resolved.push(segment);
+  }
+  return resolved;
+}
+
+/** Key under which two names collide on a case-insensitive, normalization-insensitive volume. */
+function aliasKey(name: string): string {
+  return name.normalize("NFC").toLowerCase();
+}
+
+function fileModeFor(archiveMode: number | undefined): number {
+  return FILE_MODE_BASE | ((archiveMode ?? 0) & EXECUTE_BITS);
+}
+
+// --- PAX metadata ----------------------------------------------------------------
+
+/**
+ * A metadata record is either a raw GNU long name (not key/value) or a PAX
+ * body of `<len> key=value\n` lines. Only the latter can carry sparse maps,
+ * ACLs, xattrs, or fflags, so refuse a PAX body naming any other key.
+ */
+function checkMetadataRecord(meta: string): string | undefined {
+  // The parser decodes metadata as UTF-8; a replacement character means the
+  // bytes were not, which also breaks the byte accounting below.
+  if (meta.includes("�")) return "metadata is not valid UTF-8";
+  const lines = meta.endsWith("\n") ? meta.slice(0, -1).split("\n") : [meta];
+  let records = 0;
+  for (const line of lines) {
+    const match = /^(\d+) ([^=]+)=/.exec(line);
+    if (match === null || Number(match[1]) !== Buffer.byteLength(line) + 1) continue;
+    records += 1;
+    const key = match[2] as string;
+    if (!ALLOWED_PAX_KEYS.has(key)) return `unsupported PAX record ${key}`;
+  }
+  return records > 0 && records !== lines.length ? "malformed PAX metadata" : undefined;
+}
+
+// --- extraction -------------------------------------------------------------------
+
+interface MutableMember {
+  kind: ArchiveMemberKind;
+  path: string;
+  target?: string;
+  size?: number;
+  explicit: boolean;
+}
