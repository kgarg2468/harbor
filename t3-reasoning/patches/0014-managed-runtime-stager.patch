+// @effect-diagnostics preferSchemaOverJson:off - tests mutate the golden manifest as plain JSON to forge tampered documents.
+import { assert, describe, it } from "@effect/vitest";
+import * as Effect from "effect/Effect";
+
+import {
+  canonicalJson,
+  computeReleaseInputDigest,
+  managedArtifactContentId,
+  MANAGED_RELEASE_MANIFEST_FILE,
+  parseManagedReleaseVersion,
+  sha256Hex,
+  verifyManagedReleaseDocuments,
+  type ManagedReleaseError,
+  type ManagedServerTarget,
+} from "./managedRelease.ts";
+
+// Golden cross-contract fixture: the exact `managed-release.json` and
+// `SHA256SUMS` that Harbor's write-managed-release-manifest.mjs published for
+// a descriptor resolved by resolve-managed-release.mjs (lock with two common
+// patches and one Reasoning identity patch, counter 1, four tiny artifacts).
+// Byte-for-byte; the checksum file covers these manifest bytes.
+const GOLDEN_VERSION = "0.0.38-nightly.20260905.3.managed.1.p6d1933416d7a";
+const GOLDEN_MANIFEST = `{
+  "artifacts": [
+    {
