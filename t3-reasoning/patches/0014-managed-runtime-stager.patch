+// @effect-diagnostics nodeBuiltinImport:off - builds tiny tar fixtures and inspects the extracted tree directly.
+import * as NodeFSP from "node:fs/promises";
+import * as NodeOS from "node:os";
+import * as NodePath from "node:path";
+import * as NodeZlib from "node:zlib";
+
+import { afterEach, assert, beforeEach, describe, it } from "@effect/vitest";
+import * as Effect from "effect/Effect";
+import * as Exit from "effect/Exit";
+import * as Fiber from "effect/Fiber";
+import { Header, type HeaderData } from "tar";
+import { vi } from "vite-plus/test";
+
+import {
+  extractManagedRuntimeArchive,
+  extractManagedRuntimeArchiveEffect,
+  type ExtractionInventory,
+  type ManagedRuntimeArchiveError,
+  type ManagedRuntimeArchiveLimits,
+} from "./managedRuntimeArchive.ts";
+
+// The late extraction phases (link creation, tree verification, closing the
+// archive) are held at a real filesystem call so cancellation can be delivered
+// deterministically while that call is in flight.
+vi.mock("node:fs/promises", async (importOriginal) => {
+  const actual = await importOriginal<typeof import("node:fs/promises")>();
+  return {
+    ...actual,
+    open: vi.fn(actual.open),
+    readdir: vi.fn(actual.readdir),
+    symlink: vi.fn(actual.symlink),
+  };
+});
+
+// --- tiny archive builder (headers via tar's own Header; meta blocks by hand) ---
+
+const BLOCK = 512;
+const RECORD = 10240;
+const PKG = "node_modules/t3";
+
+function pad(buffer: Buffer, unit = BLOCK): Buffer {
+  const remainder = buffer.length % unit;
+  return remainder === 0 ? buffer : Buffer.concat([buffer, Buffer.alloc(unit - remainder)]);
+}
+
+function headerBlock(data: HeaderData): Buffer {
+  // @effect-diagnostics-next-line globalDate:off - tar headers carry a plain mtime
+  const header = new Header({ mtime: new Date(0), uid: 0, gid: 0, uname: "", gname: "", ...data });
+  header.encode();
+  return Buffer.from(header.block as Buffer);
+}
+
+/** Re-signs a hand-edited raw header block so only the edited field is under test. */
+function withChecksum(block: Buffer): Buffer {
+  const copy = Buffer.from(block);
+  copy.fill(0x20, 148, 156);
+  let sum = 0;
+  for (const byte of copy) sum += byte;
+  copy.write(`${sum.toString(8).padStart(6, "0")}\0 `, 148, "ascii");
+  return copy;
+}
+
+interface Member {
+  readonly path: string;
+  readonly type?: HeaderData["type"];
+  readonly body?: string | Buffer;
+  readonly linkpath?: string;
+  readonly mode?: number;
+  /** Declared size when it should disagree with the body. */
+  readonly size?: number;
+}
+
+function member(spec: Member): Buffer {
+  const body =
+    spec.body === undefined
+      ? Buffer.alloc(0)
+      : Buffer.isBuffer(spec.body)
+        ? spec.body
+        : Buffer.from(spec.body);
+  const type = spec.type ?? (spec.path.endsWith("/") ? "Directory" : "File");
+  const header = headerBlock({
+    path: spec.path,
+    type,
+    size: spec.size ?? body.length,
+    ...(spec.linkpath === undefined ? {} : { linkpath: spec.linkpath }),
+    mode: spec.mode ?? (type === "Directory" ? 0o755 : 0o644),
+  });
+  return Buffer.concat([header, pad(body)]);
+}
+
+function paxRecord(key: string, value: string): string {
+  const rest = ` ${key}=${value}\n`;
+  let length = Buffer.byteLength(rest) + 1;
+  while (String(length).length + Buffer.byteLength(rest) !== length) length += 1;
+  return `${length}${rest}`;
+}
+
+function paxMember(records: Record<string, string>, raw?: string | Buffer): Buffer {
+  const body = Buffer.from(
+    raw ??
+      Object.entries(records)
+        .map(([key, value]) => paxRecord(key, value))
+        .join(""),
+  );
+  return Buffer.concat([
+    headerBlock({ path: "PaxHeader/x", type: "ExtendedHeader", size: body.length }),
+    pad(body),
+  ]);
+}
+
+function gnuLongPath(path: string): Buffer {
+  const body = Buffer.from(`${path}\0`);
+  return Buffer.concat([
+    headerBlock({ path: "././@LongLink", type: "NextFileHasLongPath", size: body.length }),
+    pad(body),
+  ]);
+}
+
+function tar(parts: ReadonlyArray<Buffer>, options: { eof?: boolean; pad?: boolean } = {}): Buffer {
+  const chunks = [...parts];
+  if (options.eof !== false) chunks.push(Buffer.alloc(2 * BLOCK));
+  const joined = Buffer.concat(chunks);
+  return options.pad === false ? joined : pad(joined, RECORD);
+}
+
+const gz = (buffer: Buffer): Buffer => NodeZlib.gzipSync(buffer);
+
+const PACKAGE_JSON = member({ path: `${PKG}/package.json`, body: '{"name":"t3"}' });
+const BIN = member({ path: `${PKG}/dist/bin.mjs`, body: "#!/usr/bin/env node\n", mode: 0o755 });
+const minimal = (...extra: ReadonlyArray<Buffer>) => gz(tar([PACKAGE_JSON, BIN, ...extra]));
+
+// --- harness ------------------------------------------------------------------------
+
+let root = "";
+let archivePath = "";
+let destination = "";
+let sibling = "";
+
+beforeEach(async () => {
+  root = await NodeFSP.mkdtemp(NodePath.join(NodeOS.tmpdir(), "managed-runtime-archive-"));
+  archivePath = NodePath.join(root, "server.tar.gz");
+  destination = NodePath.join(root, "staged");
+  sibling = NodePath.join(root, "keep.txt");
+  await NodeFSP.writeFile(sibling, "untouched");
+});
+
+afterEach(async () => {
+  vi.mocked(NodeFSP.open).mockReset();
+  vi.mocked(NodeFSP.readdir).mockReset();
+  vi.mocked(NodeFSP.symlink).mockReset();
+  await NodeFSP.rm(root, { recursive: true, force: true });
+});
+
+const exists = (path: string) =>
+  NodeFSP.lstat(path).then(
+    () => true,
+    () => false,
+  );
+
+interface Held {
+  /** Resolves once the extractor has entered the held call. */
+  readonly entered: Promise<void>;
+  /** Lets the real call proceed. */
+  readonly release: () => void;
+}
+
+function gate(): Held & { readonly enter: () => Promise<void> } {
+  let entered!: () => void;
+  let release!: () => void;
+  const enteredPromise = new Promise<void>((resolve) => {
+    entered = resolve;
+  });
+  const released = new Promise<void>((resolve) => {
+    release = resolve;
+  });
+  return {
+    entered: enteredPromise,
+    release,
+    enter: () => {
+      entered();
+      return released;
+    },
+  };
+}
+
+/** Pauses the extractor's next call of a mocked fs operation until released, then performs the real call. */
+function holdNext(operation: (...args: never[]) => Promise<unknown>): Held {
+  const mock = vi.mocked(operation);
+  const real = mock.getMockImplementation();
+  assert.isDefined(real);
+  const held = gate();
+  mock.mockImplementationOnce(async (...args) => {
+    await held.enter();
+    return real(...args);
+  });
+  return held;
+}
+
+/** Pauses the close of the next opened handle (the archive) until released. */
+function holdNextClose(): Held {
+  const mock = vi.mocked(NodeFSP.open);
+  const real = mock.getMockImplementation();
+  assert.isDefined(real);
+  const held = gate();
+  mock.mockImplementationOnce(async (...args) => {
+    const handle = await real(...args);
+    const close = handle.close.bind(handle);
+    handle.close = async () => {
+      await held.enter();
+      return close();
+    };
+    return handle;
+  });
+  return held;
+}
+
+/** True when the promise is still unsettled after a full turn; the held call is the only thing it can wait on. */
+const isPending = (promise: Promise<unknown>) =>
+  Promise.race([
+    promise.then(
+      () => false,
+      () => false,
+    ),
+    new Promise<boolean>((resolve) => setImmediate(() => resolve(true))),
+  ]);
+
+async function extract(
+  archive: Buffer,
+  options: {
+    limits?: Partial<ManagedRuntimeArchiveLimits>;
+    requiredFiles?: ReadonlyArray<string>;
+    signal?: AbortSignal;
+  } = {},
+): Promise<ExtractionInventory> {
+  await NodeFSP.writeFile(archivePath, archive);
+  return extractManagedRuntimeArchive({ archivePath, destination, ...options });
+}
+
+/** Extraction must fail with a typed error, remove the destination, and leave everything else alone. */
+async function refused(
+  archive: Buffer,
+  options: Parameters<typeof extract>[1] = {},
+): Promise<ManagedRuntimeArchiveError> {
+  let error: unknown;
+  try {
+    await extract(archive, options);
+  } catch (caught) {
+    error = caught;
+  }
+  assert.isDefined(error, "extraction succeeded but should have been refused");
+  const typed = error as ManagedRuntimeArchiveError;
+  assert.strictEqual(typed._tag, "ManagedRuntimeArchiveError");
+  assert.isFalse(await exists(destination), "destination should be removed");
+  assert.strictEqual(await NodeFSP.readFile(sibling, "utf8"), "untouched");
+  assert.isTrue(await exists(archivePath), "archive must not be touched");
+  return typed;
+}
+
+const at = (relative: string) => NodePath.join(destination, ...relative.split("/"));
+const modeOf = async (relative: string) => (await NodeFSP.lstat(at(relative))).mode & 0o7777;
+
+// --- tests ---------------------------------------------------------------------------
+
+describe("extractManagedRuntimeArchive", () => {
+  it("extracts a pnpm deploy layout with relative symlinks and hard links intact", async () => {
+    const effectDir = `${PKG}/node_modules/.pnpm/effect@1.0.0/node_modules`;
+    const depDir = `${PKG}/node_modules/.pnpm/dep@2.0.0/node_modules/dep`;
+    const inventory = await extract(
+      gz(
+        tar([
+          PACKAGE_JSON,
+          BIN,
+          member({ path: `${PKG}/dist/`, mode: 0o2775 }),
+          member({
+            path: `${PKG}/node_modules/effect`,
+            type: "SymbolicLink",
+            linkpath: ".pnpm/effect@1.0.0/node_modules/effect",
+          }),
+          member({ path: `${effectDir}/effect/index.js`, body: "export const effect = 1;\n" }),
+          member({ path: `${effectDir}/effect/package.json`, body: '{"name":"effect"}' }),
+          member({ path: `${depDir}/index.js`, body: "module.exports = 2;\n", mode: 0o4755 }),
+          member({
+            path: `${effectDir}/dep`,
+            type: "SymbolicLink",
+            linkpath: "../../dep@2.0.0/node_modules/dep",
+          }),
+          member({
+            path: `${PKG}/node_modules/.bin/t3`,
+            type: "SymbolicLink",
+            linkpath: "../../dist/bin.mjs",
+          }),
+          member({
+            path: `${depDir}/copy.js`,
+            type: "Link",
+            linkpath: `${effectDir}/effect/index.js`,
+          }),
+        ]),
+      ),
+    );
+
+    assert.strictEqual(inventory.files, 5);
+    assert.strictEqual(inventory.directories, 12);
+    assert.strictEqual(inventory.symlinks, 3);
+    assert.strictEqual(inventory.hardlinks, 1);
+    assert.strictEqual(inventory.members.size, 21);
+    assert.strictEqual(inventory.payloadBytes, 13 + 20 + 25 + 17 + 20);
+    assert.strictEqual(inventory.expandedBytes, RECORD);
+    assert.isTrue(inventory.members.get(`${PKG}/dist`)?.explicit);
+    assert.isFalse(inventory.members.get(`${PKG}/node_modules`)?.explicit);
+
+    assert.strictEqual((await NodeFSP.stat(destination)).mode & 0o7777, 0o700);
+    assert.strictEqual(await modeOf(`${PKG}/dist`), 0o755);
+    assert.strictEqual(await modeOf(`${PKG}/dist/bin.mjs`), 0o755);
+    assert.strictEqual(await modeOf(`${PKG}/package.json`), 0o644);
+    assert.strictEqual(await modeOf(`${depDir}/index.js`), 0o755);
+    assert.strictEqual(
+      await NodeFSP.readFile(at(`${PKG}/dist/bin.mjs`), "utf8"),
+      "#!/usr/bin/env node\n",
+    );
+    assert.strictEqual(
+      await NodeFSP.readlink(at(`${PKG}/node_modules/effect`)),
+      ".pnpm/effect@1.0.0/node_modules/effect",
