index 000000000..8f040bb51
--- /dev/null
+++ b/apps/server/src/cloud/managedRelease.ts
@@ -0,0 +1,630 @@
+import * as NodeCrypto from "node:crypto";
+
+import * as Effect from "effect/Effect";
+import * as Schema from "effect/Schema";
+
+import { SERVICE_LAUNCHER_PROTOCOL } from "./serviceProtocol.ts";
+
+/**
+ * Source-side mirror of the Harbor managed-release contract
+ * (`write-managed-release-manifest.mjs` / `resolve-managed-release.mjs`).
+ *
+ * A managed release is closed over exactly four artifacts described by
+ * `managed-release.json` and covered, together with the manifest itself, by
+ * `SHA256SUMS`. This module authenticates the two downloaded documents as
+ * bytes, recomputes the release-input digest from the provenance the manifest
+ * carries, and selects the one server archive that fits the host. Nothing a
+ * manifest says becomes a URL or a path: the caller derives locations from a
+ * trusted release base plus the validated bare file name.
+ */
+
+export const MANAGED_RELEASE_MANIFEST_FILE = "managed-release.json";
+export const MANAGED_RELEASE_SUMS_FILE = "SHA256SUMS";
+export const MANAGED_RELEASE_SCHEMA_VERSION = 1;
+export const MANAGED_SERVER_ENTRY = "node_modules/t3/dist/bin.mjs";
+export const MAX_MANAGED_MANIFEST_BYTES = 256 * 1024;
+export const MAX_MANAGED_SUMS_BYTES = 16 * 1024;
+
+const MANAGED_NIGHTLY_VARIANT = "managed-nightly";
+const REASONING_VARIANT = "reasoning";
+const COMMON_VARIANT = "common";
+const RELEASE_INPUT_SCHEMA = "t3-managed-release-input/1";
+const SHORT_DIGEST_LENGTH = 12;
+
+const PRESENTATION_VARIANTS = Object.freeze({
+  [MANAGED_NIGHTLY_VARIANT]: MANAGED_NIGHTLY_VARIANT,
+  [REASONING_VARIANT]: REASONING_VARIANT,
+});
+export const MANAGED_PUBLIC_CONFIG_KEYS = Object.freeze([
+  "T3CODE_CLERK_CLI_OAUTH_CLIENT_ID",
+  "T3CODE_CLERK_JWT_TEMPLATE",
+  "T3CODE_CLERK_PUBLISHABLE_KEY",
+  "T3CODE_RELAY_URL",
+]);
+
+const SHA256_RE = /^[0-9a-f]{64}$/;
+const COMMIT_RE = /^[0-9a-f]{40}$/;
+const NUMERIC = "(?:0|[1-9]\\d*)";
+const UPSTREAM_NIGHTLY_RE = new RegExp(
+  `^${NUMERIC}\\.${NUMERIC}\\.${NUMERIC}-nightly\\.[1-9]\\d{7}\\.${NUMERIC}$`,
+);
+const MANAGED_RELEASE_RE = new RegExp(
+  `^(${NUMERIC}\\.${NUMERIC}\\.${NUMERIC}-nightly\\.[1-9]\\d{7}\\.${NUMERIC})` +
+    `\\.managed\\.(${NUMERIC})\\.p([0-9a-f]{${SHORT_DIGEST_LENGTH}})$`,
+);
+const SUMS_LINE_RE = /^([0-9a-f]{64})  (.+)$/;
+
+export type ManagedServerReleaseArtifactId =
+  | "managed-server-darwin-arm64"
+  | "managed-server-linux-x64";
+
+export type ManagedServerTarget =
+  | { readonly platform: "darwin"; readonly arch: "arm64" }
+  | { readonly platform: "linux"; readonly arch: "x64"; readonly libc: "glibc" };
+
+/**
+ * The fixed identity of every artifact a managed release publishes, in the
+ * writer's canonical order. Records must restate these values exactly.
+ */
+const EXPECTED_ARTIFACTS = [
+  {
+    id: "managed-nightly-darwin-arm64",
+    kind: "desktop",
+    variant: MANAGED_NIGHTLY_VARIANT,
+    platform: "darwin",
+    arch: "arm64",
+    format: "zip",
+    bundleId: "com.t3tools.t3code",
+    productName: "T3 Code (Nightly)",
+    urlSchemes: ["t3code", "t3code-dev"],
+    presentationVariant: MANAGED_NIGHTLY_VARIANT,
+  },
+  {
+    id: "reasoning-darwin-arm64",
+    kind: "desktop",
+    variant: REASONING_VARIANT,
+    platform: "darwin",
+    arch: "arm64",
+    format: "zip",
+    bundleId: "com.t3tools.t3code.reasoning",
+    productName: "T3 Code (Reasoning)",
+    urlSchemes: ["t3code-reasoning"],
+    presentationVariant: REASONING_VARIANT,
+  },
+  {
+    id: "managed-server-darwin-arm64",
+    kind: "server",
+    variant: COMMON_VARIANT,
+    platform: "darwin",
+    arch: "arm64",
+    format: "tar.gz",
+    entry: MANAGED_SERVER_ENTRY,
+    launcherProtocol: SERVICE_LAUNCHER_PROTOCOL,
+  },
+  {
+    id: "managed-server-linux-x64",
+    kind: "server",
+    variant: COMMON_VARIANT,
+    platform: "linux",
+    arch: "x64",
+    format: "tar.gz",
+    entry: MANAGED_SERVER_ENTRY,
+    launcherProtocol: SERVICE_LAUNCHER_PROTOCOL,
+  },
+] as const;
+
+const RESERVED_FILES: ReadonlySet<string> = new Set([
+  MANAGED_RELEASE_MANIFEST_FILE,
+  MANAGED_RELEASE_SUMS_FILE,
+]);
+
+export class ManagedReleaseError extends Schema.TaggedErrorClass<ManagedReleaseError>()(
+  "ManagedReleaseError",
+  {
+    document: Schema.Literals(["manifest", "checksums", "target"]),
+    reason: Schema.String,
+  },
+) {
+  override get message(): string {
+    return `Managed release ${this.document} rejected: ${this.reason}`;
+  }
+}
+
+export interface VerifiedManagedServerAsset {
+  readonly version: string;
+  readonly releaseArtifactId: ManagedServerReleaseArtifactId;
+  /** Bare basename inside the trusted release directory; never a URL. */
+  readonly file: string;
+  readonly bytes: number;
+  readonly sha256: string;
+  /** SHA-256 of the original manifest bytes, as `SHA256SUMS` covers them. */
+  readonly manifestSha256: string;
+  readonly releaseInputSha256: string;
+  readonly platform: "darwin" | "linux";
+  readonly arch: "arm64" | "x64";
+  readonly entry: typeof MANAGED_SERVER_ENTRY;
+  readonly launcherProtocol: typeof SERVICE_LAUNCHER_PROTOCOL;
+}
+
+// --- schema --------------------------------------------------------------------
+
+const Sha256Hex = Schema.String.check(Schema.isPattern(SHA256_RE));
+const CommitSha = Schema.String.check(Schema.isPattern(COMMIT_RE));
+const PatchRecord = Schema.Struct({ id: Schema.NonEmptyString, sha256: Sha256Hex });
+const VariantRecord = Schema.Struct({ patches: Schema.Array(PatchRecord) });
+
+const DesktopArtifactRecord = Schema.Struct({
+  id: Schema.String,
+  kind: Schema.Literal("desktop"),
+  variant: Schema.String,
+  platform: Schema.String,
+  arch: Schema.String,
+  format: Schema.String,
+  bundleId: Schema.String,
+  productName: Schema.String,
+  urlSchemes: Schema.Array(Schema.String),
+  presentationVariant: Schema.String,
+  file: Schema.String,
+  version: Schema.String,
+  embeddedServerVersion: Schema.String,
+  bytes: Schema.Number,
+  sha256: Sha256Hex,
+});
+
+const ServerArtifactRecord = Schema.Struct({
+  id: Schema.String,
+  kind: Schema.Literal("server"),
+  variant: Schema.String,
+  platform: Schema.String,
+  arch: Schema.String,
+  format: Schema.String,
+  entry: Schema.String,
+  launcherProtocol: Schema.Number,
+  file: Schema.String,
+  version: Schema.String,
+  bytes: Schema.Number,
+  sha256: Sha256Hex,
+});
+
+/** Structural mirror of `buildManifest` in the Harbor writer. Unknown keys are refused at decode time. */
+const ManagedReleaseManifest = Schema.Struct({
+  schemaVersion: Schema.Literal(MANAGED_RELEASE_SCHEMA_VERSION),
+  releaseVersion: Schema.String,
+  upstreamVersion: Schema.String,
+  upstreamCommit: CommitSha,
+  upstreamRepository: Schema.NonEmptyString,
+  releaseCounter: Schema.Number,
+  releaseInputSha256: Sha256Hex,
+  publicConfigSha256: Sha256Hex,
+  publicConfigKeys: Schema.Array(Schema.String),
+  builderRevision: CommitSha,
+  presentationVariants: Schema.Struct({
+    [MANAGED_NIGHTLY_VARIANT]: Schema.String,
+    [REASONING_VARIANT]: Schema.String,
+  }),
+  variants: Schema.Struct({
+    [MANAGED_NIGHTLY_VARIANT]: VariantRecord,
+    [REASONING_VARIANT]: VariantRecord,
+  }),
+  artifacts: Schema.Array(Schema.Union([DesktopArtifactRecord, ServerArtifactRecord])),
+});
+type ManagedReleaseManifest = typeof ManagedReleaseManifest.Type;
+type ArtifactRecord = ManagedReleaseManifest["artifacts"][number];
+
+const decodeManifest = Schema.decodeUnknownEffect(ManagedReleaseManifest);
+
+// --- helpers ---------------------------------------------------------------------
+
+function fail(document: ManagedReleaseError["document"], reason: string): never {
+  throw new ManagedReleaseError({ document, reason });
+}
+
+function sameJson(a: unknown, b: unknown): boolean {
+  return JSON.stringify(a) === JSON.stringify(b);
+}
+
+function canonicalize(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(canonicalize);
+  if (typeof value === "object" && value !== null) {
+    const record = value as Record<string, unknown>;
+    return Object.fromEntries(
+      Object.keys(record)
+        .sort()
+        .map((key) => [key, canonicalize(record[key])]),
+    );
+  }
+  return value;
+}
+
+/** JSON with recursively sorted keys plus a trailing newline: the Harbor canonical form. */
+export function canonicalJson(value: unknown): string {
+  return `${JSON.stringify(canonicalize(value), null, 2)}\n`;
+}
+
+export function sha256Hex(bytes: Uint8Array | string): string {
+  return NodeCrypto.createHash("sha256").update(bytes).digest("hex");
+}
+
+export interface ManagedReleaseVersionParts {
+  readonly releaseVersion: string;
+  readonly upstreamVersion: string;
+  readonly releaseCounter: number;
+  readonly releaseInputShort: string;
+}
+
+/** `<upstream nightly>.managed.<counter>.p<12 hex>`; the counter must be a positive safe integer. */
+export function parseManagedReleaseVersion(
+  version: string,
+): ManagedReleaseVersionParts | undefined {
+  const match = MANAGED_RELEASE_RE.exec(version);
+  if (match === null) return undefined;
+  const releaseCounter = Number(match[2]);
+  if (!Number.isSafeInteger(releaseCounter) || releaseCounter < 1) return undefined;
+  return {
+    releaseVersion: version,
+    upstreamVersion: match[1] as string,
+    releaseCounter,
+    releaseInputShort: match[3] as string,
+  };
+}
+
+export function formatManagedReleaseVersion(
+  upstreamVersion: string,
+  releaseCounter: number,
+  releaseInputSha256: string,
+): string {
+  return `${upstreamVersion}.managed.${releaseCounter}.p${releaseInputSha256.slice(0, SHORT_DIGEST_LENGTH)}`;
+}
+
+export interface ReleaseInputDigestInput {
+  readonly upstreamRepository: string;
+  readonly upstreamCommit: string;
+  readonly upstreamVersion: string;
+  readonly variants: Readonly<
+    Record<string, ReadonlyArray<{ readonly id: string; readonly sha256: string }>>
+  >;
+  readonly builderRevision: string;
+  readonly publicConfigSha256: string;
+  readonly presentationVariants: Readonly<Record<string, string>>;
+}
+
+/**
+ * Exactly `computeReleaseInputDigest` in the Harbor resolver: the repository,
+ * commit, version, each variant's ordered `{ id, sha256 }` pairs, the builder
+ * revision, the public-config fingerprint, and the presentation variants,
+ * canonicalized under schema `t3-managed-release-input/1`.
+ */
+export function computeReleaseInputDigest(input: ReleaseInputDigestInput): string {
+  return sha256Hex(
+    canonicalJson({
+      schema: RELEASE_INPUT_SCHEMA,
+      upstreamRepository: input.upstreamRepository,
+      upstreamCommit: input.upstreamCommit,
+      upstreamVersion: input.upstreamVersion,
+      variants: Object.fromEntries(
+        Object.entries(input.variants).map(([name, patches]) => [
+          name,
+          patches.map(({ id, sha256 }) => ({ id, sha256 })),
+        ]),
+      ),
+      builderRevision: input.builderRevision,
+      publicConfigSha256: input.publicConfigSha256,
+      presentationVariants: input.presentationVariants,
+    }),
+  );
+}
+
+export function selectManagedServerArtifactId(
+  target: ManagedServerTarget,
+): ManagedServerReleaseArtifactId {
+  return target.platform === "darwin" ? "managed-server-darwin-arm64" : "managed-server-linux-x64";
+}
+
+/** Content identity for the queued-update record: stable name plus archive digest. */
+export function managedArtifactContentId(asset: {
+  readonly releaseArtifactId: ManagedServerReleaseArtifactId;
+  readonly sha256: string;
+}): string {
+  return `${asset.releaseArtifactId}@sha256:${asset.sha256}`;
+}
+
+function decodeUtf8Strict(bytes: Uint8Array, document: ManagedReleaseError["document"]): string {
+  try {
+    return new TextDecoder("utf-8", { fatal: true, ignoreBOM: true }).decode(bytes);
+  } catch {
+    return fail(document, "not valid UTF-8");
+  }
+}
+
+// --- manifest --------------------------------------------------------------------
+
+/** A bare, portable file name: the same rule the writer applies to inventory records. */
+function validateFileName(file: string, format: string, label: string): string {
+  if (file === "" || file.includes("/") || file.includes("\\") || file === "." || file === "..") {
+    fail("manifest", `${label}: file ${JSON.stringify(file)} must be a bare file name`);
+  }
+  if (/[\p{Cc}]/u.test(file) || file.startsWith("-") || file.trim() !== file) {
+    fail("manifest", `${label}: file ${JSON.stringify(file)} contains disallowed characters`);
+  }
+  if (!file.endsWith(`.${format}`) || file === `.${format}`) {
+    fail("manifest", `${label}: file ${JSON.stringify(file)} must end with .${format}`);
+  }
+  if (RESERVED_FILES.has(file)) {
+    fail("manifest", `${label}: file ${file} collides with a release document`);
+  }
+  return file;
+}
+
+function validateArtifacts(manifest: ManagedReleaseManifest): ReadonlyMap<string, ArtifactRecord> {
+  const byId = new Map<string, ArtifactRecord>();
+  for (const record of manifest.artifacts) {
+    if (record.id === "") fail("manifest", "artifact id must be non-empty");
+    if (byId.has(record.id)) fail("manifest", `duplicate artifact ${record.id}`);
+    byId.set(record.id, record);
+  }
+  const expectedIds: ReadonlyArray<string> = EXPECTED_ARTIFACTS.map((artifact) => artifact.id);
+  const missing = expectedIds.filter((id) => !byId.has(id));
+  const unexpected = [...byId.keys()].filter((id) => !expectedIds.includes(id));
+  if (missing.length > 0) fail("manifest", `missing artifact(s) ${missing.join(", ")}`);
+  if (unexpected.length > 0) {
+    fail("manifest", `artifact(s) outside the release set: ${unexpected.join(", ")}`);
+  }
+
+  const seenFiles = new Map<string, string>();
+  for (const expected of EXPECTED_ARTIFACTS) {
+    const record = byId.get(expected.id) as ArtifactRecord;
+    const label = `artifact ${expected.id}`;
+    for (const [key, value] of Object.entries(expected)) {
+      if (!sameJson((record as Record<string, unknown>)[key], value)) {
+        fail("manifest", `${label}: ${key} must be ${JSON.stringify(value)}`);
+      }
+    }
+    if (record.version !== manifest.releaseVersion) {
+      fail("manifest", `${label}: version does not equal release version`);
+    }
+    if (record.kind === "desktop" && record.embeddedServerVersion !== manifest.releaseVersion) {
+      fail("manifest", `${label}: embeddedServerVersion does not equal release version`);
+    }
+    if (!Number.isSafeInteger(record.bytes) || record.bytes < 1) {
+      fail("manifest", `${label}: bytes must be a positive safe integer`);
+    }
+    const file = validateFileName(record.file, expected.format, label);
+    const folded = file.toLowerCase();
+    const other = seenFiles.get(folded);
+    if (other !== undefined) fail("manifest", `${label}: file ${file} is also used by ${other}`);
+    seenFiles.set(folded, expected.id);
+  }
+  return byId;
+}
+
+function validateProvenance(manifest: ManagedReleaseManifest, targetVersion: string): void {
+  const parsed = parseManagedReleaseVersion(manifest.releaseVersion);
+  if (parsed === undefined) {
+    fail(
+      "manifest",
+      `releaseVersion ${JSON.stringify(manifest.releaseVersion)} is not a managed release version`,
+    );
+  }
+  if (manifest.releaseVersion !== targetVersion) {
+    fail(
+      "manifest",
+      `releaseVersion ${manifest.releaseVersion} is not the requested ${targetVersion}`,
+    );
+  }
+  if (!UPSTREAM_NIGHTLY_RE.test(manifest.upstreamVersion)) {
+    fail("manifest", "upstreamVersion is not an upstream nightly version");
+  }
+  if (manifest.upstreamVersion !== parsed.upstreamVersion) {
+    fail("manifest", "upstreamVersion does not match releaseVersion");
+  }
+  if (
+    !Number.isSafeInteger(manifest.releaseCounter) ||
+    manifest.releaseCounter < 1 ||
+    manifest.releaseCounter !== parsed.releaseCounter
+  ) {
+    fail("manifest", "releaseCounter does not match releaseVersion");
+  }
+  if (!sameJson(manifest.publicConfigKeys, MANAGED_PUBLIC_CONFIG_KEYS)) {
+    fail("manifest", `publicConfigKeys must be exactly ${MANAGED_PUBLIC_CONFIG_KEYS.join(", ")}`);
+  }
+  if (!sameJson(manifest.presentationVariants, PRESENTATION_VARIANTS)) {
+    fail("manifest", `presentationVariants must be ${JSON.stringify(PRESENTATION_VARIANTS)}`);
+  }
+
+  const common = manifest.variants[MANAGED_NIGHTLY_VARIANT].patches;
+  const reasoning = manifest.variants[REASONING_VARIANT].patches;
+  for (const [name, patches] of [
+    [MANAGED_NIGHTLY_VARIANT, common],
+    [REASONING_VARIANT, reasoning],
+  ] as const) {
+    if (patches.length === 0) fail("manifest", `variants.${name}.patches must be non-empty`);
+    const ids = new Set<string>();
+    for (const patch of patches) {
+      if (ids.has(patch.id)) fail("manifest", `variants.${name} repeats patch id ${patch.id}`);
+      ids.add(patch.id);
+    }
+  }
+  if (reasoning.length <= common.length) {
+    fail(
+      "manifest",
+      `variant ${REASONING_VARIANT} must extend ${MANAGED_NIGHTLY_VARIANT} with an identity patch`,
+    );
+  }
+  common.forEach((patch, position) => {
+    const counterpart = reasoning[position];
+    if (
+      counterpart === undefined ||
+      counterpart.id !== patch.id ||
+      counterpart.sha256 !== patch.sha256
+    ) {
+      fail("manifest", `variant ${REASONING_VARIANT}[${position}] differs from the common prefix`);
+    }
+  });
+
+  const digest = computeReleaseInputDigest({
+    upstreamRepository: manifest.upstreamRepository,
+    upstreamCommit: manifest.upstreamCommit,
+    upstreamVersion: manifest.upstreamVersion,
+    variants: { [MANAGED_NIGHTLY_VARIANT]: common, [REASONING_VARIANT]: reasoning },
+    builderRevision: manifest.builderRevision,
+    publicConfigSha256: manifest.publicConfigSha256,
+    presentationVariants: manifest.presentationVariants,
+  });
+  if (manifest.releaseInputSha256 !== digest) {
+    fail("manifest", "releaseInputSha256 does not match the digest recomputed from its provenance");
+  }
+  const expectedVersion = formatManagedReleaseVersion(
+    manifest.upstreamVersion,
+    manifest.releaseCounter,
+    digest,
+  );
+  if (manifest.releaseVersion !== expectedVersion) {
+    fail("manifest", `releaseVersion does not match the resolved ${expectedVersion}`);
+  }
+}
+
+// --- SHA256SUMS ------------------------------------------------------------------
+
+function parseSha256Sums(sumsBytes: Uint8Array): ReadonlyMap<string, string> {
+  if (sumsBytes.byteLength === 0) fail("checksums", "empty");
+  if (sumsBytes.byteLength > MAX_MANAGED_SUMS_BYTES) fail("checksums", "too large");
+  const text = decodeUtf8Strict(sumsBytes, "checksums");
+  if (!text.endsWith("\n")) fail("checksums", "must end with a newline");
+  const lines = text.slice(0, -1).split("\n");
+  const entries = new Map<string, string>();
+  let previous = "";
+  for (const line of lines) {
+    const match = SUMS_LINE_RE.exec(line);
+    if (match === null) fail("checksums", `malformed line ${JSON.stringify(line)}`);
+    const sha256 = match[1] as string;
+    const file = match[2] as string;
+    if (
+      file === "." ||
+      file === ".." ||
+      file.includes("/") ||
+      file.includes("\\") ||
+      /[\p{Cc}]/u.test(file) ||
+      file.startsWith("-") ||
+      file.trim() !== file
+    ) {
+      fail("checksums", `file name ${JSON.stringify(file)} is not a bare file name`);
+    }
+    if (entries.has(file)) fail("checksums", `duplicate entry for ${file}`);
+    if (file <= previous) fail("checksums", "entries must be sorted by file name");
+    previous = file;
+    entries.set(file, sha256);
+  }
+  return entries;
+}
+
+// --- entry point -----------------------------------------------------------------
+
+export interface VerifyManagedReleaseDocumentsInput {
+  /** The manifest exactly as downloaded; its hash must appear in `SHA256SUMS`. */
+  readonly manifestBytes: Uint8Array;
+  readonly sumsBytes: Uint8Array;
+  /** The exact managed version the caller asked for; the manifest must name it. */
+  readonly targetVersion: string;
+  readonly hostTarget: ManagedServerTarget;
+}
+
+/**
+ * Authenticates the two release documents against each other and the
+ * request, then returns the single server artifact record for the host.
+ * Pure apart from hashing: no network, no filesystem, no trusted URLs.
+ */
+export const verifyManagedReleaseDocuments = Effect.fn("cloud.managed_release.verify_documents")(
+  function* (input: VerifyManagedReleaseDocumentsInput) {
+    const prepared = yield* attempt(() => {
+      if (parseManagedReleaseVersion(input.targetVersion) === undefined) {
+        fail("target", `${JSON.stringify(input.targetVersion)} is not a managed release version`);
+      }
+      if (input.manifestBytes.byteLength === 0) fail("manifest", "empty");
+      if (input.manifestBytes.byteLength > MAX_MANAGED_MANIFEST_BYTES)
+        fail("manifest", "too large");
+      const text = decodeUtf8Strict(input.manifestBytes, "manifest");
+      try {
+        return JSON.parse(text) as unknown;
+      } catch {
+        return fail("manifest", "not valid JSON");
+      }
+    });
+    const manifest = yield* decodeManifest(prepared, { onExcessProperty: "error" }).pipe(
+      Effect.mapError(
+        (error) =>
+          new ManagedReleaseError({
+            document: "manifest",
+            reason: `does not match the managed release schema: ${error.message}`,
+          }),
+      ),
+    );
+    return yield* attempt(() => selectVerifiedAsset(manifest, input));
+  },
+);
+
+const isManagedReleaseError = Schema.is(ManagedReleaseError);
+
+/** Runs a synchronous validator, moving its typed refusals into the error channel. */
+function attempt<A>(evaluate: () => A): Effect.Effect<A, ManagedReleaseError> {
+  return Effect.suspend(() => {
+    try {
+      return Effect.succeed(evaluate());
+    } catch (error) {
+      return isManagedReleaseError(error) ? Effect.fail(error) : Effect.die(error);
+    }
+  });
+}
+
+function selectVerifiedAsset(
+  manifest: ManagedReleaseManifest,
+  input: VerifyManagedReleaseDocumentsInput,
+): VerifiedManagedServerAsset {
+  validateProvenance(manifest, input.targetVersion);
+  const artifacts = validateArtifacts(manifest);
+
+  const sums = parseSha256Sums(input.sumsBytes);
+  const expectedFiles = [
+    MANAGED_RELEASE_MANIFEST_FILE,
+    ...[...artifacts.values()].map((record) => record.file),
+  ];
+  if (sums.size !== expectedFiles.length) {
+    fail("checksums", `expected exactly ${expectedFiles.length} entries, found ${sums.size}`);
+  }
+  for (const file of expectedFiles) {
+    if (!sums.has(file)) fail("checksums", `missing entry for ${file}`);
+  }
+  const manifestSha256 = sha256Hex(input.manifestBytes);
+  if (sums.get(MANAGED_RELEASE_MANIFEST_FILE) !== manifestSha256) {
+    fail("checksums", "manifest hash does not match the downloaded manifest bytes");
+  }
+  for (const record of artifacts.values()) {
+    if (sums.get(record.file) !== record.sha256) {
+      fail("checksums", `hash for ${record.file} disagrees with the manifest`);
+    }
+  }
+
+  const releaseArtifactId = selectManagedServerArtifactId(input.hostTarget);
+  const record = artifacts.get(releaseArtifactId);
+  if (record === undefined || record.kind !== "server") {
+    return fail("manifest", `no server artifact for ${releaseArtifactId}`);
+  }
+  if (record.platform !== input.hostTarget.platform || record.arch !== input.hostTarget.arch) {
+    fail(
+      "target",
+      `${releaseArtifactId} does not target ${input.hostTarget.platform}/${input.hostTarget.arch}`,
+    );
+  }
+  return {
+    version: manifest.releaseVersion,
+    releaseArtifactId,
+    file: record.file,
+    bytes: record.bytes,
+    sha256: record.sha256,
+    manifestSha256,
+    releaseInputSha256: manifest.releaseInputSha256,
+    platform: input.hostTarget.platform,
+    arch: input.hostTarget.arch,
+    entry: MANAGED_SERVER_ENTRY,
+    launcherProtocol: SERVICE_LAUNCHER_PROTOCOL,
+  };
+}
