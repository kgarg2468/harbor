+`;
+const GOLDEN_SUMS = `bfe95af71fc00d76aa6d3587bc23f1ca91ad10b8b035cce8e42d948a02a93e51  managed-release.json
+bb2c21f987ec4d71b25daa099b33cea22a22f65ffb09de1fcc9a9609fa75119e  nightly.zip
+a281fd08f7099cf81a3771604adbbcdd249bd7151ffa70deaad7815918d73c20  reasoning.zip
+416e1222aee811facee745161a0e9553cf13764088b2d2c9d3648b9a9299d492  server-darwin-arm64.tar.gz
+9d05e7ed6624ed87a42f2ec049544d34fa31341804ad2ab11846b1df5500e6b0  server-linux-x64.tar.gz
+`;
+
+const DARWIN: ManagedServerTarget = { platform: "darwin", arch: "arm64" };
+const LINUX: ManagedServerTarget = { platform: "linux", arch: "x64", libc: "glibc" };
+const encoder = new TextEncoder();
+
+type Json = Record<string, any>;
+
+/** Re-signs a (possibly tampered) manifest so only the tampering, not the checksum file, is under test. */
+function signSums(manifestText: string): string {
+  const manifest = JSON.parse(manifestText) as Json;
+  const entries: Array<{ file: string; sha256: string }> = [
+    ...(manifest.artifacts as Array<Json>).map((artifact) => ({
+      file: artifact.file as string,
+      sha256: artifact.sha256 as string,
+    })),
+    { file: MANAGED_RELEASE_MANIFEST_FILE, sha256: sha256Hex(manifestText) },
+  ];
+  return entries
+    .sort((a, b) => (a.file < b.file ? -1 : a.file > b.file ? 1 : 0))
+    .map(({ file, sha256 }) => `${sha256}  ${file}\n`)
+    .join("");
+}
+
+function forged(mutate: (manifest: Json) => void): {
+  manifestBytes: Uint8Array;
+  sumsBytes: Uint8Array;
+} {
+  const manifest = JSON.parse(GOLDEN_MANIFEST) as Json;
+  mutate(manifest);
+  const manifestText = canonicalJson(manifest);
+  return {
+    manifestBytes: encoder.encode(manifestText),
+    sumsBytes: encoder.encode(signSums(manifestText)),
+  };
+}
+
+const verify = (input: {
+  manifestBytes?: Uint8Array;
+  sumsBytes?: Uint8Array;
+  targetVersion?: string;
+  hostTarget?: ManagedServerTarget;
+}) =>
+  verifyManagedReleaseDocuments({
+    manifestBytes: input.manifestBytes ?? encoder.encode(GOLDEN_MANIFEST),
+    sumsBytes: input.sumsBytes ?? encoder.encode(GOLDEN_SUMS),
+    targetVersion: input.targetVersion ?? GOLDEN_VERSION,
+    hostTarget: input.hostTarget ?? DARWIN,
+  });
+
+const rejection = (input: Parameters<typeof verify>[0]) =>
+  verify(input).pipe(
+    Effect.flip,
+    Effect.map((error: ManagedReleaseError) => ({
+      document: error.document,
+      reason: error.reason,
+    })),
+  );
+
+describe("verifyManagedReleaseDocuments", () => {
+  it.effect("accepts the golden Harbor release and selects the host's server archive", () =>
+    Effect.gen(function* () {
+      const darwin = yield* verify({ hostTarget: DARWIN });
+      assert.deepStrictEqual(darwin, {
+        version: GOLDEN_VERSION,
+        releaseArtifactId: "managed-server-darwin-arm64",
+        file: "server-darwin-arm64.tar.gz",
+        bytes: 14,
+        sha256: "416e1222aee811facee745161a0e9553cf13764088b2d2c9d3648b9a9299d492",
+        manifestSha256: "bfe95af71fc00d76aa6d3587bc23f1ca91ad10b8b035cce8e42d948a02a93e51",
+        releaseInputSha256: "6d1933416d7a35cfa4e8b130a6c6a7a47b58ce4301400ed841607e47515df18a",
+        platform: "darwin",
+        arch: "arm64",
+        entry: "node_modules/t3/dist/bin.mjs",
+        launcherProtocol: 2,
+      });
+      const linux = yield* verify({ hostTarget: LINUX });
+      assert.strictEqual(linux.releaseArtifactId, "managed-server-linux-x64");
+      assert.strictEqual(linux.file, "server-linux-x64.tar.gz");
+      assert.strictEqual(linux.bytes, 13);
+      assert.strictEqual(linux.platform, "linux");
+      assert.strictEqual(linux.arch, "x64");
+      assert.strictEqual(
+        managedArtifactContentId(darwin),
+        "managed-server-darwin-arm64@sha256:416e1222aee811facee745161a0e9553cf13764088b2d2c9d3648b9a9299d492",
+      );
+    }),
+  );
+
+  it("recomputes the release-input digest exactly as the Harbor resolver", () => {
+    const manifest = JSON.parse(GOLDEN_MANIFEST) as Json;
+    assert.strictEqual(
+      computeReleaseInputDigest({
+        upstreamRepository: manifest.upstreamRepository,
+        upstreamCommit: manifest.upstreamCommit,
+        upstreamVersion: manifest.upstreamVersion,
+        variants: {
+          "managed-nightly": manifest.variants["managed-nightly"].patches,
+          reasoning: manifest.variants.reasoning.patches,
+        },
+        builderRevision: manifest.builderRevision,
+        publicConfigSha256: manifest.publicConfigSha256,
+        presentationVariants: manifest.presentationVariants,
+      }),
+      manifest.releaseInputSha256,
+    );
+    assert.deepStrictEqual(parseManagedReleaseVersion(GOLDEN_VERSION), {
+      releaseVersion: GOLDEN_VERSION,
+      upstreamVersion: "0.0.38-nightly.20260905.3",
+      releaseCounter: 1,
+      releaseInputShort: "6d1933416d7a",
+    });
+    assert.isUndefined(
+      parseManagedReleaseVersion("0.0.38-nightly.20260905.3.managed.0.p6d1933416d7a"),
+    );
+    assert.isUndefined(parseManagedReleaseVersion("0.0.38-nightly.20260905.3"));
+    assert.isUndefined(parseManagedReleaseVersion("latest"));
+  });
+
+  it.effect("authenticates the original manifest bytes, not a reserialized object", () =>
+    Effect.gen(function* () {
+      // Same JSON value, different bytes: the golden checksum no longer covers it.
+      const reserialized = encoder.encode(JSON.stringify(JSON.parse(GOLDEN_MANIFEST)));
+      const mismatch = yield* rejection({ manifestBytes: reserialized });
+      assert.strictEqual(mismatch.document, "checksums");
+      assert.include(mismatch.reason, "manifest hash");
+      // The same bytes with a checksum file that covers them are fine.
+      const accepted = yield* verify({
+        manifestBytes: reserialized,
+        sumsBytes: encoder.encode(signSums(new TextDecoder().decode(reserialized))),
+      });
+      assert.strictEqual(accepted.version, GOLDEN_VERSION);
+      // A trailing byte is still a different document.
+      const appended = yield* rejection({ manifestBytes: encoder.encode(`${GOLDEN_MANIFEST}\n`) });
+      assert.strictEqual(appended.document, "checksums");
+    }),
+  );
+
+  it.effect("refuses digest inputs that were tampered with after resolution", () =>
+    Effect.gen(function* () {
+      const tampering: Array<[string, (manifest: Json) => void]> = [
+        ["repository", (m) => (m.upstreamRepository = "https://github.com/evil/t3code")],
+        [
+          "patch id",
+          (m) => {
+            m.variants["managed-nightly"].patches[0].id = "renamed";
+            m.variants.reasoning.patches[0].id = "renamed";
+          },
+        ],
+        ["patch hash", (m) => (m.variants.reasoning.patches[2].sha256 = "0".repeat(64))],
+        ["public config", (m) => (m.publicConfigSha256 = "1".repeat(64))],
+        ["builder revision", (m) => (m.builderRevision = "a".repeat(40))],
+        ["upstream commit", (m) => (m.upstreamCommit = "b".repeat(40))],
+      ];
+      for (const [label, mutate] of tampering) {
+        const result = yield* rejection(forged(mutate));
+        assert.strictEqual(result.document, "manifest", label);
+        assert.include(result.reason, "releaseInputSha256", label);
+      }
+      // Patch ids and hashes must agree on the common prefix; the identity suffix is required.
+      const prefix = yield* rejection(
+        forged((m) => (m.variants.reasoning.patches[0].sha256 = "2".repeat(64))),
+      );
+      assert.include(prefix.reason, "common prefix");
+      const suffix = yield* rejection(forged((m) => m.variants.reasoning.patches.pop()));
+      assert.include(suffix.reason, "identity patch");
+      const repeated = yield* rejection(
+        forged((m) => m.variants.reasoning.patches.push({ ...m.variants.reasoning.patches[2] })),
+      );
+      assert.include(repeated.reason, "repeats patch id");
+    }),
+  );
+
+  it.effect("requires exactly the four fixed artifacts with their fixed identities", () =>
+    Effect.gen(function* () {
+      const missing = yield* rejection(forged((m) => m.artifacts.splice(3, 1)));
+      assert.include(missing.reason, "missing artifact(s) managed-server-linux-x64");
+      const duplicate = yield* rejection(forged((m) => m.artifacts.push({ ...m.artifacts[2] })));
+      assert.include(duplicate.reason, "duplicate artifact");
+      const fifth = yield* rejection(
+        forged((m) => m.artifacts.push({ ...m.artifacts[3], id: "managed-server-windows-x64" })),
+      );
+      assert.include(fifth.reason, "outside the release set");
+      const platform = yield* rejection(forged((m) => (m.artifacts[3].platform = "darwin")));
+      assert.include(platform.reason, "platform must be");
+      const protocol = yield* rejection(forged((m) => (m.artifacts[2].launcherProtocol = 1)));
+      assert.include(protocol.reason, "launcherProtocol must be");
+      const entry = yield* rejection(
+        forged((m) => (m.artifacts[2].entry = "node_modules/t3/dist/evil.mjs")),
+      );
+      assert.include(entry.reason, "entry must be");
+      const version = yield* rejection(
+        forged(
+          (m) => (m.artifacts[2].version = "0.0.38-nightly.20260905.3.managed.2.p6d1933416d7a"),
+        ),
+      );
+      assert.include(version.reason, "version does not equal");
+      const embedded = yield* rejection(
+        forged((m) => (m.artifacts[0].embeddedServerVersion = "0.0.38-nightly.20260905.3")),
+      );
+      assert.include(embedded.reason, "embeddedServerVersion");
+      const url = yield* rejection(
+        forged((m) => (m.artifacts[2].url = "https://evil.example/server.tar.gz")),
+      );
+      assert.include(url.reason, "schema");
+      const extraTopLevel = yield* rejection(
+        forged((m) => (m.downloadBase = "https://evil.example/")),
+      );
+      assert.include(extraTopLevel.reason, "schema");
+      const schema = yield* rejection(forged((m) => (m.schemaVersion = 2)));
+      assert.include(schema.reason, "schema");
+      const bytes = yield* rejection(forged((m) => (m.artifacts[2].bytes = 0)));
+      assert.include(bytes.reason, "bytes");
+      const traversal = yield* rejection(forged((m) => (m.artifacts[2].file = "../server.tar.gz")));
+      assert.include(traversal.reason, "bare file name");
+      const extension = yield* rejection(forged((m) => (m.artifacts[2].file = "server.zip")));
+      assert.include(extension.reason, "must end with .tar.gz");
+      const reserved = yield* rejection(
+        forged((m) => {
+          m.artifacts[0].file = "SHA256SUMS.zip";
+          m.artifacts[1].file = "sha256sums.ZIP";
+        }),
+      );
+      assert.include(reserved.reason, "must end with .zip");
+      const collision = yield* rejection(forged((m) => (m.artifacts[1].file = "Nightly.zip")));
+      assert.include(collision.reason, "also used by");
+      const keys = yield* rejection(forged((m) => m.publicConfigKeys.push("T3CODE_SECRET")));
+      assert.include(keys.reason, "publicConfigKeys");
+    }),
+  );
+
+  it.effect("requires the manifest to name exactly the requested managed version", () =>
+    Effect.gen(function* () {
+      const other = yield* rejection({
+        targetVersion: "0.0.38-nightly.20260905.3.managed.2.p6d1933416d7a",
+      });
+      assert.strictEqual(other.document, "manifest");
+      assert.include(other.reason, "not the requested");
+      const malformed = yield* rejection({ targetVersion: "0.0.38-nightly.20260905.3" });
+      assert.strictEqual(malformed.document, "target");
+      const counterZero = yield* rejection({
+        targetVersion: "0.0.38-nightly.20260905.3.managed.0.p6d1933416d7a",
+      });
+      assert.strictEqual(counterZero.document, "target");
+      const range = yield* rejection({ targetVersion: "^0.0.38" });
+      assert.strictEqual(range.document, "target");
+      const counter = yield* rejection(forged((m) => (m.releaseCounter = 2)));
+      assert.include(counter.reason, "releaseCounter");
+      const upstream = yield* rejection(
+        forged((m) => (m.upstreamVersion = "0.0.38-nightly.20260905.4")),
+      );
+      assert.include(upstream.reason, "upstreamVersion");
+    }),
+  );
+
+  it.effect("requires a canonical five-line checksum closure", () =>
+    Effect.gen(function* () {
+      const lines = GOLDEN_SUMS.split("\n").filter((line) => line !== "");
+      const cases: Array<[string, string, string]> = [
+        ["missing line", `${lines.slice(0, 4).join("\n")}\n`, "expected exactly 5"],
+        ["extra line", `${GOLDEN_SUMS}${"0".repeat(64)}  zzz-extra.txt\n`, "expected exactly 5"],
+        ["duplicate", `${GOLDEN_SUMS}${lines[4]}\n`, "duplicate"],
+        ["unsorted", `${lines[1]}\n${lines[0]}\n${lines.slice(2).join("\n")}\n`, "sorted"],
+        ["traversal", `${GOLDEN_SUMS.replace("nightly.zip", "../nightly.zip")}`, "bare file name"],
+        ["no newline", GOLDEN_SUMS.slice(0, -1), "newline"],
+        ["uppercase hex", GOLDEN_SUMS.replace("bb2c21f9", "BB2C21F9"), "malformed line"],
+        [
+          "artifact hash",
+          GOLDEN_SUMS.replace("416e1222aee811fa", "416e1222aee811fb"),
+          "server-darwin-arm64.tar.gz disagrees",
+        ],
+        [
+          "manifest hash",
+          GOLDEN_SUMS.replace("bfe95af71fc00d76", "bfe95af71fc00d77"),
+          "manifest hash",
+        ],
+        [
+          "renamed artifact",
+          GOLDEN_SUMS.replace("  nightly.zip", "  nightly2.zip"),
+          "missing entry",
+        ],
+      ];
+      for (const [label, sums, expected] of cases) {
+        const result = yield* rejection({ sumsBytes: encoder.encode(sums) });
+        assert.strictEqual(result.document, "checksums", label);
+        assert.include(result.reason, expected, label);
+      }
+      const empty = yield* rejection({ sumsBytes: new Uint8Array() });
+      assert.strictEqual(empty.reason, "empty");
+      const invalidUtf8 = yield* rejection({ sumsBytes: new Uint8Array([0xff, 0xfe, 0x0a]) });
+      assert.include(invalidUtf8.reason, "UTF-8");
+    }),
+  );
+
+  it.effect("rejects manifests that are not bounded, well-formed JSON documents", () =>
+    Effect.gen(function* () {
+      const notJson = yield* rejection({ manifestBytes: encoder.encode("{") });
+      assert.include(notJson.reason, "JSON");
+      const invalidUtf8 = yield* rejection({ manifestBytes: new Uint8Array([0x7b, 0xff, 0x7d]) });
+      assert.include(invalidUtf8.reason, "UTF-8");
+      const empty = yield* rejection({ manifestBytes: new Uint8Array() });
+      assert.strictEqual(empty.reason, "empty");
+      const huge = yield* rejection({ manifestBytes: new Uint8Array(256 * 1024 + 1) });
+      assert.strictEqual(huge.reason, "too large");
+      const array = yield* rejection({ manifestBytes: encoder.encode("[]") });
+      assert.include(array.reason, "schema");
+    }),
+  );
+});
