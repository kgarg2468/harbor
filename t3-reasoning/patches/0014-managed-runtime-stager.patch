+      "urlSchemes": [
+        "t3code-reasoning"
+      ],
+      "variant": "reasoning",
+      "version": "0.0.38-nightly.20260905.3.managed.1.p6d1933416d7a"
+    },
+    {
+      "arch": "arm64",
+      "bytes": 14,
+      "entry": "node_modules/t3/dist/bin.mjs",
+      "file": "server-darwin-arm64.tar.gz",
+      "format": "tar.gz",
+      "id": "managed-server-darwin-arm64",
+      "kind": "server",
+      "launcherProtocol": 2,
+      "platform": "darwin",
+      "sha256": "416e1222aee811facee745161a0e9553cf13764088b2d2c9d3648b9a9299d492",
+      "variant": "common",
+      "version": "0.0.38-nightly.20260905.3.managed.1.p6d1933416d7a"
+    },
+    {
+      "arch": "x64",
+      "bytes": 13,
+      "entry": "node_modules/t3/dist/bin.mjs",
+      "file": "server-linux-x64.tar.gz",
+      "format": "tar.gz",
+      "id": "managed-server-linux-x64",
+      "kind": "server",
+      "launcherProtocol": 2,
+      "platform": "linux",
+      "sha256": "9d05e7ed6624ed87a42f2ec049544d34fa31341804ad2ab11846b1df5500e6b0",
+      "variant": "common",
+      "version": "0.0.38-nightly.20260905.3.managed.1.p6d1933416d7a"
+    }
+  ],
+  "builderRevision": "fedcba9876543210fedcba9876543210fedcba98",
+  "presentationVariants": {
+    "managed-nightly": "managed-nightly",
+    "reasoning": "reasoning"
+  },
+  "publicConfigKeys": [
+    "T3CODE_CLERK_CLI_OAUTH_CLIENT_ID",
+    "T3CODE_CLERK_JWT_TEMPLATE",
+    "T3CODE_CLERK_PUBLISHABLE_KEY",
+    "T3CODE_RELAY_URL"
+  ],
+  "publicConfigSha256": "2cee922b77e095709737110ab244615e0fe4230ace80231198c01a2cfb9b377e",
+  "releaseCounter": 1,
+  "releaseInputSha256": "6d1933416d7a35cfa4e8b130a6c6a7a47b58ce4301400ed841607e47515df18a",
+  "releaseVersion": "0.0.38-nightly.20260905.3.managed.1.p6d1933416d7a",
+  "schemaVersion": 1,
+  "upstreamCommit": "0123456789abcdef0123456789abcdef01234567",
