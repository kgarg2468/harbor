+    // Links resolve through the real layout.
+    assert.strictEqual(
+      await NodeFSP.readFile(at(`${PKG}/node_modules/effect/index.js`), "utf8"),
+      "export const effect = 1;\n",
+    );
+    assert.strictEqual(
+      await NodeFSP.readFile(at(`${effectDir}/dep/index.js`), "utf8"),
+      "module.exports = 2;\n",
+    );
+    assert.strictEqual(
+      await NodeFSP.readFile(at(`${PKG}/node_modules/.bin/t3`), "utf8"),
+      "#!/usr/bin/env node\n",
+    );
