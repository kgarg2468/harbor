+    const copy = await NodeFSP.stat(at(`${depDir}/copy.js`));
+    assert.strictEqual(copy.ino, original.ino);
+    assert.strictEqual(copy.nlink, 2);
+  });
+
+  it("accepts ./-prefixed names, hard link chains, and a bare node_modules directory", async () => {
+    const inventory = await extract(
+      gz(
+        tar([
+          member({ path: "./node_modules/" }),
+          member({ path: `./${PKG}/` }),
+          member({ path: `./${PKG}/package.json`, body: "{}" }),
+          member({ path: `./${PKG}/dist/bin.mjs`, body: "x", mode: 0o700 }),
+          member({ path: `${PKG}/a`, type: "Link", linkpath: `./${PKG}/dist/bin.mjs` }),
