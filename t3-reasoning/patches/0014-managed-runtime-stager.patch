+          "sha256": "ef37b0ce27427eb806b90275402cee27f4200619d6ca44a860623a455d8f7f79"
+        }
+      ]
+    },
+    "reasoning": {
+      "patches": [
+        {
+          "id": "common-one",
+          "sha256": "ec4eae78c5356aac8690e7c20970bd98284f4fbe4b54eb24933c7acf2a7b9e8a"
+        },
+        {
+          "id": "common-two",
+          "sha256": "ef37b0ce27427eb806b90275402cee27f4200619d6ca44a860623a455d8f7f79"
+        },
+        {
+          "id": "reasoning-identity",
+          "sha256": "3f72debee6fc10edb75cf331347684c769d350ace0d667d7ff1246ef5c1de450"
+        }
+      ]
+    }
