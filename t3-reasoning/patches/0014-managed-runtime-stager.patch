+    await extraction.createLinks();
+    await extraction.verifyTree(input.requiredFiles ?? DEFAULT_REQUIRED_ARCHIVE_FILES);
+    inventory = extraction.inventory(compressedBytes, expandedBytes);
+  } finally {
+    await archive.close();
+  }
+  // Closing the archive is the last asynchronous step; an abort that lands
+  // while it settles must still reject so the caller removes the destination.
+  signal?.throwIfAborted();
+  return inventory;
+}
+
+/**
+ * Extracts an authenticated archive into `destination`, which must not exist
+ * yet. Any failure or cancellation removes the destination again and leaves
+ * nothing else behind; the archive file itself is never touched.
+ */
+export async function extractManagedRuntimeArchive(
+  input: ExtractManagedRuntimeArchiveInput,
+): Promise<ExtractionInventory> {
+  const limits = { ...DEFAULT_MANAGED_RUNTIME_ARCHIVE_LIMITS, ...input.limits };
+  const signal = input.signal;
+  if (signal?.aborted) throw new ManagedRuntimeArchiveError({ reason: "extraction cancelled" });
+  try {
+    await NodeFSP.mkdir(input.destination, { mode: 0o700 });
+    await NodeFSP.chmod(input.destination, 0o700);
+  } catch (error) {
+    throw toArchiveError(error, "creating the destination");
+  }
+  try {
+    return await extractInto(input, limits, signal);
+  } catch (error) {
+    await NodeFSP.rm(input.destination, { recursive: true, force: true }).catch(() => {});
+    if (signal?.aborted) throw new ManagedRuntimeArchiveError({ reason: "extraction cancelled" });
+    throw toArchiveError(error, "extracting the archive");
+  }
+}
+
+/** Effect boundary: typed failure, and interruption aborts the extraction and waits for its cleanup. */
+export const extractManagedRuntimeArchiveEffect = Effect.fn(
+  "cloud.managed_runtime_archive.extract",
+)(function* (input: Omit<ExtractManagedRuntimeArchiveInput, "signal">) {
+  return yield* Effect.callback<ExtractionInventory, ManagedRuntimeArchiveError>(
+    (resume, signal) => {
+      const settled = extractManagedRuntimeArchive({ ...input, signal }).then(
+        (inventory) => resume(Effect.succeed(inventory)),
+        (error: unknown) =>
+          resume(isManagedRuntimeArchiveError(error) ? Effect.fail(error) : Effect.die(error)),
+      );
+      return Effect.promise(() => settled);
+    },
+  );
+});
