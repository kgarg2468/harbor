+function consumeEntry(entry: ReadEntry, write: (chunk: Buffer) => Promise<void>): Promise<void> {
+  return new Promise<void>((resolve, reject) => {
+    let chain = Promise.resolve();
+    let failed = false;
+    entry.once("error", (error: unknown) => {
+      failed = true;
+      reject(error);
+    });
+    entry.once("end", () => {
+      chain.then(resolve, reject);
+    });
+    entry.on("data", (chunk: Buffer) => {
+      if (failed) return;
+      entry.pause();
+      chain = chain
+        .then(() => write(chunk))
+        .then(
+          () => {
+            if (!failed) entry.resume();
+          },
+          (error: unknown) => {
+            failed = true;
+            reject(error);
+          },
+        );
+    });
+  });
