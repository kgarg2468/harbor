+
+// Build-owned identity: the Reasoning overlay replaces these fixed values.
+// Never derive this from overridable branding or appUserModelId settings.
+const MANAGED_PRESENTATION_IDENTITY: ManagedDesktopPresentationIdentity = Object.freeze({
+  presentationVariant: "managed-nightly",
+  bundleId: "com.t3tools.t3code",
+  productName: "T3 Code (Nightly)",
+  urlSchemes: Object.freeze(["t3code", "t3code-dev"]),
+});
+
+// Keep this exact managed grammar in sync with updates/updateChannels.ts.
+const SEMVER_NUMERIC = "(?:0|[1-9]\\d*)";
+const MANAGED_VERSION_PATTERN = new RegExp(
+  `^${SEMVER_NUMERIC}\\.${SEMVER_NUMERIC}\\.${SEMVER_NUMERIC}-nightly\\.[1-9]\\d{7}\\.${SEMVER_NUMERIC}` +
+    `\\.managed\\.(${SEMVER_NUMERIC})\\.p[0-9a-f]{12}$`,
+);
+
+function isExactManagedVersion(version: string): boolean {
+  const match = MANAGED_VERSION_PATTERN.exec(version);
+  if (match === null || match[0] !== version) return false;
+  const counter = Number(match[1]);
+  return Number.isSafeInteger(counter) && counter >= 1;
+}
