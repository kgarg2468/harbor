+
+const GitHubReleasePage = Schema.Array(GitHubRelease);
+
+const decodeRelease = Schema.decodeUnknownEffect(GitHubRelease);
+const decodeReleasePage = Schema.decodeUnknownEffect(GitHubReleasePage);
+
+/**
+ * Normalized identity of one release: everything that changes when its
+ * distribution changes, nothing that changes when its description is edited.
+ * Assets are in name order so two reads of the same release compare equal.
+ */
+interface ReleaseAssetDescriptor {
+  readonly id: number;
+  readonly name: string;
+  readonly state: "uploaded";
+  readonly size: number;
+  readonly digest: string | null;
+  readonly createdAt: string;
+  readonly updatedAt: string;
+}
+
+interface ReleaseDescriptor {
+  readonly releaseId: number;
+  readonly tag: string;
+  readonly version: string;
+  readonly draft: false;
+  readonly prerelease: true;
+  readonly publishedAt: string;
+  readonly githubImmutable: boolean;
+  readonly assets: ReadonlyArray<ReleaseAssetDescriptor>;
+}
+
+// --- errors ---------------------------------------------------------------------------
+
+const isSourceError = Schema.is(ManagedArtifactSourceError);
+
+function sourceError(reason: string, cause?: unknown): ManagedArtifactSourceError {
+  return new ManagedArtifactSourceError({
+    reason,
+    ...(cause === undefined ? {} : { cause }),
+  });
+}
+
+function fail(reason: string): never {
+  throw sourceError(reason);
+}
+
+/** Runs a synchronous validator, moving its typed refusals into the error channel. */
+function attempt<A>(evaluate: () => A): Effect.Effect<A, ManagedArtifactSourceError> {
+  return Effect.suspend(() => {
+    try {
+      return Effect.succeed(evaluate());
+    } catch (error) {
+      return isSourceError(error) ? Effect.fail(error) : Effect.die(error);
+    }
+  });
+}
+
+/** The tags of a foreign failure, never its message: HTTP client messages carry the request URL, which for an archive hop is a signed object-store link. */
+function failureTag(error: unknown): string {
+  if (
+    typeof error !== "object" ||
+    error === null ||
+    !("_tag" in error) ||
+    typeof error._tag !== "string"
+  ) {
+    return "unexpected failure";
+  }
+  const reason = "reason" in error ? error.reason : undefined;
+  const reasonTag =
+    typeof reason === "object" &&
+    reason !== null &&
+    "_tag" in reason &&
+    typeof reason._tag === "string"
+      ? ` (${reason._tag})`
+      : "";
