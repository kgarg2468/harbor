+describe("makeGitHubManagedReleaseFeed pagination", () => {
+  const listWithLink = (link: string) => {
+    const { fake, feed } = makeFake({ pageSize: 1, releases: [goldenRelease(), goldenRelease()] });
+    fake.intercept = (_request, url) =>
+      url.pathname === RELEASES_PATH && url.searchParams.get("page") === "1"
+        ? Response.json([], { headers: { link } })
+        : undefined;
+    return { fake, latest: Effect.flatMap(feed, (feed) => feed.latest) };
+  };
+
+  it.effect("continues only through a next link that names the fixed endpoint's next page", () =>
+    Effect.gen(function* () {
+      const accepted = [
+        `<${PAGE(2)}>; rel="next"`,
+        `<${PAGE(2)}>; REL=Next`,
+        `<${PAGE(2)}>; rel="prev next"`,
+        `<${PAGE(2)}>; rel="NEXT"`,
+        `<${PAGE(2)}>; rel="first  next"`,
+        `<${PAGE(2)}>; rel="Prev NEXT Last"`,
+        `<${PAGE(1)}>; rel="prev", <${PAGE(2)}>; rel="next"; title="a, b; c", <${PAGE(2)}>; rel="last"`,
+        `<${API}?page=2&per_page=100>; rel="next"`,
+      ];
+      for (const link of accepted) {
+        const { fake, latest } = listWithLink(link);
+        assert.strictEqual((yield* latest)?.version, GOLDEN_VERSION, link);
+        assert.strictEqual(fake.requests[1]?.url, PAGE(2), link);
+      }
+
+      const final = [
+        `<${PAGE(1)}>; rel="prev"`,
+        `<${PAGE(1)}>; rel="first", <${PAGE(1)}>; rel="last"`,
+        `<${PAGE(1)}>; rel="prev first"; title="urn:example:next"`,
+        "",
+      ];
+      for (const link of final) {
+        const { fake, latest } = listWithLink(link);
+        assert.isUndefined(yield* latest, link);
+        assert.deepStrictEqual(urlsOf(fake), [PAGE(1)], link);
+      }
+    }),
+  );
+
+  it.effect("refuses malformed or out-of-policy continuations instead of stopping early", () =>
+    Effect.gen(function* () {
+      const refused: Array<[string, string]> = [
+        [`<${PAGE(3)}>; rel="next"`, "outside the fixed releases endpoint"],
+        [`<${API}?per_page=50&page=2>; rel="next"`, "outside the fixed releases endpoint"],
+        [`<${API}?per_page=100&page=2&extra=1>; rel="next"`, "outside the fixed releases endpoint"],
+        [
+          `<http://api.github.com${RELEASES_PATH}?per_page=100&page=2>; rel="next"`,
+          "outside the fixed",
+        ],
+        [
+          `<https://evil.example${RELEASES_PATH}?per_page=100&page=2>; rel="next"`,
+          "outside the fixed",
+        ],
+        [
+          `<https://user:pw${"@"}api.github.com${RELEASES_PATH}?per_page=100&page=2>; rel="next"`,
+          "outside",
+        ],
+        [`<${PAGE(2)}#fragment>; rel="next"`, "outside the fixed releases endpoint"],
+        [`<${API}/latest?per_page=100&page=2>; rel="next"`, "outside the fixed releases endpoint"],
+        [`<${PAGE(2)}>; rel="next", <${PAGE(2)}>; rel="next"`, "several next pages"],
+        [`<${PAGE(2)}>; rel="prev"; rel="next"`, "repeats a rel parameter"],
+        [`<${PAGE(1)}>; rel="prev", rel=next`, "Link header is malformed"],
+        [`<${PAGE(2)}> rel="next"`, "Link header is malformed"],
+        [`<${PAGE(2)}>; rel="next`, "Link header is malformed"],
+        [`<${PAGE(2)}>; rel=`, "Link header is malformed"],
+        [`<${PAGE(2)}>; ; rel="next"`, "Link header is malformed"],
+        [`<${PAGE(2)}; rel="next"`, "Link header is malformed"],
+        [`${PAGE(2)}; rel="next"`, "Link header is malformed"],
+        [`<not a url>; rel="next"`, "Link next URL is malformed"],
+        [`<${PAGE(2)}>; rel="next"; title="${"x".repeat(9000)}"`, "Link header is too long"],
+        [`<${PAGE(2)}>; rel=""`, "malformed rel value"],
+        [`<${PAGE(2)}>; rel="   "`, "malformed rel value"],
+        [`<${PAGE(2)}>; rel=" next"`, "malformed rel value"],
+        [`<${PAGE(2)}>; rel="next "`, "malformed rel value"],
+        // The supported subset is next, prev, first and last. Anything else,
+        // whether a registered name, an extension URI or a value this module
+        // cannot classify, is refused rather than treated as "no next page",
+        // even when it sits beside a valid next relation.
+        [`<${PAGE(2)}>; rel="alternate"`, "unsupported rel value"],
+        [`<${PAGE(2)}>; rel="next alternate"`, "unsupported rel value"],
+        [`<${PAGE(2)}>; rel=next.page`, "unsupported rel value"],
+        [`<${PAGE(2)}>; rel="https://example.com/rel/next"`, "unsupported rel value"],
+        [`<${PAGE(2)}>; rel="https://example.com/rel?x=1#next next"`, "unsupported rel value"],
+        [`<${PAGE(2)}>; rel="next urn:example:paging"`, "unsupported rel value"],
+        [`<${PAGE(2)}>; rel="prev urn:example:next"`, "unsupported rel value"],
+        [`<${PAGE(2)}>; rel="next:#a#b"`, "unsupported rel value"],
+        [`<${PAGE(2)}>; rel="next:["`, "unsupported rel value"],
+        [`<${PAGE(2)}>; rel="next,"`, "unsupported rel value"],
+        [`<${PAGE(2)}>; rel="prev,next"`, "unsupported rel value"],
+        [`<${PAGE(2)}>; rel="prev\tnext"`, "unsupported rel value"],
+        [`<${PAGE(2)}>; rel=next!`, "unsupported rel value"],
+        [`<${PAGE(2)}>; rel="-next"`, "unsupported rel value"],
+        [`<${PAGE(2)}>; rel="next example.com/rel"`, "unsupported rel value"],
+        [`<${PAGE(2)}>; rel="next https://example.com/\\"x"`, "unsupported rel value"],
+        [`<${PAGE(2)}>; rel="prev", <${PAGE(1)}>; rel="first,"`, "unsupported rel value"],
+      ];
+      for (const [link, expected] of refused) {
+        const { fake, latest } = listWithLink(link);
+        assert.include(yield* reasonOf(latest), expected, link);
+        assert.deepStrictEqual(urlsOf(fake), [PAGE(1)], link);
+      }
+    }),
+  );
+
+  it.effect("fails past the page cap rather than returning a possibly stale maximum", () =>
+    Effect.gen(function* () {
+      const { fake, feed } = makeFake({});
+      fake.intercept = (_request, url) => {
+        if (url.pathname !== RELEASES_PATH) return undefined;
+        const page = Number(url.searchParams.get("page"));
+        return Response.json([], { headers: { link: `<${PAGE(page + 1)}>; rel="next"` } });
+      };
+      const reason = yield* reasonOf(Effect.flatMap(feed, (feed) => feed.latest));
+      assert.include(reason, "listing releases page 50: the repository has more than 50 pages");
+      assert.strictEqual(fake.requests.length, 50);
+      assert.strictEqual(fake.requests[49]?.url, PAGE(50));
+    }),
+  );
+});
