+/** Only an identity-encoded, well-formed `Content-Length` is an early check; anything else defers to the streamed count. */
+function declaredContentLength(headers: HttpClientResponse.HttpClientResponse["headers"]) {
+  const encoding = headers["content-encoding"];
+  if (encoding !== undefined && encoding.trim().toLowerCase() !== "identity") return undefined;
+  const value = headers["content-length"];
+  if (value === undefined || !DIGITS_RE.test(value.trim())) return undefined;
+  const length = Number(value.trim());
+  return Number.isSafeInteger(length) ? length : undefined;
