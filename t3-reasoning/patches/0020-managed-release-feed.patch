+    fail(`${phase}: Link next URL is outside the fixed releases endpoint`);
+  }
+  return expectedPage;
+}
+
+function releasesPageUrl(page: number): string {
+  return `${RELEASES_URL}?per_page=${RELEASES_PER_PAGE}&page=${page}`;
+}
+
+function releaseByTagUrl(version: string): string {
+  return `${RELEASES_URL}/tags/${encodeURIComponent(managedTag(version))}`;
+}
+
+function assetUrl(assetId: number): string {
+  return `${RELEASES_URL}/assets/${assetId}`;
+}
+
+/** Reads the already-verified checksum file's names; the verifier has proven its shape. */
+function sumsEntries(sumsBytes: Uint8Array): ReadonlyMap<string, string> {
+  const text = new TextDecoder("utf-8", { fatal: true }).decode(sumsBytes);
+  const entries = new Map<string, string>();
+  for (const line of text.slice(0, -1).split("\n")) {
+    const match = SUMS_LINE_RE.exec(line);
+    if (match === null) fail("reading the verified checksum file: unexpected line");
+    entries.set(match[2] as string, match[1] as string);
+  }
+  return entries;
+}
+
+const VERIFIED_ASSET_KEYS = [
+  "version",
+  "releaseArtifactId",
+  "file",
+  "bytes",
+  "sha256",
+  "manifestSha256",
+  "releaseInputSha256",
+  "platform",
+  "arch",
+  "entry",
+  "launcherProtocol",
+] as const satisfies ReadonlyArray<keyof VerifiedManagedServerAsset>;
+
+function sameVerifiedAsset(a: VerifiedManagedServerAsset, b: VerifiedManagedServerAsset): boolean {
+  return VERIFIED_ASSET_KEYS.every((key) => a[key] === b[key]);
