+   * malformed, incomplete or moved highest release is an error, never a
+   * downgrade to the previous version.
+   */
+  readonly latest: Effect.Effect<ManagedReleaseSelection | undefined, ManagedArtifactSourceError>;
+  /**
+   * Resolves exactly the supplied managed version through its exact tag and
+   * never consults "latest". Exists so a durable queue target restored after a
+   * process restart is re-resolved as the same version.
+   */
+  readonly resolve: (
+    exactVersion: string,
+  ) => Effect.Effect<ManagedReleaseSelection, ManagedArtifactSourceError>;
