+    url.protocol !== "https:" ||
+    url.origin !== API_ORIGIN ||
+    url.username !== "" ||
+    url.password !== "" ||
+    url.hash !== "" ||
+    url.pathname !== RELEASES_PATH ||
+    params.length !== 2 ||
+    params[0]?.[0] !== "page" ||
+    params[0]?.[1] !== String(expectedPage) ||
+    params[1]?.[0] !== "per_page" ||
+    params[1]?.[1] !== String(RELEASES_PER_PAGE)
