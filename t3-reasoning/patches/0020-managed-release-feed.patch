+/** 403/429 carry GitHub's rate-limit metadata; only digit-string values are echoed. */
+function statusReason(status: number, headers: HttpClientResponse.HttpClientResponse["headers"]) {
+  if (status !== 403 && status !== 429) return `GitHub returned HTTP ${status}`;
+  const details = (["x-ratelimit-remaining", "x-ratelimit-reset", "retry-after"] as const).flatMap(
+    (name) => {
+      const value = headers[name]?.trim();
+      return value !== undefined && DIGITS_RE.test(value) ? [`${name}=${value}`] : [];
+    },
+  );
+  return details.length === 0
+    ? `GitHub returned HTTP ${status} (rate limited or forbidden)`
+    : `GitHub returned HTTP ${status} (${details.join(", ")})`;
