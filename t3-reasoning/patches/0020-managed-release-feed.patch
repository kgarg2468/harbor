+}
+
+function toSourceError(phase: string, error: unknown): ManagedArtifactSourceError {
+  return isSourceError(error) ? error : sourceError(`${phase}: ${failureTag(error)}`, error);
+}
+
+const quote = (value: string): string => JSON.stringify(value);
+
+// --- validation -----------------------------------------------------------------------
+
+function positiveSafeInteger(value: number, label: string): number {
+  if (!Number.isSafeInteger(value) || value < 1) {
+    fail(`${label} must be a positive safe integer`);
+  }
+  return value;
+}
+
+function timestamp(value: string, label: string): string {
+  if (Option.isNone(DateTime.make(value))) fail(`${label} is not a valid timestamp`);
+  return value;
+}
+
+/** The same bare-name rule the release documents apply to their own file names. */
+function bareAssetName(name: string, label: string): string {
+  if (
+    name === "" ||
+    name === "." ||
+    name === ".." ||
+    name.includes("/") ||
+    name.includes("\\") ||
+    /[\p{Cc}]/u.test(name) ||
+    name.startsWith("-") ||
+    name.trim() !== name
+  ) {
+    fail(`${label}: asset name ${quote(name)} is not a bare file name`);
+  }
+  return name;
+}
+
+function assetDigest(value: string | null | undefined, label: string): string | null {
+  if (value === null || value === undefined) return null;
+  if (!ASSET_DIGEST_RE.test(value)) fail(`${label}: asset digest is not sha256:<64 lowercase hex>`);
+  return value;
+}
+
+/** The managed version a tag names, or undefined when the tag is not exactly `t3-managed-v<managed version>`. */
+function managedVersionOfTag(tag: string): string | undefined {
+  if (!tag.startsWith(MANAGED_RELEASE_TAG_PREFIX)) return undefined;
+  const version = tag.slice(MANAGED_RELEASE_TAG_PREFIX.length);
+  if (parseManagedReleaseVersion(version) === undefined) return undefined;
+  return `${MANAGED_RELEASE_TAG_PREFIX}${version}` === tag ? version : undefined;
+}
+
+function managedTag(version: string): string {
+  return `${MANAGED_RELEASE_TAG_PREFIX}${version}`;
+}
+
+/** The managed version a listed release publishes, or undefined when the publication or tag rules make it a non-candidate the listing ignores. */
+function candidateVersion(raw: GitHubRelease): string | undefined {
+  if (raw.draft !== false || raw.prerelease !== true || raw.published_at === null) return undefined;
+  if (Option.isNone(DateTime.make(raw.published_at))) return undefined;
+  return managedVersionOfTag(raw.tag_name);
+}
+
+/** Full descriptor normalization; every refusal names the release. */
+function normalizeRelease(raw: GitHubRelease): ReleaseDescriptor {
+  const releaseId = positiveSafeInteger(raw.id, "release id");
+  const label = `release ${releaseId} (${quote(raw.tag_name)})`;
+  if (raw.draft !== false) fail(`${label} is a draft`);
+  if (raw.prerelease !== true) fail(`${label} is not a prerelease`);
+  if (raw.published_at === null) fail(`${label} is not published`);
+  const publishedAt = timestamp(raw.published_at, `${label}: published_at`);
+  const version = managedVersionOfTag(raw.tag_name);
+  if (version === undefined) fail(`${label}: tag is not a managed release tag`);
+
+  const ids = new Set<number>();
+  const names = new Set<string>();
+  const assets = raw.assets.map((asset): ReleaseAssetDescriptor => {
+    const id = positiveSafeInteger(asset.id, `${label}: asset id`);
+    const assetLabel = `${label}: asset ${id}`;
+    const name = bareAssetName(asset.name, assetLabel);
+    if (asset.state !== "uploaded") fail(`${assetLabel} (${name}) is not uploaded`);
+    if (ids.has(id)) fail(`${assetLabel} appears twice`);
+    if (names.has(name)) fail(`${assetLabel}: asset name ${name} appears twice`);
+    ids.add(id);
+    names.add(name);
+    return {
+      id,
+      name,
+      state: "uploaded",
+      size: positiveSafeInteger(asset.size, `${assetLabel} (${name}): size`),
+      digest: assetDigest(asset.digest, `${assetLabel} (${name})`),
+      createdAt: timestamp(asset.created_at, `${assetLabel} (${name}): created_at`),
+      updatedAt: timestamp(asset.updated_at, `${assetLabel} (${name}): updated_at`),
+    };
+  });
+  assets.sort((a, b) => (a.name < b.name ? -1 : 1));
+  return {
+    releaseId,
+    tag: raw.tag_name,
+    version,
+    draft: false,
+    prerelease: true,
+    publishedAt,
+    githubImmutable: raw.immutable ?? false,
+    assets,
+  };
+}
+
+/** Equal keys mean equal normalized descriptors; field order is fixed by the constructors above. */
+function descriptorKey(descriptor: ReleaseDescriptor): string {
+  return JSON.stringify(descriptor);
+}
+
+function decodeUtf8Strict(bytes: Uint8Array, phase: string): string {
+  try {
+    return new TextDecoder("utf-8", { fatal: true, ignoreBOM: true }).decode(bytes);
+  } catch {
+    return fail(`${phase}: response is not valid UTF-8`);
+  }
+}
+
+/** Strict UTF-8 then JSON; the shape is decoded by the caller's schema. Neither error carries body text. */
+function parseJson(bytes: Uint8Array, phase: string): unknown {
+  const text = decodeUtf8Strict(bytes, phase);
+  try {
+    return JSON.parse(text) as unknown;
+  } catch {
+    return fail(`${phase}: response is not valid JSON`);
+  }
+}
