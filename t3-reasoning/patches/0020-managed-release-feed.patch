+      readonly descriptor: ReleaseDescriptor;
+      readonly verified: VerifiedManagedServerAsset;
+      readonly serverAsset: ReleaseAssetDescriptor;
+      readonly manifestBytes: Uint8Array;
+      readonly sumsBytes: Uint8Array;
