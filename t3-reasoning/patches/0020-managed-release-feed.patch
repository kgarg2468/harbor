+
+interface RecordedRequest {
+  readonly url: string;
+  readonly method: string;
+  readonly headers: Record<string, string>;
+  readonly signal: AbortSignal;
+  readonly redirect: string | undefined;
+}
+
+function streamResponse(
+  chunks: ReadonlyArray<Uint8Array>,
+  init?: { readonly status?: number; readonly headers?: Record<string, string> },
+): Response {
+  const body = new ReadableStream<Uint8Array>({
+    start(controller) {
+      for (const chunk of chunks) controller.enqueue(chunk);
+      controller.close();
+    },
+  });
+  return new Response(body, { status: init?.status ?? 200, headers: init?.headers ?? {} });
+}
+
+const bytesResponse = (bytes: Uint8Array, headers?: Record<string, string>) =>
+  streamResponse([bytes], { headers: { "content-length": String(bytes.byteLength), ...headers } });
+
+const notFound = () => Response.json({ message: "Not Found" }, { status: 404 });
+
+/**
+ * A body that never ends: `prefix` chunks are readable at once, the next read
+ * stays pending forever and opens `pulled` when it starts. Cancellation and
+ * abort are counted so a test can prove the request scope really closed.
+ */
+function hangingBody(options: {
+  readonly signal: AbortSignal;
+  readonly pulled: Latch.Latch;
+  readonly cancels: { count: number };
+  readonly prefix?: ReadonlyArray<Uint8Array>;
+}): ReadableStream<Uint8Array> {
+  return new ReadableStream<Uint8Array>(
+    {
+      start(controller) {
+        for (const chunk of options.prefix ?? []) controller.enqueue(chunk);
+        options.signal.addEventListener("abort", () => {
+          try {
+            controller.error(new Error("aborted"));
+          } catch {
+            // already closed by cancellation
+          }
+        });
+      },
+      pull() {
+        options.pulled.openUnsafe();
+        return new Promise<void>(() => {});
+      },
+      cancel() {
+        options.cancels.count += 1;
+      },
+    },
+    { highWaterMark: 0 },
+  );
+}
+
+interface FakeGitHub {
+  readonly releases: Array<FakeRelease>;
+  pageSize: number;
+  readonly requests: Array<RecordedRequest>;
+  /** Runs before routing; may mutate the model or return a response that replaces the routed one. */
+  intercept: (request: RecordedRequest, url: URL) => Response | undefined;
+  assetResponse: (asset: FakeAsset, request: RecordedRequest) => Response;
+  /** Requests this accepts are recorded and then never answered. */
+  pending: (url: URL) => boolean;
+}
+
+function makeFake(input: { readonly releases?: Array<FakeRelease>; readonly pageSize?: number }) {
+  const fake: FakeGitHub = {
+    releases: input.releases ?? [],
+    pageSize: input.pageSize ?? 100,
+    requests: [],
+    intercept: () => undefined,
+    assetResponse: (asset) => bytesResponse(asset.bytes),
+    pending: () => false,
+  };
+
+  const route = (url: URL, record: RecordedRequest): Response => {
+    const intercepted = fake.intercept(record, url);
+    if (intercepted !== undefined) return intercepted;
+    if (url.origin !== API_ORIGIN) return notFound();
+    const path = url.pathname;
+    if (path === RELEASES_PATH) {
+      if (url.searchParams.get("per_page") !== "100") return notFound();
+      const page = Number(url.searchParams.get("page") ?? "1");
+      const start = (page - 1) * fake.pageSize;
+      const slice = fake.releases.slice(start, start + fake.pageSize);
+      const lastPage = Math.max(1, Math.ceil(fake.releases.length / fake.pageSize));
+      const links: Array<string> = [];
+      if (page > 1) links.push(`<${PAGE(page - 1)}>; rel="prev"`, `<${PAGE(1)}>; rel="first"`);
+      if (page < lastPage) {
+        links.push(`<${PAGE(page + 1)}>; rel="next"`, `<${PAGE(lastPage)}>; rel="last"`);
+      }
+      return Response.json(
+        slice.map(releaseJson),
+        links.length === 0 ? undefined : { headers: { link: links.join(", ") } },
+      );
+    }
+    const tagsPrefix = `${RELEASES_PATH}/tags/`;
+    if (path.startsWith(tagsPrefix)) {
+      const tag = decodeURIComponent(path.slice(tagsPrefix.length));
+      const release = fake.releases.find((candidate) => candidate.tag_name === tag);
+      return release === undefined ? notFound() : Response.json(releaseJson(release));
+    }
+    const assetsPrefix = `${RELEASES_PATH}/assets/`;
+    if (path.startsWith(assetsPrefix)) {
+      const id = Number(path.slice(assetsPrefix.length));
+      const asset = fake.releases
+        .flatMap((release) => release.assets)
+        .find((candidate) => candidate.id === id);
+      if (asset === undefined) return notFound();
+      if (record.headers.accept !== "application/octet-stream") {
+        return Response.json(assetJson(asset));
+      }
+      return fake.assetResponse(asset, record);
+    }
+    return notFound();
+  };
+
+  const client = HttpClient.make((request, url, signal) =>
+    Effect.flatMap(Effect.serviceOption(FetchHttpClient.RequestInit), (init) => {
+      const record: RecordedRequest = {
+        url: url.toString(),
+        method: request.method,
+        headers: Object.fromEntries(Object.entries(request.headers)),
+        signal,
+        redirect: Option.getOrUndefined(init)?.redirect,
+      };
+      fake.requests.push(record);
+      if (fake.pending(url)) return Effect.never;
+      return Effect.succeed(HttpClientResponse.fromWeb(request, route(url, record)));
+    }),
+  );
+
+  const feed: Effect.Effect<ManagedReleaseFeed> = makeGitHubManagedReleaseFeed({
+    hostTarget: DARWIN,
+  }).pipe(Effect.provideService(HttpClient.HttpClient, client));
+
+  return { fake, feed };
+}
+
+const urlsOf = (fake: FakeGitHub) => fake.requests.map((request) => request.url);
+
+const reasonOf = <A>(effect: Effect.Effect<A, ManagedArtifactSourceError>) =>
+  effect.pipe(
+    Effect.flip,
+    Effect.map((error) => {
+      assert.strictEqual(error._tag, "ManagedArtifactSourceError");
+      return error.reason;
+    }),
+  );
+
+/** Applies `mutate` to the golden release the first time its tag endpoint is read. */
+function latestWithTagMutation(mutate: (release: FakeRelease) => void) {
+  const release = goldenRelease();
+  const { fake, feed } = makeFake({ releases: [release] });
+  let applied = false;
+  fake.intercept = (_request, url) => {
+    if (!applied && url.pathname.includes("/tags/")) {
+      applied = true;
+      mutate(release);
+    }
+    return undefined;
+  };
+  return { fake, latest: Effect.flatMap(feed, (feed) => feed.latest) };
+}
+
+/** Selects the golden release, then hands back a fake whose only later requests belong to the archive. */
+const selectGolden = Effect.fn(function* (input?: {
+  readonly assetResponse?: FakeGitHub["assetResponse"];
+  readonly intercept?: FakeGitHub["intercept"];
+}) {
+  const release = goldenRelease();
+  const { fake, feed: makeFeed } = makeFake({ releases: [release] });
+  const feed = yield* makeFeed;
+  const selection = yield* feed.resolve(GOLDEN_VERSION);
+  const verified = yield* verifiedGolden;
+  fake.requests.length = 0;
+  if (input?.assetResponse) fake.assetResponse = input.assetResponse;
+  if (input?.intercept) fake.intercept = input.intercept;
+  return { fake, feed, release, selection, verified };
+});
