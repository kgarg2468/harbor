+// --- GitHub schema -----------------------------------------------------------------
+
+/** Only the identity fields; every other GitHub field, including any URL, is ignored. */
+const GitHubAsset = Schema.Struct({
+  id: Schema.Number,
+  name: Schema.String,
+  state: Schema.String,
+  size: Schema.Number,
+  digest: Schema.optional(Schema.NullOr(Schema.String)),
+  created_at: Schema.String,
+  updated_at: Schema.String,
+});
