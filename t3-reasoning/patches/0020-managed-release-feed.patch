+
+// --- Link header ------------------------------------------------------------------------
+
+/** Splits on `separator` outside `<...>` and quoted strings; unbalanced nesting is undefined. */
+function splitOutsideQuotes(value: string, separator: "," | ";"): Array<string> | undefined {
+  const parts: Array<string> = [];
+  let current = "";
+  let inAngle = false;
+  let inQuote = false;
+  for (let index = 0; index < value.length; index += 1) {
+    const char = value[index] as string;
+    if (inQuote) {
+      current += char;
+      if (char === "\\") {
+        index += 1;
+        if (index >= value.length) return undefined;
+        current += value[index];
+      } else if (char === '"') {
+        inQuote = false;
+      }
+      continue;
+    }
+    if (inAngle) {
+      if (char === "<") return undefined;
+      if (char === ">") inAngle = false;
+      current += char;
+      continue;
+    }
+    if (char === '"') inQuote = true;
+    else if (char === "<") inAngle = true;
+    else if (char === ">") return undefined;
+    else if (char === separator) {
+      parts.push(current);
+      current = "";
+      continue;
+    }
+    current += char;
+  }
+  if (inQuote || inAngle) return undefined;
+  parts.push(current);
+  return parts;
+}
+
+/**
+ * Relation names of one `rel` value, lowercased. The framing follows RFC 8288
+ * section 3.3: one relation name as a token, or a quoted-string of names
+ * separated by one or more spaces. Every name must be in
+ * `SUPPORTED_RELATIONS`; an empty or space-padded list is malformed and any
+ * other name, registered or extension URI, is unsupported. Both are refusals.
+ */
+function relationTypes(value: string, phase: string): ReadonlyArray<string> {
+  const parts = value.startsWith('"')
+    ? value.slice(1, -1).replace(/\\(.)/g, "$1").split(/ +/)
+    : [value];
+  return parts.map((part) => {
+    if (part === "") fail(`${phase}: Link header has a malformed rel value`);
+    const name = part.toLowerCase();
+    if (!SUPPORTED_RELATIONS.has(name)) {
+      fail(`${phase}: Link header has an unsupported rel value`);
+    }
+    return name;
+  });
+}
+
+/**
+ * Parses the whole `Link` field strictly and returns the URI-reference of its
+ * one `rel="next"` link-value, or undefined when no link-value has a next
+ * relation. Malformed syntax, a repeated `rel` parameter, a relation outside
+ * the supported navigation subset, and several next link-values are refusals:
+ * a continuation this parser cannot fully read is an error, never the end of
+ * the listing.
+ */
+function nextLinkTarget(link: string, phase: string): string | undefined {
+  const malformed = `${phase}: Link header is malformed`;
+  if (link.length > MAX_LINK_HEADER_LENGTH) fail(`${phase}: Link header is too long`);
+  const linkValues = splitOutsideQuotes(link, ",");
+  if (linkValues === undefined) fail(malformed);
+  let next: string | undefined;
+  for (const rawLinkValue of linkValues) {
+    const linkValue = rawLinkValue.trim();
+    if (linkValue === "") continue;
+    const close = linkValue.indexOf(">");
+    if (!linkValue.startsWith("<") || close === -1) fail(malformed);
+    const target = linkValue.slice(1, close);
+    const params = splitOutsideQuotes(linkValue.slice(close + 1), ";");
+    if (params === undefined || params[0]?.trim() !== "") fail(malformed);
+    let rel: string | undefined;
+    for (const param of params.slice(1)) {
+      const match = LINK_PARAM_RE.exec(param.trim());
+      if (match === null) fail(malformed);
+      if ((match[1] as string).toLowerCase() !== "rel") continue;
+      if (rel !== undefined) fail(`${phase}: Link header repeats a rel parameter`);
+      rel = match[2] as string;
+    }
+    if (rel === undefined) continue;
+    if (!relationTypes(rel, phase).includes("next")) continue;
+    if (next !== undefined) fail(`${phase}: Link header names several next pages`);
+    next = target;
+  }
+  return next;
+}
+
+/**
+ * The only continuation accepted from a `Link` header: one `rel="next"` whose
+ * URL is exactly the fixed releases endpoint on the next page. The returned
+ * page number is then used to build the URL locally; the header's URL itself
+ * is never fetched.
+ */
+function nextPageFromLink(link: string | undefined, current: number): number | undefined {
+  if (link === undefined) return undefined;
+  const phase = `listing releases page ${current}`;
+  const target = nextLinkTarget(link, phase);
+  if (target === undefined) return undefined;
+  let url: URL;
+  try {
+    url = new URL(target);
+  } catch {
+    return fail(`${phase}: Link next URL is malformed`);
+  }
+  const expectedPage = current + 1;
+  const params = [...url.searchParams.entries()].sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0));
