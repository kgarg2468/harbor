+interface Documents {
+  readonly version: string;
+  readonly manifest: Uint8Array;
+  readonly sums: Uint8Array;
+}
+
+function signSums(manifestText: string): string {
+  const manifest = JSON.parse(manifestText) as Json;
+  const entries: Array<{ file: string; sha256: string }> = [
+    ...(manifest.artifacts as Array<Json>).map((artifact) => ({
+      file: artifact.file as string,
+      sha256: artifact.sha256 as string,
+    })),
+    { file: MANAGED_RELEASE_MANIFEST_FILE, sha256: sha256Hex(manifestText) },
+  ];
+  return entries
+    .sort((a, b) => (a.file < b.file ? -1 : a.file > b.file ? 1 : 0))
+    .map(({ file, sha256 }) => `${sha256}  ${file}\n`)
+    .join("");
+}
+
+/** Counter 1 is the golden release byte for byte; other counters are the same provenance re-signed under their own version. */
+function documentsForCounter(counter: number): Documents {
+  if (counter === 1) {
+    return {
+      version: GOLDEN_VERSION,
+      manifest: encoder.encode(GOLDEN_MANIFEST),
+      sums: encoder.encode(GOLDEN_SUMS),
+    };
+  }
+  const manifest = JSON.parse(GOLDEN_MANIFEST) as Json;
+  const version = GOLDEN_VERSION.replace(".managed.1.", `.managed.${counter}.`);
+  manifest.releaseCounter = counter;
+  manifest.releaseVersion = version;
+  for (const artifact of manifest.artifacts as Array<Json>) {
+    artifact.version = version;
+    if (artifact.kind === "desktop") artifact.embeddedServerVersion = version;
+  }
+  const text = canonicalJson(manifest);
+  return { version, manifest: encoder.encode(text), sums: encoder.encode(signSums(text)) };
+}
