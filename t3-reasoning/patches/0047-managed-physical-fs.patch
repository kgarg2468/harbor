diff --git a/apps/desktop/src/updates/managedPhysicalFs.ts b/apps/desktop/src/updates/managedPhysicalFs.ts
new file mode 100644
index 00000000..08a86538
--- /dev/null
+++ b/apps/desktop/src/updates/managedPhysicalFs.ts
@@ -0,0 +1,14 @@
+// @effect-diagnostics nodeBuiltinImport:off -- Bundle verification needs physical archive files.
+import * as fs from "node:fs/promises";
+import { createRequire } from "node:module";
+
+/** Electron's normal fs treats app.asar as a virtual directory. Installation
+ * must inspect, hash and remove the physical archive, just like the Node helper. */
+export function managedPhysicalFs(
+  electronVersion = process.versions.electron,
+  load: (id: string) => unknown = createRequire(import.meta.url),
+): typeof fs {
+  if (!electronVersion) return fs;
+  // Do not fall back to virtual fs if original-fs is unavailable in Electron.
+  return (load("original-fs") as { promises: typeof fs }).promises;
+}
