index 0000000000000000000000000000000000000000..d953ba2f3ea0287f8c004a769af5d5611c50b225
--- /dev/null
+++ b/apps/server/src/persistence/ReasoningSchema.ts
@@ -0,0 +1,109 @@
+/**
+ * Reasoning schema for the projection tables.
+ *
+ * Reasoning is a maintained feature patch on top of upstream T3 Code. Its
+ * schema deliberately lives outside the numbered migration manifest: a
+ * numbered entry would collide with whichever migration upstream adds next,
+ * on every nightly rebase. `runMigrations` runs the upstream manifest first
+ * and then calls `ensureReasoningSchema`, which is idempotent and cheap.
+ */
+
+import * as Effect from "effect/Effect";
+import * as Migrator from "effect/unstable/sql/Migrator";
+import * as SqlClient from "effect/unstable/sql/SqlClient";
+import type { SqlError } from "effect/unstable/sql/SqlError";
+
+const MIGRATIONS_TABLE = "effect_sql_migrations";
+
+/**
+ * Earlier Reasoning builds shipped the channel column as migration 44, an id
+ * upstream later assigned to `ClearAutomaticProjectModelDefaults`.
+ */
+export const LEGACY_REASONING_MIGRATION_ID = 44;
+export const LEGACY_REASONING_MIGRATION_NAME = "ProjectionThreadMessagesChannel";
+
+/**
+ * On a database migrated by a legacy Reasoning build the migrator sees id 44
+ * as already applied and would skip upstream's 44 forever. When the record
+ * carries exactly the legacy name, run upstream's 44 body and rename the
+ * record inside one transaction so the manifest matches upstream again. The
+ * channel column and the rows written under it are left untouched; the
+ * ensure phase later finds the column and does nothing.
+ *
+ * Any other unexpected name at id 44 is reported as a migrator `BadState`
+ * error rather than guessed at.
+ */
+export const repairLegacyReasoningMigration = Effect.fn("repairLegacyReasoningMigration")(
+  function* (input: {
+    readonly upstreamMigrationName: string;
+    readonly upstreamMigration: Effect.Effect<void, SqlError, SqlClient.SqlClient>;
+  }) {
+    const sql = yield* SqlClient.SqlClient;
+    const tables = yield* sql<{ readonly name: string }>`
+      SELECT name FROM sqlite_master WHERE type = 'table' AND name = ${MIGRATIONS_TABLE}
+    `;
+    if (tables.length === 0) {
+      return false;
+    }
+    const records = yield* sql<{ readonly name: string }>`
+      SELECT name FROM effect_sql_migrations WHERE migration_id = ${LEGACY_REASONING_MIGRATION_ID}
+    `;
+    const recordedName = records[0]?.name;
+    if (recordedName === undefined || recordedName === input.upstreamMigrationName) {
+      return false;
+    }
+    if (recordedName !== LEGACY_REASONING_MIGRATION_NAME) {
+      return yield* new Migrator.MigrationError({
+        kind: "BadState",
+        message:
+          `Migration ${LEGACY_REASONING_MIGRATION_ID} is recorded as "${recordedName}"; ` +
+          `expected "${input.upstreamMigrationName}" or the legacy Reasoning ` +
+          `"${LEGACY_REASONING_MIGRATION_NAME}". Refusing to guess its identity.`,
+      });
+    }
+
+    yield* sql
+      .withTransaction(
+        Effect.gen(function* () {
+          yield* input.upstreamMigration;
+          yield* sql`
+          UPDATE effect_sql_migrations
+          SET name = ${input.upstreamMigrationName}
+          WHERE migration_id = ${LEGACY_REASONING_MIGRATION_ID}
+            AND name = ${LEGACY_REASONING_MIGRATION_NAME}
+        `;
+        }),
+      )
+      .pipe(
+        Effect.mapError(
+          (cause) =>
+            new Migrator.MigrationError({
+              kind: "Failed",
+              cause,
+              message: `Repairing legacy Reasoning migration ${LEGACY_REASONING_MIGRATION_ID} failed`,
+            }),
+        ),
+      );
+    return true;
+  },
+);
+
+/**
+ * Adds the nullable `channel` column to message projections when it is
+ * missing. Runs after the upstream manifest on every startup; a database that
+ * already has the column is left alone.
+ */
+export const ensureReasoningSchema = Effect.fn("ensureReasoningSchema")(function* () {
+  const sql = yield* SqlClient.SqlClient;
+  const columns = yield* sql<{ readonly name: string }>`
+    PRAGMA table_info(projection_thread_messages)
+  `;
+  if (columns.length === 0 || columns.some((column) => column.name === "channel")) {
+    return false;
+  }
+  yield* sql`
+    ALTER TABLE projection_thread_messages
+    ADD COLUMN channel TEXT
+  `;
+  return true;
+});
