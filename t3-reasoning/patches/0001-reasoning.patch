@@ -0,0 +1,264 @@
+import { assert, describe, it } from "@effect/vitest";
+import * as Effect from "effect/Effect";
+import * as Migrator from "effect/unstable/sql/Migrator";
+import * as SqlClient from "effect/unstable/sql/SqlClient";
+import { SqlError, UnknownError } from "effect/unstable/sql/SqlError";
+
+import { migrationManifest, runMigrations } from "./Migrations.ts";
+import * as NodeSqliteClient from "@t3tools/shared/nodeSqliteClient";
+import {
+  ensureReasoningSchema,
+  LEGACY_REASONING_MIGRATION_ID,
+  LEGACY_REASONING_MIGRATION_NAME,
+  repairLegacyReasoningMigration,
+} from "./ReasoningSchema.ts";
+
+// Each test gets its own in-memory database; a shared layer would leak the
+// schema from one scenario into the next.
+const withFreshDatabase = <A, E>(effect: Effect.Effect<A, E, SqlClient.SqlClient>) =>
+  effect.pipe(Effect.provide(NodeSqliteClient.layerMemory()));
+
+const UPSTREAM_MIGRATION_NAME = "ClearAutomaticProjectModelDefaults";
+const LATEST_UPSTREAM_MIGRATION_ID = migrationManifest.at(-1)![0];
+const MODEL_SELECTION = '{"instanceId":"codex","model":"gpt-5.6-sol"}';
+
+const channelColumns = Effect.gen(function* () {
+  const sql = yield* SqlClient.SqlClient;
+  const columns = yield* sql<{ readonly name: string; readonly notnull: number }>`
+    PRAGMA table_info(projection_thread_messages)
+  `;
+  return columns.filter((column) => column.name === "channel");
+});
+
+const migrationRecords = Effect.gen(function* () {
+  const sql = yield* SqlClient.SqlClient;
+  return yield* sql<{ readonly migration_id: number; readonly name: string }>`
+    SELECT migration_id, name FROM effect_sql_migrations ORDER BY migration_id ASC
+  `;
+});
+
+/**
+ * Rebuilds what a database migrated by a legacy Reasoning build looks like:
+ * upstream through 43, the channel column shipped as custom migration 44, and
+ * data both migrations care about.
+ */
+const seedLegacyReasoningDatabase = Effect.gen(function* () {
+  const sql = yield* SqlClient.SqlClient;
+  yield* runMigrations({ toMigrationInclusive: LEGACY_REASONING_MIGRATION_ID - 1 });
+  yield* sql`ALTER TABLE projection_thread_messages ADD COLUMN channel TEXT`;
+  yield* sql`
+    INSERT INTO effect_sql_migrations (migration_id, name)
+    VALUES (${LEGACY_REASONING_MIGRATION_ID}, ${LEGACY_REASONING_MIGRATION_NAME})
+  `;
+
+  yield* sql`
+    INSERT INTO orchestration_events (
+      event_id, aggregate_kind, stream_id, stream_version, event_type, occurred_at,
+      actor_kind, payload_json, metadata_json
+    )
+    VALUES
+      (
+        'event-auto', 'project', 'project-auto', 1, 'project.created', '2026-05-01T00:00:00.000Z',
+        'user', ${`{"id":"project-auto","defaultModelSelection":${MODEL_SELECTION}}`}, '{}'
+      ),
+      (
+        'event-manual', 'project', 'project-manual', 1, 'project.created', '2026-05-01T00:00:00.000Z',
+        'user', ${`{"id":"project-manual","defaultModelSelection":${MODEL_SELECTION}}`}, '{}'
+      ),
+      (
+        'event-manual-meta', 'project', 'project-manual', 2, 'project.meta-updated', '2026-05-02T00:00:00.000Z',
+        'user', ${`{"defaultModelSelection":${MODEL_SELECTION}}`}, '{}'
+      )
+  `;
+  yield* sql`
+    INSERT INTO projection_projects (
+      project_id, title, workspace_root, scripts_json, default_model_selection_json, created_at, updated_at
+    )
+    VALUES
+      ('project-auto', 'Automatic', '/tmp/auto', '[]', ${MODEL_SELECTION}, '2026-05-01T00:00:00.000Z', '2026-05-01T00:00:00.000Z'),
+      ('project-manual', 'Manual', '/tmp/manual', '[]', ${MODEL_SELECTION}, '2026-05-01T00:00:00.000Z', '2026-05-02T00:00:00.000Z')
+  `;
+  yield* sql`
+    INSERT INTO projection_thread_messages (
+      message_id, thread_id, turn_id, role, text, is_streaming, created_at, updated_at, channel
+    )
+    VALUES
+      ('reasoning-1', 'thread-1', 'turn-1', 'assistant', 'Thinking it through', 0, '2026-06-01T00:00:00.000Z', '2026-06-01T00:00:00.000Z', 'reasoning'),
+      ('answer-1', 'thread-1', 'turn-1', 'assistant', 'Done', 0, '2026-06-01T00:00:01.000Z', '2026-06-01T00:00:01.000Z', NULL)
+  `;
+});
+
+describe("ReasoningSchema", () => {
+  it.effect("adds the channel column on a fresh database and stays idempotent", () =>
+    withFreshDatabase(
+      Effect.gen(function* () {
+        const executed = yield* runMigrations();
+        assert.deepStrictEqual(
+          executed.map(([id]) => id),
+          migrationManifest.map(([id]) => id),
+        );
+
+        const columns = yield* channelColumns;
+        assert.equal(columns.length, 1);
+        assert.equal(columns[0]?.notnull, 0);
+
+        const executedAgain = yield* runMigrations();
+        assert.deepStrictEqual(executedAgain, []);
+        assert.equal((yield* channelColumns).length, 1);
+        assert.equal(yield* ensureReasoningSchema(), false);
+      }),
+    ),
+  );
+
+  it.effect("keeps partial upstream runs on the stock schema", () =>
+    withFreshDatabase(
+      Effect.gen(function* () {
+        yield* runMigrations({ toMigrationInclusive: LATEST_UPSTREAM_MIGRATION_ID });
+        assert.equal((yield* channelColumns).length, 0);
+
+        assert.equal(yield* ensureReasoningSchema(), true);
+        assert.equal((yield* channelColumns).length, 1);
+        assert.equal(yield* ensureReasoningSchema(), false);
+        assert.equal((yield* channelColumns).length, 1);
+      }),
+    ),
+  );
+
+  it.effect("does nothing before the migrations table exists", () =>
+    withFreshDatabase(
+      Effect.gen(function* () {
+        const repaired = yield* repairLegacyReasoningMigration({
+          upstreamMigrationName: UPSTREAM_MIGRATION_NAME,
+          upstreamMigration: Effect.die("must not run"),
+        });
+        assert.equal(repaired, false);
+        assert.equal(yield* ensureReasoningSchema(), false);
+      }),
+    ),
+  );
+
+  it.effect("repairs a database migrated by a legacy Reasoning build", () =>
+    withFreshDatabase(
+      Effect.gen(function* () {
+        const sql = yield* SqlClient.SqlClient;
+        yield* seedLegacyReasoningDatabase;
+
+        const executed = yield* runMigrations();
+        assert.deepStrictEqual(
+          executed.map(([id]) => id),
+          migrationManifest.map(([id]) => id).filter((id) => id > LEGACY_REASONING_MIGRATION_ID),
+        );
+
+        const records = yield* migrationRecords;
+        assert.deepStrictEqual(
+          records.map((record) => record.migration_id),
+          migrationManifest.map(([id]) => id),
+        );
+        assert.equal(
+          records.find((record) => record.migration_id === LEGACY_REASONING_MIGRATION_ID)?.name,
+          UPSTREAM_MIGRATION_NAME,
+        );
+
+        // Upstream 44 ran: automatically seeded defaults are cleared, manual ones stay.
+        const projects = yield* sql<{
+          readonly project_id: string;
+          readonly default_model_selection_json: string | null;
+        }>`
+        SELECT project_id, default_model_selection_json
+        FROM projection_projects
+        ORDER BY project_id ASC
+      `;
+        assert.deepStrictEqual(
+          projects.map((project) => [project.project_id, project.default_model_selection_json]),
+          [
+            ["project-auto", null],
+            ["project-manual", MODEL_SELECTION],
+          ],
+        );
+        const createdEvents = yield* sql<{
+          readonly stream_id: string;
+          readonly default_model_selection: string;
+        }>`
+        SELECT stream_id, json_type(payload_json, '$.defaultModelSelection') AS default_model_selection
+        FROM orchestration_events
+        WHERE event_type = 'project.created'
+        ORDER BY stream_id ASC
+      `;
+        assert.deepStrictEqual(
+          createdEvents.map((event) => [event.stream_id, event.default_model_selection]),
+          [
+            ["project-auto", "null"],
+            ["project-manual", "object"],
+          ],
+        );
+
+        // The legacy channel column and its rows survive untouched.
+        assert.equal((yield* channelColumns).length, 1);
+        const messages = yield* sql<{
+          readonly message_id: string;
+          readonly channel: string | null;
+        }>`
+        SELECT message_id, channel FROM projection_thread_messages ORDER BY message_id ASC
+      `;
+        assert.deepStrictEqual(
+          messages.map((message) => [message.message_id, message.channel]),
+          [
+            ["answer-1", null],
+            ["reasoning-1", "reasoning"],
+          ],
+        );
+
+        // A second start finds a stock database plus the Reasoning schema.
+        assert.deepStrictEqual(yield* runMigrations(), []);
+        assert.equal((yield* channelColumns).length, 1);
+      }),
+    ),
+  );
+
+  it.effect("rolls the repair back when upstream 44 fails", () =>
+    withFreshDatabase(
+      Effect.gen(function* () {
+        yield* seedLegacyReasoningDatabase;
+
+        const error = yield* repairLegacyReasoningMigration({
+          upstreamMigrationName: UPSTREAM_MIGRATION_NAME,
+          upstreamMigration: Effect.fail(
+            new SqlError({ reason: new UnknownError({ cause: new Error("boom") }) }),
+          ),
+        }).pipe(Effect.flip);
+        assert.instanceOf(error, Migrator.MigrationError);
+        assert.equal(error.kind, "Failed");
+
+        const records = yield* migrationRecords;
+        assert.equal(
+          records.find((record) => record.migration_id === LEGACY_REASONING_MIGRATION_ID)?.name,
+          LEGACY_REASONING_MIGRATION_NAME,
+        );
+      }),
+    ),
+  );
+
+  it.effect("refuses to guess an unknown migration 44 identity", () =>
+    withFreshDatabase(
+      Effect.gen(function* () {
+        const sql = yield* SqlClient.SqlClient;
+        yield* runMigrations({ toMigrationInclusive: LEGACY_REASONING_MIGRATION_ID - 1 });
+        yield* sql`
+        INSERT INTO effect_sql_migrations (migration_id, name)
+        VALUES (${LEGACY_REASONING_MIGRATION_ID}, 'SomeOtherForkMigration')
+      `;
+
+        const error = yield* runMigrations().pipe(Effect.flip);
+        assert.instanceOf(error, Migrator.MigrationError);
+        assert.equal(error.kind, "BadState");
+        assert.match(error.message, /SomeOtherForkMigration/);
+
+        // Nothing past 43 ran and the record is untouched.
+        const records = yield* migrationRecords;
+        assert.equal(records.at(-1)?.migration_id, LEGACY_REASONING_MIGRATION_ID);
+        assert.equal(records.at(-1)?.name, "SomeOtherForkMigration");
+        assert.equal((yield* channelColumns).length, 0);
+      }),
+    ),
+  );
+});
