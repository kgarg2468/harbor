+
+  it.effect("decodes UTF-8 incrementally across chunk boundaries and flags invalid bytes", () =>
+    Effect.gen(function* () {
+      const encoded = Buffer.from("héllo\n");
+      const split = yield* launched(fakeSpawn(), { kind: "version" });
