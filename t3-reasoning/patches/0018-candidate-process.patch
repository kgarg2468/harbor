+      );
+      assert.include(relative.reason, "not absolute");
+      assert.strictEqual(fake.calls.length, 1);
+    }),
+  );
+
+  it.effect("keeps a complete JSON line pending until the child has actually exited", () =>
+    Effect.gen(function* () {
+      const { fiber, child } = yield* launched(fakeSpawn(), { kind: "version" });
+      child.stdout.write("1.2.3\n");
+      child.endStreams();
+      yield* assertPending(fiber);
+      assert.strictEqual((yield* scratchEntries).length, 1);
+      child.exit(0);
+      assert.strictEqual((yield* Fiber.join(fiber)).stdout, "1.2.3\n");
+      assert.deepStrictEqual(yield* scratchEntries, []);
+    }),
+  );
+
+  it.effect("keeps an exited child pending until both pipes reach end-of-stream", () =>
+    Effect.gen(function* () {
+      const { fiber, child } = yield* launched(fakeSpawn(), { kind: "version" });
+      child.stdout.write("1.2.3\n");
+      child.exit(0);
+      yield* assertPending(fiber);
+      child.stdout.end();
+      yield* assertPending(fiber);
+      assert.strictEqual((yield* scratchEntries).length, 1);
+      child.stderr.end();
+      assert.strictEqual((yield* Fiber.join(fiber)).code, 0);
+      assert.deepStrictEqual(yield* scratchEntries, []);
+    }),
+  );
+
+  it.effect("rejects a pipe that closes without end-of-stream", () =>
+    Effect.gen(function* () {
+      const { fiber, child } = yield* launched(fakeSpawn(), { kind: "version" });
+      child.stdout.write("1.2.3\n");
+      child.stderr.end();
+      child.stdout.destroy();
+      child.exit(0);
+      const error = yield* failureOf(fiber);
+      assert.include(error.reason, "stdout closed before end-of-stream");
+    }),
+  );
+
+  it.effect("asks a live child to stop as soon as a pipe closes without end-of-stream", () =>
+    Effect.gen(function* () {
+      const { fiber, child } = yield* launched(
+        fakeSpawn(),
+        { kind: "version" },
+        { identityTimeoutMs: 60_000 },
+      );
+      const killed = child.nextKill();
+      child.stdout.write("1.2.3\n");
+      child.stdout.destroy();
+      yield* Effect.promise(() => killed);
+      assert.deepStrictEqual(child.kills, ["SIGTERM"]);
+      yield* assertPending(fiber, "termination request must not settle the process");
+      assert.strictEqual((yield* scratchEntries).length, 1);
+      child.stderr.end();
+      child.exit(0);
+      const error = yield* failureOf(fiber);
+      assert.include(error.reason, "stdout closed before end-of-stream");
+      assert.strictEqual(error.output?.code, 0);
+      assert.deepStrictEqual(yield* scratchEntries, []);
+    }),
+  );
+
+  it.effect("rejects a signal exit and reports the signal", () =>
+    Effect.gen(function* () {
+      const { fiber, child } = yield* launched(fakeSpawn(), { kind: "version" });
+      child.finish(null, "SIGKILL");
+      const error = yield* failureOf(fiber);
+      assert.include(error.reason, "exited on signal SIGKILL");
+      assert.strictEqual(error.output?.signal, "SIGKILL");
+      assert.strictEqual(error.output?.code, null);
+    }),
+  );
+
+  it.effect("treats an error after the PID exists as unusable but not as exit", () =>
+    Effect.gen(function* () {
+      const { fiber, child } = yield* launched(fakeSpawn(), { kind: "version" });
+      child.emit("error", new Error("kill EPERM"));
+      yield* assertPending(fiber);
+      assert.strictEqual((yield* scratchEntries).length, 1);
+      child.stdout.write("1.2.3\n");
+      child.finish(0);
+      const error = yield* failureOf(fiber);
+      assert.include(error.reason, "process error: kill EPERM");
+      assert.strictEqual(error.output?.code, 0);
+      assert.deepStrictEqual(yield* scratchEntries, []);
+    }),
+  );
+
+  it.effect("settles a spawn failure with no PID as a failure and removes scratch", () =>
+    Effect.gen(function* () {
+      const fake = fakeSpawn((child) => {
+        child.pid = undefined;
+        process.nextTick(() => child.emit("error", new Error("spawn ENOENT")));
+      });
