+        { kind: "version" },
+        { identityTimeoutMs: 5 },
+      );
+      yield* Effect.promise(() => child.nextKill());
+      assert.deepStrictEqual(child.kills, ["SIGTERM"]);
+      yield* assertPending(fiber);
+      assert.strictEqual((yield* scratchEntries).length, 1);
+      child.finish(null, "SIGTERM");
+      const error = yield* failureOf(fiber);
+      assert.include(error.reason, "timed out after 5ms");
+      assert.strictEqual(error.output?.timedOut, true);
+      assert.strictEqual(error.output?.signal, "SIGTERM");
+      assert.deepStrictEqual(yield* scratchEntries, []);
+    }),
+  );
+
+  it.effect("retains ownership when the kill is refused until the child really exits", () =>
+    Effect.gen(function* () {
+      const { fiber, child } = yield* launched(
