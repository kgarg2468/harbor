+// @effect-diagnostics nodeBuiltinImport:off - drives a fake raw child and inspects the scratch directory directly.
+import * as NodeEvents from "node:events";
+import * as NodeFSP from "node:fs/promises";
+import * as NodeOS from "node:os";
+import * as NodePath from "node:path";
+import * as NodeStream from "node:stream";
+
+import { afterEach, assert, beforeEach, describe, it } from "@effect/vitest";
+import * as Effect from "effect/Effect";
+import * as Exit from "effect/Exit";
+import * as Fiber from "effect/Fiber";
+import * as Option from "effect/Option";
+import { vi } from "vite-plus/test";
+
+import {
+  MANAGED_CANDIDATE_NODE_VERSION,
+  makeManagedCandidateProcess,
+  type CandidateChildHandle,
+  type CandidateSpawn,
+  type CandidateSpawnOptions,
+  type ManagedCandidateError,
+  type ManagedCandidateLimits,
+  type ManagedCandidateOperation,
+  type ManagedCandidateOutput,
+} from "./managedCandidateProcess.ts";
+
+// Scratch creation is held at its first filesystem call so cancellation can be
+// delivered deterministically before any child exists.
+vi.mock("node:fs/promises", async (importOriginal) => {
+  const actual = await importOriginal<typeof import("node:fs/promises")>();
+  return { ...actual, mkdtemp: vi.fn(actual.mkdtemp) };
+});
+
+// --- fake raw spawn ----------------------------------------------------------------
+
+class FakeChild extends NodeEvents.EventEmitter implements CandidateChildHandle {
+  pid: number | undefined = 4242;
+  readonly stdout = new NodeStream.PassThrough();
+  readonly stderr = new NodeStream.PassThrough();
+  readonly kills: Array<NodeJS.Signals> = [];
+  killResult = true;
+  private killWaiters: Array<() => void> = [];
+
+  kill(signal: NodeJS.Signals): boolean {
+    this.kills.push(signal);
+    const waiters = this.killWaiters;
+    this.killWaiters = [];
+    for (const waiter of waiters) waiter();
+    return this.killResult;
+  }
+
+  /** Resolves the next time the runner asks this child to stop. */
+  nextKill(): Promise<void> {
+    return new Promise((resolve) => this.killWaiters.push(resolve));
+  }
+
+  endStreams(): void {
+    this.stdout.end();
+    this.stderr.end();
+  }
+
+  exit(code: number | null, signal: NodeJS.Signals | null = null): void {
+    this.emit("exit", code, signal);
+  }
+
+  /** The ordinary happy path: output is flushed, pipes close, then the process exits. */
+  finish(code: number | null, signal: NodeJS.Signals | null = null): void {
+    this.endStreams();
+    this.exit(code, signal);
+  }
+}
+
+interface SpawnCall {
+  readonly command: string;
+  readonly args: ReadonlyArray<string>;
+  readonly options: CandidateSpawnOptions;
+  readonly child: FakeChild;
+}
+
+function fakeSpawn(configure?: (child: FakeChild) => void) {
+  const calls: Array<SpawnCall> = [];
+  let waiters: Array<(call: SpawnCall) => void> = [];
+  const spawn: CandidateSpawn = (command, args, options) => {
+    const child = new FakeChild();
+    configure?.(child);
+    const call: SpawnCall = { command, args, options, child };
+    calls.push(call);
+    const pending = waiters;
+    waiters = [];
+    for (const waiter of pending) waiter(call);
+    return child;
+  };
+  return {
+    spawn,
+    calls,
+    nextSpawn: (): Promise<SpawnCall> => new Promise((resolve) => waiters.push(resolve)),
+  };
+}
+
+// --- helpers -----------------------------------------------------------------------
+
+const NODE = "/opt/managed/node";
+const ENTRY = "/opt/managed/versions/1.2.3/node_modules/t3/dist/bin.mjs";
+const SNAPSHOT = "/private/tmp/t3-migration-preflight-abc/snapshot.sqlite";
+const REPLACEMENT_ENV_KEYS = [
+  "HOME",
+  "TMPDIR",
+  "TMP",
+  "TEMP",
+  "XDG_CONFIG_HOME",
+  "XDG_CACHE_HOME",
+  "XDG_DATA_HOME",
+  "PATH",
+  "LANG",
+  "LC_ALL",
+].sort();
+
+const flush = async (): Promise<void> => {
+  for (let index = 0; index < 5; index += 1) {
+    await new Promise<void>((resolve) => setImmediate(resolve));
+  }
+};
+
+/** Drains the microtask and immediate queues, then asserts the fiber still has no exit. */
+const assertPending = (fiber: Fiber.Fiber<unknown, unknown>, message?: string) =>
+  Effect.promise(flush).pipe(
+    Effect.map(() => {
+      assert.isUndefined(fiber.pollUnsafe(), message ?? "must still be waiting on the child");
+    }),
+  );
+
+const failureOf = <A>(fiber: Fiber.Fiber<A, ManagedCandidateError>) =>
+  Effect.flip(Fiber.join(fiber)).pipe(
+    Effect.map((error) => {
+      assert.strictEqual(error._tag, "ManagedCandidateError");
+      return error;
+    }),
+  );
+
+let scratchParent: string;
+const scratchEntries = Effect.promise(() => NodeFSP.readdir(scratchParent));
+const exists = (path: string) =>
+  Effect.promise(() =>
+    NodeFSP.lstat(path).then(
+      () => true,
+      () => false,
+    ),
+  );
+
+beforeEach(async () => {
+  scratchParent = await NodeFSP.mkdtemp(NodePath.join(NodeOS.tmpdir(), "t3-candidate-test-"));
+});
+
+afterEach(async () => {
+  vi.unstubAllEnvs();
+  // Drops any unconsumed one-shot hold and restores the original implementation.
+  vi.mocked(NodeFSP.mkdtemp).mockReset();
+  await NodeFSP.rm(scratchParent, { recursive: true, force: true });
+});
+
+function runner(spawn: CandidateSpawn, limits?: Partial<ManagedCandidateLimits>) {
+  return makeManagedCandidateProcess({
+    nodeExecutable: NODE,
+    scratchParent,
+    spawn,
+    ...(limits === undefined ? {} : { limits }),
+  });
+}
+
+/** Starts one operation against the fake and hands back the spawn call and the running fiber. */
+const launch = (
+  spawn: CandidateSpawn,
+  operation: ManagedCandidateOperation,
+  limits?: Partial<ManagedCandidateLimits>,
+) => Effect.forkChild(runner(spawn, limits).run({ entryPath: ENTRY, operation }));
+
+const launched = (
+  fake: ReturnType<typeof fakeSpawn>,
+  operation: ManagedCandidateOperation,
+  limits?: Partial<ManagedCandidateLimits>,
+) =>
+  Effect.gen(function* () {
+    const spawned = fake.nextSpawn();
+    const fiber = yield* launch(fake.spawn, operation, limits);
+    const call = yield* Effect.promise(() => spawned);
+    return { fiber, ...call };
+  });
+
+// --- tests -------------------------------------------------------------------------
+
+describe("managedCandidateProcess", () => {
+  it.effect(
+    "spawns the version probe with exact argv, a replacement environment, and private scratch",
+    () =>
+      Effect.gen(function* () {
+        vi.stubEnv("NODE_OPTIONS", "--require /tmp/evil.cjs");
+        vi.stubEnv("NODE_PATH", "/tmp/evil");
+        vi.stubEnv("NODE_CHANNEL_FD", "3");
+        vi.stubEnv("ELECTRON_RUN_AS_NODE", "1");
+        vi.stubEnv("T3CODE_HOME", "/tmp/live-home");
+        vi.stubEnv("HTTPS_PROXY", "http://proxy.invalid");
+        vi.stubEnv("ANTHROPIC_API_KEY", "secret");
+        const { fiber, command, args, options, child } = yield* launched(fakeSpawn(), {
+          kind: "version",
+        });
+
+        assert.strictEqual(command, NODE);
+        assert.deepStrictEqual(args, ["--no-global-search-paths", ENTRY, "--version"]);
+        assert.deepStrictEqual(options.stdio, ["ignore", "pipe", "pipe"]);
+        assert.strictEqual(options.shell, false);
+        assert.strictEqual(options.detached, false);
+        assert.deepStrictEqual(Object.keys(options.env).sort(), REPLACEMENT_ENV_KEYS);
+        assert.strictEqual(options.env.PATH, "/usr/bin:/bin:/usr/sbin:/sbin");
+
+        const [scratchName] = yield* scratchEntries;
+        assert.isDefined(scratchName);
+        const scratch = NodePath.join(scratchParent, scratchName as string);
+        assert.strictEqual(
+          (yield* Effect.promise(() => NodeFSP.stat(scratch))).mode & 0o777,
+          0o700,
+        );
+        assert.strictEqual(options.cwd, NodePath.join(scratch, "cwd"));
+        assert.deepStrictEqual(yield* Effect.promise(() => NodeFSP.readdir(options.cwd)), []);
+        assert.strictEqual(options.env.HOME, NodePath.join(scratch, "home"));
+        assert.notStrictEqual(options.env.HOME, NodeOS.homedir());
+        for (const key of ["TMPDIR", "TMP", "TEMP"] as const) {
+          assert.strictEqual(options.env[key], NodePath.join(scratch, "tmp"));
+        }
+        assert.strictEqual(options.env.XDG_CONFIG_HOME, NodePath.join(scratch, "xdg", "config"));
+        assert.strictEqual(options.env.XDG_CACHE_HOME, NodePath.join(scratch, "xdg", "cache"));
+        assert.strictEqual(options.env.XDG_DATA_HOME, NodePath.join(scratch, "xdg", "data"));
+
+        child.stdout.write("1.2.3\n");
+        child.finish(0);
+        const output = yield* Fiber.join(fiber);
+        assert.deepStrictEqual(output, {
+          code: 0,
+          signal: null,
+          stdout: "1.2.3\n",
+          stderr: "",
+          stdoutTruncated: false,
+          stderrTruncated: false,
+          stdoutInvalidUtf8: false,
+          stderrInvalidUtf8: false,
+          timedOut: false,
+        } satisfies ManagedCandidateOutput);
+        assert.deepStrictEqual(yield* scratchEntries, []);
+      }),
+  );
+
+  it.effect(
+    "points the service identity probe at an absent scratch database and refuses one that appears",
+    () =>
+      Effect.gen(function* () {
+        const { fiber, args, child } = yield* launched(fakeSpawn(), { kind: "service-preflight" });
+        assert.strictEqual(args[0], "--no-global-search-paths");
+        assert.strictEqual(args[1], ENTRY);
+        assert.strictEqual(args[2], "__service-preflight");
+        assert.strictEqual(args[3], "--database-path");
+        const databasePath = args[4] as string;
+        assert.deepStrictEqual(args.slice(5), ["--launcher-protocol", "2"]);
+        const [scratchName] = yield* scratchEntries;
+        assert.isTrue(databasePath.startsWith(NodePath.join(scratchParent, scratchName as string)));
+        assert.isFalse(yield* exists(databasePath));
+
+        child.stdout.write('{"status":"ready","version":"1.2.3","launcherProtocol":2}\n');
+        child.finish(0);
+        assert.strictEqual((yield* Fiber.join(fiber)).code, 0);
+
+        const second = yield* launched(fakeSpawn(), { kind: "service-preflight" });
+        yield* Effect.promise(() => NodeFSP.writeFile(`${second.args[4] as string}-wal`, ""));
+        second.child.stdout.write('{"status":"ready","version":"1.2.3","launcherProtocol":2}\n');
+        second.child.finish(0);
+        const error = yield* failureOf(second.fiber);
+        assert.include(error.reason, "identity database path");
+        assert.include(error.reason, "-wal");
+        assert.strictEqual(error.output?.code, 0);
+        assert.deepStrictEqual(yield* scratchEntries, []);
+      }),
+  );
+
+  it.effect("passes the migration snapshot path verbatim with the fixed launcher protocol", () =>
+    Effect.gen(function* () {
+      const fake = fakeSpawn();
+      const { fiber, args, child } = yield* launched(fake, {
+        kind: "migration-preflight",
+        snapshotPath: SNAPSHOT,
+      });
+      assert.deepStrictEqual(args, [
+        "--no-global-search-paths",
+        ENTRY,
+        "__migration-preflight",
+        "--snapshot-path",
+        SNAPSHOT,
+        "--launcher-protocol",
+        "2",
+      ]);
+      child.stdout.write('{"protocol":1,"status":"ok"}\n');
+      child.finish(0);
+      assert.strictEqual((yield* Fiber.join(fiber)).stdout, '{"protocol":1,"status":"ok"}\n');
+
+      const relative = yield* Effect.flip(
+        runner(fake.spawn).run({
