+// @effect-diagnostics nodeBuiltinImport:off - owns one raw child process and its private scratch directory; only Node reports the actual exit and pipe settlement this boundary waits for.
+import * as NodeChildProcess from "node:child_process";
+import * as NodeFSP from "node:fs/promises";
+import * as NodePath from "node:path";
+import type * as NodeStream from "node:stream";
+
+import * as Effect from "effect/Effect";
+import * as Schema from "effect/Schema";
+
+import { SERVICE_LAUNCHER_PROTOCOL } from "./serviceProtocol.ts";
+
+/**
+ * Runs a staged (not yet trusted) server build as a short-lived probe: its
+ * `--version`, the hidden `__service-preflight` identity command against a
+ * database path that must never come into existence, and the hidden
+ * `__migration-preflight` rehearsal against a private snapshot. It is
+ * deliberately not a general process facility.
+ *
+ * The child sees a replacement environment built from nothing, a fresh
+ * mode-0700 scratch directory for HOME/cwd/temp/XDG, no stdin, and no IPC
+ * channel. A result is reported only after Node has delivered the raw `exit`
+ * event and both stdout and stderr have closed. Timeouts, output bounds, and
+ * cancellation ask the child to stop with SIGTERM but never synthesize an
+ * exit: the scratch directory and the caller's snapshot stay put until the
+ * process is proven gone, even if that means the operation stays pending.
+ */
+
+/** Builder pin for this release generation; not a field the manifest authenticates yet. */
+export const MANAGED_CANDIDATE_NODE_VERSION = "v24.13.1";
+
+export interface ManagedCandidateLimits {
+  /** Cap on retained bytes for stdout and for stderr, each. */
+  readonly maxOutputBytes: number;
+  /** Version, service identity, and Node identity probes. */
+  readonly identityTimeoutMs: number;
+  readonly migrationTimeoutMs: number;
+}
+
+export const DEFAULT_MANAGED_CANDIDATE_LIMITS: ManagedCandidateLimits = {
+  maxOutputBytes: 256 * 1024,
+  identityTimeoutMs: 30_000,
+  migrationTimeoutMs: 120_000,
+};
+
+const CANDIDATE_PATH = "/usr/bin:/bin:/usr/sbin:/sbin";
+const CANDIDATE_LOCALE = "C.UTF-8";
+const TERMINATION_SIGNAL: NodeJS.Signals = "SIGTERM";
+/** Everything SQLite could leave beside a database file it was asked to open. */
+const SQLITE_SIDECAR_SUFFIXES = ["", "-wal", "-shm", "-journal"] as const;
+
+export type ManagedCandidateOperation =
+  | { readonly kind: "version" }
+  /** The database path is owned by the runner: a fresh absent file in scratch, never the live database. */
+  | { readonly kind: "service-preflight" }
+  | { readonly kind: "migration-preflight"; readonly snapshotPath: string };
+
+type OperationKind = ManagedCandidateOperation["kind"] | "inspect-node";
+
+export const ManagedCandidateOutput = Schema.Struct({
+  code: Schema.NullOr(Schema.Number),
+  signal: Schema.NullOr(Schema.String),
+  stdout: Schema.String,
+  stderr: Schema.String,
+  stdoutTruncated: Schema.Boolean,
+  stderrTruncated: Schema.Boolean,
+  stdoutInvalidUtf8: Schema.Boolean,
+  stderrInvalidUtf8: Schema.Boolean,
+  timedOut: Schema.Boolean,
+});
+export type ManagedCandidateOutput = typeof ManagedCandidateOutput.Type;
+
+export interface ManagedNodeIdentity {
+  readonly version: string;
+  /** `process.versions.modules`, reported verbatim rather than compared to a remembered constant. */
+  readonly modulesAbi: string;
+  readonly platform: string;
+  readonly arch: string;
+  readonly glibcVersionRuntime: string | undefined;
+}
+
+export class ManagedCandidateError extends Schema.TaggedErrorClass<ManagedCandidateError>()(
+  "ManagedCandidateError",
+  {
+    reason: Schema.String,
+    operation: Schema.String,
+    /** Present once the child actually settled, so callers can see what it printed. */
+    output: Schema.optional(ManagedCandidateOutput),
+    cause: Schema.optional(Schema.Defect()),
+  },
+) {
+  override get message(): string {
+    return `Managed candidate ${this.operation} rejected: ${this.reason}`;
+  }
+}
+
+export interface ManagedCandidateProcess {
+  readonly inspectNode: Effect.Effect<ManagedNodeIdentity, ManagedCandidateError>;
+  readonly run: (input: {
+    readonly entryPath: string;
+    readonly operation: ManagedCandidateOperation;
+  }) => Effect.Effect<ManagedCandidateOutput, ManagedCandidateError>;
+}
+
+// --- raw spawn seam -----------------------------------------------------------------
+
+/** The exact spawn options this runner uses; tests assert them and nothing else is ever passed. */
+export interface CandidateSpawnOptions {
+  readonly cwd: string;
+  readonly env: Readonly<Record<string, string>>;
+  readonly stdio: ["ignore", "pipe", "pipe"];
+  readonly shell: false;
+  readonly detached: false;
+  readonly windowsHide: true;
+}
+
+/** The slice of `ChildProcess` the runner observes. */
+export interface CandidateChildHandle {
+  /** Undefined when Node could not create the process; then an `error` event settles the invocation. */
+  readonly pid?: number | undefined;
+  readonly stdout: NodeStream.Readable | null;
+  readonly stderr: NodeStream.Readable | null;
+  on(
+    event: "exit",
+    listener: (code: number | null, signal: NodeJS.Signals | null) => void,
+  ): unknown;
+  on(event: "error", listener: (error: Error) => void): unknown;
+  kill(signal: NodeJS.Signals): boolean;
+}
+
+export type CandidateSpawn = (
+  command: string,
+  args: ReadonlyArray<string>,
+  options: CandidateSpawnOptions,
+) => CandidateChildHandle;
+
+export interface ManagedCandidateProcessOptions {
+  /** Absolute path to a plain Node binary; never `process.execPath` by default because the parent may be Electron or Bun. */
+  readonly nodeExecutable: string;
+  /** Absolute, server-owned directory that receives one private scratch directory per invocation. */
+  readonly scratchParent: string;
+  readonly limits?: Partial<ManagedCandidateLimits>;
+  readonly spawn?: CandidateSpawn;
+}
+
+// --- argv ---------------------------------------------------------------------------
+
+/**
+ * Mirrors the hidden `__migration-preflight` command's flags. The migration
+ * helper that owns this argv is not integrated into this tree yet; replace
+ * this with its builder when it lands rather than keeping two copies.
+ */
+function migrationPreflightArgs(snapshotPath: string): ReadonlyArray<string> {
+  return [
+    "__migration-preflight",
+    "--snapshot-path",
+    snapshotPath,
+    "--launcher-protocol",
+    String(SERVICE_LAUNCHER_PROTOCOL),
+  ];
+}
+
+function servicePreflightArgs(databasePath: string): ReadonlyArray<string> {
+  return [
+    "__service-preflight",
+    "--database-path",
+    databasePath,
+    "--launcher-protocol",
+    String(SERVICE_LAUNCHER_PROTOCOL),
+  ];
+}
+
+/** Trusted inline probe; prints one JSON line and nothing else. */
+const NODE_IDENTITY_PROBE = [
+  "const report = typeof process.report?.getReport === 'function' ? process.report.getReport() : undefined;",
+  "process.stdout.write(JSON.stringify({",
+  "  release: process.release?.name,",
+  "  version: process.version,",
+  "  modules: process.versions.modules,",
+  "  electron: process.versions.electron,",
+  "  bun: process.versions.bun,",
+  "  platform: process.platform,",
+  "  arch: process.arch,",
+  "  glibc: report?.header?.glibcVersionRuntime,",
+  "}) + '\\n');",
+].join("\n");
+
+// --- scratch ------------------------------------------------------------------------
+
+interface Scratch {
+  readonly root: string;
+  readonly home: string;
+  readonly cwd: string;
+  readonly tmp: string;
+  readonly xdgConfig: string;
+  readonly xdgCache: string;
+  readonly xdgData: string;
+  /** Never created by the runner; the service identity probe must leave it absent. */
+  readonly databasePath: string;
+}
+
+/**
+ * Owns the root from the moment `mkdtemp` succeeds: if any later setup step
+ * fails, the partially built root is removed before the error propagates, so
+ * the caller only ever holds a complete Scratch or nothing.
+ */
+async function createScratch(parent: string): Promise<Scratch> {
+  const root = await NodeFSP.mkdtemp(NodePath.join(parent, "candidate-"));
+  try {
+    await NodeFSP.chmod(root, 0o700);
+    const scratch: Scratch = {
+      root,
+      home: NodePath.join(root, "home"),
+      cwd: NodePath.join(root, "cwd"),
+      tmp: NodePath.join(root, "tmp"),
+      xdgConfig: NodePath.join(root, "xdg", "config"),
+      xdgCache: NodePath.join(root, "xdg", "cache"),
+      xdgData: NodePath.join(root, "xdg", "data"),
+      databasePath: NodePath.join(root, "identity", "never-created.sqlite"),
+    };
+    for (const directory of [
+      scratch.home,
+      scratch.cwd,
+      scratch.tmp,
+      scratch.xdgConfig,
+      scratch.xdgCache,
+      scratch.xdgData,
+      NodePath.dirname(scratch.databasePath),
+    ]) {
+      await NodeFSP.mkdir(directory, { recursive: true, mode: 0o700 });
+    }
+    return scratch;
+  } catch (error) {
+    // The setup error is what the caller needs to see; a failing removal must not mask it.
+    await NodeFSP.rm(root, { recursive: true, force: true }).catch(() => {});
+    throw error;
+  }
+}
+
+/** Built from nothing: no inherited loader, channel, proxy, credential, or T3 variables. */
+function candidateEnvironment(scratch: Scratch): Record<string, string> {
+  return {
+    HOME: scratch.home,
+    TMPDIR: scratch.tmp,
+    TMP: scratch.tmp,
+    TEMP: scratch.tmp,
+    XDG_CONFIG_HOME: scratch.xdgConfig,
+    XDG_CACHE_HOME: scratch.xdgCache,
+    XDG_DATA_HOME: scratch.xdgData,
+    PATH: CANDIDATE_PATH,
+    LANG: CANDIDATE_LOCALE,
+    LC_ALL: CANDIDATE_LOCALE,
+  };
+}
+
+// --- bounded capture ----------------------------------------------------------------
+
+/**
+ * Decodes one pipe incrementally with a hard byte bound. Bytes past the bound
+ * are counted and discarded, never retained, so a chatty child costs memory
+ * proportional to the bound only.
+ */
+class BoundedCapture {
+  private readonly decoder = new TextDecoder("utf-8", { fatal: true });
+  private readonly limit: number;
+  private readonly onUnusable: () => void;
+  private bytes = 0;
+  text = "";
+  truncated = false;
+  invalidUtf8 = false;
+  ended = false;
+  closed = false;
+  readError: Error | undefined;
+
+  constructor(limit: number, onUnusable: () => void) {
+    this.limit = limit;
+    this.onUnusable = onUnusable;
+  }
+
+  push(chunk: Buffer): void {
+    const previous = this.bytes;
+    this.bytes += chunk.length;
+    if (this.truncated || this.invalidUtf8) return;
+    const retained = this.bytes > this.limit ? chunk.subarray(0, this.limit - previous) : chunk;
+    try {
+      this.text += this.decoder.decode(retained, { stream: true });
+    } catch {
+      this.invalidUtf8 = true;
+      this.onUnusable();
+      return;
+    }
+    if (this.bytes > this.limit) {
+      this.truncated = true;
+      this.onUnusable();
+    }
+  }
+
+  /** Flushes the decoder at end-of-stream; a dangling partial sequence is invalid UTF-8. */
+  finish(): void {
+    if (this.truncated || this.invalidUtf8) return;
+    try {
+      this.text += this.decoder.decode();
+    } catch {
+      this.invalidUtf8 = true;
+      this.onUnusable();
+    }
+  }
+}
+
+// --- one invocation -----------------------------------------------------------------
+
+type TerminationReason =
+  | "timeout"
+  | "cancelled"
+  | "output bound"
+  | "invalid output"
+  | "read failure"
+  | "premature close";
+
+type Settlement =
+  | { readonly kind: "spawn-failed"; readonly error: Error }
+  | {
+      readonly kind: "exited";
+      readonly code: number | null;
+      readonly signal: NodeJS.Signals | null;
+      readonly stdout: BoundedCapture;
+      readonly stderr: BoundedCapture;
+      readonly timedOut: boolean;
+      readonly cancelled: boolean;
+      readonly termination: TerminationReason | undefined;
+      readonly postSpawnError: Error | undefined;
+    };
+
+/**
+ * Spawns and observes one child. Resolves only on proof: either Node reported
+ * an error before any PID existed, or the raw `exit` event fired and both
+ * pipes closed. It never rejects and never resolves early, so a child the OS
+ * will not terminate keeps the returned promise pending.
+ */
+function runChild(input: {
+  readonly spawn: CandidateSpawn;
+  readonly command: string;
+  readonly args: ReadonlyArray<string>;
+  readonly options: CandidateSpawnOptions;
+  readonly maxOutputBytes: number;
+  readonly timeoutMs: number;
+  readonly signal: AbortSignal | undefined;
+}): Promise<Settlement> {
+  return new Promise<Settlement>((resolve) => {
+    let settled = false;
+    let exited:
+      | { readonly code: number | null; readonly signal: NodeJS.Signals | null }
+      | undefined;
+    let timedOut = false;
+    let cancelled = false;
+    let termination: TerminationReason | undefined;
+    let postSpawnError: Error | undefined;
+    let timer: ReturnType<typeof setTimeout> | undefined;
+
+    const child = input.spawn(input.command, input.args, input.options);
+
+    const requestTermination = (reason: TerminationReason): void => {
+      termination ??= reason;
+      if (settled || exited !== undefined || child.pid === undefined) return;
+      // A refused or failing kill is recorded by Node as an error event or a
+      // false return; neither is treated as exit, so we keep waiting.
+      try {
+        child.kill(TERMINATION_SIGNAL);
+      } catch {
+        // Ownership is retained until Node proves the exit.
+      }
+    };
+
+    const stdout = new BoundedCapture(input.maxOutputBytes, () =>
+      requestTermination(stdout.truncated ? "output bound" : "invalid output"),
+    );
+    const stderr = new BoundedCapture(input.maxOutputBytes, () =>
+      requestTermination(stderr.truncated ? "output bound" : "invalid output"),
+    );
+
+    const finish = (settlement: Settlement): void => {
+      if (settled) return;
+      settled = true;
+      if (timer !== undefined) clearTimeout(timer);
+      input.signal?.removeEventListener("abort", onAbort);
+      resolve(settlement);
+    };
+
+    const check = (): void => {
+      if (exited === undefined || !stdout.closed || !stderr.closed) return;
+      finish({
+        kind: "exited",
+        code: exited.code,
+        signal: exited.signal,
+        stdout,
+        stderr,
+        timedOut,
+        cancelled,
+        termination,
+        postSpawnError,
+      });
+    };
+
+    const observe = (stream: NodeStream.Readable | null, capture: BoundedCapture): void => {
+      if (stream === null) {
+        // Without a pipe there is nothing to settle; the output is unusable.
+        capture.readError = new Error("pipe was not created");
+        capture.closed = true;
+        return;
+      }
+      stream.on("data", (chunk: Buffer | string) => {
+        capture.push(Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk));
+      });
+      stream.on("end", () => {
+        capture.ended = true;
+      });
+      stream.on("error", (error: Error) => {
+        capture.readError ??= error;
+        requestTermination("read failure");
+      });
+      stream.on("close", () => {
+        if (capture.closed) return;
+        capture.closed = true;
+        capture.finish();
+        // Output that became unusable at pipe close asks the child to stop
+        // now rather than at the deadline; settlement still waits for exit.
+        if (!capture.ended) requestTermination("premature close");
+        check();
+      });
+    };
+
+    const onAbort = (): void => {
+      cancelled = true;
+      requestTermination("cancelled");
+    };
+
+    // Observers go on before anything asynchronous can run: Node emits spawn
+    // failures and early output on the next tick.
+    child.on("error", (error: Error) => {
+      if (child.pid === undefined) {
+        child.stdout?.destroy();
+        child.stderr?.destroy();
+        finish({ kind: "spawn-failed", error });
+        return;
+      }
+      postSpawnError ??= error;
+    });
+    child.on("exit", (code, signal) => {
+      if (exited !== undefined) return;
+      exited = { code, signal };
+      check();
+    });
+    observe(child.stdout, stdout);
+    observe(child.stderr, stderr);
+
+    // @effect-diagnostics-next-line globalTimers:off - the deadline belongs to this raw child and is cleared on the same settlement path.
+    timer = setTimeout(() => {
+      timedOut = true;
+      requestTermination("timeout");
+    }, input.timeoutMs);
+    if (input.signal !== undefined) {
+      if (input.signal.aborted) onAbort();
+      else input.signal.addEventListener("abort", onAbort, { once: true });
+    }
+    check();
+  });
+}
+
+// --- runner -------------------------------------------------------------------------
+
+const isManagedCandidateError = Schema.is(ManagedCandidateError);
+
+function describeError(error: unknown): string {
+  return error instanceof Error ? error.message : String(error);
+}
+
+/** Reports the first sidecar the candidate left beside the never-created identity database. */
+async function findCreatedDatabaseFile(databasePath: string): Promise<string | undefined> {
+  for (const suffix of SQLITE_SIDECAR_SUFFIXES) {
+    const candidate = `${databasePath}${suffix}`;
+    try {
+      await NodeFSP.lstat(candidate);
+      return candidate;
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== "ENOENT") return candidate;
+    }
+  }
+  return undefined;
+}
+
+export function managedNodeIdentityProblem(identity: ManagedNodeIdentity): string | undefined {
+  if (identity.version !== MANAGED_CANDIDATE_NODE_VERSION) {
+    return `Node ${identity.version} is not the pinned ${MANAGED_CANDIDATE_NODE_VERSION}`;
+  }
+  if (identity.platform === "darwin" && identity.arch === "arm64") return undefined;
+  if (identity.platform === "linux" && identity.arch === "x64") {
+    return identity.glibcVersionRuntime === undefined
+      ? "Linux Node did not report a glibc runtime"
+      : undefined;
+  }
+  return `unsupported host ${identity.platform}-${identity.arch}`;
+}
+
+function decodeNodeIdentity(stdout: string): ManagedNodeIdentity | string {
+  const lines = stdout.split("\n");
+  if (lines.length !== 2 || lines[1] !== "") return "probe did not print exactly one line";
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(lines[0] as string) as unknown;
+  } catch {
+    return "probe output is not JSON";
+  }
+  if (typeof parsed !== "object" || parsed === null || Array.isArray(parsed)) {
+    return "probe output is not an object";
+  }
+  const record = parsed as Record<string, unknown>;
+  if (record.release !== "node") return "executable is not plain Node";
+  if (record.electron !== undefined || record.bun !== undefined) {
+    return "executable is not plain Node";
+  }
+  if (
+    typeof record.version !== "string" ||
+    typeof record.modules !== "string" ||
+    typeof record.platform !== "string" ||
+    typeof record.arch !== "string" ||
+    (record.glibc !== undefined && typeof record.glibc !== "string")
+  ) {
+    return "probe output is incomplete";
+  }
+  return {
+    version: record.version,
+    modulesAbi: record.modules,
+    platform: record.platform,
+    arch: record.arch,
+    glibcVersionRuntime: record.glibc === "" ? undefined : record.glibc,
+  };
+}
+
+export function makeManagedCandidateProcess(
+  options: ManagedCandidateProcessOptions,
+): ManagedCandidateProcess {
+  const limits: ManagedCandidateLimits = { ...DEFAULT_MANAGED_CANDIDATE_LIMITS, ...options.limits };
+  const spawn: CandidateSpawn =
+    options.spawn ??
+    ((command, args, spawnOptions) => NodeChildProcess.spawn(command, args, spawnOptions));
+
+  const fail = (
+    operation: OperationKind,
+    reason: string,
+    extra: { readonly output?: ManagedCandidateOutput; readonly cause?: unknown } = {},
+  ): ManagedCandidateError =>
+    new ManagedCandidateError({
+      reason,
+      operation,
+      ...(extra.output === undefined ? {} : { output: extra.output }),
+      ...(extra.cause === undefined ? {} : { cause: extra.cause }),
+    });
+
+  /**
+   * Creates scratch, runs the child to proven settlement, checks what it left
+   * behind, and only then removes the scratch. Rejections carry the settled
+   * output so callers can report what the candidate printed.
+   */
+  const invoke = async (
+    operation: OperationKind,
+    argsAfterNode: (scratch: Scratch) => ReadonlyArray<string>,
+    timeoutMs: number,
+    signal: AbortSignal | undefined,
+  ): Promise<ManagedCandidateOutput> => {
+    if (signal?.aborted) throw fail(operation, "cancelled");
+    if (!NodePath.isAbsolute(options.nodeExecutable)) {
+      throw fail(operation, "node executable path is not absolute");
+    }
+    if (!NodePath.isAbsolute(options.scratchParent)) {
+      throw fail(operation, "scratch parent path is not absolute");
+    }
+    let scratch: Scratch;
+    try {
+      scratch = await createScratch(options.scratchParent);
+    } catch (error) {
+      throw fail(operation, `creating scratch: ${describeError(error)}`, { cause: error });
+    }
+    try {
+      if (signal?.aborted) throw fail(operation, "cancelled");
+      const settlement = await runChild({
+        spawn,
+        command: options.nodeExecutable,
+        args: ["--no-global-search-paths", ...argsAfterNode(scratch)],
+        options: {
+          cwd: scratch.cwd,
+          env: candidateEnvironment(scratch),
+          stdio: ["ignore", "pipe", "pipe"],
+          shell: false,
+          detached: false,
+          windowsHide: true,
+        },
+        maxOutputBytes: limits.maxOutputBytes,
+        timeoutMs,
+        signal,
+      });
+      if (settlement.kind === "spawn-failed") {
+        throw fail(operation, `could not start: ${settlement.error.message}`, {
+          cause: settlement.error,
+        });
+      }
+      const output: ManagedCandidateOutput = {
+        code: settlement.code,
+        signal: settlement.signal,
+        stdout: settlement.stdout.text,
+        stderr: settlement.stderr.text,
+        stdoutTruncated: settlement.stdout.truncated,
+        stderrTruncated: settlement.stderr.truncated,
+        stdoutInvalidUtf8: settlement.stdout.invalidUtf8,
+        stderrInvalidUtf8: settlement.stderr.invalidUtf8,
+        timedOut: settlement.timedOut,
+      };
+      const reject = (reason: string): ManagedCandidateError => fail(operation, reason, { output });
+      if (settlement.cancelled) throw reject("cancelled");
+      if (settlement.timedOut) throw reject(`timed out after ${timeoutMs}ms`);
+      if (settlement.postSpawnError !== undefined) {
+        throw fail(operation, `process error: ${settlement.postSpawnError.message}`, {
+          output,
+          cause: settlement.postSpawnError,
+        });
+      }
+      if (settlement.signal !== null) throw reject(`exited on signal ${settlement.signal}`);
+      for (const [name, capture] of [
+        ["stdout", settlement.stdout],
+        ["stderr", settlement.stderr],
+      ] as const) {
+        if (capture.readError !== undefined) {
+          throw reject(`${name} read failed: ${capture.readError.message}`);
+        }
+        if (!capture.ended) throw reject(`${name} closed before end-of-stream`);
+        if (capture.truncated) throw reject(`${name} exceeded ${limits.maxOutputBytes} bytes`);
+        if (capture.invalidUtf8) throw reject(`${name} is not valid UTF-8`);
+      }
+      if (operation === "service-preflight") {
+        const created = await findCreatedDatabaseFile(scratch.databasePath);
+        if (created !== undefined) {
+          throw reject(`service preflight touched the identity database path: ${created}`);
+        }
+      }
+      return output;
+    } finally {
+      // Reached only after settlement (or before any child existed).
+      await NodeFSP.rm(scratch.root, { recursive: true, force: true }).catch(() => {});
+    }
+  };
+
+  const inspect = async (signal: AbortSignal | undefined): Promise<ManagedNodeIdentity> => {
+    const output = await invoke(
+      "inspect-node",
+      () => ["-e", NODE_IDENTITY_PROBE],
+      limits.identityTimeoutMs,
+      signal,
+    );
+    if (output.code !== 0) {
+      throw fail("inspect-node", `probe exited with code ${output.code}`, { output });
+    }
+    const identity = decodeNodeIdentity(output.stdout);
+    if (typeof identity === "string") throw fail("inspect-node", identity, { output });
+    const problem = managedNodeIdentityProblem(identity);
+    if (problem !== undefined) throw fail("inspect-node", problem, { output });
+    return identity;
+  };
+
+  const runOperation = async (
+    entryPath: string,
+    operation: ManagedCandidateOperation,
+    signal: AbortSignal | undefined,
+  ): Promise<ManagedCandidateOutput> => {
+    if (!NodePath.isAbsolute(entryPath)) {
+      throw fail(operation.kind, "entry path is not absolute");
+    }
+    switch (operation.kind) {
+      case "version":
+        return invoke("version", () => [entryPath, "--version"], limits.identityTimeoutMs, signal);
+      case "service-preflight":
+        return invoke(
+          "service-preflight",
+          (scratch) => [entryPath, ...servicePreflightArgs(scratch.databasePath)],
+          limits.identityTimeoutMs,
+          signal,
+        );
+      case "migration-preflight": {
+        if (!NodePath.isAbsolute(operation.snapshotPath)) {
+          throw fail(operation.kind, "snapshot path is not absolute");
+        }
+        return invoke(
+          "migration-preflight",
+          () => [entryPath, ...migrationPreflightArgs(operation.snapshotPath)],
+          limits.migrationTimeoutMs,
+          signal,
+        );
+      }
+    }
+  };
+
+  /** Interruption aborts the invocation and waits for the same settlement before the fiber finishes. */
+  const bridge = <A>(start: (signal: AbortSignal) => Promise<A>) =>
+    Effect.callback<A, ManagedCandidateError>((resume, signal) => {
+      const settled = start(signal).then(
+        (value) => resume(Effect.succeed(value)),
+        (error: unknown) =>
+          resume(isManagedCandidateError(error) ? Effect.fail(error) : Effect.die(error)),
+      );
+      return Effect.promise(() => settled);
+    });
+
+  return {
+    inspectNode: bridge((signal) => inspect(signal)).pipe(
+      Effect.withSpan("cloud.managed_candidate.inspect_node"),
+    ),
+    run: (input) =>
+      bridge((signal) => runOperation(input.entryPath, input.operation, signal)).pipe(
+        Effect.withSpan("cloud.managed_candidate.run", {
+          attributes: { operation: input.operation.kind },
+        }),
+      ),
+  };
+}
