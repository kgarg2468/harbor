+
+  it.effect("interruption signals the child and waits for its exit before releasing scratch", () =>
+    Effect.gen(function* () {
+      const { fiber, child } = yield* launched(fakeSpawn(), { kind: "version" });
+      const killed = child.nextKill();
+      const interrupter = yield* Effect.forkChild(Fiber.interrupt(fiber), {
