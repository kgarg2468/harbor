+          stage: "queued",
+          targetVersion: TARGET,
+          staged: artifactFor(TARGET),
+          reason: "busy: agent running",
+        });
+
+        const second = yield* setup({ statePath });
+        const booted = yield* second.controller.getState;
+        assert.deepStrictEqual(
+          [booted.stage, booted.targetVersion, booted.staged],
+          ["downloading", TARGET, undefined],
+        );
+        const waiting = yield* second.controller.awaitState(
+          (state) => state.stage === "queued" && state.reason !== undefined,
+        );
+        assert.deepStrictEqual(waiting.staged, artifactFor(TARGET));
+        assert.deepStrictEqual(second.fakes.stageCalls, [TARGET]);
+      }),
+    ),
+  );
+
+  it.effect("staging interrupted by shutdown resumes on the next boot", () =>
+    provide(
+      Effect.gen(function* () {
+        const first = yield* Scope.make();
+        const { controller, fakes, statePath } = yield* setup({ scope: first });
+        const staging = yield* blockedStaging();
+        fakes.stage = staging.stage;
+        yield* controller.queue(TARGET);
+        yield* Deferred.await(staging.started);
+        yield* Scope.close(first, Exit.void);
+        yield* Deferred.await(staging.interrupted);
+        assert.deepStrictEqual(yield* fakes.readState, {
+          version: 1,
+          stage: "downloading",
+          targetVersion: TARGET,
+        });
+
+        const second = yield* setup({ statePath });
+        const waiting = yield* second.controller.awaitState(
+          (state) => state.stage === "queued" && state.reason !== undefined,
+        );
+        assert.equal(waiting.targetVersion, TARGET);
+        assert.deepStrictEqual(second.fakes.stageCalls, [TARGET]);
+      }),
+    ),
+  );
+
+  it.effect("an interrupted updating state is re-staged, never trusted", () =>
+    provide(
+      Effect.gen(function* () {
+        const fs = yield* FileSystem.FileSystem;
+        const path = yield* Path.Path;
+        const root = yield* fs.makeTempDirectoryScoped({ prefix: "t3-queued-update-test-" });
+        const statePath = path.join(root, "queued-update.json");
+        yield* fs.writeFileString(
+          statePath,
+          encodeJson({
+            version: 1,
+            stage: "updating",
+            targetVersion: TARGET,
+            staged: artifactFor(TARGET),
+          }),
+        );
+        const { controller, fakes } = yield* setup({ statePath });
+        assert.equal((yield* controller.getState).stage, "downloading");
+        yield* controller.awaitState(
+          (state) => state.stage === "queued" && state.reason !== undefined,
+        );
+        assert.deepStrictEqual(fakes.stageCalls, [TARGET]);
+      }),
+    ),
+  );
+
+  it.effect("a prior target that matches the installed version becomes current", () =>
+    provide(
+      Effect.gen(function* () {
+        const fs = yield* FileSystem.FileSystem;
+        const path = yield* Path.Path;
+        const root = yield* fs.makeTempDirectoryScoped({ prefix: "t3-queued-update-test-" });
+        const statePath = path.join(root, "queued-update.json");
+        yield* fs.writeFileString(
+          statePath,
+          encodeJson({
+            version: 1,
+            stage: "updating",
+            targetVersion: TARGET,
+            staged: artifactFor(TARGET),
+          }),
+        );
+        const { controller, fakes } = yield* setup({ statePath, installedVersion: TARGET });
+        const state = yield* controller.getState;
+        assert.deepStrictEqual(
+          [state.stage, state.targetVersion, state.installedVersion],
+          ["current", TARGET, TARGET],
+        );
+        assert.deepStrictEqual(yield* fakes.readState, {
+          version: 1,
+          stage: "current",
+          targetVersion: TARGET,
+        });
+        assert.deepStrictEqual(fakes.stageCalls, []);
+      }),
+    ),
+  );
+
+  it.effect("a failed prior update is kept as failed", () =>
+    provide(
+      Effect.gen(function* () {
+        const fs = yield* FileSystem.FileSystem;
+        const path = yield* Path.Path;
+        const root = yield* fs.makeTempDirectoryScoped({ prefix: "t3-queued-update-test-" });
+        const statePath = path.join(root, "queued-update.json");
+        yield* fs.writeFileString(
+          statePath,
+          encodeJson({ version: 1, stage: "failed", targetVersion: TARGET, reason: "earlier" }),
+        );
+        const { controller, fakes } = yield* setup({ statePath });
+        const state = yield* controller.getState;
+        assert.deepStrictEqual([state.stage, state.reason], ["failed", "earlier"]);
+        assert.deepStrictEqual(fakes.stageCalls, []);
+      }),
+    ),
+  );
+
+  it.effect(
+    "after handoff the update is durable as updating and cannot be cancelled or replaced",
+    () =>
+      provide(
+        Effect.gen(function* () {
+          const scope = yield* Scope.make();
+          const { controller, fakes } = yield* setup({ scope });
+          fakes.activate = (_, onHandoffAccepted) =>
+            onHandoffAccepted.pipe(Effect.andThen(Effect.never));
+
+          yield* controller.queue(TARGET);
+          const handedOff = yield* controller.awaitState((state) => state.handoffAccepted);
+          assert.equal(handedOff.stage, "updating");
+
+          const cancel = yield* controller.cancel.pipe(Effect.flip);
+          assert.equal(rejectedReason(cancel), "handoff-accepted");
+          const queue = yield* controller.queue(NEWER).pipe(Effect.flip);
+          assert.equal(rejectedReason(queue), "handoff-accepted");
+          const retry = yield* controller.retry.pipe(Effect.flip);
+          assert.equal(rejectedReason(retry), "handoff-accepted");
+
+          yield* Scope.close(scope, Exit.void);
+          assert.deepStrictEqual(yield* fakes.readState, {
+            version: 1,
+            stage: "updating",
+            targetVersion: TARGET,
+            staged: artifactFor(TARGET),
+          });
+        }),
+      ),
