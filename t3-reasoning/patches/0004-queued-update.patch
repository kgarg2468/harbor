index 000000000..4732c55de
--- /dev/null
+++ b/apps/server/src/cloud/queuedUpdate.ts
@@ -0,0 +1,510 @@
+import * as Context from "effect/Context";
+import * as Deferred from "effect/Deferred";
+import type * as Duration from "effect/Duration";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Option from "effect/Option";
+import * as Path from "effect/Path";
+import * as Schedule from "effect/Schedule";
+import * as Schema from "effect/Schema";
+import * as Semaphore from "effect/Semaphore";
+
+import { isExactServiceVersion } from "./serviceProtocol.ts";
+
+/**
+ * Stages, in order. `updating` is the point of no return for commands: an
+ * activation attempt is running, so `cancel`, `retry`, and a different
+ * `queue` target are rejected until the attempt answers. A decline moves back
+ * to `queued` and re-enables them; a handoff keeps `updating` forever.
+ */
+export const QueuedUpdateStage = Schema.Literals([
+  "downloading",
+  "queued",
+  "updating",
+  "current",
+  "failed",
+]);
+export type QueuedUpdateStage = typeof QueuedUpdateStage.Type;
+
+/** Exact SemVer only, so a dist-tag or range can never reach disk, the stager, or the launcher. */
+const ExactVersion = Schema.String.check(
+  Schema.makeFilter(isExactServiceVersion, { expected: "an exact t3 version" }),
+);
+
+/**
+ * Identity of a prepared runtime as the stager reports it. `artifactId` is
+ * whatever the stager can re-resolve (a pinned runtime directory, a package
+ * hash); it is never a client-supplied path.
+ */
+export const StagedArtifact = Schema.Struct({
+  version: ExactVersion,
+  artifactId: Schema.String.check(
+    Schema.makeFilter((id) => id.trim() !== "", { expected: "a non-empty artifact id" }),
+  ),
+});
+export type StagedArtifact = typeof StagedArtifact.Type;
+const isStagedArtifact = Schema.is(StagedArtifact);
+
+const PersistedQueuedUpdate = Schema.Struct({
+  version: Schema.Literal(1),
+  stage: QueuedUpdateStage,
+  targetVersion: ExactVersion,
+  staged: Schema.optional(StagedArtifact),
+  reason: Schema.optional(Schema.String),
+});
+type PersistedQueuedUpdate = typeof PersistedQueuedUpdate.Type;
+
+const PersistedQueuedUpdateJson = Schema.fromJsonString(PersistedQueuedUpdate);
+const decodePersistedQueuedUpdate = Schema.decodeUnknownEffect(PersistedQueuedUpdateJson);
+const encodePersistedQueuedUpdate = Schema.encodeSync(PersistedQueuedUpdateJson);
+
+/** The durable state file could not be read, decoded, or written. Decode failures are fatal on boot: the controller refuses to guess. */
+export class QueuedUpdateStateError extends Schema.TaggedErrorClass<QueuedUpdateStateError>()(
+  "QueuedUpdateStateError",
+  {
+    operation: Schema.Literals(["read", "decode", "persist"]),
+    statePath: Schema.String,
+    cause: Schema.Defect(),
+  },
+) {
+  override get message(): string {
+    return this.operation === "decode"
+      ? `Queued update state at ${this.statePath} is unreadable; refusing to install or reset it. Fix or remove the file: ${String(this.cause)}`
+      : `Failed to ${this.operation} queued update state at ${this.statePath}.`;
+  }
+}
+
+/** Typed failure from the injected stage or activation step. */
+export class QueuedUpdateStepError extends Schema.TaggedErrorClass<QueuedUpdateStepError>()(
+  "QueuedUpdateStepError",
+  {
+    step: Schema.Literals(["stage", "activate"]),
+    reason: Schema.String,
+    cause: Schema.optional(Schema.Defect()),
+  },
+) {
+  override get message(): string {
+    return this.reason;
+  }
+}
+
+export class QueuedUpdateRejectedError extends Schema.TaggedErrorClass<QueuedUpdateRejectedError>()(
+  "QueuedUpdateRejectedError",
+  {
+    reason: Schema.Literals([
+      "invalid-version",
+      "handoff-accepted",
+      "activation-in-progress",
+      "already-installed",
+      "nothing-to-retry",
+    ]),
+  },
+) {
+  override get message(): string {
+    switch (this.reason) {
+      case "invalid-version":
+        return "Updates need an exact t3 version such as 1.2.3.";
+      case "handoff-accepted":
+        return "The update has been handed off; the server is restarting.";
+      case "activation-in-progress":
+        return "The update is being activated; wait for it to finish or be declined.";
+      case "already-installed":
+        return "That version is already installed.";
+      case "nothing-to-retry":
+        return "There is no failed update to retry.";
+    }
+  }
+}
+
+/** Activation was not performed. The success channel carries only declines: nothing here ever grants permission to install. */
+export interface ActivationDeclined {
+  readonly status: "busy" | "unknown";
+  readonly reason: string;
+}
+
+export interface QueuedUpdateDependencies {
+  /** File owned exclusively by this controller. */
+  readonly statePath: string;
+  /** The version this process is running. Authoritative over anything on disk. */
+  readonly installedVersion: string;
+  /** How long to wait after a decline before asking again. */
+  readonly pollInterval: Duration.Input;
+  /** Downloads and verifies the exact version. May run while agents are busy. */
+  readonly stage: (targetVersion: string) => Effect.Effect<StagedArtifact, QueuedUpdateStepError>;
+  /**
+   * Owns the admission gate and the real activity check. Returns a decline
+   * without activating, fails with a typed error, or runs `onHandoffAccepted`
+   * once the process is committed to restart and then never returns. The
+   * controller never interrupts it and rejects every command while it runs, so
+   * it must answer promptly when the environment is known busy (check activity
+   * before closing admissions) rather than wait for idleness.
+   */
+  readonly tryActivate: (
+    staged: StagedArtifact,
+    onHandoffAccepted: Effect.Effect<void>,
+  ) => Effect.Effect<ActivationDeclined, QueuedUpdateStepError>;
+}
+
+export interface QueuedUpdateState {
+  readonly stage: QueuedUpdateStage;
+  readonly installedVersion: string;
+  readonly targetVersion: string;
+  readonly staged: StagedArtifact | undefined;
+  readonly reason: string | undefined;
+  readonly handoffAccepted: boolean;
+}
+
+export type QueuedUpdateCommandError = QueuedUpdateRejectedError | QueuedUpdateStateError;
+
+export interface QueuedUpdateShape {
+  /**
+   * Records the intent durably and returns; staging and activation happen in
+   * the background. Rejects inexact versions before touching disk, and a
+   * different target while `updating`. The same target is idempotent.
+   */
+  readonly queue: (
+    targetVersion: string,
+  ) => Effect.Effect<QueuedUpdateState, QueuedUpdateCommandError>;
+  /** Drops the pending target and interrupts staging or waiting. Rejected while `updating`. */
+  readonly cancel: Effect.Effect<QueuedUpdateState, QueuedUpdateCommandError>;
+  /** Re-stages a failed target. Rejected while `updating`. */
+  readonly retry: Effect.Effect<QueuedUpdateState, QueuedUpdateCommandError>;
+  readonly getState: Effect.Effect<QueuedUpdateState>;
+  /** Resolves with the first state (current included) satisfying `predicate`. */
+  readonly awaitState: (
+    predicate: (state: QueuedUpdateState) => boolean,
+  ) => Effect.Effect<QueuedUpdateState>;
+}
+
+export class QueuedUpdate extends Context.Service<QueuedUpdate, QueuedUpdateShape>()(
+  "t3/cloud/queuedUpdate",
+) {}
+
+interface Failed {
+  readonly _tag: "failed";
+  readonly reason: string;
+}
+interface Woken {
+  readonly _tag: "woken";
+}
+type Declined = ActivationDeclined & { readonly _tag: "declined" };
+const WOKEN: Woken = { _tag: "woken" };
+
+const isRejected = Schema.is(QueuedUpdateRejectedError);
+
+/** Turns a step's typed failure or defect into a value so the worker loop never dies. */
+const settle = <A, O>(
+  effect: Effect.Effect<A, QueuedUpdateStepError>,
+  onSuccess: (value: A) => O,
+): Effect.Effect<O | Failed> =>
+  effect.pipe(
+    Effect.map((value): O | Failed => onSuccess(value)),
+    Effect.catch((error) => Effect.succeed<Failed>({ _tag: "failed", reason: error.reason })),
+    Effect.catchDefect((defect) =>
+      Effect.succeed<Failed>({
+        _tag: "failed",
+        reason: defect instanceof Error ? defect.message : String(defect),
+      }),
+    ),
+  );
+
+export const make = Effect.fn("queuedUpdate.make")(function* (deps: QueuedUpdateDependencies) {
+  const fs = yield* FileSystem.FileSystem;
+  const path = yield* Path.Path;
+  const { statePath, installedVersion } = deps;
+  const stateError = (operation: QueuedUpdateStateError["operation"], cause: unknown) =>
+    new QueuedUpdateStateError({ operation, statePath, cause });
+
+  const persist = Effect.fn("queuedUpdate.persist")(
+    function* (next: PersistedQueuedUpdate) {
+      yield* fs.makeDirectory(path.dirname(statePath), { recursive: true, mode: 0o700 });
+      const tempPath = `${statePath}.tmp`;
+      yield* fs.writeFileString(tempPath, `${encodePersistedQueuedUpdate(next)}\n`, {
+        mode: 0o600,
+      });
+      yield* fs.rename(tempPath, statePath);
+    },
+    Effect.mapError((cause) => stateError("persist", cause)),
+  );
+
+  const load = fs.readFileString(statePath).pipe(
+    Effect.map(Option.some),
+    Effect.catch((error) =>
+      error.reason._tag === "NotFound"
+        ? Effect.succeed(Option.none<string>())
+        : Effect.fail(stateError("read", error)),
+    ),
+    Effect.flatMap(
+      Option.match({
+        onNone: () => Effect.succeed(Option.none<PersistedQueuedUpdate>()),
+        onSome: (raw) =>
+          decodePersistedQueuedUpdate(raw).pipe(
+            Effect.map(Option.some),
+            Effect.mapError((cause) => stateError("decode", cause)),
+          ),
+      }),
+    ),
+  );
+
+  const currentInstalled: PersistedQueuedUpdate = {
+    version: 1,
+    stage: "current",
+    targetVersion: installedVersion,
+  };
+  // The previous process may have died anywhere between staging and
+  // activation. Only the exact target survives a boot; the artifact is
+  // re-staged rather than trusted.
+  const reconcile = (prior: PersistedQueuedUpdate): PersistedQueuedUpdate => {
+    if (prior.targetVersion === installedVersion || prior.stage === "current") {
+      return currentInstalled;
+    }
+    if (prior.stage === "failed") return prior;
+    return { version: 1, stage: "downloading", targetVersion: prior.targetVersion };
+  };
+  const prior = yield* load;
+  let current = Option.isNone(prior) ? currentInstalled : reconcile(prior.value);
+  if (Option.isSome(prior) && current !== prior.value) {
+    yield* persist(current);
+  }
+
+  let handoffAccepted = false;
+  let wake = Deferred.makeUnsafe<void>();
+  const waiters = new Set<{
+    readonly predicate: (state: QueuedUpdateState) => boolean;
+    readonly deferred: Deferred.Deferred<QueuedUpdateState>;
+  }>();
+  const mutex = yield* Semaphore.make(1);
+
+  const snapshot = (): QueuedUpdateState => ({
+    stage: current.stage,
+    installedVersion,
+    targetVersion: current.targetVersion,
+    staged: current.staged,
+    reason: current.reason,
+    handoffAccepted,
+  });
+
+  const notify = () => {
+    const state = snapshot();
+    for (const waiter of waiters) {
+      if (waiter.predicate(state)) {
+        waiters.delete(waiter);
+        Deferred.doneUnsafe(waiter.deferred, Effect.succeed(state));
+      }
+    }
+  };
+
+  /**
+   * The only writer. Decides under the mutex against the latest state, persists
+   * before exposing the new state, and cannot be interrupted between the two.
+   * `wake` interrupts whatever the worker is staging or waiting on. Because
+   * every command is refused while `updating`, no command persist can be in
+   * flight when an attempt accepts the handoff.
+   */
+  const commit = (
+    decide: (
+      state: PersistedQueuedUpdate,
+    ) => PersistedQueuedUpdate | QueuedUpdateRejectedError | undefined,
+    options: { readonly wake: boolean },
+  ): Effect.Effect<QueuedUpdateState, QueuedUpdateCommandError> =>
+    mutex.withPermits(1)(
+      Effect.uninterruptible(
+        Effect.suspend((): Effect.Effect<QueuedUpdateState, QueuedUpdateCommandError> => {
+          const next = decide(current);
+          if (next === undefined) return Effect.succeed(snapshot());
+          if (isRejected(next)) return Effect.fail(next);
+          return persist(next).pipe(
+            Effect.map(() => {
+              current = next;
+              if (options.wake) Deferred.doneUnsafe(wake, Effect.void);
+              notify();
+              return snapshot();
+            }),
+          );
+        }),
+      ),
+    );
+
+  const matches = (state: PersistedQueuedUpdate, stage: QueuedUpdateStage, targetVersion: string) =>
+    state.stage === stage && state.targetVersion === targetVersion;
+
+  const untilWoken = <O>(
+    effect: Effect.Effect<O>,
+    signal: Deferred.Deferred<void>,
+  ): Effect.Effect<O | Woken> =>
+    Effect.raceFirst(effect, Deferred.await(signal).pipe(Effect.as(WOKEN)));
+
+  const acceptHandoff = Effect.sync(() => {
+    handoffAccepted = true;
+    notify();
+  });
+
+  const stageStep = Effect.fn("queuedUpdate.stageStep")(function* (
+    targetVersion: string,
+    signal: Deferred.Deferred<void>,
+  ) {
+    const outcome = yield* untilWoken(
+      settle(deps.stage(targetVersion), (staged) => ({ _tag: "staged" as const, staged })),
+      signal,
+    );
+    if (outcome._tag === "woken") return;
+    const next: PersistedQueuedUpdate =
+      outcome._tag === "failed"
+        ? { version: 1, stage: "failed", targetVersion, reason: outcome.reason }
+        : isStagedArtifact(outcome.staged) && outcome.staged.version === targetVersion
+          ? { version: 1, stage: "queued", targetVersion, staged: outcome.staged }
+          : {
+              version: 1,
+              stage: "failed",
+              targetVersion,
+              reason: `The stager returned an invalid artifact for t3@${targetVersion}.`,
+            };
+    yield* commit((state) => (matches(state, "downloading", targetVersion) ? next : undefined), {
+      wake: false,
+    });
+  });
+
+  const activateStep = Effect.fn("queuedUpdate.activateStep")(function* (
+    targetVersion: string,
+    staged: StagedArtifact,
+    signal: Deferred.Deferred<void>,
+  ) {
+    const updating = yield* commit(
+      (state) =>
+        matches(state, "queued", targetVersion)
+          ? { version: 1, stage: "updating", targetVersion, staged }
+          : undefined,
+      { wake: false },
+    );
+    if (updating.stage !== "updating" || updating.targetVersion !== targetVersion) return;
+
+    // Persisted `updating` means no command can change the target until the
+    // attempt answers, so nothing here needs to be interruptible or fenced.
+    // Only the owning scope closing can interrupt the attempt.
+    const outcome = yield* settle(
+      deps.tryActivate(staged, acceptHandoff),
+      (declined): Declined => ({ _tag: "declined", ...declined }),
+    );
+    // The callback promised never to return after acceptance. Hold `updating`
+    // rather than record an answer that would contradict the restart.
+    if (handoffAccepted) return yield* Effect.never;
+
+    const next: PersistedQueuedUpdate =
+      outcome._tag === "failed"
+        ? { version: 1, stage: "failed", targetVersion, staged, reason: outcome.reason }
+        : {
+            version: 1,
+            stage: "queued",
+            targetVersion,
+            staged,
+            reason: `${outcome.status}: ${outcome.reason}`,
+          };
+    // The answer is known and no handoff happened, so all that is left is
+    // making it durable. A transient persist failure must not drop the answer,
+    // re-ask, or release the reservation: hold `updating` (commands keep being
+    // rejected) and retry the write on the poll interval until it lands.
+    const after = yield* commit(
+      (state) => (matches(state, "updating", targetVersion) ? next : undefined),
+      { wake: false },
+    ).pipe(
+      Effect.tapError((error) => Effect.logWarning(error.message, { cause: error })),
+      Effect.retry({
+        schedule: Schedule.spaced(deps.pollInterval),
+        while: (error) => error._tag === "QueuedUpdateStateError",
+      }),
+    );
+    if (
+      next.stage === "queued" &&
+      after.stage === "queued" &&
+      after.targetVersion === targetVersion
+    ) {
+      yield* untilWoken(Effect.sleep(deps.pollInterval), signal);
+    }
+  });
+
+  const iteration = Effect.fn("queuedUpdate.iteration")(function* (
+    signal: Deferred.Deferred<void>,
+  ) {
+    const state = current;
+    if (state.stage === "current" || state.stage === "failed") {
+      yield* Deferred.await(signal);
+    } else if (state.stage === "downloading") {
+      yield* stageStep(state.targetVersion, signal);
+    } else if (state.stage === "queued" && state.staged !== undefined) {
+      yield* activateStep(state.targetVersion, state.staged, signal);
+    } else {
+      yield* commit(
+        (latest) =>
+          latest === state
+            ? { version: 1, stage: "downloading", targetVersion: state.targetVersion }
+            : undefined,
+        { wake: false },
+      );
+    }
+  });
+
+  const worker = Effect.gen(function* () {
+    while (true) {
+      wake = Deferred.makeUnsafe<void>();
+      const signal = wake;
+      yield* iteration(signal).pipe(
+        Effect.catchTag("QueuedUpdateStateError", (error) =>
+          Effect.logError(error.message, { cause: error }).pipe(
+            Effect.andThen(Deferred.await(signal)),
+          ),
+        ),
+      );
+    }
+  });
+  yield* Effect.forkScoped(worker);
+
+  const reject = (reason: QueuedUpdateRejectedError["reason"]) =>
+    new QueuedUpdateRejectedError({ reason });
+  // Decided under the mutex before any persist, so a command can never be
+  // half-applied while an attempt runs or hands off.
+  const blockedByAttempt = (state: PersistedQueuedUpdate) =>
+    handoffAccepted
+      ? reject("handoff-accepted")
+      : state.stage === "updating"
+        ? reject("activation-in-progress")
+        : undefined;
+
+  const queue: QueuedUpdateShape["queue"] = (targetVersion) =>
+    commit(
+      (state) => {
+        if (!isExactServiceVersion(targetVersion)) return reject("invalid-version");
+        if (targetVersion === installedVersion) return reject("already-installed");
+        if (state.targetVersion === targetVersion && state.stage !== "failed") return undefined;
+        return blockedByAttempt(state) ?? { version: 1, stage: "downloading", targetVersion };
+      },
+      { wake: true },
+    );
+
+  const cancel: QueuedUpdateShape["cancel"] = commit(
+    (state) =>
+      state.stage === "current" ? undefined : (blockedByAttempt(state) ?? currentInstalled),
+    { wake: true },
+  );
+
+  const retry: QueuedUpdateShape["retry"] = commit(
+    (state) =>
+      blockedByAttempt(state) ??
+      (state.stage === "failed"
+        ? { version: 1, stage: "downloading", targetVersion: state.targetVersion }
+        : reject("nothing-to-retry")),
+    { wake: true },
+  );
+
+  const awaitState: QueuedUpdateShape["awaitState"] = (predicate) =>
+    Effect.suspend(() => {
+      const state = snapshot();
+      if (predicate(state)) return Effect.succeed(state);
+      const waiter = { predicate, deferred: Deferred.makeUnsafe<QueuedUpdateState>() };
+      waiters.add(waiter);
+      return Deferred.await(waiter.deferred).pipe(
+        Effect.onInterrupt(() => Effect.sync(() => waiters.delete(waiter))),
+      );
+    });
+
+  return QueuedUpdate.of({ queue, cancel, retry, getState: Effect.sync(snapshot), awaitState });
+});
