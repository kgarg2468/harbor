@@ -0,0 +1,971 @@
+import { assert, describe, it } from "@effect/vitest";
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import * as Deferred from "effect/Deferred";
+import * as Duration from "effect/Duration";
+import * as Effect from "effect/Effect";
+import * as Exit from "effect/Exit";
+import * as Fiber from "effect/Fiber";
+import * as FileSystem from "effect/FileSystem";
+import * as Path from "effect/Path";
+import * as PlatformError from "effect/PlatformError";
+import * as Schema from "effect/Schema";
+import * as Scope from "effect/Scope";
+import { TestClock } from "effect/testing";
+
+import {
+  make,
+  QueuedUpdateRejectedError,
+  QueuedUpdateStateError,
+  QueuedUpdateStepError,
+  type ActivationDeclined,
+  type QueuedUpdateCommandError,
+  type QueuedUpdateDependencies,
+  type QueuedUpdateShape,
+  type StagedArtifact,
+} from "./queuedUpdate.ts";
+
+const INSTALLED = "1.1.0";
+const TARGET = "1.2.0";
+const NEWER = "1.3.0";
+const POLL = Duration.minutes(5);
+
+type Activate = QueuedUpdateDependencies["tryActivate"];
+type Stage = QueuedUpdateDependencies["stage"];
+
+const UnknownJson = Schema.fromJsonString(Schema.Unknown);
+const decodeJson = Schema.decodeUnknownEffect(UnknownJson);
+const encodeJson = Schema.encodeSync(UnknownJson);
+const isRejected = Schema.is(QueuedUpdateRejectedError);
+
+const artifactFor = (version: string): StagedArtifact => ({
+  version,
+  artifactId: `artifact-${version}`,
+});
+
+const declined =
+  (status: ActivationDeclined["status"], reason: string): Activate =>
+  () =>
+    Effect.succeed({ status, reason });
+
+const rejectedReason = (error: QueuedUpdateCommandError) =>
+  error._tag === "QueuedUpdateRejectedError"
+    ? error.reason
+    : assert.fail(`expected a rejection, got ${error._tag}`);
+
+/** Staging that blocks until interrupted, reporting when it is actually running and when it was interrupted. */
+const blockedStaging = Effect.fn("blockedStaging")(function* () {
+  const started = yield* Deferred.make<void>();
+  const interrupted = yield* Deferred.make<void>();
+  const stage: Stage = () =>
+    Deferred.succeed(started, undefined).pipe(
+      Effect.andThen(Effect.never),
+      Effect.onInterrupt(() => Deferred.succeed(interrupted, undefined)),
+    );
+  return { stage, started, interrupted };
+});
+
+/**
+ * Fake stager/activator with swappable behavior plus call logs and the state
+ * file contents observed at each call, so tests can prove intent was durable
+ * before the side effect started.
+ */
+const makeFakes = Effect.fn("makeFakes")(function* (statePath: string) {
+  const fs = yield* FileSystem.FileSystem;
+  const readState = fs.readFileString(statePath).pipe(Effect.flatMap(decodeJson));
+  const stageCalls: Array<string> = [];
+  const activateCalls: Array<StagedArtifact> = [];
+  const stateAtStage: Array<unknown> = [];
+  const stateAtActivate: Array<unknown> = [];
+  const fakes = {
+    stageCalls,
+    activateCalls,
+    stateAtStage,
+    stateAtActivate,
+    readState,
+    stage: ((version) => Effect.succeed(artifactFor(version))) as Stage,
+    activate: declined("busy", "agent running") as Activate,
+  };
+  const deps = {
+    stage: (version: string) =>
+      Effect.gen(function* () {
+        stageCalls.push(version);
+        stateAtStage.push(yield* readState.pipe(Effect.orDie));
+        return yield* fakes.stage(version);
+      }),
+    tryActivate: (staged: StagedArtifact, onHandoffAccepted: Effect.Effect<void>) =>
+      Effect.gen(function* () {
+        activateCalls.push(staged);
+        stateAtActivate.push(yield* readState.pipe(Effect.orDie));
+        return yield* fakes.activate(staged, onHandoffAccepted);
+      }),
+  };
+  return { fakes, deps };
+});
+
+/** The real filesystem, except that `rename` fails once after `failNextRename` and reports it through `failed`. */
+const faultyRename = Effect.fn("faultyRename")(function* () {
+  const fs = yield* FileSystem.FileSystem;
+  const failed = yield* Deferred.make<void>();
+  let failNext = false;
+  const fileSystem = FileSystem.FileSystem.of({
+    ...fs,
+    rename: (from, to) =>
+      Effect.suspend(() => {
+        if (!failNext) return fs.rename(from, to);
+        failNext = false;
+        return Deferred.succeed(failed, undefined).pipe(
+          Effect.andThen(
+            Effect.fail(
+              PlatformError.systemError({
+                _tag: "Unknown",
+                module: "FileSystem",
+                method: "rename",
+                description: "injected rename failure",
+              }),
+            ),
+          ),
+        );
+      }),
+  });
+  return {
+    fileSystem,
+    failed,
+    failNextRename: () => {
+      failNext = true;
+    },
+  };
+});
+
+const setup = Effect.fn("setup")(function* (options?: {
+  readonly installedVersion?: string;
+  readonly statePath?: string;
+  readonly scope?: Scope.Scope;
+  readonly fileSystem?: FileSystem.FileSystem;
+}) {
+  const fs = yield* FileSystem.FileSystem;
+  const path = yield* Path.Path;
+  const statePath =
+    options?.statePath ??
+    path.join(
+      yield* fs.makeTempDirectoryScoped({ prefix: "t3-queued-update-test-" }),
+      "runtime",
+      "queued-update.json",
+    );
+  const { fakes, deps } = yield* makeFakes(statePath);
+  const controller = yield* make({
+    statePath,
+    installedVersion: options?.installedVersion ?? INSTALLED,
+    pollInterval: POLL,
+    ...deps,
+  }).pipe(
+    options?.scope ? Scope.provide(options.scope) : (effect) => effect,
+    options?.fileSystem
+      ? Effect.provideService(FileSystem.FileSystem, options.fileSystem)
+      : (effect) => effect,
+  );
+  return { controller, fakes, statePath };
+});
+
+/**
+ * Activation answers definitively (busy or a typed failure) but the durable
+ * transition out of `updating` fails once. The reservation must hold until the
+ * answer is durable, then recover on the poll interval without re-asking.
+ */
+const persistFailureRecovers = (answer: "busy" | "failure") =>
+  provide(
+    Effect.gen(function* () {
+      const faulty = yield* faultyRename();
+      const { controller, fakes } = yield* setup({ fileSystem: faulty.fileSystem });
+      const asked = yield* Deferred.make<void>();
+      const release = yield* Deferred.make<void>();
+      fakes.activate = () =>
+        Deferred.succeed(asked, undefined).pipe(
+          Effect.andThen(Deferred.await(release)),
+          Effect.andThen(
+            answer === "busy"
+              ? Effect.succeed({ status: "busy" as const, reason: "agent running" })
+              : Effect.fail(
+                  new QueuedUpdateStepError({ step: "activate", reason: "launcher rejected" }),
+                ),
+          ),
+        );
+      const reserved = {
+        version: 1,
+        stage: "updating",
+        targetVersion: TARGET,
+        staged: artifactFor(TARGET),
+      };
+
+      yield* controller.queue(TARGET);
+      yield* Deferred.await(asked);
+      faulty.failNextRename();
+      yield* Deferred.succeed(release, undefined);
+      yield* Deferred.await(faulty.failed);
+
+      assert.equal((yield* controller.getState).stage, "updating");
+      assert.deepStrictEqual(yield* fakes.readState, reserved);
+      assert.equal(
+        rejectedReason(yield* controller.cancel.pipe(Effect.flip)),
+        "activation-in-progress",
+      );
+
+      yield* Effect.yieldNow;
+      yield* TestClock.adjust(POLL);
+      const expectedStage = answer === "busy" ? "queued" : "failed";
+      const expectedReason = answer === "busy" ? "busy: agent running" : "launcher rejected";
+      const recovered = yield* awaitStage(controller, expectedStage);
+      assert.equal(recovered.reason, expectedReason);
+      assert.deepStrictEqual(yield* fakes.readState, {
+        ...reserved,
+        stage: expectedStage,
+        reason: expectedReason,
+      });
+      assert.equal(fakes.activateCalls.length, 1);
+      assert.equal((yield* controller.cancel).stage, "current");
+    }),
+  );
+
+const awaitStage = (controller: QueuedUpdateShape, stage: string, targetVersion?: string) =>
+  controller.awaitState(
+    (state) =>
+      state.stage === stage &&
+      (targetVersion === undefined || state.targetVersion === targetVersion),
+  );
+
+const provide = <A, E>(
+  effect: Effect.Effect<A, E, FileSystem.FileSystem | Path.Path | Scope.Scope>,
+) => effect.pipe(Effect.scoped, Effect.provide(NodeServices.layer));
+
+describe("queuedUpdate", () => {
+  it.effect("starts current without touching the filesystem when no state exists", () =>
+    provide(
