+        assert.deepStrictEqual(fakes.stateAtActivate, [
+          { version: 1, stage: "updating", targetVersion: TARGET, staged: artifactFor(TARGET) },
+        ]);
+        assert.deepStrictEqual(fakes.activateCalls, [artifactFor(TARGET)]);
+        assert.deepStrictEqual(yield* fakes.readState, {
+          version: 1,
+          stage: "updating",
