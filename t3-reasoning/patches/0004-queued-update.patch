+
+  it.effect("malformed state fails closed without rewriting the file", () =>
+    provide(
+      Effect.gen(function* () {
+        const fs = yield* FileSystem.FileSystem;
+        const path = yield* Path.Path;
+        const root = yield* fs.makeTempDirectoryScoped({ prefix: "t3-queued-update-test-" });
+        for (const contents of [
