+      expect(f.calls).toEqual([]);
+    },
+  );
+  it.each([
+    "CFBundleIdentifier",
+    "CFBundleName",
+    "CFBundleShortVersionString",
+    "CFBundleVersion",
+    "CFBundleURLTypes",
+  ])("rejects wrong %s", async (field) => {
+    const f = await fixture();
+    f.plist[field] = "wrong";
+    await expect(f.make().prepare(f.descriptor)).rejects.toThrow();
+  });
+  it.each(["x64", "empty-asar", "missing-asar", "app-update.yml", "extra-root"])(
+    "rejects %s",
+    async (kind) => {
+      const f = await fixture();
+      if (kind === "x64") f.behavior.arch = "x86_64";
+      if (kind === "empty-asar")
+        await fs.writeFile(path.join(f.source, "Contents/Resources/app.asar"), "");
+      if (kind === "missing-asar")
+        await fs.unlink(path.join(f.source, "Contents/Resources/app.asar"));
+      if (kind === "app-update.yml")
+        await fs.writeFile(path.join(f.source, "Contents/Resources/app-update.yml"), "x");
+      if (kind === "extra-root") f.behavior.extraRoot = true;
+      await expect(f.make().prepare(f.descriptor)).rejects.toThrow();
+    },
+  );
+  it("rejects invalid resources suffix and parent without write access", async () => {
+    const f = await fixture();
+    f.env.resourcesPath += "/app.asar";
+    await expect(f.make().prepare(f.descriptor)).rejects.toThrow("resources suffix");
+    f.env.resourcesPath = path.join(f.installed, "Contents/Resources");
+    f.seams.fs = {
+      ...fs,
+      access: async () => {
