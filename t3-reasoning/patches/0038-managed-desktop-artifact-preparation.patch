+  it("preserves an already valid custom-build signature", async () => {
+    const f = await fixture();
+    const p = f.make();
+    const token = await p.prepare(f.descriptor);
+    expect(p.isPrepared(token)).toBe(true);
+    expect(f.calls.filter(([command]) => command === "/usr/bin/codesign")).toEqual([
+      ["/usr/bin/codesign", ["--verify", "--deep", "--strict", expect.any(String)]],
