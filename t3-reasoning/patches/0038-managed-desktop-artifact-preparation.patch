+  });
+  it("rejects the first signature failure without repairing the artifact", async () => {
+    const f = await fixture();
+    // A second verification would succeed: the old repair fallback accepted this.
+    f.behavior.verifyFailures = 1;
+    await expect(f.make().prepare(f.descriptor)).rejects.toThrow("invalid signature");
