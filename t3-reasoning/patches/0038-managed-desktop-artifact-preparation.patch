+// @effect-diagnostics nodeBuiltinImport:off -- Tests use isolated fixture trees and fake native process runners.
+import { afterEach, describe, expect, it } from "@effect/vitest";
+import * as fs from "node:fs/promises";
+import path from "node:path";
+import os from "node:os";
+import { createHash } from "node:crypto";
+import { crc32, deflateRawSync } from "node:zlib";
+import type { ManagedDesktopArtifactDescriptor } from "@t3tools/contracts";
+import { managedDesktopArtifactStorageSegments } from "@t3tools/contracts";
+import { createManagedDesktopArtifactPreparer } from "./ManagedDesktopArtifact.ts";
+
+// Minimal stored ZIP; fake ditto uses a fixture, never executes host tools.
+function zip(
+  entries: Array<{
+    name: string;
+    contents?: string;
+    mode?: number;
+    deflate?: boolean;
+    claimedSize?: number;
+  }>,
+): Buffer {
+  const locals: Buffer[] = [];
+  const central: Buffer[] = [];
+  let offset = 0;
+  for (const entry of entries) {
+    const name = Buffer.from(entry.name);
+    const contents = Buffer.from(entry.contents ?? "fixture");
+    const data = entry.deflate ? deflateRawSync(contents) : contents;
+    const size = entry.claimedSize ?? contents.length;
+    const local = Buffer.alloc(30);
+    local.writeUInt32LE(0x04034b50);
+    local.writeUInt32LE(data.length, 18);
+    local.writeUInt16LE(entry.deflate ? 8 : 0, 8);
+    local.writeUInt32LE(crc32(contents), 14);
+    local.writeUInt32LE(size, 22);
+    local.writeUInt16LE(name.length, 26);
+    locals.push(local, name, data);
+    const header = Buffer.alloc(46);
+    header.writeUInt32LE(0x02014b50);
+    header.writeUInt32LE(data.length, 20);
+    header.writeUInt16LE(entry.deflate ? 8 : 0, 10);
+    header.writeUInt32LE(crc32(contents), 16);
+    header.writeUInt32LE(size, 24);
+    header.writeUInt16LE(name.length, 28);
+    header.writeUInt32LE(((entry.mode ?? 0o100644) << 16) >>> 0, 38);
+    header.writeUInt32LE(offset, 42);
+    central.push(header, name);
+    offset += local.length + name.length + data.length;
+  }
+  const directory = Buffer.concat(central);
+  const end = Buffer.alloc(22);
+  end.writeUInt32LE(0x06054b50);
+  end.writeUInt16LE(entries.length, 8);
+  end.writeUInt16LE(entries.length, 10);
+  end.writeUInt32LE(directory.length, 12);
+  end.writeUInt32LE(offset, 16);
+  return Buffer.concat([...locals, directory, end]);
+}
+const roots: string[] = [];
+const cleanups: Array<() => Promise<void>> = [];
+afterEach(async () => {
+  for (const cleanup of cleanups.splice(0)) await cleanup();
+  for (const root of roots.splice(0)) await fs.rm(root, { recursive: true, force: true });
+});
+async function fixture(archiveBytes = zip([{ name: "Product.app/Contents/Info.plist" }])) {
+  const root = await fs.realpath(await fs.mkdtemp(path.join(os.tmpdir(), "artifact-test-")));
+  roots.push(root);
+  const installed = path.join(root, "Applications/Product.app");
+  const source = path.join(root, "fixture/Product.app");
+  await fs.mkdir(path.join(installed, "Contents/Resources"), { recursive: true });
+  await fs.mkdir(path.join(source, "Contents/Resources"), { recursive: true });
+  await fs.mkdir(path.join(source, "Contents/MacOS"));
+  await fs.writeFile(path.join(source, "Contents/Resources/app.asar"), "asar");
+  await fs.writeFile(path.join(source, "Contents/Info.plist"), "fixture plist");
+  await fs.writeFile(path.join(source, "Contents/MacOS/Product"), "fixture arm64", { mode: 0o755 });
+  const descriptor: ManagedDesktopArtifactDescriptor = {
+    schemaVersion: 1,
+    presentationVariant: "reasoning",
+    releaseArtifactId: "reasoning-darwin-arm64",
+    targetVersion: "0.0.39-nightly.20260910.0.managed.1.paaaaaaaaaaaa",
+    bytes: archiveBytes.length,
+    sha256: createHash("sha256").update(archiveBytes).digest("hex"),
+    manifestSha256: "b".repeat(64),
+    releaseInputSha256: "a".repeat(64),
+  };
+  const archive = path.join(root, ...managedDesktopArtifactStorageSegments(descriptor));
+  await fs.mkdir(path.dirname(archive), { recursive: true });
+  await fs.writeFile(archive, archiveBytes);
+  const plist: Record<string, unknown> = {
+    CFBundleIdentifier: "com.example.product",
+    CFBundleName: "Product",
+    CFBundleExecutable: "Product",
+    CFBundleShortVersionString: descriptor.targetVersion,
+    CFBundleVersion: descriptor.targetVersion,
+    CFBundleURLTypes: [{ CFBundleURLSchemes: ["product", "product-dev"] }],
+  };
+  const env = {
+    baseDir: root,
+    resourcesPath: path.join(installed, "Contents/Resources"),
+    isPackaged: true,
+    platform: "darwin",
+    managedPresentationIdentity: {
+      presentationVariant: "reasoning" as const,
+      bundleId: "com.example.product",
+      productName: "Product",
+      urlSchemes: ["product", "product-dev"],
+    },
+  };
+  const calls: Array<[string, readonly string[]]> = [];
+  const behavior = {
+    arch: "arm64",
+    verifyFailures: 0,
+    extraRoot: false,
+  };
+  const run = async (command: string, args: readonly string[]) => {
+    calls.push([command, args]);
+    if (command === "/usr/bin/ditto") {
+      if (args[0] === "-x") {
+        expect(args[2]).not.toBe(archive);
+        await fs.cp(source, path.join(args[3]!, "Product.app"), {
+          recursive: true,
+          verbatimSymlinks: true,
+        });
+        if (behavior.extraRoot) await fs.writeFile(path.join(args[3]!, "extra"), "x");
+      } else await fs.cp(args[0]!, args[1]!, { recursive: true, verbatimSymlinks: true });
+    } else if (command === "/usr/bin/plutil") return JSON.stringify(plist);
+    else if (command === "/usr/bin/lipo") return behavior.arch;
+    else if (command === "/usr/bin/codesign") {
+      if (args[0] === "--verify" && behavior.verifyFailures-- > 0)
+        throw new Error("invalid signature");
+    } else throw new Error("unexpected process");
+    return "";
+  };
+  const seams = { fs, run, temporaryDirectory: root };
+  const make = () => createManagedDesktopArtifactPreparer(env, seams);
+  return { root, source, installed, descriptor, archive, plist, env, behavior, calls, seams, make };
+}
+describe("managed desktop artifact preparation", () => {
+  it("preserves substituted staging paths during cleanup", async () => {
+    const f = await fixture();
+    const p = f.make();
+    const token = await p.prepare(f.descriptor);
+    const staged = f.calls.find(
+      ([command, args]) => command.endsWith("/ditto") && args.length === 2,
+    )![1][1]!;
+    await fs.rename(staged, staged + ".original");
+    await fs.mkdir(staged);
+    await fs.writeFile(path.join(staged, "unowned"), "keep");
+    await p.cancel(token);
+    expect(await fs.readFile(path.join(staged, "unowned"), "utf8")).toBe("keep");
+    expect(p.isPrepared(token)).toBe(false);
+  });
+  it("hands authenticated bytes to extraction through stdin despite pathname replacement", async () => {
+    const f = await fixture();
+    const authenticated = await fs.readFile(f.archive);
+    f.seams.fs = {
+      ...fs,
+      mkdir: (async (...args: Parameters<typeof fs.mkdir>) => {
+        const result = await fs.mkdir(...args);
+        if (path.basename(String(args[0])) === "extracted") {
+          await fs.writeFile(
+            path.join(path.dirname(String(args[0])), "archive.zip"),
+            "substituted",
+          );
+          await fs.writeFile(f.archive, "also substituted");
+        }
+        return result;
+      }) as typeof fs.mkdir,
+    };
+    const calls: Buffer[] = [];
+    const original = f.seams.run;
+    const p = createManagedDesktopArtifactPreparer(f.env, {
+      ...f.seams,
+      run: async (command, args, options) => {
+        if (args[0] === "-x") {
+          expect(args[2]).toBe("-");
+          calls.push(options!.input!);
+        }
+        return original(command, args);
+      },
+    });
+    const token = await p.prepare(f.descriptor);
+    expect(calls).toEqual([authenticated]);
+    await p.cancel(token);
+  });
+  it("rejects actual expansion beyond declared size before native extraction", async () => {
+    const f = await fixture(
+      zip([
+        {
+          name: "Product.app/payload",
+          contents: "x".repeat(10 * 1024 * 1024),
+          deflate: true,
+          claimedSize: 1,
+        },
+      ]),
+    );
+    await expect(f.make().prepare(f.descriptor)).rejects.toThrow();
+    expect(f.calls).toEqual([]);
+  });
+  it.each(["descriptor", "zip64", "local-size", "local-crc", "payload-crc", "unsupported-flag"])(
+    "rejects ZIP %s before extraction",
+    async (kind) => {
+      const bytes = zip([{ name: "Product.app/payload" }]);
+      const central = bytes.readUInt32LE(bytes.length - 6);
+      if (kind === "descriptor" || kind === "unsupported-flag") {
+        bytes.writeUInt16LE(kind === "descriptor" ? 8 : 16, 6);
+        bytes.writeUInt16LE(kind === "descriptor" ? 8 : 16, central + 8);
+      }
+      if (kind === "zip64") {
+        bytes.writeUInt32LE(0xffffffff, 22);
+        bytes.writeUInt32LE(0xffffffff, central + 24);
+      }
+      if (kind === "local-size") bytes.writeUInt32LE(123, 22);
+      if (kind === "local-crc") bytes.writeUInt32LE(123, 14);
+      if (kind === "payload-crc") {
+        bytes.writeUInt32LE(123, 14);
+        bytes.writeUInt32LE(123, central + 16);
+      }
+      const f = await fixture(bytes);
+      await expect(f.make().prepare(f.descriptor)).rejects.toThrow();
+      expect(f.calls).toEqual([]);
+    },
+  );
+  it.each(["validation", "extraction", "staging", "signature"])(
+    "stops after abort during %s",
+    async (boundary) => {
+      const f = await fixture();
+      const controller = new AbortController();
+      const original = f.seams.run;
+      let abortedAt = -1;
+      f.seams.run = async (command, args) => {
+        const result = await original(command, args);
+        if (
+          (boundary === "validation" && command.endsWith("/plutil")) ||
+          (boundary === "extraction" && args[0] === "-x") ||
+          (boundary === "staging" && command.endsWith("/ditto") && args.length === 2) ||
+          (boundary === "signature" && command.endsWith("/codesign"))
