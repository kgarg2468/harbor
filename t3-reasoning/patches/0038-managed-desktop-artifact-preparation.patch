+// @effect-diagnostics nodeBuiltinImport:off globalTimers:off -- Native preparation adapter needs no-follow file handles, process tools, and owned token expiry outside Effect.
+import { constants } from "node:fs";
+import * as fs from "node:fs/promises";
+import path from "node:path";
+import os from "node:os";
+import { createHash, randomUUID } from "node:crypto";
+import { execFile } from "node:child_process";
+import { crc32, inflateRawSync } from "node:zlib";
+import {
+  ManagedDesktopArtifactDescriptor,
+  managedDesktopArtifactStorageSegments,
+} from "@t3tools/contracts";
+import * as Schema from "effect/Schema";
+import type { ManagedDesktopPresentationIdentity } from "../app/DesktopEnvironment.ts";
+
+export interface ManagedDesktopArtifactEnvironment {
+  readonly baseDir: string;
+  readonly resourcesPath: string;
+  readonly isPackaged: boolean;
+  readonly platform: string;
+  readonly managedPresentationIdentity: ManagedDesktopPresentationIdentity;
+}
+export interface ManagedDesktopArtifactSeams {
+  readonly fs: typeof fs;
+  readonly run: (
+    command: string,
+    args: readonly string[],
+    options?: { readonly input?: Buffer; readonly signal?: AbortSignal },
+  ) => Promise<string>;
+  readonly temporaryDirectory: string;
+}
+const defaults: ManagedDesktopArtifactSeams = {
+  fs,
+  run: (command, args, options) =>
+    new Promise((resolve, reject) => {
+      let failure: Error | null = null;
+      let output = "";
+      const child = execFile(command, [...args], { signal: options?.signal }, (error, stdout) => {
+        failure = error;
+        output = stdout;
+      });
+      // An abort callback can precede exit; cleanup must await the actual close.
+      child.once("close", () => {
+        if (failure) reject(failure);
+        else resolve(output);
+      });
+      child.stdin?.on("error", () => {});
+      child.stdin?.end(options?.input);
+    }),
+  temporaryDirectory: os.tmpdir(),
+};
+declare const preparedBrand: unique symbol;
+/** Only this preparer's WeakMap can authenticate a token. No filesystem paths are exposed. */
+export interface PreparedManagedDesktopArtifact {
+  readonly [preparedBrand]: true;
+}
+const fail = (message: string): never => {
+  throw new Error(`Managed desktop artifact: ${message}`);
+};
+const inside = (root: string, target: string) =>
+  target === root || target.startsWith(root + path.sep);
+
+/** Preflight before invoking an extractor: reject ZIP ambiguity, traversal and symlink writes. */
+function checkZip(zip: Buffer): void {
+  if (zip.length < 22) fail("invalid ZIP directory");
+  let end = zip.length - 22;
+  while (end >= Math.max(0, zip.length - 65557) && zip.readUInt32LE(end) !== 0x06054b50) end--;
+  if (end < Math.max(0, zip.length - 65557)) fail("invalid ZIP directory");
+  if (
+    end + 22 + zip.readUInt16LE(end + 20) !== zip.length ||
+    zip.readUInt16LE(end + 4) !== 0 ||
+    zip.readUInt16LE(end + 6) !== 0
+  )
+    fail("unsupported ZIP");
+  const count = zip.readUInt16LE(end + 10);
+  let cursor = zip.readUInt32LE(end + 16);
+  if (
+    count === 0 ||
+    count === 65535 ||
+    zip.readUInt16LE(end + 8) !== count ||
+    cursor + zip.readUInt32LE(end + 12) !== end
+  )
+    fail("unsupported ZIP directory");
+  const checkExtras = (start: number, length: number) => {
+    const limit = start + length;
+    for (let position = start; position < limit;) {
+      if (position + 4 > limit) fail("invalid ZIP extra field");
+      const tag = zip.readUInt16LE(position);
+      const size = zip.readUInt16LE(position + 2);
+      // Only timestamp/UID metadata; path overrides, ASi symlinks and ZIP64 are rejected.
+      if (![0x5455, 0x7875, 0x7855, 0x5855, 0x000a].includes(tag) || position + 4 + size > limit)
+        fail("unsupported ZIP extra field");
+      position += 4 + size;
+    }
+  };
+  const names = new Set<string>();
+  const links = new Set<string>();
+  let expanded = 0;
+  let localEnd = 0;
+  for (let i = 0; i < count; i++) {
+    if (cursor + 46 > end || zip.readUInt32LE(cursor) !== 0x02014b50) fail("invalid ZIP entry");
+    const flags = zip.readUInt16LE(cursor + 8);
+    const method = zip.readUInt16LE(cursor + 10);
+    const compressed = zip.readUInt32LE(cursor + 20);
+    const size = zip.readUInt32LE(cursor + 24);
+    const length = zip.readUInt16LE(cursor + 28);
+    const next =
+      cursor + 46 + length + zip.readUInt16LE(cursor + 30) + zip.readUInt16LE(cursor + 32);
+    if (
+      next > end ||
+      (flags & ~0x800) !== 0 ||
+      ![0, 8].includes(method) ||
+      size === 0xffffffff ||
+      compressed === 0xffffffff ||
+      zip.readUInt16LE(cursor + 34) !== 0
+    )
+      fail("unsupported ZIP entry");
+    const rawName = zip.subarray(cursor + 46, cursor + 46 + length);
+    const name = rawName.toString("utf8");
+    if (!Buffer.from(name).equals(rawName)) fail("invalid ZIP filename encoding");
+    const clean = name.endsWith("/") ? name.slice(0, -1) : name;
+    if (
+      !clean ||
+      name.includes("\\") ||
+      name.includes(":") ||
+      name.includes("\0") ||
+      clean.split("/").some((part) => !part || part === "." || part === "..") ||
+      names.has(clean.normalize("NFD").toLowerCase())
+    )
+      fail("unsafe ZIP path");
+    names.add(clean.normalize("NFD").toLowerCase());
+    checkExtras(cursor + 46 + length, zip.readUInt16LE(cursor + 30));
+    const local = zip.readUInt32LE(cursor + 42);
+    if (
+      local !== localEnd ||
+      local + 30 > zip.readUInt32LE(end + 16) ||
+      zip.readUInt32LE(local) !== 0x04034b50 ||
+      zip.readUInt16LE(local + 6) !== flags ||
+      zip.readUInt16LE(local + 8) !== method ||
+      zip.readUInt32LE(local + 14) !== zip.readUInt32LE(cursor + 16) ||
+      zip.readUInt32LE(local + 18) !== compressed ||
+      zip.readUInt32LE(local + 22) !== size
+    )
+      fail("ZIP header mismatch");
+    const localLength = zip.readUInt16LE(local + 26);
+    const data = local + 30 + localLength + zip.readUInt16LE(local + 28);
+    if (
+      !zip.subarray(local + 30, local + 30 + localLength).equals(rawName) ||
+      data + compressed > zip.readUInt32LE(end + 16)
+    )
+      fail("ZIP header mismatch");
+    checkExtras(local + 30 + localLength, zip.readUInt16LE(local + 28));
+    localEnd = data + compressed;
+    const mode = zip.readUInt32LE(cursor + 38) >>> 16;
+    const kind = mode & 0o170000;
+    if (![0, 0o100000, 0o040000, 0o120000].includes(kind)) fail("special ZIP entry");
+    if (kind === 0o120000 && size > 4096) fail("oversized symlink");
+    // Bound actual output, rather than relying on the untrusted directory sizes.
+    const remaining = Math.min(512 * 1024 ** 2, 4 * 1024 ** 3 - expanded);
+    if (size > remaining || remaining <= 0) fail("ZIP expansion limit");
+    const packed = zip.subarray(data, data + compressed);
+    const contents =
+      method === 0
+        ? packed
+        : inflateRawSync(packed, {
+            maxOutputLength: Math.max(1, Math.min(size + 1, remaining)),
+          });
+    if (contents.length !== size || crc32(contents) !== zip.readUInt32LE(cursor + 16))
+      fail("ZIP payload size/CRC mismatch");
+    expanded += contents.length;
+    if (kind === 0o120000) {
+      const target = contents.toString("utf8");
+      if (!Buffer.from(target).equals(contents)) fail("invalid symlink encoding");
+      if (
+        !target ||
+        target.includes("\0") ||
+        target.includes("\\") ||
+        path.isAbsolute(target) ||
+        !inside("/tree", path.resolve("/tree", path.dirname(clean), target))
+      )
+        fail("ZIP symlink escape");
+      links.add(clean.normalize("NFD").toLowerCase());
+    }
+    cursor = next;
+  }
+  if (cursor !== end || localEnd !== zip.readUInt32LE(end + 16)) fail("ZIP directory mismatch");
+  for (const name of names) {
+    for (let slash = name.indexOf("/"); slash !== -1; slash = name.indexOf("/", slash + 1))
+      if (links.has(name.slice(0, slash))) fail("ZIP writes through symlink");
+  }
+}
+
+export function createManagedDesktopArtifactPreparer(
+  environment: ManagedDesktopArtifactEnvironment,
+  seams: ManagedDesktopArtifactSeams = defaults,
+) {
+  const io = seams.fs;
+  const env = {
+    ...environment,
+    managedPresentationIdentity: Object.freeze({
+      ...environment.managedPresentationIdentity,
+      urlSchemes: Object.freeze([...environment.managedPresentationIdentity.urlSchemes]),
+    }),
+  };
+  const identity = env.managedPresentationIdentity;
+  const tokens = new WeakMap<
+    PreparedManagedDesktopArtifact,
+    {
+      descriptor: ManagedDesktopArtifactDescriptor;
+      installedBundle: string;
+      stagedBundle: string;
+      cleanup: () => Promise<void>;
+    }
+  >();
+  async function tree(root: string): Promise<void> {
+    const walk = async (entry: string): Promise<void> => {
+      const stat = await io.lstat(entry);
+      if (!inside(root, await io.realpath(entry))) fail("extracted symlink escape");
+      if (path.basename(entry).toLowerCase() === "app-update.yml")
+        fail("managed bundle contains app-update.yml");
+      if (stat.isSymbolicLink()) return;
+      if (stat.isDirectory()) {
+        for (const name of await io.readdir(entry)) await walk(path.join(entry, name));
+      } else if (!stat.isFile() || stat.nlink !== 1) fail("nonregular bundle entry");
+    };
+    if (!(await io.lstat(root)).isDirectory()) fail("bundle is not a directory");
+    await walk(root);
+  }
+  async function verify(
+    bundle: string,
+    descriptor: ManagedDesktopArtifactDescriptor,
+    run: ManagedDesktopArtifactSeams["run"],
+  ): Promise<void> {
+    await tree(bundle);
+    const plist = JSON.parse(
+      await run("/usr/bin/plutil", [
+        "-convert",
+        "json",
+        "-o",
+        "-",
+        path.join(bundle, "Contents/Info.plist"),
+      ]),
+    ) as Record<string, unknown>;
+    if (
+      plist.CFBundleIdentifier !== identity.bundleId ||
+      plist.CFBundleName !== identity.productName ||
+      (plist.CFBundleDisplayName !== undefined &&
+        plist.CFBundleDisplayName !== identity.productName) ||
+      plist.CFBundleShortVersionString !== descriptor.targetVersion ||
+      plist.CFBundleVersion !== descriptor.targetVersion
+    )
+      fail("bundle identity/version mismatch");
+    const types = plist.CFBundleURLTypes;
+    if (!Array.isArray(types)) fail("URL schemes mismatch");
+    const schemes: unknown[] = (types as Array<{ CFBundleURLSchemes?: unknown }>).flatMap(
+      (value) => (Array.isArray(value?.CFBundleURLSchemes) ? value.CFBundleURLSchemes : [null]),
+    );
+    if (JSON.stringify([...schemes].sort()) !== JSON.stringify([...identity.urlSchemes].sort()))
+      fail("URL schemes mismatch");
+    const executable = plist.CFBundleExecutable;
+    if (
+      typeof executable !== "string" ||
+      !executable ||
+      path.basename(executable) !== executable ||
+      executable === "." ||
+      executable === ".."
+    )
+      fail("invalid executable name");
+    const binary = path.join(bundle, "Contents/MacOS", executable as string);
+    const executableStat = await io.stat(binary);
+    if (
+      !executableStat.isFile() ||
+      (executableStat.mode & 0o111) === 0 ||
+      !(await run("/usr/bin/lipo", ["-archs", binary])).trim().split(/\s+/).includes("arm64")
+    )
+      fail("main executable is not arm64");
+    const asar = await io.stat(path.join(bundle, "Contents/Resources/app.asar"));
+    if (!asar.isFile() || asar.size === 0) fail("missing or empty app.asar");
+  }
+  return {
+    async prepare(
+      input: ManagedDesktopArtifactDescriptor,
+      options: { signal?: AbortSignal; ttlMs?: number } = {},
+    ): Promise<PreparedManagedDesktopArtifact> {
+      const descriptor = Object.freeze(
+        Schema.decodeUnknownSync(ManagedDesktopArtifactDescriptor)(input),
+      );
+      if (
+        !env.isPackaged ||
+        env.platform !== "darwin" ||
+        descriptor.presentationVariant !== identity.presentationVariant ||
+        path.basename(identity.productName) !== identity.productName
+      )
+        fail("unsupported managed environment");
+      const suffix = path.join(`${identity.productName}.app`, "Contents", "Resources");
+      if (
+        !path.isAbsolute(env.resourcesPath) ||
+        !env.resourcesPath.endsWith(path.sep + suffix) ||
+        path.normalize(env.resourcesPath) !== env.resourcesPath
+      )
+        fail("invalid packaged resources suffix");
+      const installedBundle = env.resourcesPath.slice(0, -"/Contents/Resources".length);
+      if (
+        (await io.realpath(installedBundle)) !== installedBundle ||
+        (await io.realpath(env.resourcesPath)) !== env.resourcesPath
+      )
+        fail("installed bundle symlink");
+      const parent = path.dirname(installedBundle);
+      const owned: Array<{ entry: string; dev: number; ino: number; real: string }> = [];
+      const own = async (entry: string) => {
+        const stat = await io.lstat(entry);
+        if (!stat.isDirectory() || stat.isSymbolicLink()) fail("staging directory substituted");
+        owned.push({ entry, dev: stat.dev, ino: stat.ino, real: await io.realpath(entry) });
+      };
+      let timer: ReturnType<typeof setTimeout> | undefined;
+      let token: PreparedManagedDesktopArtifact | undefined;
+      const cleanup = async () => {
+        if (timer) clearTimeout(timer);
+        options.signal?.removeEventListener("abort", onAbort);
+        if (token) tokens.delete(token);
+        for (const owner of owned.splice(0)) {
+          try {
+            const stat = await io.lstat(owner.entry);
+            if (
+              stat.isDirectory() &&
+              !stat.isSymbolicLink() &&
+              stat.dev === owner.dev &&
+              stat.ino === owner.ino &&
+              (await io.realpath(owner.entry)) === owner.real
+            )
+              await io.rm(owner.entry, { recursive: true, force: true });
+          } catch (error) {
+            if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error;
+          }
+        }
+      };
+      const onAbort = () => {
+        void cleanup().catch(() => {});
+      };
+      const cancelled = () => {
+        if (options.signal?.aborted) fail("preparation cancelled");
+      };
+      const run: ManagedDesktopArtifactSeams["run"] = async (command, args, processOptions) => {
+        cancelled();
+        const result = await seams.run(command, args, {
+          ...processOptions,
+          ...(options.signal ? { signal: options.signal } : {}),
+        });
+        cancelled();
+        return result;
+      };
+      try {
+        cancelled();
+        const createdRoot = await io.mkdtemp(
+          path.join(seams.temporaryDirectory, "managed-desktop-"),
+        );
+        await own(createdRoot);
+        cancelled();
+        const root = await io.realpath(createdRoot);
+        cancelled();
+        await io.chmod(root, 0o700);
+        const archive = path.join(
+          env.baseDir,
+          ...managedDesktopArtifactStorageSegments(descriptor),
+        );
+        if ((await io.realpath(archive)) !== archive) fail("archive symlink path");
+        cancelled();
+        const chunks: Buffer[] = [];
+        const source = await io.open(
+          archive,
+          constants.O_RDONLY | constants.O_NOFOLLOW | constants.O_NONBLOCK,
+        );
+        try {
+          const before = await source.stat();
+          if (!before.isFile() || before.nlink !== 1 || before.size !== descriptor.bytes)
+            fail("archive size/type mismatch");
+          {
+            const hash = createHash("sha256");
+            const buffer = Buffer.alloc(64 * 1024);
+            let bytes = 0;
+            while (true) {
+              cancelled();
+              const read = await source.read(buffer, 0, buffer.length, null);
+              if (!read.bytesRead) break;
+              bytes += read.bytesRead;
+              if (bytes > descriptor.bytes) fail("archive size mismatch");
+              hash.update(buffer.subarray(0, read.bytesRead));
+              chunks.push(Buffer.from(buffer.subarray(0, read.bytesRead)));
+            }
+            const after = await source.stat();
+            const current = await io.lstat(archive);
+            if (
+              bytes !== descriptor.bytes ||
+              hash.digest("hex") !== descriptor.sha256 ||
+              !current.isFile() ||
+              current.nlink !== 1 ||
+              after.nlink !== 1 ||
+              before.ino !== current.ino ||
+              before.dev !== current.dev ||
+              after.size !== before.size ||
+              after.mtimeMs !== before.mtimeMs ||
+              after.ctimeMs !== before.ctimeMs
+            )
+              fail("archive substituted or digest mismatch");
+          }
+        } finally {
+          await source.close();
+        }
+        const copy = Buffer.concat(chunks);
+        chunks.length = 0;
+        cancelled();
+        checkZip(copy);
+        const extracted = path.join(root, "extracted");
+        cancelled();
+        await io.mkdir(extracted, { mode: 0o700 });
+        await run("/usr/bin/ditto", ["-x", "-k", "-", extracted], { input: copy });
+        cancelled();
+        const entries = await io.readdir(extracted);
+        if (entries.length !== 1 || entries[0] !== `${identity.productName}.app`)
+          fail("expected exactly one product app");
+        const bundle = path.join(extracted, entries[0]!);
+        await verify(bundle, descriptor, run);
+        await io.access(parent, constants.W_OK);
+        cancelled();
+        // The staged app itself is a hidden direct sibling, on the installed volume.
+        const stagedBundle = path.join(
+          parent,
+          `.${identity.productName}.managed-${randomUUID()}.app`,
+        );
+        await io.mkdir(stagedBundle, { mode: 0o700 });
+        await own(stagedBundle);
+        await run("/usr/bin/ditto", [bundle, stagedBundle]);
+        await verify(stagedBundle, descriptor, run);
+        // Custom builds may arrive ad-hoc signed, but their original signature
+        // must verify. Re-signing here would accept a broken artifact seal.
+        await run("/usr/bin/codesign", ["--verify", "--deep", "--strict", stagedBundle]);
+        await verify(stagedBundle, descriptor, run);
+        cancelled();
+        const ttl = options.ttlMs ?? 15 * 60 * 1000;
+        if (!Number.isSafeInteger(ttl) || ttl <= 0 || ttl > 2 ** 31 - 1)
+          fail("invalid preparation TTL");
+        token = Object.freeze({}) as PreparedManagedDesktopArtifact;
+        tokens.set(token, { descriptor, installedBundle, stagedBundle, cleanup });
+        options.signal?.addEventListener("abort", onAbort, { once: true });
+        timer = setTimeout(() => {
+          void cleanup().catch(() => {});
+        }, ttl);
+        timer.unref();
+        return token;
+      } catch (error) {
+        await cleanup();
+        throw error;
+      }
+    },
+    isPrepared(token: PreparedManagedDesktopArtifact): boolean {
+      return tokens.has(token);
+    },
+    async cancel(token: PreparedManagedDesktopArtifact): Promise<void> {
+      await tokens.get(token)?.cleanup();
+    },
+  };
+}
