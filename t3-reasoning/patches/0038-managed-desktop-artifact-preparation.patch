+          abortedAt = f.calls.length;
+          controller.abort();
+        }
+        return result;
+      };
+      await expect(f.make().prepare(f.descriptor, { signal: controller.signal })).rejects.toThrow(
+        "cancelled",
+      );
+      expect(abortedAt).toBeGreaterThan(0);
+      expect(f.calls.length).toBe(abortedAt);
+      expect(await fs.readdir(path.dirname(f.installed))).toEqual(["Product.app"]);
+    },
+  );
+
+  it("returns an opaque identity-bound token and cancels only owned paths", async () => {
+    const f = await fixture();
+    const p = f.make();
+    const token = await p.prepare(f.descriptor);
+    cleanups.push(() => p.cancel(token));
+    expect(Object.keys(token)).toEqual([]);
+    expect(p.isPrepared(token)).toBe(true);
+    expect(f.make().isPrepared(token)).toBe(false);
+    const copy = f.calls.find(
+      ([command, args]) => command === "/usr/bin/ditto" && args.length === 2,
+    )!;
+    expect(path.dirname(copy[1][1]!)).toBe(path.dirname(f.installed));
+    expect(path.basename(copy[1][1]!)).toMatch(/^\.Product\.managed-.+\.app$/);
+    await p.cancel(token);
+    expect(p.isPrepared(token)).toBe(false);
+    expect(await fs.readFile(f.archive)).toBeTruthy();
+    expect(await fs.stat(f.installed)).toBeTruthy();
+    expect(await fs.readdir(path.dirname(f.installed))).toEqual(["Product.app"]);
+    expect(
+      (await fs.readdir(f.root)).filter((name) => name.startsWith("managed-desktop-")),
+    ).toEqual([]);
+  });
+  it.each(["../escape", "/absolute", "Product.app/../escape", "Product.app\\escape"])(
+    "rejects ZIP traversal %s before extraction",
+    async (name) => {
+      const f = await fixture(zip([{ name }]));
+      await expect(f.make().prepare(f.descriptor)).rejects.toThrow("unsafe ZIP path");
+      expect(f.calls).toEqual([]);
+    },
+  );
+  it("rejects ZIP symlink escapes and writes through symlinks", async () => {
+    for (const entries of [
+      [{ name: "Product.app/link", contents: "../../escape", mode: 0o120777 }],
+      [
+        { name: "Product.app/link", contents: "Contents", mode: 0o120777 },
+        { name: "Product.app/link/write" },
+      ],
+    ]) {
+      const f = await fixture(zip(entries));
+      await expect(f.make().prepare(f.descriptor)).rejects.toThrow(/symlink/);
+      expect(f.calls).toEqual([]);
+    }
+  });
+  it("rejects extracted symlinks escaping the app", async () => {
+    const f = await fixture();
+    await fs.symlink(f.root, path.join(f.source, "escape"));
+    await expect(f.make().prepare(f.descriptor)).rejects.toThrow("symlink escape");
+  });
+  it("accepts confined framework-style symlinks", async () => {
+    const f = await fixture();
+    await fs.symlink("Resources", path.join(f.source, "Contents/link"));
