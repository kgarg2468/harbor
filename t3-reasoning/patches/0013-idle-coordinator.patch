diff --git a/apps/server/src/cloud/idleUpdateCoordinator.test.ts b/apps/server/src/cloud/idleUpdateCoordinator.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6437fbebd3fbf8d3708411ff80204021a551244d
--- /dev/null
+++ b/apps/server/src/cloud/idleUpdateCoordinator.test.ts
@@ -0,0 +1,471 @@
+import { assert, describe, it } from "@effect/vitest";
+import * as Cause from "effect/Cause";
+import * as Deferred from "effect/Deferred";
+import * as Effect from "effect/Effect";
+import * as Exit from "effect/Exit";
+import * as Fiber from "effect/Fiber";
+import * as Scope from "effect/Scope";
+
+import { make as makeAdmission, UpdateAdmissionClosedError } from "../updateAdmission.ts";
+import { make as makeActivity, UpdateActivityUnavailableError } from "../updateActivity.ts";
+import { type IdleHandoffControl, make } from "./idleUpdateCoordinator.ts";
+import type { ActivationDeclined } from "./queuedUpdate.ts";
+
+const declined: ActivationDeclined = { status: "unknown", reason: "driver declined" };
+
+const setup = Effect.fn("setup")(function* () {
+  const admission = yield* makeAdmission();
+  const activity = yield* makeActivity();
+  const coordinator = make({ admission, activity });
+  let notified = 0;
+  const onHandoffAccepted = Effect.sync(() => {
+    notified += 1;
+  });
+  return { admission, activity, coordinator, onHandoffAccepted, notifications: () => notified };
+});
+
+type Setup = Effect.Success<ReturnType<typeof setup>>;
+
+/** Both gates open with nothing outstanding and no shutdown authorized. */
+const assertOpen = Effect.fn("assertOpen")(function* (env: Setup) {
+  assert.deepStrictEqual(yield* env.admission.state, { phase: "open", inFlight: 0 });
+  assert.include(yield* env.activity.state, { phase: "open", idleShutdownAuthorized: false });
+  assert.deepStrictEqual(yield* env.coordinator.state, { phase: "ready" });
+});
+
+/** Both gates closed: client commands rejected, activity sealed and shutdown authorized. */
+const assertLatched = Effect.fn("assertLatched")(function* (env: Setup) {
+  assert.deepStrictEqual(yield* env.admission.state, { phase: "maintenance", inFlight: 0 });
+  assert.include(yield* env.activity.state, { phase: "sealed", idleShutdownAuthorized: true });
+  const rejected = yield* env.admission.withAdmission(Effect.void).pipe(Effect.flip);
+  assert.instanceOf(rejected, UpdateAdmissionClosedError);
+  const sealed = yield* env.activity.acquire("root").pipe(Effect.flip);
+  assert.instanceOf(sealed, UpdateActivityUnavailableError);
+});
+
+/** Nobody else can take the retained permit: waiting maintenance never starts, claims answer busy. */
+const assertUnstealable = Effect.fn("assertUnstealable")(function* (env: Setup) {
+  const started = yield* Deferred.make<void>();
+  const waiting = yield* env.admission
+    .withMaintenance(Deferred.succeed(started, undefined))
+    .pipe(Effect.forkChild);
+  yield* Effect.yieldNow;
+  assert.isFalse(yield* Deferred.isDone(started));
+  yield* Fiber.interrupt(waiting);
+  assert.isFalse(yield* Deferred.isDone(started));
+  assert.deepStrictEqual(yield* env.admission.tryWithMaintenance(Effect.void), { status: "busy" });
+  assert.deepStrictEqual(yield* env.admission.tryWithHandoffMaintenance(() => Effect.void), {
+    status: "busy",
+  });
+});
+
+const isSettled = (fiber: Fiber.Fiber<unknown, unknown>) =>
+  Effect.sync(() => fiber.pollUnsafe() !== undefined);
+
+/**
+ * Forks an attempt into `scope` whose handoff runs `before`, then parks on
+ * `resume` and finishes with `after`. Resolves once the handoff is parked.
+ */
+const forkAttempt = Effect.fn("forkAttempt")(function* (
+  env: Setup,
+  scope: Scope.Scope,
+  before: (control: IdleHandoffControl) => Effect.Effect<void>,
+  after: (control: IdleHandoffControl) => Effect.Effect<ActivationDeclined, string>,
+) {
+  const parked = yield* Deferred.make<IdleHandoffControl>();
+  const resume = yield* Deferred.make<void>();
+  const fiber = yield* Effect.forkIn(
+    env.coordinator.tryActivate(
+      (control) =>
+        before(control).pipe(
+          Effect.andThen(Deferred.succeed(parked, control)),
+          Effect.andThen(Deferred.await(resume)),
+          Effect.andThen(Effect.suspend(() => after(control))),
+        ),
+      env.onHandoffAccepted,
+    ),
+    scope,
+  );
+  const control = yield* Deferred.await(parked);
+  return { fiber, control, resume };
+});
+
+describe("idleUpdateCoordinator", () => {
+  it.effect("declines at once while an agent holds a lease and leaves admission open", () =>
+    Effect.gen(function* () {
+      const env = yield* setup();
+      const lease = yield* env.activity.acquire("turn waiting for approval");
+
+      let invoked = false;
+      const outcome = yield* env.coordinator.tryActivate(() => {
+        invoked = true;
+        return Effect.succeed(declined);
+      }, env.onHandoffAccepted);
+      assert.deepStrictEqual(outcome, { status: "busy", reason: "1 agent operation(s) in flight" });
+      assert.isFalse(invoked);
+      assert.deepStrictEqual(yield* env.admission.state, { phase: "open", inFlight: 0 });
+      assert.include(yield* env.activity.state, { phase: "open", idleShutdownAuthorized: false });
+
+      // The approval that finishes the turn is still admitted.
+      const approved = yield* env.admission.withAdmission(Effect.sync(() => lease.release()));
+      assert.isUndefined(approved);
+      yield* assertOpen(env);
+
+      const blocker = env.activity.block("worker unavailable: fanout");
+      const blocked = yield* env.coordinator.tryActivate(
+        () => Effect.succeed(declined),
+        env.onHandoffAccepted,
+      );
+      assert.deepStrictEqual(blocked, {
+        status: "unknown",
+        reason: "activity is blocked: worker unavailable: fanout",
+      });
+      blocker.clear();
+      assert.equal(env.notifications(), 0);
+    }),
+  );
+
+  it.effect("declines while a client command is in flight without touching either gate", () =>
+    Effect.gen(function* () {
+      const env = yield* setup();
+      const release = yield* Deferred.make<void>();
+      const command = yield* env.admission
+        .withAdmission(Deferred.await(release))
+        .pipe(Effect.forkChild);
+      yield* Effect.yieldNow;
+
+      let invoked = false;
+      const outcome = yield* env.coordinator.tryActivate(() => {
+        invoked = true;
+        return Effect.succeed(declined);
+      }, env.onHandoffAccepted);
+      assert.equal(outcome.status, "busy");
+      assert.isFalse(invoked);
+      assert.deepStrictEqual(yield* env.admission.state, { phase: "open", inFlight: 1 });
+      assert.include(yield* env.activity.state, { phase: "open", idleShutdownAuthorized: false });
+
+      yield* Deferred.succeed(release, undefined);
+      yield* Fiber.join(command);
+      yield* assertOpen(env);
+    }),
+  );
+
+  it.effect("a root that acquires between the activity read and the seal defeats activation", () =>
+    Effect.gen(function* () {
+      const env = yield* setup();
+      // The coordinator reads this state, then the racing root acquires before
+      // the seal can be taken. Admission must reopen before any retry.
+      let lease: { release: () => void } | undefined;
+      const racing = {
+        ...env.activity,
+        state: Effect.tap(env.activity.state, () =>
+          Effect.map(Effect.orDie(env.activity.acquire("racing root")), (acquired) => {
+            lease = acquired;
+          }),
+        ),
+      };
+      const coordinator = make({ admission: env.admission, activity: racing });
+
+      let invoked = false;
+      const outcome = yield* coordinator.tryActivate(() => {
+        invoked = true;
+        return Effect.succeed(declined);
+      }, env.onHandoffAccepted);
+      assert.deepStrictEqual(outcome, { status: "busy", reason: "1 agent operation(s) in flight" });
+      assert.isFalse(invoked);
+      assert.deepStrictEqual(yield* env.admission.state, { phase: "open", inFlight: 0 });
+      assert.include(yield* env.activity.state, { phase: "open", outstanding: 1 });
+      lease?.release();
+      yield* assertOpen(env);
+    }),
+  );
+
+  it.effect(
+    "a successful seal rejects new admission and activity until a pre-dispatch exit restores both",
+    () =>
+      Effect.gen(function* () {
+        const env = yield* setup();
+        const scope = yield* Scope.make();
+
+        // Typed failure before dispatch.
+        const failing = yield* forkAttempt(
+          env,
+          scope,
+          () => Effect.void,
+          () => Effect.fail("preflight failed"),
+        );
+        yield* assertLatched(env);
+        assert.deepStrictEqual(yield* env.coordinator.state, { phase: "attempting" });
+        const again = yield* env.coordinator.tryActivate(
+          () => Effect.succeed(declined),
+          env.onHandoffAccepted,
+        );
+        assert.equal(again.status, "busy");
+        yield* Deferred.succeed(failing.resume, undefined);
+        const failed = yield* Fiber.join(failing.fiber).pipe(Effect.flip);
+        assert.equal(failed, "preflight failed");
+        yield* assertOpen(env);
+
+        // Synchronous throw while constructing the handoff.
+        const thrown = yield* env.coordinator
+          .tryActivate((): Effect.Effect<ActivationDeclined> => {
+            throw new Error("construction defect");
+          }, env.onHandoffAccepted)
+          .pipe(Effect.exit);
+        assert.isTrue(Exit.isFailure(thrown) && !Cause.hasInterrupts(thrown.cause));
+        yield* assertOpen(env);
+
+        // Cancellation before dispatch.
+        const cancelled = yield* forkAttempt(
+          env,
+          scope,
+          () => Effect.void,
+          () => Effect.succeed(declined),
+        );
+        yield* assertLatched(env);
+        yield* Fiber.interrupt(cancelled.fiber);
+        const exit = yield* Fiber.await(cancelled.fiber);
+        assert.isTrue(Exit.isFailure(exit) && Cause.hasInterrupts(exit.cause));
+        yield* assertOpen(env);
+
+        // A decline returned without any dispatch releases both gates too.
+        const answered = yield* env.coordinator.tryActivate(
+          () => Effect.succeed(declined),
+          env.onHandoffAccepted,
+        );
+        assert.deepStrictEqual(answered, declined);
+        yield* assertOpen(env);
+
+        // Controls from exited attempts are inert and cannot retain a later claim.
+        const live = yield* forkAttempt(
+          env,
+          scope,
+          () => Effect.void,
+          () => Effect.succeed(declined),
+        );
+        failing.control.dispatchStarted();
+        yield* failing.control.accepted;
+        cancelled.control.dispatchStarted();
+        yield* cancelled.control.accepted;
+        assert.deepStrictEqual(yield* env.coordinator.state, { phase: "attempting" });
+        assert.equal(env.notifications(), 0);
+        yield* Deferred.succeed(live.resume, undefined);
+        assert.deepStrictEqual(yield* Fiber.join(live.fiber), declined);
+        yield* assertOpen(env);
+        yield* Scope.close(scope, Exit.void);
+      }),
+  );
+
+  it.effect("the root that loses to the seal cannot execute while the attempt is live", () =>
+    Effect.gen(function* () {
+      const env = yield* setup();
+      const scope = yield* Scope.make();
+      const attempt = yield* forkAttempt(
+        env,
+        scope,
+        () => Effect.void,
+        () => Effect.succeed(declined),
+      );
+      const root = yield* env.activity.acquire("late root").pipe(Effect.flip);
+      assert.equal(root.reason, "sealed");
+      const command = yield* env.admission.withAdmission(Effect.void).pipe(Effect.flip);
+      assert.instanceOf(command, UpdateAdmissionClosedError);
+      yield* Deferred.succeed(attempt.resume, undefined);
+      assert.deepStrictEqual(yield* Fiber.join(attempt.fiber), declined);
+      yield* assertOpen(env);
+      yield* Scope.close(scope, Exit.void);
+    }),
+  );
+
+  it.effect.each([
+    { name: "returns a decline", after: () => Effect.succeed(declined) },
+    { name: "fails", after: () => Effect.fail("transport lost after acceptance") },
+    {
+      name: "is rejected late",
+      after: (control: IdleHandoffControl) =>
+        Effect.sync(() => {
+          control.definitivelyRejected();
+          return declined;
+        }),
+    },
+  ])(
+    "acceptance latches both gates even when the handoff $name, until the owning scope closes",
+    ({ after }) =>
+      Effect.gen(function* () {
+        const env = yield* setup();
+        const scope = yield* Scope.make();
+        const attempt = yield* forkAttempt(
+          env,
+          scope,
+          (control) =>
+            Effect.sync(() => control.dispatchStarted()).pipe(
+              Effect.andThen(control.accepted),
+              Effect.andThen(control.accepted),
+            ),
+          after,
+        );
+        assert.deepStrictEqual(yield* env.coordinator.state, { phase: "accepted" });
+        assert.equal(env.notifications(), 1);
+        yield* assertLatched(env);
+
+        // The handoff exits, but the attempt parks instead of answering the queue.
+        yield* Deferred.succeed(attempt.resume, undefined);
+        yield* Effect.yieldNow;
+        yield* Effect.yieldNow;
+        assert.isFalse(yield* isSettled(attempt.fiber));
+        yield* assertLatched(env);
+        yield* assertUnstealable(env);
+        assert.deepStrictEqual(yield* env.coordinator.state, { phase: "accepted" });
+
+        // Scope teardown ends the attempt with finite cleanup and nothing reopened.
+        yield* Scope.close(scope, Exit.void);
+        const exit = yield* Fiber.await(attempt.fiber);
+        assert.isTrue(Exit.isFailure(exit) && Cause.hasInterrupts(exit.cause));
+        yield* assertLatched(env);
+        yield* assertUnstealable(env);
+        assert.equal(env.notifications(), 1);
+        assert.deepStrictEqual(yield* env.coordinator.state, { phase: "accepted" });
+
+        // A later attempt parks rather than offering the queue a reusable decline.
+        const later = yield* env.coordinator
+          .tryActivate(() => Effect.succeed(declined), env.onHandoffAccepted)
+          .pipe(Effect.forkChild);
+        yield* Effect.yieldNow;
+        assert.isFalse(yield* isSettled(later));
+        yield* Fiber.interrupt(later);
+      }),
+  );
+
+  it.effect("cancellation right after acceptance keeps both gates and notifies exactly once", () =>
+    Effect.gen(function* () {
+      const env = yield* setup();
+      const scope = yield* Scope.make();
+      const attempt = yield* forkAttempt(
+        env,
+        scope,
+        (control) =>
+          Effect.sync(() => control.dispatchStarted()).pipe(Effect.andThen(control.accepted)),
+        () => Effect.succeed(declined),
+      );
+      yield* Fiber.interrupt(attempt.fiber);
+      const exit = yield* Fiber.await(attempt.fiber);
+      assert.isTrue(Exit.isFailure(exit) && Cause.hasInterrupts(exit.cause));
+      yield* assertLatched(env);
+      assert.equal(env.notifications(), 1);
+      assert.deepStrictEqual(yield* env.coordinator.state, { phase: "accepted" });
+      yield* Scope.close(scope, Exit.void);
+    }),
+  );
+
+  it.effect("a queue notification defect after acceptance cannot reopen the gates", () =>
+    Effect.gen(function* () {
+      const env = yield* setup();
+      const scope = yield* Scope.make();
+      const attempt = yield* Effect.forkIn(
+        env.coordinator.tryActivate(
+          (control) =>
+            Effect.sync(() => control.dispatchStarted()).pipe(
+              Effect.andThen(control.accepted),
+              Effect.as(declined),
+            ),
+          Effect.die(new Error("queue persistence exploded")),
+        ),
+        scope,
+      );
+      yield* Effect.yieldNow;
+      yield* Effect.yieldNow;
+      assert.isFalse(yield* isSettled(attempt));
+      yield* assertLatched(env);
+      assert.deepStrictEqual(yield* env.coordinator.state, { phase: "accepted" });
+      yield* Scope.close(scope, Exit.void);
+      yield* assertLatched(env);
+    }),
+  );
+
+  it.effect("dispatch followed by a definite rejection releases both gates", () =>
+    Effect.gen(function* () {
+      const env = yield* setup();
+      const outcome = yield* env.coordinator.tryActivate(
+        (control) =>
+          Effect.sync(() => {
+            control.dispatchStarted();
+            control.definitivelyRejected();
+            return { status: "busy", reason: "launcher refused: agents running" } as const;
+          }),
+        env.onHandoffAccepted,
+      );
+      assert.deepStrictEqual(outcome, {
+        status: "busy",
+        reason: "launcher refused: agents running",
+      });
+      assert.equal(env.notifications(), 0);
+      yield* assertOpen(env);
+    }),
+  );
+
+  it.effect.each([
+    { name: "a decline return", after: () => Effect.succeed(declined) },
+    { name: "an error", after: () => Effect.fail("ipc timeout") },
+  ])("dispatch followed by $name without proof latches both gates as uncertain", ({ after }) =>
+    Effect.gen(function* () {
+      const env = yield* setup();
+      const scope = yield* Scope.make();
+      const attempt = yield* forkAttempt(
+        env,
+        scope,
+        (control) => Effect.sync(() => control.dispatchStarted()),
+        after,
+      );
+      assert.deepStrictEqual(yield* env.coordinator.state, { phase: "attempting" });
+
+      yield* Deferred.succeed(attempt.resume, undefined);
+      yield* Effect.yieldNow;
+      yield* Effect.yieldNow;
+      assert.isFalse(yield* isSettled(attempt.fiber));
+      assert.deepStrictEqual(yield* env.coordinator.state, { phase: "uncertain" });
+      assert.equal(env.notifications(), 0);
+      yield* assertLatched(env);
+      yield* assertUnstealable(env);
+
+      // Stale rejection cannot undo a latch; a late acknowledgement upgrades it once.
+      attempt.control.definitivelyRejected();
+      assert.deepStrictEqual(yield* env.coordinator.state, { phase: "uncertain" });
+      yield* attempt.control.accepted;
+      yield* attempt.control.accepted;
+      assert.deepStrictEqual(yield* env.coordinator.state, { phase: "accepted" });
+      assert.equal(env.notifications(), 1);
+
+      yield* Scope.close(scope, Exit.void);
+      const exit = yield* Fiber.await(attempt.fiber);
+      assert.isTrue(Exit.isFailure(exit) && Cause.hasInterrupts(exit.cause));
+      yield* assertLatched(env);
+      yield* attempt.control.accepted;
+      assert.equal(env.notifications(), 1);
+    }),
+  );
+
+  it.effect("cancellation after dispatch latches both gates as uncertain without notifying", () =>
+    Effect.gen(function* () {
+      const env = yield* setup();
+      const scope = yield* Scope.make();
+      const attempt = yield* forkAttempt(
+        env,
+        scope,
+        (control) => Effect.sync(() => control.dispatchStarted()),
+        () => Effect.succeed(declined),
+      );
+      yield* Scope.close(scope, Exit.void);
+      const exit = yield* Fiber.await(attempt.fiber);
+      assert.isTrue(Exit.isFailure(exit) && Cause.hasInterrupts(exit.cause));
+      assert.deepStrictEqual(yield* env.coordinator.state, { phase: "uncertain" });
+      assert.equal(env.notifications(), 0);
+      yield* assertLatched(env);
+      yield* assertUnstealable(env);
+
+      // Once the attempt has exited, its control can no longer change anything.
+      yield* attempt.control.accepted;
+      assert.deepStrictEqual(yield* env.coordinator.state, { phase: "uncertain" });
+      assert.equal(env.notifications(), 0);
+    }),
+  );
+});
diff --git a/apps/server/src/cloud/idleUpdateCoordinator.ts b/apps/server/src/cloud/idleUpdateCoordinator.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d795ebafa437fc5635d6e7b42aaca4c044a5209b
--- /dev/null
+++ b/apps/server/src/cloud/idleUpdateCoordinator.ts
@@ -0,0 +1,215 @@
+/**
+ * IdleUpdateCoordinator - claims both update gates (client admission and agent
+ * activity) for an update handoff only while the server is provably idle, and
+ * never lets a possibly accepted handoff reopen them.
+ *
+ * The queue owns staging, retry timing and the activation fiber; this only
+ * decides whether one handoff attempt may run right now and what its exit
+ * means for the gates. A busy environment is answered at once without closing
+ * anything. Once a transport has been dispatched, only a definite rejection
+ * may release the gates: acceptance and every ambiguous outcome latch them for
+ * the rest of the process, and the attempt parks interruptibly instead of
+ * returning an answer the queue could retry or cancel.
+ *
+ * @module IdleUpdateCoordinator
+ */
+import * as Cause from "effect/Cause";
+import * as Context from "effect/Context";
+import * as Effect from "effect/Effect";
+import * as Exit from "effect/Exit";
+import * as Layer from "effect/Layer";
+
+import {
+  type HandoffMaintenanceControl,
+  UpdateAdmission,
+  type UpdateAdmissionShape,
+} from "../updateAdmission.ts";
+import {
+  UpdateActivity,
+  type UpdateActivityShape,
+  type UpdateActivityState,
+} from "../updateActivity.ts";
+import type { ActivationDeclined } from "./queuedUpdate.ts";
+
+export interface IdleHandoffControl {
+  /**
+   * Call immediately before the actual transport submission, inside its mask.
+   * From here on an exit without `definitivelyRejected` or `accepted` is an
+   * ambiguous outcome and latches the gates.
+   */
+  readonly dispatchStarted: () => void;
+  /**
+   * Only a definite response proving no shutdown was authorized may call this.
+   * Clears the outstanding dispatch uncertainty; never revokes acceptance.
+   */
+  readonly definitivelyRejected: () => void;
+  /**
+   * Latches both gates for the rest of the process synchronously, then runs
+   * the queue notification once. Idempotent; inert once the attempt has exited.
+   */
+  readonly accepted: Effect.Effect<void>;
+}
+
+export interface IdleUpdateCoordinatorState {
+  readonly phase: "ready" | "attempting" | "accepted" | "uncertain";
+}
+
+export interface IdleUpdateCoordinatorShape {
+  /**
+   * Runs `handoff` with both gates claimed if the server is idle, otherwise
+   * declines promptly with nothing closed. Returns only declines: after an
+   * accepted or ambiguous handoff it never returns, and only the owning scope
+   * closing ends it, with both gates still latched.
+   */
+  readonly tryActivate: <E, R>(
+    handoff: (control: IdleHandoffControl) => Effect.Effect<ActivationDeclined, E, R>,
+    onHandoffAccepted: Effect.Effect<void>,
+  ) => Effect.Effect<ActivationDeclined, E, R>;
+  readonly state: Effect.Effect<IdleUpdateCoordinatorState>;
+}
+
+export class IdleUpdateCoordinator extends Context.Service<
+  IdleUpdateCoordinator,
+  IdleUpdateCoordinatorShape
+>()("t3/cloud/idleUpdateCoordinator") {}
+
+export interface IdleUpdateCoordinatorDependencies {
+  readonly admission: UpdateAdmissionShape;
+  readonly activity: UpdateActivityShape;
+}
+
+const isIdle = (state: UpdateActivityState): boolean =>
+  state.phase === "open" && state.outstanding === 0 && state.blockers.length === 0;
+
+const declineFor = (state: UpdateActivityState): ActivationDeclined => {
+  if (state.phase === "closed") return { status: "unknown", reason: "activity registry is closed" };
+  if (state.phase === "sealed") return { status: "busy", reason: "activity is already sealed" };
+  if (state.blockers.length > 0) {
+    return { status: "unknown", reason: `activity is blocked: ${state.blockers.join(", ")}` };
+  }
+  return { status: "busy", reason: `${state.outstanding} agent operation(s) in flight` };
+};
+
+const admissionBusy: ActivationDeclined = {
+  status: "busy",
+  reason: "client commands or another maintenance own update admission",
+};
+
+const attemptInProgress: ActivationDeclined = {
+  status: "busy",
+  reason: "an update handoff attempt is already in progress",
+};
+
+export const make = ({
+  admission,
+  activity,
+}: IdleUpdateCoordinatorDependencies): IdleUpdateCoordinatorShape => {
+  let phase: IdleUpdateCoordinatorState["phase"] = "ready";
+
+  // Latched gates outlive every attempt. A later call must never hand the
+  // queue a decline it could retry or cancel against a possible restart.
+  const parked = Effect.interruptible(Effect.never);
+
+  // Runs inside the admission claim: seal activity, own the seal under cleanup,
+  // then interpret the handoff's exit. The seal is retained by never releasing
+  // it; admission by the control handed in from the claim. Both happen in one
+  // synchronous step, so no observer sees one gate latched without the other.
+  const attempt = <E, R>(
+    admissionControl: HandoffMaintenanceControl,
+    handoff: (control: IdleHandoffControl) => Effect.Effect<ActivationDeclined, E, R>,
+    onHandoffAccepted: Effect.Effect<void>,
+  ): Effect.Effect<ActivationDeclined, E, R> =>
+    Effect.uninterruptibleMask((restore) =>
+      Effect.flatMap(activity.trySealIdle, (claim) => {
+        if (claim.status === "busy") return Effect.succeed(declineFor(claim.state));
