+  );
+
+  it.effect("blocks idleness when a required runtime consumer dies with undelivered events", () =>
+    Effect.gen(function* () {
+      const threadId = asThreadId("thread-update-activity-dead");
+      const { codex, provider, activity } = yield* startTrackedSession(threadId);
+
+      const ingestion = yield* provider.subscribeUpdateEvents("runtime-ingestion");
+      const checkpoint = yield* provider.subscribeUpdateEvents("checkpoint");
+      const checkpointed: string[] = [];
+      const secondCheckpointed = yield* Deferred.make<void>();
+      const ingestionRun = yield* Effect.forkChild(
+        ingestion.run(() => Effect.fail("ingestion crashed")),
+      );
+      yield* Effect.forkScoped(
+        checkpoint.run((event) =>
+          Effect.sync(() => {
+            checkpointed.push(event.eventId);
+            if (checkpointed.length === 2) Deferred.doneUnsafe(secondCheckpointed, Effect.void);
+          }),
+        ),
+      );
+      yield* awaitActivity(activity, (state) => state.blockers.length === 0);
+
+      codex.emit(terminalEvent("evt-dead-1", threadId));
+      assert.equal(Exit.isFailure(yield* Fiber.await(ingestionRun)), true);
+      // The dead channel stays blocked while the adapter reader and the other
+      // consumer keep working.
+      codex.emit(terminalEvent("evt-dead-2", threadId));
+      yield* Deferred.await(secondCheckpointed);
