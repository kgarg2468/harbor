+describe("ProviderServiceLive update activity", () => {
+  // Resolves through registry revisions once the predicate holds; never polls.
+  const awaitActivity = (
+    activity: UpdateActivityShape,
+    predicate: (state: UpdateActivityState) => boolean,
+  ) =>
+    Effect.gen(function* () {
+      let state = yield* activity.state;
+      while (!predicate(state)) state = yield* activity.awaitChange(state.revision);
+      return state;
+    });
+
+  const makeTrackedProviderLayer = (codex: ReturnType<typeof makeFakeCodexAdapter>) =>
+    makeProviderServiceLive().pipe(
+      Layer.provide(NodeServices.layer),
+      Layer.provide(
+        Layer.succeed(
+          ProviderAdapterRegistry.ProviderAdapterRegistry,
+          makeStaticInstanceRegistry([[codexInstanceId, codex.adapter]]),
+        ),
+      ),
+      Layer.provide(
+        ProviderSessionDirectoryLive.pipe(
+          Layer.provide(ProviderSessionRuntime.layer.pipe(Layer.provide(SqlitePersistenceMemory))),
+        ),
+      ),
+      Layer.provide(defaultServerSettingsLayer),
+      Layer.provide(serverConfigTestLayer),
+      Layer.provide(AnalyticsService.layerTest),
+      Layer.provide(
+        Layer.succeed(
+          ProviderEventLoggers.ProviderEventLoggers,
+          ProviderEventLoggers.NoOpProviderEventLoggers,
+        ),
+      ),
+      Layer.provideMerge(UpdateActivityLive),
+    );
+
+  const terminalEvent = (eventId: string, threadId: ThreadId): LegacyProviderRuntimeEvent => ({
+    type: "turn.completed",
+    eventId: asEventId(eventId),
+    provider: CODEX_DRIVER,
+    createdAt: "2026-01-01T00:00:00.000Z",
+    threadId,
+    turnId: asTurnId("turn-1"),
+    payload: { state: "completed" },
+  });
+
+  const startTrackedSession = (threadId: ThreadId) =>
+    Effect.gen(function* () {
+      const codex = makeFakeCodexAdapter();
+      const services = yield* Layer.build(makeTrackedProviderLayer(codex));
+      const provider = yield* ProviderService.ProviderService.pipe(Effect.provide(services));
+      const activity = yield* UpdateActivity.pipe(Effect.provide(services));
+      yield* provider.startSession(threadId, {
+        provider: CODEX_DRIVER,
+        providerInstanceId: codexInstanceId,
+        threadId,
+        runtimeMode: "full-access",
+      });
+      return { codex, provider, activity };
+    });
+
+  it.effect("keeps a canonical terminal event owned until both required consumers finish", () =>
+    Effect.gen(function* () {
+      const threadId = asThreadId("thread-update-activity-owned");
+      const { codex, provider, activity } = yield* startTrackedSession(threadId);
+
+      // Nothing may be claimed idle before both required consumers exist.
+      assert.equal((yield* activity.trySealIdle).status, "busy");
+      assert.deepEqual((yield* activity.state).blockers, [
+        "required subscriber not registered: runtime/runtime-ingestion",
+        "required subscriber not registered: runtime/checkpoint",
+      ]);
+
+      const ingestion = yield* provider.subscribeUpdateEvents("runtime-ingestion");
+      const checkpoint = yield* provider.subscribeUpdateEvents("checkpoint");
+      const ingested: string[] = [];
+      const checkpointed: string[] = [];
+      const ingestionEntered = yield* Deferred.make<void>();
+      const ingestionGate = yield* Deferred.make<void>();
+      const checkpointEntered = yield* Deferred.make<void>();
+      const checkpointGate = yield* Deferred.make<void>();
+      yield* Effect.forkScoped(
+        ingestion.run((event) =>
+          Effect.suspend(() => {
+            ingested.push(event.eventId);
+            return Deferred.succeed(ingestionEntered, undefined).pipe(
+              Effect.andThen(Deferred.await(ingestionGate)),
+            );
+          }),
+        ),
+      );
+      yield* Effect.forkScoped(
+        checkpoint.run((event) =>
+          Effect.suspend(() => {
+            checkpointed.push(event.eventId);
+            return Deferred.succeed(checkpointEntered, undefined).pipe(
+              Effect.andThen(Deferred.await(checkpointGate)),
+            );
+          }),
+        ),
+      );
+      // Started runs clear their not-running blockers. An idle session is not work.
+      yield* awaitActivity(activity, (state) => state.blockers.length === 0);
+      const idle = yield* activity.trySealIdle;
+      assert.equal(idle.status, "sealed");
+      if (idle.status === "sealed") idle.seal.release();
+
+      codex.emit(terminalEvent("evt-owned-1", threadId));
+      yield* Deferred.await(ingestionEntered);
+      yield* Deferred.await(checkpointEntered);
+      // Processing ownership ends with publication; the two deliveries remain.
+      const delivered = yield* awaitActivity(activity, (state) => state.outstanding === 2);
+      assert.deepEqual(delivered.blockers, []);
+      assert.equal((yield* activity.trySealIdle).status, "busy");
+
+      yield* Deferred.succeed(ingestionGate, undefined);
+      yield* awaitActivity(activity, (state) => state.outstanding === 1);
+      assert.equal((yield* activity.trySealIdle).status, "busy");
+
+      yield* Deferred.succeed(checkpointGate, undefined);
+      yield* awaitActivity(activity, (state) => state.outstanding === 0);
+      const sealed = yield* activity.trySealIdle;
+      assert.equal(sealed.status, "sealed");
+      assert.deepEqual(ingested, ["evt-owned-1"]);
+      assert.deepEqual(checkpointed, ["evt-owned-1"]);
+
+      // A native event arriving while sealed cannot be owned. It is dropped
+      // behind a permanent blocker rather than treated as settled work.
+      const sealedRevision = (yield* activity.state).revision;
+      codex.emit(terminalEvent("evt-while-sealed", threadId));
+      const dropped = yield* activity.awaitChange(sealedRevision);
+      assert.deepEqual(dropped.blockers, ["provider runtime event not owned: sealed"]);
+      if (sealed.status === "sealed") sealed.seal.release();
+      assert.equal((yield* activity.trySealIdle).status, "busy");
+      assert.deepEqual(ingested, ["evt-owned-1"]);
