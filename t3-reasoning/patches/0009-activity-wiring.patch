+    });
+
+  const makeMutableInstanceRegistry = Effect.gen(function* () {
+    const adapters = new Map<ProviderInstanceId, ProviderAdapterShape<ProviderAdapterError>>();
+    const changes = yield* PubSub.unbounded<void>();
+    const unsupported = (instanceId: ProviderInstanceId) =>
+      new ProviderUnsupportedError({ provider: ProviderDriverKind.make(instanceId) });
+    const registry: ProviderAdapterRegistry.ProviderAdapterRegistry["Service"] = {
+      getByInstance: (instanceId) => {
+        const adapter = adapters.get(instanceId);
+        return adapter ? Effect.succeed(adapter) : Effect.fail(unsupported(instanceId));
+      },
+      getInstanceInfo: (instanceId) => {
+        const adapter = adapters.get(instanceId);
+        return adapter
+          ? Effect.succeed({
+              instanceId,
+              driverKind: adapter.provider,
+              displayName: undefined,
+              enabled: true,
+              continuationIdentity: {
+                driverKind: adapter.provider,
+                continuationKey: `${adapter.provider}:instance:${instanceId}`,
+              },
+            })
+          : Effect.fail(unsupported(instanceId));
+      },
+      listInstances: () => Effect.succeed(Array.from(adapters.keys())),
+      subscribeChanges: PubSub.subscribe(changes),
+    };
+    const replace = (
+      instanceId: ProviderInstanceId,
+      adapter: ProviderAdapterShape<ProviderAdapterError>,
+    ) =>
+      Effect.sync(() => {
+        adapters.set(instanceId, adapter);
+      }).pipe(Effect.andThen(PubSub.publish(changes, undefined)));
+    return { registry, replace };
+  });
+
+  // Holds canonical publication of chosen events so a receipt can be
+  // observed while its event is mid-flight in the service.
+  const makeHoldingCanonicalLogger = () => {
+    const holds = new Map<
+      string,
+      { readonly entered: Deferred.Deferred<void>; readonly gate: Deferred.Deferred<void> }
+    >();
+    const logger: EventNdjsonLogger = {
+      filePath: "memory://canonical",
+      write: (event) =>
+        Effect.suspend(() => {
+          const eventId = (event as { readonly eventId?: string }).eventId;
+          const hold = eventId === undefined ? undefined : holds.get(eventId);
+          if (hold === undefined) return Effect.void;
+          return Deferred.succeed(hold.entered, undefined).pipe(
+            Effect.andThen(Deferred.await(hold.gate)),
+          );
+        }),
+      close: () => Effect.void,
+    };
+    const hold = (eventId: string) =>
+      Effect.gen(function* () {
+        const entered = yield* Deferred.make<void>();
+        const gate = yield* Deferred.make<void>();
+        holds.set(eventId, { entered, gate });
+        return { entered, gate };
+      });
+    return { logger, hold };
+  };
