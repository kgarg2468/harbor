+      Layer.provide(defaultServerSettingsLayer),
+      Layer.provide(serverConfigTestLayer),
+      Layer.provide(AnalyticsService.layerTest),
+      Layer.provide(
+        Layer.succeed(
+          ProviderEventLoggers.ProviderEventLoggers,
+          ProviderEventLoggers.NoOpProviderEventLoggers,
+        ),
+      ),
+      Layer.provide(Layer.succeed(UpdateActivity, activity)),
+    );
+
+  // Both required consumers, completing immediately, with a barrier on any
+  // event id so a test can prove an earlier event has already been handled.
+  const makeRequiredConsumers = (provider: ProviderService.ProviderService["Service"]) =>
+    Effect.gen(function* () {
+      const seen: Array<string> = [];
+      const waiters = new Map<string, Deferred.Deferred<void>>();
+      const record = (name: string) => (event: ProviderRuntimeEvent) =>
+        Effect.sync(() => {
+          seen.push(`${name}:${event.eventId}`);
+          const waiter = waiters.get(`${name}:${event.eventId}`);
+          if (waiter) Deferred.doneUnsafe(waiter, Effect.void);
+        });
+      const ingestion = yield* provider.subscribeUpdateEvents("runtime-ingestion");
+      const checkpoint = yield* provider.subscribeUpdateEvents("checkpoint");
+      yield* Effect.forkScoped(ingestion.run(record("runtime-ingestion")));
+      yield* Effect.forkScoped(checkpoint.run(record("checkpoint")));
+      const awaitEvent = (eventId: string) =>
+        Effect.forEach(
+          ["runtime-ingestion", "checkpoint"],
+          (name) =>
+            Effect.suspend(() => {
+              const key = `${name}:${eventId}`;
+              if (seen.includes(key)) return Effect.void;
+              const waiter = Deferred.makeUnsafe<void>();
+              waiters.set(key, waiter);
+              return Deferred.await(waiter);
+            }),
