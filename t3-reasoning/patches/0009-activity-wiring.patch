+/**
+ * OwnedEventSource - a single required delivery queue whose every accepted
+ * value travels with a unique, closure-owned receipt, plus an untracked
+ * observer stream of the same values.
+ *
+ * A receipt is settled only by an explicit `complete` or `lost`; returning
+ * from the required handler does not settle it, because the handler may have
+ * moved the delivery into a buffer it flushes later. The source remembers
+ * every unsettled receipt so abnormal teardown can establish a blocker and
+ * release receipts held outside its queue, while a clean `retire` waits for
+ * them instead.
+ *
+ * Unlike `makeTrackedFanout`, closure is not always a permanent blocker: an
+ * idle adapter generation that has authoritatively finished its native work
+ * retires cleanly so its replacement can later be claimed idle.
+ *
+ * @module OwnedEventSource
+ */
+import * as Cause from "effect/Cause";
+import * as Deferred from "effect/Deferred";
+import * as Effect from "effect/Effect";
+import * as Exit from "effect/Exit";
+import * as PubSub from "effect/PubSub";
+import * as Queue from "effect/Queue";
+import type * as Scope from "effect/Scope";
+import * as Stream from "effect/Stream";
+
+import {
+  UpdateActivityUnavailableError,
+  type ActivityBlocker,
+  type ActivityLease,
+  type UpdateActivityShape,
+} from "../updateActivity.ts";
+
+export interface OwnedDelivery<A> {
+  readonly value: A;
+  /** Settles this occurrence as fully handled. Synchronous and idempotent. */
+  readonly complete: () => void;
+  /** Establishes the source's permanent blocker, then settles this occurrence. Synchronous and idempotent. */
+  readonly lost: (reason: string) => void;
+}
+
+export interface RequiredOwnedSubscription<A> {
+  /**
+   * Consumes the required queue in order. Exactly one run per source. Ends
+   * successfully only after a clean `retire` drained the queue; any other
+   * end, including a handler failure, fails the source first.
+   */
+  readonly run: <E, R>(
+    handle: (delivery: OwnedDelivery<A>) => Effect.Effect<void, E, R>,
+  ) => Effect.Effect<void, E | UpdateActivityUnavailableError, R>;
+}
+
+export interface OwnedEventSource<A> {
+  /** Acquires a delivery lease, then offers the receipt to the required queue and the value to observers. */
+  readonly publish: (value: A) => Effect.Effect<void, UpdateActivityUnavailableError>;
+  /** Claims the single required consumer. Registration swaps the missing blocker for a not-running one that only a started `run` clears. */
+  readonly subscribeRequired: Effect.Effect<
+    RequiredOwnedSubscription<A>,
+    UpdateActivityUnavailableError,
+    Scope.Scope
+  >;
+  /** Untracked observers; each run subscribes on its own and never touches receipts. */
+  readonly streamObservers: Stream.Stream<A>;
+  /**
+   * Producer-side clean end, only after native work has authoritatively
+   * finished. Refuses new publishes, ends the queue, waits for every
+   * unsettled receipt and for a started required run to finish normally,
+   * then clears the source's own readiness blockers.
+   */
+  readonly retire: Effect.Effect<void>;
+  /** Abnormal teardown: permanent blocker first, then every unsettled receipt is released and the queue is failed. */
+  readonly fail: (reason: string) => Effect.Effect<void>;
+}
+
+interface Receipt<A> extends OwnedDelivery<A> {
+  readonly lease: ActivityLease;
+  settled: boolean;
+}
+
+type Phase = "open" | "retiring" | "retired" | "failed";
+
+export const makeOwnedEventSource = <A>(
+  activity: UpdateActivityShape,
+  label: string,
+): Effect.Effect<OwnedEventSource<A>, never, Scope.Scope> =>
+  Effect.gen(function* () {
+    const queue = yield* Queue.unbounded<Receipt<A>, Cause.Done | UpdateActivityUnavailableError>();
+    const observers = yield* Effect.acquireRelease(PubSub.unbounded<A>(), PubSub.shutdown);
+    const closeObservers = PubSub.shutdown(observers);
+    const unsettled = new Set<Receipt<A>>();
+    const drainWaiters = new Set<Deferred.Deferred<void>>();
+    let phase: Phase = "open";
+    let owned = false;
+    let running = false;
+    // Settled once the single required run has exited, however it ended.
+    const runExit = yield* Deferred.make<void>();
+    const missing: ActivityBlocker = activity.block(`required subscriber not registered: ${label}`);
+    let notRunning: ActivityBlocker | undefined;
+    let unavailable: ActivityBlocker | undefined;
+
+    const closedError = () => new UpdateActivityUnavailableError({ reason: "closed" });
+
+    const wakeDrainWaiters = (): void => {
+      if (unsettled.size > 0 || drainWaiters.size === 0) return;
+      const woken = Array.from(drainWaiters);
+      drainWaiters.clear();
+      for (const waiter of woken) Deferred.doneUnsafe(waiter, Effect.void);
+    };
+
+    // Releases one receipt's lease. Callers establish any blocker first.
+    const settle = (receipt: Receipt<A>): void => {
+      if (receipt.settled) return;
+      receipt.settled = true;
+      unsettled.delete(receipt);
+      receipt.lease.release();
+      wakeDrainWaiters();
+    };
+
+    const markUnavailable = (reason: string): void => {
+      unavailable ??= activity.block(`owned event source unavailable: ${label}: ${reason}`);
+    };
+
+    // Blocker first, then diagnostic blockers, then every receipt this source
+    // still tracks, all in one synchronous step so no observer can see the
+    // outstanding count drop without the blocker.
+    const failSync = (reason: string): void => {
+      markUnavailable(reason);
+      if (phase === "failed") return;
+      phase = "failed";
+      missing.clear();
+      notRunning?.clear();
+      for (const receipt of Array.from(unsettled)) settle(receipt);
+      Queue.failCauseUnsafe(queue, Cause.fail(closedError()));
+    };
+
+    const makeReceipt = (value: A, lease: ActivityLease): Receipt<A> => {
+      const receipt: Receipt<A> = {
+        value,
+        lease,
+        settled: false,
+        complete: () => settle(receipt),
+        lost: (reason) => {
+          if (receipt.settled) return;
+          markUnavailable(`delivery lost: ${reason}`);
+          settle(receipt);
+        },
+      };
+      return receipt;
+    };
+
+    // The lease exists before the offer; a refused or late offer hands it
+    // straight back under the same mask, so an accepted value is never unowned
+    // and a rejected one never leaks a lease.
+    const publish: OwnedEventSource<A>["publish"] = (value) =>
+      Effect.uninterruptible(
+        Effect.flatMap(activity.acquire(`${label} delivery`), (lease) =>
+          Effect.suspend(() => {
+            if (phase !== "open") {
+              lease.release();
+              return Effect.fail(closedError());
+            }
+            const receipt = makeReceipt(value, lease);
+            unsettled.add(receipt);
+            if (!Queue.offerUnsafe(queue, receipt)) {
+              failSync("required queue refused a delivery");
+              return Effect.fail(closedError());
+            }
+            PubSub.publishUnsafe(observers, value);
+            return Effect.void;
+          }),
+        ),
+      );
+
+    // Death cleanup is installed before the not-running blocker clears, so a
+    // run canceled before its body starts stays visibly blocked. The handler
+    // is constructed inside the delivery's own cleanup, so a callback that
+    // throws synchronously fails the source rather than orphaning a receipt.
+    // A successful exit only follows the queue's `Done` from a clean retire.
+    // Any other end is a consumer loss unless the source already retired,
+    // which only happens after this run exited or before it ever started;
+    // a run canceled on an already retired source has nothing left to lose.
+    const runLoop = <E, R>(
+      handle: (delivery: OwnedDelivery<A>) => Effect.Effect<void, E, R>,
+    ): Effect.Effect<void, E | UpdateActivityUnavailableError, R> =>
+      Effect.onExit(
+        Effect.sync(() => notRunning?.clear()).pipe(
+          Effect.andThen(
+            Effect.uninterruptibleMask((restore) =>
+              Effect.flatMap(restore(Queue.take(queue)), (receipt) =>
+                Effect.onExit(restore(Effect.suspend(() => handle(receipt))), (exit) =>
+                  Effect.sync(() => {
+                    if (!Exit.isSuccess(exit)) {
+                      failSync(
+                        `required handler ended with ${exit.cause.reasons[0]?._tag ?? "failure"}`,
+                      );
+                    }
+                  }),
+                ),
+              ),
+            ).pipe(Effect.forever),
+          ),
+          Effect.catchTag("Done", () => Effect.void),
+        ),
+        (exit) =>
+          Effect.suspend(() => {
+            if (!Exit.isSuccess(exit) && phase !== "retired") failSync("required consumer ended");
+            Deferred.doneUnsafe(runExit, Effect.void);
+            return phase === "failed" ? closeObservers : Effect.void;
+          }),
+      );
+
+    const subscribeRequired: OwnedEventSource<A>["subscribeRequired"] = Effect.uninterruptible(
+      Effect.gen(function* () {
+        if (owned) {
+          return yield* new UpdateActivityUnavailableError({ reason: "subscriber-already-owned" });
+        }
+        if (phase === "failed" || phase === "retired") return yield* closedError();
+        owned = true;
+        // Losing the registration scope with the source still live is a
+        // consumer loss; after a clean retire there is nothing left to lose.
+        yield* Effect.addFinalizer(() =>
+          Effect.suspend(() => {
+            if (phase === "retired") return Effect.void;
+            failSync("required subscription scope closed");
+            return closeObservers;
+          }),
+        );
+        notRunning = activity.block(`required subscriber not running: ${label}`);
+        missing.clear();
+        const run: RequiredOwnedSubscription<A>["run"] = (handle) =>
