+  const makeOwnedFakeAdapter = (
+    activity: UpdateActivityShape,
+    label: string,
+    provider: ProviderDriverKind = CODEX_DRIVER,
+  ) =>
+    Effect.gen(function* () {
+      const source = yield* makeOwnedEventSource<ProviderRuntimeEvent>(activity, label);
+      const base = makeFakeCodexAdapter(provider);
+      const adapter: ProviderAdapterShape<ProviderAdapterError> = {
+        ...base.adapter,
+        streamEvents: source.streamObservers,
+        subscribeUpdateEvents: source.subscribeRequired,
+      };
+      const publish = (event: LegacyProviderRuntimeEvent) =>
+        source.publish(event as unknown as ProviderRuntimeEvent);
