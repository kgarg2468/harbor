index 0000000000000000000000000000000000000000..fa01ce8573a0476c1eab9a85ac6dc8c0d974893c
--- /dev/null
+++ b/apps/server/src/cloud/managedDesktopQueuedUpdate.ts
@@ -0,0 +1,130 @@
+/** Durable desktop adapter. The desktop reservation receiver alone owns the idle gates. */
+import type * as Duration from "effect/Duration";
+import * as Effect from "effect/Effect";
+import {
+  DesktopUpdateCommitRejected,
+  type DesktopAppUpdate,
+} from "../desktopUpdate/DesktopAppUpdate.ts";
+import * as QueuedUpdate from "./queuedUpdate.ts";
+
+export const make = Effect.fn("cloud.managed_desktop_queued_update.make")(function* (deps: {
+  readonly statePath: string;
+  readonly installedVersion: string;
+  readonly pollInterval: Duration.Input;
+  readonly prepared?: Effect.Effect<boolean>;
+  readonly capturePreparationInvalidation?: Effect.Effect<Effect.Effect<void>>;
+  readonly desktop: Pick<DesktopAppUpdate["Service"], "run" | "commit" | "cancelPrepared">;
+}) {
+  // Process-local tokens must never be recovered from the durable state. Queue
+  // reconciliation restages on restart, obtaining a fresh verified descriptor.
+  const bindings = new Map<string, string>();
+  const key = (staged: QueuedUpdate.StagedArtifact) => `${staged.version}\0${staged.artifactId}`;
+  const restage = new Set<string>();
+  const stage = (targetVersion: string) =>
+    Effect.gen(function* () {
+      const result = yield* deps.desktop
+        .run(targetVersion, () => Effect.void)
+        .pipe(
+          Effect.mapError(
+            (cause) =>
+              new QueuedUpdate.QueuedUpdateStepError({
+                step: "stage",
+                reason: cause.reason,
+                cause,
+              }),
+          ),
+        );
+      if (
+        result.targetVersion !== targetVersion ||
+        result.managedArtifact?.targetVersion !== targetVersion ||
+        !result.desktopUpdateToken
+      ) {
+        if (result.desktopUpdateToken !== undefined)
+          yield* (
+            deps.desktop.cancelPrepared?.(result.desktopUpdateToken).pipe(Effect.ignore) ??
+              Effect.void
+          );
+        return yield* new QueuedUpdate.QueuedUpdateStepError({
+          step: "stage",
+          reason: "Desktop preparation did not return the exact artifact and request token.",
+        });
+      }
+      const artifact = result.managedArtifact;
+      const staged = {
+        version: targetVersion,
+        artifactId: [
+          artifact.schemaVersion,
+          artifact.targetVersion,
+          artifact.releaseArtifactId,
+          artifact.presentationVariant,
+          artifact.bytes,
+          artifact.sha256,
+          artifact.manifestSha256,
+          artifact.releaseInputSha256,
+        ]
+          .map((value) => `${String(value).length}:${value}`)
+          .join(""),
+      };
+      bindings.set(key(staged), result.desktopUpdateToken);
+      return staged;
+    });
+  return yield* QueuedUpdate.make({
+    ...deps,
+    stage,
+    tryActivate: (staged, accepted) =>
+      Effect.gen(function* () {
+        if (deps.prepared !== undefined && !(yield* deps.prepared))
+          return { status: "busy" as const, reason: "Waiting for idle desktop preparation." };
+        const invalidate = yield* (
+          deps.capturePreparationInvalidation ?? Effect.succeed(Effect.void)
+        );
+        let handoffAccepted = false;
+        return yield* Effect.gen(function* () {
+          if (restage.has(key(staged))) {
+            const replacement = yield* stage(staged.version);
+            if (key(replacement) !== key(staged)) {
+              const replacementId = bindings.get(key(replacement));
+              bindings.delete(key(replacement));
+              if (replacementId !== undefined)
+                yield* (
+                  deps.desktop.cancelPrepared?.(replacementId).pipe(Effect.ignore) ?? Effect.void
+                );
+              return yield* new QueuedUpdate.QueuedUpdateStepError({
+                step: "activate",
+                reason: "The replacement desktop preparation does not match the queued artifact.",
+              });
+            }
+            restage.delete(key(staged));
+          }
+          const requestId = bindings.get(key(staged));
+          if (requestId === undefined)
+            return yield* new QueuedUpdate.QueuedUpdateStepError({
+              step: "activate",
+              reason: "Desktop artifact must be prepared again in this process.",
+            });
+          return yield* deps.desktop
+            .commit(requestId, () =>
+              Effect.sync(() => {
+                handoffAccepted = true;
+              }).pipe(Effect.andThen(accepted)),
+            )
+            .pipe(
+              Effect.catch((cause) => {
+                if (!handoffAccepted && cause.cause instanceof DesktopUpdateCommitRejected) {
+                  bindings.delete(key(staged));
+                  restage.add(key(staged));
+                  return Effect.succeed({ status: "busy" as const, reason: cause.reason });
+                }
+                return Effect.fail(
+                  new QueuedUpdate.QueuedUpdateStepError({
+                    step: "activate",
+                    reason: cause.reason,
+                    cause,
+                  }),
+                );
+              }),
+            );
+        }).pipe(Effect.onError(() => (handoffAccepted ? Effect.void : invalidate)));
+      }),
+  });
+});
