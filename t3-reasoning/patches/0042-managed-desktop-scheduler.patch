diff --git a/apps/server/src/cloud/managedDesktopQueuedUpdate.test.ts b/apps/server/src/cloud/managedDesktopQueuedUpdate.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4dba00cd62028e8ca9690dcd82029e89516bc65f
--- /dev/null
+++ b/apps/server/src/cloud/managedDesktopQueuedUpdate.test.ts
@@ -0,0 +1,246 @@
+import { assert, it } from "@effect/vitest";
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import { ServerSelfUpdateError, type ManagedDesktopArtifactDescriptor } from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Scope from "effect/Scope";
+import * as Exit from "effect/Exit";
+import { TestClock } from "effect/testing";
+import { make } from "./managedDesktopQueuedUpdate.ts";
+import { DesktopUpdateCommitRejected } from "../desktopUpdate/DesktopAppUpdate.ts";
+import * as Preparation from "./idleUpdatePreparation.ts";
+import { make as makeAdmission } from "../updateAdmission.ts";
+import { make as makeActivity } from "../updateActivity.ts";
+import { ProviderIdlePreparationTokenTypeId } from "../provider/Services/ProviderService.ts";
+import { discoverAndQueue } from "./managedNightlyUpdate.ts";
+import * as Semaphore from "effect/Semaphore";
+import type { ManagedReleaseSelection } from "./managedReleaseSource.ts";
+
+const installed = "0.0.38-nightly.20260906.1.managed.1.p6d1933416d7a";
+const target = "0.0.38-nightly.20260906.1.managed.2.p6d1933416d7a";
+const artifact: ManagedDesktopArtifactDescriptor = {
+  schemaVersion: 1,
+  targetVersion: target,
+  presentationVariant: "reasoning",
+  releaseArtifactId: "reasoning-darwin-arm64",
+  bytes: 14,
+  sha256: "a".repeat(64),
+  manifestSha256: "b".repeat(64),
+  releaseInputSha256: "c".repeat(64),
+};
+it.layer(NodeServices.layer)("managed desktop queue", (it) => {
+  it.effect("restages content after restart and commits the new token after preparation", () =>
+    Effect.scoped(
+      Effect.gen(function* () {
+        const fs = yield* FileSystem.FileSystem;
+        const dir = yield* fs.makeTempDirectoryScoped();
+        let generation = 0;
+        let ready = false;
+        const commits: string[] = [];
+        const desktop = {
+          run: () =>
+            Effect.sync(() => ({
+              targetVersion: target,
+              method: "desktop-app" as const,
+              desktopUpdateToken: `token-${++generation}`,
+              managedArtifact: { ...artifact, sha256: String(generation).repeat(64) },
+            })),
+          commit: (id: string, accepted?: () => Effect.Effect<void>) =>
+            Effect.gen(function* () {
+              commits.push(id);
+              yield* accepted?.() ?? Effect.void;
+              return yield* Effect.never;
+            }),
+        };
+        const deps = {
+          statePath: `${dir}/queue.json`,
+          installedVersion: installed,
+          pollInterval: "1 second",
+          desktop,
+          prepared: Effect.sync(() => ready),
+        } as const;
+        const firstScope = yield* Scope.make();
+        const first = yield* make(deps).pipe(Effect.provideService(Scope.Scope, firstScope));
+        yield* first.queue(target);
+        const before = yield* first.awaitState((s) => s.stage === "queued");
+        yield* Scope.close(firstScope, Exit.void);
+        const second = yield* make(deps);
+        const after = yield* second.awaitState((s) => s.stage === "queued");
+        assert.notEqual(before.staged!.artifactId, after.staged!.artifactId);
+        assert.equal(generation, 2);
+        ready = true;
+        yield* TestClock.adjust("1 second");
+        yield* second.awaitState((s) => s.handoffAccepted);
+        assert.deepEqual(commits, ["token-2"]);
+        assert.equal((yield* second.getState).stage, "updating");
+      }),
+    ),
+  );
+  it.effect("busy queues do not delay independent idle queues and refusal has no fallback", () =>
+    Effect.scoped(
+      Effect.gen(function* () {
+        const fs = yield* FileSystem.FileSystem;
+        const dir = yield* fs.makeTempDirectoryScoped();
+        const calls: string[] = [];
+        const desktop = {
+          run: () =>
+            Effect.succeed({
+              targetVersion: target,
+              method: "desktop-app" as const,
+              desktopUpdateToken: "exact-token",
+              managedArtifact: artifact,
+            }),
+          commit: (id: string) =>
+            Effect.sync(() => calls.push(id)).pipe(
+              Effect.andThen(Effect.fail(new ServerSelfUpdateError({ reason: "refused" }))),
+            ),
+        };
+        const busyScope = yield* Scope.make();
+        const busy = yield* make({
+          statePath: `${dir}/busy.json`,
+          installedVersion: installed,
+          pollInterval: "1 second",
+          desktop,
+          prepared: Effect.succeed(false),
+        }).pipe(Effect.provideService(Scope.Scope, busyScope));
+        const idle = yield* make({
+          statePath: `${dir}/idle.json`,
+          installedVersion: installed,
+          pollInterval: "1 second",
+          desktop,
+        });
+        yield* busy.queue(target);
+        yield* busy.awaitState((s) => s.stage === "queued");
+        yield* idle.queue(target);
+        assert.equal((yield* idle.awaitState((s) => s.stage === "failed")).reason, "refused");
+        assert.deepEqual(calls, ["exact-token"]);
+        assert.equal((yield* busy.getState).handoffAccepted, false);
+        yield* Scope.close(busyScope, Exit.void);
+      }),
+    ),
+  );
+  it.effect("rejects version-only preparation before commit", () =>
+    Effect.scoped(
+      Effect.gen(function* () {
+        const fs = yield* FileSystem.FileSystem;
+        const dir = yield* fs.makeTempDirectoryScoped();
+        let commits = 0;
+        const queue = yield* make({
+          statePath: `${dir}/queue.json`,
+          installedVersion: installed,
+          pollInterval: "1 second",
+          desktop: {
+            run: () =>
+              Effect.succeed({
+                targetVersion: target,
+                method: "desktop-app" as const,
+                desktopUpdateToken: "unbound",
+              }),
+            commit: () => Effect.sync(() => commits++).pipe(Effect.andThen(Effect.never)),
+          },
+        });
+        yield* queue.queue(target);
+        yield* queue.awaitState((s) => s.stage === "failed");
+        assert.equal(commits, 0);
+      }),
+    ),
+  );
+});
+
+it.layer(NodeServices.layer)("desktop rejection recovery with real preparation", (it) => {
+  for (const failure of ["rejected", "control", "mismatch"] as const) {
+    it.effect(failure, () =>
+      Effect.scoped(
+        Effect.gen(function* () {
+          const fs = yield* FileSystem.FileSystem;
+          const dir = yield* fs.makeTempDirectoryScoped();
+          const preparation = Preparation.make({
+            admission: yield* makeAdmission(),
+            activity: yield* makeActivity(),
+            serverScope: yield* Scope.Scope,
+            provider: {
+              prepareIdleRetirement: () =>
+                Effect.succeed({
+                  status: "prepared" as const,
+                  token: {
+                    [ProviderIdlePreparationTokenTypeId]: ProviderIdlePreparationTokenTypeId,
+                  },
+                }),
+              checkIdleRetirementReadiness: () => Effect.succeed({ status: "retired" as const }),
+            },
+          });
+          let runs = 0;
+          const commits: string[] = [];
+          const cancelled: string[] = [];
+          const queue = yield* make({
+            statePath: `${dir}/queue.json`,
+            installedVersion: installed,
+            pollInterval: "1 second",
+            prepared: preparation.state.pipe(Effect.map((s) => s.phase === "prepared")),
+            capturePreparationInvalidation: preparation.captureInvalidation,
+            desktop: {
+              run: () =>
+                Effect.sync(() => ({
+                  targetVersion: target,
+                  method: "desktop-app" as const,
+                  desktopUpdateToken: `token-${++runs}`,
+                  managedArtifact: {
+                    ...artifact,
+                    sha256: failure === "mismatch" && runs > 1 ? "d".repeat(64) : artifact.sha256,
+                  },
+                })),
+              cancelPrepared: (id) =>
+                Effect.sync(() => {
+                  cancelled.push(id);
+                }),
+              commit: (id, accepted) =>
+                Effect.gen(function* () {
+                  commits.push(id);
+                  if (commits.length === 1)
+                    return yield* new ServerSelfUpdateError({
+                      reason: failure,
+                      ...(failure === "control"
+                        ? {}
+                        : { cause: new DesktopUpdateCommitRejected() }),
+                    });
+                  yield* accepted?.() ?? Effect.void;
+                  return yield* Effect.never;
+                }),
+            },
+          });
+          yield* queue.queue(target);
+          yield* queue.awaitState((s) => s.stage === "queued");
+          yield* preparation.request;
+          assert.equal((yield* preparation.settled).phase, "prepared");
+          yield* TestClock.adjust("1 second");
+          if (failure === "control") {
+            yield* queue.awaitState((s) => s.stage === "failed");
+            assert.equal((yield* preparation.state).phase, "idle");
+            yield* discoverAndQueue({
+              installedVersion: installed,
+              discoverLatest: Effect.succeed({ version: target } as ManagedReleaseSelection),
+              queue,
+              preparation,
+              gate: yield* Semaphore.make(1),
+            });
+            yield* queue.awaitState((s) => s.stage === "queued");
+            assert.equal(runs, 2);
+          } else {
+            yield* queue.awaitState((s) => s.stage === "queued" && s.reason === `busy: ${failure}`);
+            yield* TestClock.adjust("1 second");
+            if (failure === "mismatch") {
+              yield* queue.awaitState((s) => s.stage === "failed");
+              assert.deepEqual(cancelled, ["token-2"]);
+              assert.deepEqual(commits, ["token-1"]);
+              assert.equal((yield* preparation.state).phase, "idle");
+            } else {
+              yield* queue.awaitState((s) => s.handoffAccepted);
+              assert.deepEqual(commits, ["token-1", "token-2"]);
+              assert.equal((yield* preparation.state).phase, "prepared");
+            }
+          }
+        }),
+      ),
+    );
+  }
+});
